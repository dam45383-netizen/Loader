local SORU = loadstring(game:HttpGet("https://raw.githubusercontent.com/dam45383-netizen/Loader/refs/heads/main/UI.lua"))()
if not SORU then return end
local Window = SORU:CreateWindow({Title="Soru Hub"})
if not Window then return end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local lp = Players.LocalPlayer

local LOBBY = Vector3.new(-8, 5, -55)
local MIN_X, MAX_X = -78, 77

local CageConfig
pcall(function() CageConfig = require(ReplicatedStorage.Shared.Config.CageConfig) end)
if not CageConfig then CageConfig = {Cages={}} end

local function sortNum(a,b)
    local na, nb = tonumber(a:match("%d+")) or 0, tonumber(b:match("%d+")) or 0
    if na == nb then return a < b end
    return na < nb
end

local function getRarity()
    local t = {}
    for k,v in pairs(CageConfig.Cages) do table.insert(t, {Name=k, Order=v.Order or 99}) end
    table.sort(t, function(a,b) return a.Order < b.Order end)
    local o = {}
    for _,v in ipairs(t) do table.insert(o, v.Name) end
    return o
end

local function getAreas()
    local f = Workspace:FindFirstChild("Paths")
    if not f then return {} end
    local o = {}
    for _,v in ipairs(f:GetChildren()) do table.insert(o, v.Name) end
    table.sort(o, sortNum)
    return o
end

local function getBoss()
    local paths = Workspace:FindFirstChild("Paths")
    if not paths then return nil end
    local p10 = paths:FindFirstChild("Path10")
    if p10 then
        local boss = p10:FindFirstChild("Boss")
        if boss then
            if boss:IsA("BasePart") then return boss.Position end
            local part = boss:FindFirstChildWhichIsA("BasePart", true)
            if part then return part.Position end
            return boss:GetPivot().Position
        end
    end
    return nil
end

local Tab = Window:Tab({Title="Steal"})
local Crate = Tab:Accordion({Title="Crate"})

local selRar, selArea = {}, {}
local defend = "Orbit"
local on = false

Crate:MultiDropdown({Title="Rarity", Options=getRarity(), Callback=function(v) selRar = v or {} end})
Crate:MultiDropdown({Title="Area", Options=getAreas(), Callback=function(v)
    if type(v) == "string" then selArea = {v} else selArea = v or {} end
    table.sort(selArea, sortNum)
end})
Crate:Dropdown({Title="Defend", Options={"Straight","Zigzag","Wide","Random","Wave","LeftRight","Backstep","Circle","Snake","Orbit"}, Default="Orbit", Callback=function(v) defend = type(v) == "table" and v[1] or v end})

local function getChar()
    local c = lp.Character or lp.CharacterAdded:Wait()
    return c:FindFirstChild("HumanoidRootPart"), c:FindFirstChildOfClass("Humanoid")
end

local function getPos(cage)
    for _,d in ipairs(cage:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            local p = d.Parent
            if p and p:IsA("BasePart") then return p.Position end
            if p then return p:GetPivot().Position end
        end
    end
    local pr = cage:FindFirstChildWhichIsA("BasePart", true)
    return pr and pr.Position or cage:GetPivot().Position
end

local function instant(cage)
    for _,d in ipairs(cage:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            d.HoldDuration = 0
            d.RequiresLineOfSight = false
            d.MaxActivationDistance = 100
        end
    end
end

local function tween(pos)
    local hrp, hum = getChar()
    if not hrp or not hum then return end
    local cur = hrp.Position
    local dest = Vector3.new(pos.X, cur.Y, pos.Z)
    local dist = (Vector3.new(cur.X,0,cur.Z) - Vector3.new(dest.X,0,dest.Z)).Magnitude
    if dist < 0.8 then return end
    local dur = math.clamp(dist / (hum.WalkSpeed or 16), 0.15, 10)
    local cf0 = hrp.CFrame
    local dir = Vector3.new(dest.X-cur.X, 0, dest.Z-cur.Z)
    if dir.Magnitude > 0 then dir = dir.Unit else dir = Vector3.new(0,0,-1) end
    local cf1 = CFrame.lookAt(dest, dest + dir)
    hum.AutoRotate = false
    hum:ChangeState(Enum.HumanoidStateType.Physics)
    hum.PlatformStand = true
    local t0 = tick()
    local conn
    conn = RunService.Heartbeat:Connect(function()
        local a = math.clamp((tick()-t0)/dur, 0, 1)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.CFrame = cf0:Lerp(cf1, a)
        if a >= 1 then conn:Disconnect() end
    end)
    repeat task.wait() until tick()-t0 >= dur
    if conn.Connected then conn:Disconnect() end
    hrp.CFrame = cf1
    hrp.AssemblyLinearVelocity = Vector3.zero
    hum.PlatformStand = false
    hum.AutoRotate = true
    hum:ChangeState(Enum.HumanoidStateType.Running)
end

local function advanceZ(target)
    local hrp = getChar()
    if not hrp then return end
    while on do
        local cur = hrp.Position
        local dz = target.Z - cur.Z
        if math.abs(dz) <= 7 then break end
        local step = math.clamp(math.abs(dz), 10, 16) * (dz > 0 and 1 or -1)
        tween(Vector3.new(cur.X, cur.Y, cur.Z + step))
        if (Vector3.new(hrp.Position.X,0,hrp.Position.Z) - Vector3.new(target.X,0,target.Z)).Magnitude < 12 then break end
    end
    if on then tween(Vector3.new(target.X, hrp.Position.Y, target.Z)) end
end

local function defendPath(from, to, mode)
    local pts = {}
    local totalX, totalZ = to.X-from.X, to.Z-from.Z
    if mode == "Orbit" then
        local boss = getBoss()
        if boss then
            local r = 18
            for i=1,12 do
                local a = i/12 * math.pi*2
                local t = i/12
                local x = boss.X + math.cos(a)*r + (to.X-boss.X)*t*0.4
                local z = boss.Z + math.sin(a)*r + (to.Z-boss.Z)*t*0.4
                table.insert(pts, Vector3.new(math.clamp(x, MIN_X, MAX_X), from.Y, z))
            end
            table.insert(pts, Vector3.new(to.X, from.Y, to.Z))
            return pts
        end
        mode = "Zigzag"
    end
    local steps = (mode == "Wave" or mode == "Snake") and 12 or 8
    for i=1,steps do
        local t = i/steps
        local bx = from.X + totalX*t
        local bz = from.Z + totalZ*t
        local ox, oz = 0, 0
        if mode == "Zigzag" then ox = (i%2==0 and 22 or -22)
        elseif mode == "Wide" then ox = (i%2==0 and 38 or -38)
        elseif mode == "Random" then ox = math.random(-32,32) oz = math.random(-4,4)
        elseif mode == "Wave" then ox = math.sin(t*math.pi*4)*28
        elseif mode == "LeftRight" then ox = (i%2==0 and 26 or -26)
        elseif mode == "Backstep" then if i==2 then oz = -16 elseif i==3 then ox = 28 end
        elseif mode == "Circle" then if i<=5 then local a=(i/5)*math.pi*2 bx=from.X+math.cos(a)*18 bz=from.Z+math.sin(a)*10 end
        elseif mode == "Snake" then ox = math.sin(t*math.pi*6)*32
        end
        table.insert(pts, Vector3.new(math.clamp(bx+ox, MIN_X, MAX_X), from.Y, bz+oz))
    end
    table.insert(pts, Vector3.new(to.X, from.Y, to.Z))
    return pts
end

local function findTargets()
    local paths = Workspace:FindFirstChild("Paths")
    if not paths then return {} end
    local areas = #selArea > 0 and selArea or getAreas()
    table.sort(areas, sortNum)
    local out = {}
    for _,an in ipairs(areas) do
        local p = paths:FindFirstChild(an)
        if not p then continue end
        local cf = p:FindFirstChild("Cages") or p
        for _,cage in ipairs(cf:GetChildren()) do
            if not cage:IsA("Model") then continue end
            if #selRar == 0 then table.insert(out, cage)
            else for _,r in ipairs(selRar) do if string.find(cage.Name, r) then table.insert(out, cage) break end end end
        end
    end
    return out
end

Crate:Toggle({Title="Auto Steal", Callback=function(s)
    on = s
    if s then task.spawn(function()
        while on do
            local targets = findTargets()
            if #targets == 0 then task.wait(1) continue end
            for _,cage in ipairs(targets) do
                if not on then break end
                if not cage.Parent then continue end
                local tPos = getPos(cage)
                instant(cage)
                advanceZ(tPos)
                if not on then break end
                instant(cage)
                for _,pr in ipairs(cage:GetDescendants()) do
                    if pr:IsA("ProximityPrompt") and fireproximityprompt then pcall(fireproximityprompt, pr) end
                end
                task.wait(0.35)
                local hrp = getChar()
                if hrp then
                    for _,wp in ipairs(defendPath(hrp.Position, LOBBY, defend)) do
                        if not on then break end
                        tween(wp)
                    end
                end
                task.wait(0.2)
            end
        end
    end) end
end})
