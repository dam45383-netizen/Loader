local function teleportToPuzzle()
    -- prioritas 1: cari yang namanya Key di dalam PuzzleItems / Puzzle
    local function findKeyIn(parent)
        if not parent then return nil end
        for _, desc in ipairs(parent:GetDescendants()) do
            if desc.Name:lower():find("key") and (desc:IsA("Model") or desc:IsA("BasePart")) then
                return desc
            end
        end
        return nil
    end

    local puzzleItems = workspace:FindFirstChild("PuzzleItems")
    local puzzle = workspace:FindFirstChild("Puzzle")

    local target = findKeyIn(puzzleItems) or findKeyIn(puzzle) or findKeyIn(workspace)

    if not target then
        -- kalau ga ada Key, teleport ke PuzzleItems pertama / Puzzle
        if puzzleItems then
            for _, desc in ipairs(puzzleItems:GetDescendants()) do
                if desc:IsA("Model") or desc:IsA("BasePart") then
                    target = desc
                    break
                end
            end
        end
        if not target and puzzle then
            target = puzzle
        end
    end

    if target then
        local pos = getObjectPosition(target)
        if pos then
            teleportTo(CFrame.new(pos + Vector3.new(0, 3, 0)))
            Window.Notify("Teleport", "Ke Puzzle / Key: " .. target.Name)
            return true
        end
    end

    Window.Notify("Teleport", "Puzzle / Key ga ketemu")
    return false
end

