local HideAcc = Automation:Accordion({Title = "Auto hide", Icon = "door-open", Column = 2, Open = true})
AutoHide = HideAcc:Toggle({
    Title = "Auto hide",
    Desc = "Runs to the nearest wardrobe when Opah chases",
    Flag = "AutoHide",
    Default = false,
})
HideRange = HideAcc:Slider({
    Title = "Trigger distance",
    Flag = "HideRange",
    Default = 45,
    Min = 10,
    Max = 120,
    Step = 5,
    Suffix = " studs",
})
HideMode = HideAcc:Dropdown({
    Title = "Mode",
    Flag = "HideMode",
    Options = { "Teleport", "Walk" },
    Default = "Teleport",
    Callback = function(v) hideModeSelection = v end,
})
HideAcc:Button({
    Title = "Leave wardrobe now",
    Desc = "Exit the wardrobe you are hiding in",
    Callback = function()
        if hub.hiddenPrompt then
            triggerPrompt(hub.hiddenPrompt)
            hub.hiddenPrompt = nil
            pushLog("<Muted>Leave wardrobe requested</Muted>")
        else
            pushLog("<Muted>Not hidden</Muted>")
        end
    end,
})

local OverlayAcc = Overlays:Accordion({Title = "Radar & Passcode", Icon = "eye", Column = 1, Open = true})
RadarEnabled = OverlayAcc:Toggle({
    Title = "Opah radar",
    Desc = "State, distance and chase target",
    Flag = "RadarEnabled",
    Default = true,
})
PasscodeOverlay = OverlayAcc:Toggle({
    Title = "Passcode overlay",
    Desc = "Reads the note and copies digits",
    Flag = "PasscodeOverlay",
    Default = true,
})

local DiagAcc = Overlays:Accordion({Title = "Diagnostics", Icon = "activity", Column = 2, Open = true})
DiagAcc:Button({
    Title = "Check my game",
    Desc = "Prints a diagnostics report to the console (F9)",
    Callback = function()
        runDiagnostics()
    end,
})
DiagAcc:Button({
    Title = "Copy passcode",
    Desc = "Copies the passcode digits to clipboard",
    Callback = function()
        if hub.code and typeof(setclipboard) == "function" then
            pcall(setclipboard, hub.code:gsub("%s", ""))
            notifyRMSO("Copied", "Passcode digits copied")
        else
            notifyRMSO("Copy", "No passcode read yet")
        end
    end,
})
DiagAcc:Paragraph({
    Title = "About",
    Desc = "Fitur dari Robscript Team v1.0.0, di-port ke Nexrift. Activity log jadi print console (F9).",
})

local MarkerAcc = Teleport:Accordion({Title = "Markers", Icon = "map-pin", Column = 1, Open = true})
TeleportTarget = MarkerAcc:Dropdown({
    Title = "Destination",
    Flag = "TeleportTarget",
    Options = { "Passcode note", "Nearest key", "Front door", "Keypad", "Nearest wardrobe", "Nearest drawer", "Spawn" },
    Default = "Passcode note",
    Callback = function(v) teleportTargetSelection = v end,
})
MarkerAcc:Button({
    Title = "Teleport",
    Desc = "Teleport to the selected marker",
    Callback = function()
        local kind = teleportTargetSelection or "Passcode note"
        local position = resolveTargetPosition(kind)
        if not position then
            notifyRMSO("Teleport", "Target not found")
            return
        end
        teleportNear(position)
        pushLog("<Success>Teleported</Success> to " .. escapeRich(kind))
    end,
})
MarkerAcc:Button({
    Title = "Walk to",
    Desc = "Walk to the selected marker",
    Callback = function()
        local kind = teleportTargetSelection or "Passcode note"
        local position = resolveTargetPosition(kind)
        if not position then
            notifyRMSO("Walk", "Target not found")
            return
        end
        task.spawn(function()
            local ok = walkTo(position, 8, 15)
            if not ok then
                notifyRMSO("Walk", "Target unreachable")
            end
        end)
    end,
})
local MarkerInfo = Teleport:Accordion({Title = "Info", Icon = "info", Column = 2, Open = true})
MarkerInfo:Paragraph({
    Title = "Targets",
    Desc = "Positions are resolved from the live workspace: note, keys, door, keypad, wardrobes and drawers.",
})

