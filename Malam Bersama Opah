    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart end
        return obj:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function getObjectPosition(obj)
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Model") then
        local ok, pivot = pcall(function() return obj:GetPivot() end)
        if ok then return pivot.Position end
        local main = getMainPart(obj)
        if main then return main.Position end
    end
    return nil
end

local function getObjectSize(obj)
    if obj:IsA("BasePart") then return obj.Size end
    if obj:IsA("Model") then
        local ok, size = pcall(function() return obj:GetExtentsSize() end)
        if ok then return size end
    end
    return Vector3.new(2, 2, 2)
end

local function getTargetCFrame(obj)
    if obj:IsA("BasePart") then return obj.CFrame end
    if obj:IsA("Model") then
        local ok, pivot = pcall(function() return obj:GetPivot() end)
        if ok then return pivot end
    end
    return nil
end

local function teleportTo(cf)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.CFrame = cf end
end

local function fireNearestPrompt(maxDist)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local nearest = nil
    local bestDist = maxDist or 30
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then
            local pos = nil
            local parent = desc.Parent
            if parent then
                if parent:IsA("BasePart") then pos = parent.Position
                elseif parent:IsA("Attachment") then pos = parent.WorldPosition
                elseif parent:IsA("Model") then pos = getObjectPosition(parent) end
            end
            if pos then
                local d = (hrp.Position - pos).Magnitude
                if d <= bestDist then
                    bestDist = d
                    nearest = desc
                end
            end
        end
    end
    if nearest and fireproximityprompt then
        pcall(function() fireproximityprompt(nearest) end)
    end
end

