local Esp = Feature:SubTab({Title = "Esp", Icon = "eye"})

local function createESP(targetName, fillColor, outlineColor)
    local enabled = false
    local highlights = {}
    local function createHighlight(adornee)
        local hlName = targetName .. "_ESP"
        if adornee:FindFirstChild(hlName) then return end
        local hl = Instance.new("Highlight")
        hl.Name = hlName
        hl.FillColor = fillColor
        hl.OutlineColor = outlineColor
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = adornee
        hl.Parent = adornee
        table.insert(highlights, hl)
    end
    local function clearESP()
        for _, h in ipairs(highlights) do pcall(function() h:Destroy() end) end
        highlights = {}
    end
    local function applyESP()
        local target = workspace:FindFirstChild(targetName)
        if not target then return end
        if target:IsA("Model") or target:IsA("BasePart") then
            createHighlight(target)
        elseif target:IsA("Folder") then
            local foundModel = false
            for _, desc in ipairs(target:GetDescendants()) do
                if desc:IsA("Model") then createHighlight(desc) foundModel = true end
            end
            if not foundModel then
                for _, desc in ipairs(target:GetDescendants()) do
                    if desc:IsA("BasePart") then createHighlight(desc) end
                end
            end
        end
    end
    task.spawn(function()
        while true do
            if enabled then pcall(applyESP) end
            task.wait(0.5)
        end
    end)
    return function(v)
        enabled = v
        if v then applyESP() else clearESP() end
    end
end

local function createBoxESP(targetName, color)
    local enabled = false
    local boxes = {}
    local function createBox(obj)
        local mainPart = getMainPart(obj)
        if not mainPart then return end
        if mainPart:FindFirstChild(targetName .. "_Box") then return end
        local box = Instance.new("BoxHandleAdornment")
        box.Name = targetName .. "_Box"
        box.Adornee = mainPart
        box.AlwaysOnTop = true
        box.ZIndex = 10
        box.Size = getObjectSize(obj)
        box.Color3 = color
        box.Transparency = 0
        box.CFrame = CFrame.new(0, 0, 0)
        box.Parent = mainPart
        table.insert(boxes, box)
    end
    local function clearBox()
        for _, b in ipairs(boxes) do pcall(function() b:Destroy() end) end
        boxes = {}
    end
    local function applyBox()
        local target = workspace:FindFirstChild(targetName)
        if not target then return end
        if target:IsA("Model") or target:IsA("BasePart") then
            createBox(target)
        elseif target:IsA("Folder") then
            local foundModel = false
            for _, desc in ipairs(target:GetDescendants()) do
                if desc:IsA("Model") then createBox(desc) foundModel = true end
            end
            if not foundModel then
                for _, desc in ipairs(target:GetDescendants()) do
                    if desc:IsA("BasePart") then createBox(desc) end
                end
            end
        end
    end
    task.spawn(function()
        while true do
            if enabled then pcall(applyBox) end
            task.wait(0.5)
        end
    end)
    return function(v)
        enabled = v
        if v then applyBox() else clearBox() end
    end
end

local function createDistanceESP(targetName, textColor)
    local enabled = false
    local entries = {}
    local function createBillboard(obj)
        local mainPart = getMainPart(obj)
        if not mainPart then return end
        if mainPart:FindFirstChild(targetName .. "_Distance") then return end
        local bg = Instance.new("BillboardGui")
        bg.Name = targetName .. "_Distance"
        bg.Size = UDim2.new(0, 120, 0, 25)
        bg.StudsOffset = Vector3.new(0, 3.5, 0)
        bg.AlwaysOnTop = true
        bg.Adornee = mainPart
        bg.Parent = mainPart
        local lbl = Instance.new("TextLabel")
        lbl.Name = "DistanceLabel"
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.TextColor3 = textColor
        lbl.TextStrokeTransparency = 0
        lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
        lbl.TextSize = 13
        lbl.Font = Enum.Font.GothamBold
        lbl.Text = targetName .. " [0]"
        lbl.Parent = bg
        table.insert(entries, {gui = bg, label = lbl, obj = obj})
    end
    local function clearDist()
        for _, e in ipairs(entries) do pcall(function() e.gui:Destroy() end) end
        entries = {}
    end
    local function applyDist()
        local target = workspace:FindFirstChild(targetName)
        if not target then return end
        if target:IsA("Model") or target:IsA("BasePart") then
            createBillboard(target)
        elseif target:IsA("Folder") then
            local foundModel = false
            for _, desc in ipairs(target:GetDescendants()) do
                if desc:IsA("Model") then createBillboard(desc) foundModel = true end
            end
            if not foundModel then
                for _, desc in ipairs(target:GetDescendants()) do
                    if desc:IsA("BasePart") then createBillboard(desc) end
                end
            end
        end
    end
    task.spawn(function()
        while true do
            if enabled then
                pcall(applyDist)
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    for _, e in ipairs(entries) do
                        local pos = getObjectPosition(e.obj)
                        if pos then
                            local dist = (hrp.Position - pos).Magnitude
                            e.label.Text = string.format("%s [%.0f]", targetName, dist)
                        end
                    end
                end
            end
            task.wait(0.2)
        end
    end)
    return function(v)
        enabled = v
        if v then applyDist() else clearDist() end
    end
end

