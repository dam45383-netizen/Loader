-- NEXRIFT | Auto X2 + Auto Throw - Mobile Friendly
local Lib = loadstring(game:HttpGet("https://raw.githubusercontent.com/dam45383-netizen/Loader/refs/heads/main/UI.lua"))()

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- shortcut yang lu minta
local V3, V2, CF, C3 = Vector3.new, Vector2.new, CFrame.new, Color3.new

-- Window
local Window = Lib:CreateWindow({
    Title = "NEXRIFT",
    Brand = "NEXRIFT",
    Tagline = "Play Smarter.",
})

-- Group Nexrift
local NexriftGroup = Window:Group({
    Title = "Nexrift",
    Icon = "zap",
})

-- Tab Feature
local FeatureTab = NexriftGroup:Tab({
    Title = "Feature",
    Icon = "zap",
    Subtitle = "Fitur utama Nexrift",
})

-- ========== SubTab Training ==========
local TrainingSub = FeatureTab:SubTab({
    Title = "Training",
    Icon = "target",
})

local AutoX2Accordion = TrainingSub:Accordion({
    Title = "Auto X2",
    Icon = "zap",
    Open = true,
})

local AutoX2Enabled = false

local function isReallyVisible(obj)
    local p = obj
    while p do
        if p:IsA("GuiObject") and not p.Visible then
            return false
        end
        p = p.Parent
    end
    return true
end

local function getXPButton()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local hud = pg:FindFirstChild("XPBoostHud")
    if not hud then return nil end
    if hud:IsA("GuiButton") and isReallyVisible(hud) then
        return hud
    end
    local candidates = {}
    for _, obj in ipairs(hud:GetDescendants()) do
        if obj:IsA("GuiButton") and obj.Visible and obj.Active and isReallyVisible(obj) then
            table.insert(candidates, obj)
        end
    end
    if #candidates == 0 then return nil end
    for _, btn in ipairs(candidates) do
        local n = btn.Name:lower()
        if n:find("boost") or n:find("claim") or n:find("x2") or n:find("xp") or n:find("button") then
            return btn
        end
    end
    return candidates[1]
end

local function clickXP()
    local btn = getXPButton()
    if not btn then return end
    pcall(function()
        if firesignal then
            firesignal(btn.MouseButton1Click)
            firesignal(btn.Activated)
        else
            btn:Activate()
        end
    end)
end

AutoX2Accordion:Toggle({
    Title = "Auto X2",
    Desc = "Auto klik XPBoostHud tanpa mouse - aman joystick & jump HP",
    Flag = "AutoX2",
    Default = false,
    Callback = function(v)
        AutoX2Enabled = v
        if v then
            pcall(function()
                Window.Notify({ Title = "Auto X2", Content = "ON - Auto klik XPBoostHud aktif" })
            end)
            task.spawn(function()
                while AutoX2Enabled do
                    pcall(clickXP)
                    task.wait(0.6)
                end
            end)
        else
            pcall(function()
                Window.Notify({ Title = "Auto X2", Content = "OFF" })
            end)
        end
    end,
})

-- ========== SubTab Throw ==========
local ThrowSub = FeatureTab:SubTab({
    Title = "Throw",
    Icon = "target",
})

local AutoThrowAccordion = ThrowSub:Accordion({
    Title = "Auto Throw",
    Icon = "zap",
    Open = true,
})

local AutoThrowEnabled = false

local function fireThrow()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local throwRemote = remotes and remotes:FindFirstChild("Throw")
    if not throwRemote then return end
    pcall(function()
        throwRemote:InvokeServer(10, 0)
    end)
end

AutoThrowAccordion:Toggle({
    Title = "Auto Throw",
    Desc = "Auto fire Throw:InvokeServer(10, 0) loop 0.01",
    Flag = "AutoThrow",
    Default = false,
    Callback = function(v)
        AutoThrowEnabled = v
        if v then
            pcall(function()
                Window.Notify({ Title = "Auto Throw", Content = "ON - Throw loop 0.01 aktif" })
            end)
            task.spawn(function()
                while AutoThrowEnabled do
                    fireThrow()
                    task.wait(0.01)
                end
            end)
        else
            pcall(function()
                Window.Notify({ Title = "Auto Throw", Content = "OFF" })
            end)
        end
    end,
})
