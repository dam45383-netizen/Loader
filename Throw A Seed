local function getXPButton()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local hud = pg:FindFirstChild("XPBoostHud")
    if not hud then return nil end
    if hud:IsA("GuiButton") and isReallyVisible(hud) then
        return hud
    end
    local candidates = {}
    for _, obj in ipairs(hud:GetDescendants()) do
        if obj:IsA("GuiButton") and obj.Visible and obj.Active and isReallyVisible(obj) then
            table.insert(candidates, obj)
        end
    end
    if #candidates == 0 then return nil end
    for _, btn in ipairs(candidates) do
        local n = btn.Name:lower()
        if n:find("boost") or n:find("claim") or n:find("x2") or n:find("xp") or n:find("button") then
            return btn
        end
    end
    return candidates[1]
end

local function clickXP()
    local btn = getXPButton()
    if not btn then return end
    pcall(function()
        if firesignal then
            firesignal(btn.MouseButton1Click)
            firesignal(btn.Activated)
        else
            btn:Activate()
        end
    end)
end

AutoX2Accordion:Toggle({
    Title = "Auto X2",
    Desc = "Auto klik XPBoostHud tanpa mouse - aman joystick & jump HP",
    Flag = "AutoX2",
    Default = false,
    Callback = function(v)
        AutoX2Enabled = v
        if v then
            pcall(function()
                Window.Notify({ Title = "Auto X2", Content = "ON - Auto klik XPBoostHud aktif" })
            end)
            task.spawn(function()
                while AutoX2Enabled do
                    pcall(clickXP)
                    task.wait(0.6)
                end
            end)
        else
            pcall(function()
                Window.Notify({ Title = "Auto X2", Content = "OFF" })
            end)
        end
    end,
})

-- ========== SubTab Throw ==========
local ThrowSub = FeatureTab:SubTab({
    Title = "Throw",
    Icon = "target",
})

local AutoThrowAccordion = ThrowSub:Accordion({
    Title = "Auto Throw",
    Icon = "zap",
    Open = true,
})

local AutoThrowEnabled = false

local function fireThrow()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local throwRemote = remotes and remotes:FindFirstChild("Throw")
    if not throwRemote then return end
    pcall(function()
        throwRemote:InvokeServer(10, 0)
    end)
end

-- BARU: Cek Jauge muncul
local function isJaugeVisible()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return false end
    local hud = pg:FindFirstChild("HudLancer")
    if not hud then return false end
    local jauge = hud:FindFirstChild("Jauge", true)
    if not jauge then return false end
    return isReallyVisible(jauge)
end

-- BARU: Klik layar pake mouse (tengah layar)
local function clickScreenCenter()
    pcall(function()
        local cam = workspace.CurrentCamera
        if not cam then return end
        local cx = cam.ViewportSize.X / 2
        local cy = cam.ViewportSize.Y / 2
        VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
    end)
end

AutoThrowAccordion:Toggle({
    Title = "Auto Throw",
    Desc = "Jauge muncul -> tunggu 3.5 detik -> Fire Throw + Klik layar",
    Flag = "AutoThrow",
    Default = false,
    Callback = function(v)
        AutoThrowEnabled = v
        if v then
            pcall(function()
                Window.Notify({ Title = "Auto Throw", Content = "ON - Nunggu Jauge muncul, 3.5 detik baru Throw" })
            end)
            task.spawn(function()
                while AutoThrowEnabled do
                    if isJaugeVisible() then
                        -- Jauge udah muncul, tunggu 3.5 detik
                        task.wait(4.2)
                        if not AutoThrowEnabled then break end
                        -- Fire Throw + Klik layar pake mouse
                        fireThrow()
                        clickScreenCenter()
                        -- Tunggu Jauge hilang biar gak spam 2x
                        repeat
                            task.wait(0.1)
                        until not AutoThrowEnabled or not isJaugeVisible()
                    else
                        task.wait(0.1)
                    end
                end
            end)
        else
            pcall(function()
                Window.Notify({ Title = "Auto Throw", Content = "OFF" })
            end)
        end
    end,
})
