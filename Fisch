local function GetTargetPosition(hrp)
    if not hrp then hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") end
    if not hrp then return nil end
    local hrpPos = hrp.Position
    local world = workspace:FindFirstChild("world")
    local mapF = world and world:FindFirstChild("map")
    local carrotFolder = mapF and mapF:FindFirstChild("Carrot Secret")
    if carrotFolder then
        local closestDist = math.huge local closestMesh = nil
        for _, model in ipairs(carrotFolder:GetChildren()) do
            local mesh = model:FindFirstChild("Meshes/CarrotPool_Cube.001 (1)")
            if mesh and mesh:IsA("MeshPart") then local dist = (hrpPos - mesh.Position).Magnitude if dist < closestDist then closestDist = dist closestMesh = mesh end end
        end
        if closestMesh and closestDist < 50 then return CFrame.new(closestMesh.Position - Vector3.new(0, 3, 0)) end
    end
    local Params = RaycastParams.new() Params.FilterType = Enum.RaycastFilterType.Include Params.FilterDescendantsInstances = {workspace.Terrain} Params.IgnoreWater = false
    local scanY = hrpPos.Y + 50
    local head = hrp.Parent and hrp.Parent:FindFirstChild("Head")
    local lookVec = hrp.CFrame.LookVector
    for _, dist in ipairs({10, 15, 20, 25, 30, 35, 45}) do
        local testPos = hrpPos + (lookVec * dist)
        local res = workspace:Raycast(Vector3.new(testPos.X, scanY, testPos.Z), Vector3.new(0, -300, 0), Params)
        if res and res.Instance:IsA("Terrain") and res.Material == Enum.Material.Water then return CFrame.new(res.Position - Vector3.new(0, 3, 0)) end
    end
    local bestPos = nil local bestDist = math.huge
    for i = 0, 23 do
        local angle = (i / 24) * (math.pi * 2) local cosA = math.cos(angle) local sinA = math.sin(angle)
        for _, radius in ipairs({8, 12, 16, 22, 30, 40}) do
            local sx = hrpPos.X + cosA * radius local sz = hrpPos.Z + sinA * radius
            local result = workspace:Raycast(Vector3.new(sx, scanY, sz), Vector3.new(0, -300, 0), Params)
            if result and result.Instance:IsA("Terrain") and result.Material == Enum.Material.Water then if radius < bestDist then bestDist = radius bestPos = result.Position end break end
        end
    end
    if bestPos then return CFrame.new(bestPos - Vector3.new(0, 3, 0)) end
    local basePos = head and head.Position or hrpPos
    return CFrame.new(basePos + (lookVec * 10) - Vector3.new(0, 11, 0))
end
