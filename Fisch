local function autoEnsureToolEquipped(itemId) if not itemId then return nil end local char = LocalPlayer.Character if not char then return nil end local humanoid = char:FindFirstChildOfClass("Humanoid") if not humanoid then return nil end local equipped = char:FindFirstChildOfClass("Tool") if equipped then local link = equipped:FindFirstChild("link") if link and link.Value == itemId then return equipped end end local target = nil for _, child in ipairs(char:GetChildren()) do if child:IsA("Tool") then local link = child:FindFirstChild("link") if link and link.Value == itemId then target = child break end end end if not target then local bp = LocalPlayer:FindFirstChild("Backpack") if bp then for _, child in ipairs(bp:GetChildren()) do if child:IsA("Tool") then local link = child:FindFirstChild("link") if link and link.Value == itemId then target = child break end end end end end if target and target.Parent ~= char then humanoid:EquipTool(target) local t = 0 while target.Parent ~= char and t < 0.5 do task.wait(0.05) t = t + 0.05 end end return target end
local function autoNormalizeKeywords(raw) local res = {} if type(raw) == "table" then for k, v in pairs(raw) do if type(k) == "string" and v == true then table.insert(res, k) elseif type(k) == "number" and type(v) == "string" then table.insert(res, v) end end elseif type(raw) == "string" and raw ~= "" then table.insert(res, raw) end return res end
local function autoGetInventory() local inv = nil pcall(function() if DataControllerAuto and DataControllerAuto.InventoryReplicator then inv = DataControllerAuto.InventoryReplicator:Index({"Inventory"}) else inv = DataControllerAuto and DataControllerAuto.fetch("Inventory") end end) return inv end
local function autoCheckItemMatches(itemId, keywords) if not itemId then itemId = autoGetEquippedItemId() end if not itemId then return false, nil, nil end local inv = autoGetInventory() if not inv then return false, nil, nil end local d = inv[itemId] if not d or not d.sub then return false, nil, nil end local sub = d.sub for _, kwRaw in ipairs(keywords) do local kw = string.lower(kwRaw) if kw == "shiny" and sub.Shiny == true then return true, kw, d.name end if kw == "sparkling" and sub.Sparkling == true then return true, kw, d.name end if kw == "big" and sub.Big == true then return true, kw, d.name end if kw == "giant" and sub.Giant == true then return true, kw, d.name end if sub.Mutation and string.find(string.lower(tostring(sub.Mutation)), kw, 1, true) then return true, kw, d.name end if d.name and string.find(string.lower(tostring(d.name)), kw, 1, true) then return true, kw, d.name end end return false, nil, nil end
