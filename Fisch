    local cache = filterCache or buildFilterCache()
    local hasName, hasRelic, hasRarity, hasMut = (#cache.names>0), (#cache.relics>0), (#cache.rarities>0), (#cache.mutations>0 or #cache.traits>0)
    if not hasName and not hasRelic and not hasRarity and not hasMut then return true end
    local fishName = fishData.Name or fishData.name or "Unknown"
    local fName = fishName:lower()
    local rarity = fishData.Rarity or fishData.rarity
    if not rarity then local info = lookupFishInfo(fishName) if info then rarity = info.Rarity or info.rarity end end
    if not rarity then rarity = "Common" end
    local fRarity = tostring(rarity):lower()
    local isShiny = fishData.Shiny or false
    local isSparkling = fishData.Sparkling or false
    local mutation = fishData.Mutation
    local nameMatch=false if hasName then for _,t in ipairs(cache.names) do if fName:find(t,1,true) then nameMatch=true break end end end
    local relicMatch=false if hasRelic then for _,t in ipairs(cache.relics) do if fName:find(t,1,true) then relicMatch=true break end end end
    local rarityMatch=false if hasRarity then for _,t in ipairs(cache.rarities) do if fRarity==t or fRarity:find(t,1,true) then rarityMatch=true break end end end
    local mutationMatch=false if hasMut then
        local traitOK=(#cache.traits==0) if not traitOK then for _,tr in ipairs(cache.traits) do if (tr=="shiny" and isShiny) or (tr=="sparkling" and isSparkling) then traitOK=true break end end end
