        if res and res.Instance:IsA("Terrain") and res.Material == Enum.Material.Water then return CFrame.new(res.Position - Vector3.new(0, 3, 0)) end
    end
    local bestPos = nil
    local bestDist = math.huge
    for i = 0, 23 do local angle = (i / 24) * (math.pi * 2) local cosA = math.cos(angle) local sinA = math.sin(angle)
        for _, radius in ipairs({8, 12, 16, 22, 30, 40}) do local sx = hrpPos.X + cosA * radius local sz = hrpPos.Z + sinA * radius local r2 = workspace:Raycast(Vector3.new(sx, scanY, sz), Vector3.new(0, -300, 0), Params) if r2 and r2.Instance:IsA("Terrain") and r2.Material == Enum.Material.Water then if radius < bestDist then bestDist = radius bestPos = r2.Position end break end end end
    if bestPos then return CFrame.new(bestPos - Vector3.new(0, 3, 0)) end
    local basePos = head and head.Position or hrpPos
    return CFrame.new(basePos + (lookVec * 10) - Vector3.new(0, 11, 0))
