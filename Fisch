local function teleportToPlayer(pName) local char = LocalPlayer.Character local root = char and char:FindFirstChild("HumanoidRootPart") local tp = Players:FindFirstChild(pName) if not root or not tp or not tp.Character then return end local tr = tp.Character:FindFirstChild("HumanoidRootPart") if not tr then return end local targetCF = tr.CFrame + Vector3.new(3, 1, 0) root.Anchored = true task.wait(0.05) local dist = (root.Position - tr.Position).Magnitude if dist > 500 then local mid = root.CFrame:Lerp(targetCF, 0.5) root.CFrame = mid task.wait(0.1) end root.CFrame = targetCF task.wait(0.05) root.Anchored = false breakVelocity() end
