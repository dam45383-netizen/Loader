local function SetPerfectChance(value)
    value = math.clamp(math.floor(tonumber(value) or 100), 0, 100)
    _G.Config.PerfectCatchChance = value
    if value > 0 then
        _G.Config.AutoPerfectCatch = true
    else
        _G.Config.AutoPerfectCatch = false
    end
    if value == 100 then
        _G.Config.CatchMode = "Perfect"
    elseif value == 0 then
        _G.Config.CatchMode = "Normal"
    else
        _G.Config.CatchMode = "Custom"
    end
end

