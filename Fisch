local LastNotifKey = ""
local LastNotifTime = 0
local function showCatchNotification(fishData)
    if not fishData then return end
    local fishName = fishData.Name or fishData.name or "Unknown"
    local fishWeight = fishData.Weight or fishData.weight or 0
    local isShiny = fishData.Shiny or false
    local isSparkling = fishData.Sparkling or false
    local mutation = fishData.Mutation or fishData.mutation
    local rarity, price = getRarityAndPrice(fishData)
    local parts = {}
    if isShiny then table.insert(parts, "Shiny") end
    if isSparkling then table.insert(parts, "Sparkling") end
    if mutation and mutation ~= "None" and mutation ~= "" then table.insert(parts, mutation) end
    local mutationDisplay = (#parts > 0) and table.concat(parts, ", ") or "None"
    local key = fishName .. "|" .. tostring(math.floor((fishWeight or 0)*10)) .. "|" .. mutationDisplay .. "|" .. tostring(rarity)
    local now = tick()
    if key == LastNotifKey and (now - LastNotifTime) < 0.5 then return end
    LastNotifKey = key LastNotifTime = now
    if C.FishNotificationEnabled ~= false then createFishNotification(fishName, mutationDisplay, fishWeight, price, rarity) end
    if C.DiscordWebhookEnabled and C.DiscordWebhookURL and C.DiscordWebhookURL ~= "" then
        task.spawn(function()
            local requestFunc = (syn and syn.request) or (http and http.request) or request or http_request
