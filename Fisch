local fishLibCache = nil
local mutLibCache = nil
local function getFishLib()
    if fishLibCache then return fishLibCache end
    pcall(function()
        local shared = waitChild(ReplicatedStorage, "shared", 3)
        local modules = shared and waitChild(shared, "modules", 3)
        local library = modules and waitChild(modules, "library", 3)
        local fishMod = library and waitChild(library, "fish", 3)
        if fishMod then fishLibCache = require(fishMod) end
    end)
    return fishLibCache
end
local function getMutLib()
    if mutLibCache then return mutLibCache end
    pcall(function()
        local shared = waitChild(ReplicatedStorage, "shared", 3)
        local modules = shared and waitChild(modules, "modules", 3)
        local fishing = modules and waitChild(modules, "fishing", 3)
        local mutMod = fishing and waitChild(fishing, "mutations", 3)
        if mutMod then mutLibCache = require(mutMod) end
    end)
    return mutLibCache
end
local function lookupFishInfo(fishName)
    if not fishName then return nil end
    local lib = getFishLib()
    if not lib then return nil end
    if lib[fishName] then return lib[fishName] end
    if lib.Fish and lib.Fish[fishName] then return lib.Fish[fishName] end
    if lib.fish and lib.fish[fishName] then return lib.fish[fishName] end
    if lib.Fishes and lib.Fishes[fishName] then return lib.Fishes[fishName] end
    for k, v in pairs(lib) do if type(v) == "table" and (k == fishName or v.Name == fishName) then return v end end
    return nil
end
local function getRarityAndPrice(fishData)
    local fishName = fishData.Name or fishData.name or "Unknown"
    local weight = fishData.Weight or fishData.weight or 0
    local info = lookupFishInfo(fishName)
    local rarity = fishData.Rarity or fishData.rarity or fishData.RarityName
    local price = fishData.Price or fishData.price or fishData.Value or 0
    if info then
        if not rarity then rarity = info.Rarity or info.rarity end
        if info.Price then
            if weight and weight > 0 and info.WeightPool and info.WeightPool[2] and info.WeightPool[2] > 0 then price = math.ceil(weight / (info.WeightPool[2] / 10) * info.Price) else price = info.Price end
        end
    end
    if not rarity or rarity == "" then rarity = "Common" end
    if fishData.Shiny then price = math.ceil(price * 1.85) end
    if fishData.Sparkling then price = math.ceil(price * 1.85) end
    local mut = fishData.Mutation
    if mut and mut ~= "None" and mut ~= "" then
        local ml = getMutLib()
        local mData = ml and ((ml.Mutations and ml.Mutations[mut]) or ml[mut])
        if mData and mData.PriceMultiply then price = math.ceil(price * mData.PriceMultiply) end
    end
    return tostring(rarity), math.max(0, math.floor(price or 0))
end

