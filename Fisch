local function safeCall(obj, methodNames, arg)
    if not obj then return nil end
    for _, m in ipairs(methodNames) do
        local f = obj[m]
        if type(f) == "function" then
            local ok, res = pcall(f, obj, arg)
            if ok then return res end
            warn("UI "..m.." error: "..tostring(res))
            return nil
        end
    end
    warn("UI method hilang: "..table.concat(methodNames, "/"))
    return nil
end
