local function findOldSoloServer() local gameId = game.PlaceId for page = 0, 2 do local cursor = page > 0 and "&cursor=" .. (page * 100) or "" local url = "https://games.roblox.com/v1/games/" .. gameId .. "/servers/Public?sortOrder=Asc&limit=100" .. cursor local ok, result = pcall(function() return HttpService:JSONDecode(game:HttpGet(url)) end) if ok and result.data then for _, server in ipairs(result.data) do if server.playing == 1 and server.id ~= game.JobId then if server.maxPlayers >= 25 then local TS = game:GetService("TeleportService") TS:TeleportToPlaceInstance(gameId, server.id, Players.LocalPlayer) return true end end end end task.wait(0.5) end return false end
local function toggleSoloServer(state) if state then local gameId = game.PlaceId local ok, result = pcall(function() return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. gameId .. "/servers/Public?sortOrder=Asc&limit=100")) end) if ok and result.data then local valid = {} for _, server in ipairs(result.data) do if server.playing == 1 and server.id ~= game.JobId then table.insert(valid, server) end end if #valid > 0 then table.sort(valid, function(a, b) if a.maxPlayers ~= b.maxPlayers then return a.maxPlayers > b.maxPlayers end return a.id < b.id end) local target = valid[1] local TS = game:GetService("TeleportService") TS:TeleportToPlaceInstance(gameId, target.id, Players.LocalPlayer) return end end end end
