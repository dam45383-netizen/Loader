local function waitChild(parent, name, timeout)
    if not parent then return nil end
    local f = parent:FindFirstChild(name)
    if f then return f end
    local ok, res = pcall(function() return parent:WaitForChild(name, timeout or 5) end)
    if ok and res then return res end
    return parent:FindFirstChild(name)
end
local function safePrimaryPart(obj)
    if not obj then return nil end
    local ok, res = pcall(function()
        if obj:IsA("Model") then return obj.PrimaryPart end
        return nil
    end)
    if ok then return res end
    return nil
end
local function getNPCRoot(npc)
    if not npc then return nil end
    if npc:IsA("Model") then
        return npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Head") or safePrimaryPart(npc)
    elseif npc:IsA("BasePart") then
        return npc
    elseif npc:IsA("Folder") then
        for _, child in ipairs(npc:GetChildren()) do
            local r = getNPCRoot(child)
            if r then return r end
        end
    end
    local ok, r = pcall(function() return npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Head") end)
    if ok then return r end
    return nil
end
local function getZonePart(zone)
    if not zone then return nil end
    if zone:IsA("BasePart") then return zone end
    if zone:IsA("Model") then return zone.PrimaryPart and safePrimaryPart(zone) or zone:FindFirstChildWhichIsA("BasePart") end
    if zone:IsA("Folder") then return zone:FindFirstChildWhichIsA("BasePart") end
    return zone:FindFirstChildWhichIsA("BasePart")
end
