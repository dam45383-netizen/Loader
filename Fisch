local function fetchSource(url)
    local req = http_request or (syn and syn.request) or request
    if req then
        local ok, res = pcall(function()
            return req({Url = url, Method = "GET"})
        end)
        if ok and res and res.Body and #res.Body > 100 and not res.Body:find("404") then
            return res.Body
        end
        if ok and res and type(res) == "string" and #res > 100 then
            return res
        end
    end
    if game and game.HttpGet then
        local ok, res = pcall(function()
            return game:HttpGet(url)
        end)
        if ok and res and type(res) == "string" and #res > 100 and not res:find("404") then
            return res
        end
    end
    if game and game.HttpGetAsync then
        local ok, res = pcall(function()
            return game:HttpGetAsync(game, url)
        end)
        if ok and res and type(res) == "string" and #res > 100 then
            return res
        end
    end
    return nil
end

