local function collectFishTable(tbl, out)
    if type(tbl) ~= "table" then
        return
    end
    for k, v in pairs(tbl) do
        if type(v) == "table" then
            local fname = v.Name or v.name or v.FishName or v.DisplayName
            if not fname and type(k) == "string" then
                fname = k
            end
            local rarity = v.Rarity or v.rarity or v.RarityName or v.Tier or v.Rare
            local price = v.Price or v.SellPrice or v.SellValue or v.BasePrice or v.Value or v.Worth or v.Cost
            if fname and (rarity ~= nil or price ~= nil) then
                out[tostring(fname):lower()] = { Rarity = rarity, Price = price }
            end
        end
    end
end

local function getFishDB()
    if FishDBCache then
        return FishDBCache
    end
    FishDBCache = {}
    for _, mod in ipairs(ReplicatedStorage:GetDescendants()) do
        if mod:IsA("ModuleScript") then
            local ok, tbl = pcall(require, mod)
            if ok and type(tbl) == "table" then
                collectFishTable(tbl, FishDBCache)
                for _, subKey in ipairs({"Data", "Fishes", "Fish", "AllFish", "FishesData", "FishData"}) do
                    if type(tbl[subKey]) == "table" then
                        collectFishTable(tbl[subKey], FishDBCache)
                    end
                end
            end
        end
    end
    return FishDBCache
end

