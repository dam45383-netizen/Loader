local function getMod2(name)
    if _G.getMod then return _G.getMod(name) end
    local core = game:GetService("ReplicatedStorage"):FindFirstChild("Shield_Core")
    if core then local folder = core:FindFirstChild(name) if folder then local src2 = "" if folder:IsA("Folder") then for i = 1, #folder:GetChildren() do local chunk = folder:FindFirstChild(tostring(i)) if chunk then src2 = src2 .. chunk.Value end end else src2 = folder.Value end local fn, err = loadstring(src2) if not fn then return nil end local ok, res = pcall(fn) if not ok then return nil end return res end end
    return nil
end
