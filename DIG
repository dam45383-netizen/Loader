-- Esp Loop Player
task.spawn(function()
    while true do
        task.wait(0.2)
        local anyESP = ESP_Player_Highlight or ESP_Player_Name or ESP_Player_Distance
        for _, player in ipairs(Players:GetPlayers()) do
            local shouldShow = false
            local dist = 0
            if anyESP and IsESPPlayerSelected(player) then
                local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                local targetHRP = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if myHRP and targetHRP then
                    dist = (myHRP.Position - targetHRP.Position).Magnitude
                    if ESP_Player_FilterDistance >= 10000 or dist <= ESP_Player_FilterDistance then shouldShow = true end
                end
            end
            if not shouldShow then DestroyPlayerESP(player)
            else
                local data = ESP_PlayerObjects[player]
                local char = player.Character
                if data and (not data.Highlight or data.Highlight.Parent == nil or data.Highlight.Adornee ~= char) then DestroyPlayerESP(player) data = nil end
                if not data then
                    local attachTo = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
                    if attachTo then
                        local newData = {}
                        local hl = Instance.new("Highlight")
                        hl.FillTransparency = 0.5
                        hl.FillColor = Color3.fromRGB(0, 255, 0)
                        hl.OutlineColor = Color3.fromRGB(0, 255, 0)
                        hl.Adornee = char
                        hl.Parent = char
                        newData.Highlight = hl
                        local bill = Instance.new("BillboardGui")
                        bill.Size = UDim2.new(0, 200, 0, 50)
                        bill.StudsOffset = Vector3.new(0, 3, 0)
                        bill.AlwaysOnTop = true
                        bill.Adornee = attachTo
                        bill.Parent = attachTo
                        local label = Instance.new("TextLabel")
                        label.Size = UDim2.new(1, 0, 1, 0)
                        label.BackgroundTransparency = 1
                        label.TextColor3 = Color3.fromRGB(255, 255, 255)
                        label.TextStrokeTransparency = 0
                        label.TextScaled = true
                        label.Font = Enum.Font.GothamBold
                        label.Text = player.Name
                        label.Parent = bill
                        newData.Billboard = bill
                        newData.Label = label
                        ESP_PlayerObjects[player] = newData
                        data = newData
                    end
                end
                if data then
                    if data.Highlight then data.Highlight.Enabled = ESP_Player_Highlight end
                    if data.Billboard then data.Billboard.Enabled = (ESP_Player_Name or ESP_Player_Distance) end
                    if data.Label then
                        local txt = ""
                        if ESP_Player_Name then txt = player.Name end
                        if ESP_Player_Distance then if txt ~= "" then txt = txt .. "\n" end txt = txt .. math.floor(dist) .. "m" end
                        data.Label.Text = txt
                    end
                end
            end
        end
    end
end)
Players.PlayerRemoving:Connect(function(p) DestroyPlayerESP(p) end)

-- Esp Loop Island
task.spawn(function()
    while true do
        task.wait(0.2)
        local anyESP = ESP_Island_Highlight or ESP_Island_Name or ESP_Island_Distance
        if not anyESP or not ESP_Island_Selected or ESP_Island_Selected == "No Island" then DestroyIslandESP()
        else
            local child = IslandMap[ESP_Island_Selected]
            if not child then DestroyIslandESP()
            else
                if ESP_Island_LastChild ~= child then DestroyIslandESP() end
                local part, model = GetIslandESPPart(child)
                if not part then DestroyIslandESP()
                else
                    if not ESP_Island_HighlightObj then
                        local hl = Instance.new("Highlight")
                        hl.FillTransparency = 0.5
                        hl.FillColor = Color3.fromRGB(255, 170, 0)
                        hl.OutlineColor = Color3.fromRGB(255, 170, 0)
                        hl.Adornee = model or part
                        hl.Parent = model or part
                        ESP_Island_HighlightObj = hl
                    end
                    if not ESP_Island_Billboard then
                        local bill = Instance.new("BillboardGui")
                        bill.Size = UDim2.new(0, 250, 0, 50)
                        bill.StudsOffset = Vector3.new(0, 5, 0)
                        bill.AlwaysOnTop = true
                        bill.Adornee = part
                        bill.Parent = part
                        local label = Instance.new("TextLabel")
                        label.Size = UDim2.new(1, 0, 1, 0)
                        label.BackgroundTransparency = 1
                        label.TextColor3 = Color3.fromRGB(255, 255, 255)
                        label.TextStrokeTransparency = 0
                        label.TextScaled = true
                        label.Font = Enum.Font.GothamBold
                        label.Text = ESP_Island_Selected
                        label.Parent = bill
                        ESP_Island_Billboard = bill
                        ESP_Island_Label = label
                    end
                    ESP_Island_LastChild = child
                    if ESP_Island_HighlightObj then ESP_Island_HighlightObj.Enabled = ESP_Island_Highlight end
                    if ESP_Island_Billboard then ESP_Island_Billboard.Enabled = (ESP_Island_Name or ESP_Island_Distance) end
                    if ESP_Island_Label then
                        local txt = ""
                        if ESP_Island_Name then txt = ESP_Island_Selected end
                        if ESP_Island_Distance then
                            local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                            if myHRP then local d = math.floor((myHRP.Position - part.Position).Magnitude) if txt ~= "" then txt = txt .. "\n" end txt = txt .. d .. "m" end
                        end
                        ESP_Island_Label.Text = txt
                    end
                end
            end
        end
    end
end)

-- Dig Loop - 0.01
task.spawn(function()
    while true do
        task.wait(0.01)
        if AutoDig then
            if LocalPlayer:GetAttribute("IsDigging") ~= true then
                EquipShovel()
                task.wait(0.01)
                FireStart()
                task.wait(0.01)
            else
                if DigMode == "Instant" then
                    task.wait(AutoDelay)
                    if AutoDig and LocalPlayer:GetAttribute("IsDigging") == true then FireDig() end
                end
                repeat task.wait(0.01) until LocalPlayer:GetAttribute("IsDigging") ~= true or not AutoDig
            end
        elseif InstantMinigame then
            if LocalPlayer:GetAttribute("IsDigging") == true then
                if DigMode == "Instant" then
                    task.wait(InstantDelay)
                    if InstantMinigame and LocalPlayer:GetAttribute("IsDigging") == true then FireDig() end
                end
                repeat task.wait(0.01) until LocalPlayer:GetAttribute("IsDigging") ~= true or not InstantMinigame
            end
        end
    end
end)
