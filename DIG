    if folder then
        for _, v in ipairs(folder:GetChildren()) do
            if v:IsA("Model") or v:IsA("BasePart") then table.insert(all, {parent = nil, npc = v})
            elseif v:IsA("Folder") then for _, sub in ipairs(v:GetChildren()) do if sub:IsA("Model") or sub:IsA("BasePart") then table.insert(all, {parent = v, npc = sub}) end end end
        end
        local nameCount = {}
        for _, e in ipairs(all) do nameCount[e.npc.Name] = (nameCount[e.npc.Name] or 0) + 1 end
        for _, e in ipairs(all) do local label = e.npc.Name if e.parent and nameCount[e.npc.Name] > 1 then label = e.parent.Name .. " / " .. e.npc.Name end NPCMap[label] = e.npc table.insert(list, label) end
