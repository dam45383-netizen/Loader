local function SaveStyle(obj)
    if not SavedStyle[obj] and (obj:IsA("Frame") or obj:IsA("TextLabel") or obj:IsA("ImageLabel")) then
        SavedStyle[obj] = {Color = obj.BackgroundColor3, Trans = obj.BackgroundTransparency}
    end
end
local function ApplyMinigameStyle()
    if not MinigameStyleEnabled then return end
    local Holder = GetMinigameHolder()
    if not Holder then return end
    local theme = Themes[SelectedStyle]
    if not theme then return end
    pcall(function()
        SaveStyle(Holder)
        Holder.BackgroundColor3 = theme.BG
        Holder.BackgroundTransparency = theme.BGTrans
    end)
    for _, obj in ipairs(Holder:GetDescendants()) do
        if obj:IsA("Frame") or obj:IsA("TextLabel") or obj:IsA("ImageLabel") then
            local n = obj.Name:lower()
            SaveStyle(obj)
            if n:find("strong") then
                obj.BackgroundColor3 = theme.Strong
                obj.BackgroundTransparency = 0
            elseif n:find("playerbar") then
                obj.BackgroundColor3 = theme.Bar
                obj.BackgroundTransparency = 0
            elseif n:find("perfect") then
                obj.BackgroundColor3 = theme.Perfect
                obj.BackgroundTransparency = 0
            elseif n:find("good") then
                obj.BackgroundColor3 = theme.Good
                obj.BackgroundTransparency = 0
            elseif n:find("background") or n:find("holder") or n:find("safezone") or n:find("bar") then
                if not n:find("playerbar") and not n:find("strong") then
                    obj.BackgroundColor3 = theme.BG
                end
            end
            if n:find("strong") or n:find("playerbar") then
                local corner = obj:FindFirstChildOfClass("UICorner")
                if not corner then
                    corner = Instance.new("UICorner")
                    corner.CornerRadius = UDim.new(0, 8)
                    corner.Parent = obj
                end
                local stroke = obj:FindFirstChildOfClass("UIStroke")
                if not stroke then
                    stroke = Instance.new("UIStroke")
                    stroke.Thickness = 2
                    stroke.Parent = obj
                end
                stroke.Color = theme.Stroke
            end
        end
    end
end
