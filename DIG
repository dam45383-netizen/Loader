local function SaveStyle(obj) if not SavedStyle[obj] and (obj:IsA("Frame") or obj:IsA("TextLabel") or obj:IsA("ImageLabel")) then SavedStyle[obj] = {Color = obj.BackgroundColor3, Trans = obj.BackgroundTransparency} end end
local function ApplyMinigameStyle()
