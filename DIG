        for _, v in ipairs(terrain:GetChildren()) do if v:IsA("Folder") then local m = v:FindFirstChildOfClass("Model") if m then return m end return v end end
        local p = terrain:FindFirstChildWhichIsA("BasePart", true)
        if p then return p end
        return terrain
    end
    return childFolder
end
