    for obj, data in pairs(SavedStyle) do
        pcall(function()
            if obj and obj.Parent then
                obj.BackgroundColor3 = data.Color
                obj.BackgroundTransparency = data.Trans
            end
        end)
    end
    SavedStyle = {}
end
