-- ANTI CANCEL
if not getgenv().AntiLock then
    getgenv().AntiLock = true
    local req = Request
    local oldNamecall; oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self,...)
        local args = {...}
        local method = getnamecallmethod()
        if (method == "FireServer" or method == "InvokeServer") and self == req then
            if args[1] and tostring(args[1]):lower():find("cancel") then
                if _G.ThrowCoin or _G.MacroRunning then return nil end
            end
        end
        return oldNamecall(self,...)
    end))
    local oldFire; oldFire = hookfunction(req.FireServer, newcclosure(function(self,...)
        local args = {...}
        if args[1] and tostring(args[1]):lower():find("cancel") then
            if _G.ThrowCoin or _G.MacroRunning then return nil end
        end
        return oldFire(self,...)
    end))
end

local function getEggList()
    local list, priceMap, modelMap = {}, {}, {}
    pcall(function()
        local worlds = workspace:FindFirstChild("SkippingWorlds")
        if worlds then
            for _, world in ipairs(worlds:GetChildren()) do
                local shop = world:FindFirstChild("EggShop")
                local displays = shop and shop:FindFirstChild("Displays")
                if displays then
                    for _, m in ipairs(displays:GetChildren()) do
                        if m:IsA("Model") and not modelMap[m.Name] then
                            local wins = m:GetAttribute("Wins") or m:GetAttribute("Price")
                            if not wins then local v = m:FindFirstChild("Wins") or m:FindFirstChild("Price") if v and v.Value then wins = v.Value end end
                            table.insert(list, m.Name) priceMap[m.Name] = wins or "?" modelMap[m.Name] = m
                        end
                    end
                end
            end
        end
    end)
    if #list == 0 then list = {"Eternal"} priceMap["Eternal"] = "?" end
    return list, priceMap, modelMap
end

local function getTreadmillList()
    local list, map = {}, {}
    pcall(function()
        local worlds = workspace:FindFirstChild("SkippingWorlds")
        if worlds then
            for _, world in ipairs(worlds:GetChildren()) do
                local tz = world:FindFirstChild("TrainingZones")
                if tz then
                    for _, zone in ipairs(tz:GetChildren()) do
                        local stand = zone:FindFirstChild("TrainingStand", true)
                        local cf = nil
                        if stand and stand:IsA("BasePart") then cf = stand.CFrame
                        elseif zone:IsA("BasePart") then cf = zone.CFrame
                        elseif zone:IsA("Model") then
                            local p = zone.PrimaryPart or stand or zone:FindFirstChildWhichIsA("BasePart", true)
                            if p and p:IsA("BasePart") then cf = p.CFrame else cf = zone:GetPivot() end
                        end
                        if cf then
                            local name = world.Name.." - "..zone.Name
                            if not map[name] then table.insert(list, name) map[name] = {CFrame = cf, Model = zone, Stand = stand} end
                        end
                    end
                end
            end
        end
    end)
    return list, map
end

local EggList, EggPrice, EggModels = getEggList()
local TreadmillList, TreadmillMap = getTreadmillList()
_G.SelectedEgg = EggList[1] or "Eternal"
_G.SelectedTreadmill = TreadmillList[1]

local function getEggModel(name) return EggModels[name] end
local function getTreadmillCF(name) local d = TreadmillMap[name] return d and d.CFrame end
local function getLaunchZone() if LaunchCache and LaunchCache.Parent then return LaunchCache end local z = workspace:FindFirstChild("LaunchZone", true) if z then LaunchCache = z end return z end
local function getWorldId() local zone = getLaunchZone() if zone then local cur = zone.Parent while cur and cur ~= workspace do local num = cur.Name:match("%d+") if num then return tonumber(num) end cur = cur.Parent end end return 33 end
local function getLaunchCFrame() local z = getLaunchZone() if not z then return nil end if z:IsA("BasePart") then return z.CFrame elseif z:IsA("Model") then return z:GetPivot() else local p = z:FindFirstChildWhichIsA("BasePart", true) if p then return p.CFrame end end end
local function getThrowButton() if ButtonCache and ButtonCache.Parent then return ButtonCache end local pg = LP:FindFirstChild("PlayerGui") if not pg then return nil end if not HudCache or not HudCache.Parent then HudCache = pg:FindFirstChild("SkippinhHUD") or pg:FindFirstChild("SkippingHUD") end if not HudCache then return nil end local ok, btn = pcall(function() return HudCache.HUD.Bottom.Progression.Throw end) if ok and btn then ButtonCache = btn return btn end local f = HudCache:FindFirstChild("Throw", true) if f then ButtonCache = f end return f end
local function getRebirthValue() local ls = LP:FindFirstChild("leaderstats") local rb = ls and (ls:FindFirstChild("Rebirth") or ls:FindFirstChild("Rebirths")) if rb then return rb.Value end return 78 end

local ThrowToggleApi = nil

local function StartThrow()
    if ThrowRunning then return end
    ThrowRunning = true
    _G.ThrowCoin = true
    LaunchCache = nil ButtonCache = nil HudCache = nil
    if ThrowToggleApi then pcall(function() ThrowToggleApi:Set(true) end) end
    task.spawn(function()
        while ThrowRunning and _G.ThrowCoin do
            local b = getThrowButton()
            if b and not b.Visible then pcall(function() b.Visible = true end) end
            if b and not VisibleConn then
                VisibleConn = b:GetPropertyChangedSignal("Visible"):Connect(function()
                    if ThrowRunning and not b.Visible then b.Visible = true end
                end)
            end
            task.wait(0.2)
        end
        if VisibleConn then VisibleConn:Disconnect() VisibleConn = nil end
    end)
    task.spawn(function()
        while ThrowRunning and _G.ThrowCoin do
            pcall(function()
                local char = LP.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hum then hum.PlatformStand = false if hrp then hrp.Anchored = false end if hum.WalkSpeed < 8 then hum.WalkSpeed = 16 end end
            end)
            task.wait(0.1)
        end
    end)
    task.spawn(function()
        while ThrowRunning and _G.ThrowCoin do
            local worldId = getWorldId()
            if _G.ThrowMode == "Normal" then pcall(function() Request:FireServer("Throw", worldId) end) task.wait(2.5)
            else pcall(function() Request:FireServer("Throw", worldId) end) task.wait(0.6) end
        end
    end)
end

local function StopThrow()
    ThrowRunning = false
    _G.ThrowCoin = false
    if ThrowToggleApi then pcall(function() ThrowToggleApi:Set(false) end) end
    if VisibleConn then VisibleConn:Disconnect() VisibleConn = nil end
end

local TargetTab = CoinAcc or MainTab
TargetTab:Dropdown({Title = "Throw Mode", Desc = " ", Flag = "ThrowMode", Options = {"Normal", "Silent"}, Default = "Silent", Callback = function(v) _G.ThrowMode = v end})
ThrowToggleApi = TargetTab:Toggle({Title = "Throw Coin", Desc = " ", Flag = "ThrowCoin", Default = false, Callback = function(state) if state then StartThrow() else StopThrow() end end})

local RebirthTarget = RebirthAcc or RebirthTab
RebirthTarget:Toggle({Title = "Auto Rebirth", Desc = " ", Flag = "AutoRebirth", Default = false, Callback = function(state) _G.AutoRebirth = state if state then task.spawn(function() while _G.AutoRebirth do pcall(function() Request:FireServer("Rebirth", getRebirthValue()) end) task.wait(1) end end) end end})

local EggTarget = EggAcc or EggTab
EggTarget:Dropdown({Title = "Select Egg", Desc = " ", Flag = "SelectedEgg", Options = EggList, Default = EggList[1], Callback = function(val) _G.SelectedEgg = val end})
EggTarget:Slider({Title = "Hatch Count", Desc = " ", Flag = "HatchCount", Min = 1, Max = 8, Step = 1, Default = 2, Suffix = "x", Callback = function(v) _G.HatchCount = v end})
EggTarget:Toggle({Title = "Auto Hatch Egg", Desc = " ", Flag = "AutoHatch", Default = false, Callback = function(state) _G.AutoHatch = state if state then task.spawn(function() local model = getEggModel(_G.SelectedEgg) if model then local cf = model:IsA("Model") and model:GetPivot() or model:FindFirstChildWhichIsA("BasePart", true).CFrame local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") if cf and hrp then hrp.CFrame = cf + Vector3.new(0,10,0) task.wait(0.6) end end local reqId = 0 while _G.AutoHatch do reqId += 1 pcall(function() Request:FireServer("HatchEgg", {RequestId = reqId, Count = _G.HatchCount, EggId = _G.SelectedEgg}) end) task.wait(0.35) end end) end end})

local MacroTarget = MacroAcc or MacroTab
MacroTarget:Dropdown({Title = "Treadmill Select", Desc = " ", Flag = "SelectedTreadmill", Options = TreadmillList, Default = TreadmillList[1], Callback = function(v) _G.SelectedTreadmill = v end})
MacroTarget:Slider({Title = "Time Treadmill", Desc = " ", Flag = "MacroTreadmillTime", Min = 5, Max = 300, Step = 5, Default = 30, Suffix = "s", Callback = function(v) _G.MacroTreadmillTime = v end})
MacroTarget:Slider({Title = "Time Throw", Desc = " ", Flag = "MacroThrowTime", Min = 5, Max = 300, Step = 5, Default = 30, Suffix = "s", Callback = function(v) _G.MacroThrowTime = v end})
MacroTarget:Toggle({Title = "Start Macro", Desc = " ", Flag = "MacroStart", Default = false, Callback = function(state)
    _G.MacroRunning = state
    if state then
        task.spawn(function()
            while _G.MacroRunning do
                StopThrow()
                local cf = getTreadmillCF(_G.SelectedTreadmill)
                local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if cf and hrp then hrp.CFrame = cf + Vector3.new(0,3,0) end
                local tTime = _G.MacroTreadmillTime or 30
                local s = tick()
                while _G.MacroRunning and tick() - s < tTime do task.wait(0.5) end
                if not _G.MacroRunning then break end
                pcall(function()
                    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
                    if hum then hum.Jump = true hum:ChangeState(Enum.HumanoidStateType.Jumping) end
                    VIM:SendKeyEvent(true, Enum.KeyCode.Space, false, game) task.wait(0.1) VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
                end)
                task.wait(0.5)
                if _G.ThrowMode == "Normal" then
                    local lcf = getLaunchCFrame()
                    hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                    if lcf and hrp then hrp.CFrame = lcf + Vector3.new(0,5,0) task.wait(0.8) end
                end
                StartThrow()
                local throwTime = _G.MacroThrowTime or 30
                local ts = tick()
                while _G.MacroRunning and tick() - ts < throwTime do task.wait(0.5) end
                StopThrow()
            end
            StopThrow()
        end)
    else
        StopThrow()
    end
end})
