local function isDropVisible()
    local ok, v = pcall(function()
        local drop = lp.PlayerGui:FindFirstChild("Drop")
        if not drop then return false end
        local frame = drop:FindFirstChild("Frame")
        return frame and frame.Visible == true
    end)
    return ok and v
end

local function getSpawnsFolder() return workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("GuardianSpawns") end
local function getAreas()
    local f = getSpawnsFolder()
    local list = {}
    if f then for _,v in ipairs(f:GetChildren()) do table.insert(list, v.Name) local cf = v:IsA("BasePart") and v.CFrame or v:GetPivot() SavedPositions[v.Name] = {cf.Position.X, cf.Position.Y, cf.Position.Z} end end
    for name,_ in pairs(SavedPositions) do if not table.find(list, name) then table.insert(list, name) end end
    if #list > 0 then saveToFile(list) end
    return list
end
local function getAreaCFrame(name)
    local f = getSpawnsFolder()
    if f then local o = f:FindFirstChild(name) if o then local cf = o:IsA("BasePart") and o.CFrame or o:GetPivot() SavedPositions[name] = {cf.Position.X, cf.Position.Y, cf.Position.Z} return cf end end
    if SavedPositions[name] then local p = SavedPositions[name] return CFrame.new(p[1], p[2], p[3]) end
    return nil
end
local function getHumanoid() local c = lp.Character if not c then return nil,nil end return c:FindFirstChildOfClass("Humanoid"), c end

local function walkTo(cframe, speed)
    local hum, char = getHumanoid() if not hum or not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart") if not hrp then return false end
    if Mode == "Teleport" then hrp.CFrame = CFrame.new(cframe.Position + Vector3.new(0,3,0)) task.wait(0.2) return true end
    hum.WalkSpeed = speed or WalkSpeed
    local dist = (hrp.Position - cframe.Position).Magnitude
    local dur = math.clamp(dist / (speed or WalkSpeed), 0.2, 8)
    local tw = TweenService:Create(hrp, TweenInfo.new(dur, Enum.EasingStyle.Linear), {CFrame = CFrame.new(cframe.Position + Vector3.new(0,3,0))})
    tw:Play() tw.Completed:Wait()
    return true
end

local function getClosestEgg(areaCF)
    local folder = workspace:FindFirstChild("Live") and workspace.Live:FindFirstChild("Friends")
    if not folder then return nil end
    local closest, minDist = nil, math.huge
    for _, m in ipairs(folder:GetChildren()) do
        if m:GetAttribute("SpawnScale") ~= nil then
            local ok, cf = pcall(function() return m:GetPivot() end)
            if ok then local dist = (cf.Position - areaCF.Position).Magnitude if dist < minDist then minDist = dist closest = m end end
        end
    end
    return closest
end

