local function holdPrompt(prompt)
    if not prompt then return false end
    prompt.Enabled = true
    prompt.MaxActivationDistance = 150
    prompt.RequiresLineOfSight = false
    local duration = prompt.HoldDuration if duration <= 0 then duration = 1.5 end
    pcall(function() prompt:InputHoldBegin() end)
    local t = 0 while t < duration + 0.3 do task.wait(0.1) t += 0.1 if not prompt.Parent then break end end
    pcall(function() prompt:InputHoldEnd() end) task.wait(0.4) return true
end

