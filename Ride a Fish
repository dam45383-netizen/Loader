local function walkToPos(targetPos)
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = getHRP()
    if not hum or not hrp then return end
    hum:MoveTo(targetPos)
    local startTick = tick()
    local lastRepath = tick()
    while true do
        task.wait(0.01)
        if not char.Parent or not hum.Parent then break end
        local dist = (hrp.Position - targetPos).Magnitude
        if dist <= 5 then break end
        if tick() - startTick > 30 then break end
        if tick() - lastRepath > 0.35 then
            hum:MoveTo(targetPos)
            lastRepath = tick()
        end
        local fish = getRidingFish()
        if fish then
            pcall(function() fish:PivotTo(CFrame.new(hrp.Position + Vector3.new(0,1.5,0))) end)
        end
    end
end

