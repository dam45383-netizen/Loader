local function ensureEggPanel() if EggVaultPanel then return EggVaultPanel end EggVaultPanel=Window:Panel({Title="🥚 EGG VAULT",Subtitle="Filter • Silent • ESP • KingKalolo",Width=340,GripY=0.35,Open=isPanelShow,Callback=function(open) isPanelShow=open end}) return EggVaultPanel end
local function refreshPanel()
    if not isPanelShow then return end
    local wasOpen=false
    if EggVaultPanel then pcall(function() wasOpen=EggVaultPanel:IsOpen() end) pcall(function() EggVaultPanel:Destroy() end) end
    EggVaultPanel=Window:Panel({Title="🥚 EGG VAULT",Subtitle="≥ "..formatCompact(minLuckFilter).." | "..getSelectedRarityDisplay().." | "..selectedArea,Width=350,GripY=0.35,Open=wasOpen or true,Callback=function(open) isPanelShow=open end})
    local eggs=getFilteredEggs()
    table.sort(eggs,function(a,b) local la,lb=tonumber(a:GetAttribute("EggLuck")) or 0, tonumber(b:GetAttribute("EggLuck")) or 0 if la~=lb then return la>lb end local wa,wb=tonumber(a:GetAttribute("EggKg")) or 0, tonumber(b:GetAttribute("EggKg")) or 0 return wa>wb end)
    EggVaultPanel:Paragraph({Title="📊 STATS",Desc="Total: "..#eggs.." | Filter: ≥ "..formatCompact(minLuckFilter).." | Rarity: "..getSelectedRarityDisplay().." | Area: "..selectedArea.." | Best: "..(#eggs>0 and formatCompact(tonumber(eggs[1]:GetAttribute("EggLuck")) or 0) or "0")}) EggVaultPanel:Divider()
    if #eggs==0 then EggVaultPanel:Label("Tidak ada egg sesuai filter") return end
    for _,egg in ipairs(eggs) do local luck=tonumber(egg:GetAttribute("EggLuck")) or 0 local kg=egg:GetAttribute("EggKg") or 0 local tier=getEggTier(egg) local area=getEggArea(egg) EggVaultPanel:Button({Title=egg.Name.." ["..tier.."] ["..area.."] 🍀 "..formatCompact(luck),Desc="⚖️ "..tostring(kg).." Kg • "..area,Callback=function() task.spawn(function() doSteal(egg) end) end}) end
end
