local function refreshPanel()
    if not scrollFrame or not isPanelShow then return end
    for _,c in ipairs(scrollFrame:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
    local eggs=getAllEggs() table.sort(eggs,function(a,b) local la,lb=tonumber(a:GetAttribute("EggLuck")) or 0, tonumber(b:GetAttribute("EggLuck")) or 0 if la~=lb then return la>lb end local wa,wb=tonumber(a:GetAttribute("EggKg")) or 0, tonumber(b:GetAttribute("EggKg")) or 0 return wa>wb end)
    if statTotal then statTotal.Text="Total: "..#eggs end if statBest and #eggs>0 then statBest.Text="Best: "..tostring(eggs[1]:GetAttribute("EggLuck")) end
    for _,egg in ipairs(eggs) do
        local card=NI("Frame") card.Size=UDim2.new(1,-10,0,68) card.BackgroundColor3=Color3.fromRGB(22,20,38) card.Parent=scrollFrame local cc=NI("UICorner") cc.CornerRadius=UDim.new(0,12) cc.Parent=card local cs=NI("UIStroke") cs.Color=Color3.fromRGB(70,60,120) cs.Transparency=0.6 cs.Parent=card
        local left=NI("Frame") left.Size=UDim2.new(0,4,1,0) left.BackgroundColor3=ACCENT left.BorderSizePixel=0 left.Parent=card local lg=NI("UIGradient") lg.Color=ColorSequence.new(ACCENT,CYAN) lg.Rotation=90 lg.Parent=left
        local imgBox=NI("Frame") imgBox.Size=UDim2.fromOffset(48,48) imgBox.Position=UDim2.fromOffset(12,10) imgBox.BackgroundColor3=Color3.fromRGB(14,12,26) imgBox.Parent=card local ic=NI("UICorner") ic.CornerRadius=UDim.new(0,10) ic.Parent=imgBox local vp=NI("ViewportFrame") vp.Size=UDim2.fromScale(1,1) vp.BackgroundTransparency=1 vp.Parent=imgBox local cam=NI("Camera") cam.Parent=vp vp.CurrentCamera=cam pcall(function() local cl=egg:Clone() cl.Parent=vp local cf,_=cl:GetBoundingBox() cam.CFrame=CFrame.new(cf.Position+Vector3.new(2,2,4),cf.Position) end)
        local nL=NI("TextLabel") nL.Text=egg.Name nL.Font=Enum.Font.GothamBold nL.TextSize=12 nL.TextColor3=Color3.fromRGB(245,243,255) nL.BackgroundTransparency=1 nL.Position=UDim2.fromOffset(70,8) nL.Size=UDim2.new(1,-150,0,16) nL.TextXAlignment=Enum.TextXAlignment.Left nL.Parent=card
        local lB=NI("Frame") lB.Size=UDim2.fromOffset(68,16) lB.Position=UDim2.fromOffset(70,30) lB.BackgroundColor3=ACCENT lB.BackgroundTransparency=0.2 lB.Parent=card local lbc=NI("UICorner") lbc.CornerRadius=UDim.new(1,0) lbc.Parent=lB local lbT=NI("TextLabel") lbT.Text="🍀 "..tostring(egg:GetAttribute("EggLuck") or 0) lbT.Font=Enum.Font.GothamBold lbT.TextSize=10 lbT.TextColor3=Color3.new(1,1,1) lbT.BackgroundTransparency=1 lbT.Size=UDim2.fromScale(1,1) lbT.Parent=lB
        local kB=NI("Frame") kB.Size=UDim2.fromOffset(62,16) kB.Position=UDim2.fromOffset(142,30) kB.BackgroundColor3=Color3.fromRGB(30,28,50) kB.Parent=card local kbc=NI("UICorner") kbc.CornerRadius=UDim.new(1,0) kbc.Parent=kB local kbT=NI("TextLabel") kbT.Text=tostring(egg:GetAttribute("EggKg") or 0).." Kg" kbT.Font=Enum.Font.GothamMedium kbT.TextSize=10 kbT.TextColor3=Color3.fromRGB(180,175,210) kbT.BackgroundTransparency=1 kbT.Size=UDim2.fromScale(1,1) kbT.Parent=kB
        local btn=NI("TextButton") btn.Text="SILENT STEAL" btn.Font=Enum.Font.GothamBold btn.TextSize=10 btn.TextColor3=Color3.new(1,1,1) btn.BackgroundColor3=ACCENT btn.Size=UDim2.fromOffset(76,32) btn.Position=UDim2.new(1,-82,0.5,-16) btn.Parent=card local bc=NI("UICorner") bc.CornerRadius=UDim.new(0,8) bc.Parent=btn local bg=NI("UIGradient") bg.Color=ColorSequence.new(ACCENT,CYAN) bg.Parent=btn
        btn.MouseButton1Click:Connect(function() task.spawn(function() doSteal(egg) end) end)
    end
