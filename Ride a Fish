local function resolveRuntimePos(runtimeName)
    local obj=workspace:FindFirstChild(runtimeName)
    if obj then
        local pos=getEggPos(obj)
        if pos then return pos end
        local ok,cf=pcall(function() return obj:GetPivot() end)
        if ok and cf then return cf.Position end
    end
    local er=workspace:FindFirstChild("EggRuntime")
    if er then
        local sub=er:FindFirstChild(runtimeName)
        if sub then
            local pos=getEggPos(sub)
            if pos then return pos end
        end
    end
    return nil
end

