-- MAIN API = TAB
local MainTab = Window:Tab({Title="Main", Icon="M"})
local EggAcc = MainTab:Accordion({Title="Egg", Desc=" ", Open=true})
EggAcc:Toggle({Title="Best Luck", Desc=" ", Flag="BestLuck", Default=true, Callback=function(v) isBestLuck=v end})
EggAcc:Toggle({Title="Silent Method", Desc=" ", Flag="SilentMethod", Default=true, Callback=function(v) useSilentMethod=v end})
EggAcc:Slider({Title="Tween Speed", Desc=" ", Flag="TweenSpeedBase", Min=20, Max=1000, Step=5, Default=120, Suffix=" stud/s", Callback=function(v) tweenSpeed=v end})
EggAcc:Toggle({Title="Auto Collect Egg", Desc=" ", Flag="AutoCollectEgg", Default=false, Callback=function(s)
    isCollecting=s
    if s then task.spawn(function() while isCollecting do pcall(function() local all=getAllEggs() if #all==0 then task.wait(1) return end local target,best=nil,-1 local hrp=getHRP() local closest=math.huge if isBestLuck then for _,m in ipairs(all) do local n=tonumber(m:GetAttribute("EggLuck")) or 0 if n>best then best=n target=m end end else for _,m in ipairs(all) do local p=getEggPos(m) if p and hrp then local d=(hrp.Position-p).Magnitude if d<closest then closest=d target=m end end end end if target then doSteal(target) else task.wait(0.8) end end) task.wait(0.3) end end) else if cloneModel then cloneModel:Destroy() setInvisible(false) restoreCam() end end
end})

local PanelTab = Window:Tab({Title="Panel", Icon="P"})
local PanelAcc = PanelTab:Accordion({Title="Panel Egg", Desc=" ", Open=true})
PanelAcc:Toggle({Title="Show Panel", Desc=" ", Flag="ShowEggPanel", Default=false, Callback=function(v)
    isPanelShow=v if v then createPanelUI() refreshPanel() task.spawn(function() while isPanelShow do task.wait(1.5) refreshPanel() end end) else if panelGui then panelGui:Destroy() panelGui=nil end if cloneModel then cloneModel:Destroy() setInvisible(false) restoreCam() end end
end})
