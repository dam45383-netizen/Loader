local TokenTab=Window:Tab({Title="Token", Icon="T"})
local TokenAcc=TokenTab:Accordion({Title="Auto Collect Token", Desc="Farm TokenClientVisuals", Open=true})
TokenAcc:Toggle({Title="Auto Token",Desc="Auto teleport ke token",Flag="AutoToken",Default=false,Callback=function(s) isCollectingToken=s if s then Window.Notify("Auto Token","ON",CYAN,1.5) task.spawn(function() while isCollectingToken do pcall(function() local folder=workspace:FindFirstChild("TokenClientVisuals") if not folder then task.wait(1) return end local all=getAllTokens() if #all==0 then task.wait(1) return end local hrp=getHRP() table.sort(all, function(a,b) local pa=getTokenPos(a) local pb=getTokenPos(b) if not pa or not pb or not hrp then return false end return (hrp.Position-pa).Magnitude < (hrp.Position-pb).Magnitude end) for _,tok in ipairs(all) do if not isCollectingToken then break end if tok.Parent then doCollectToken(tok) task.wait(0.22) end end end) task.wait(0.3) end end) else Window.Notify("Auto Token","OFF",Color3.fromRGB(248,113,113),1) end end})
TokenAcc:Button({Title="Collect Nearest Token Once",Desc="Teleport ke token terdekat 1x",Callback=function() local all=getAllTokens() if #all==0 then Window.Notify("Token","Ga ada token",Color3.fromRGB(248,113,113),1) return end local hrp=getHRP() local best,closest=nil,math.huge for _,m in ipairs(all) do local p=getTokenPos(m) if p and hrp then local d=(hrp.Position-p).Magnitude if d<closest then closest=d best=m end end end if best then doCollectToken(best) end end})
TokenAcc:Button({Title="Check Token Count",Desc="Lihat berapa token tersedia",Callback=function() local c=#getAllTokens() Window.Notify("Token Count","Ada "..c.." token",ACCENT,1.5) end})

