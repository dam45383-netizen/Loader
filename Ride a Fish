local function refreshEsp()
    if not isEspEggEnabled then clearAllEsp() return end
    for _,m in ipairs(getAllEggs()) do
        local luck=tonumber(m:GetAttribute("EggLuck")) or 0 local tier=getEggTier(m) local area=getEggArea(m) ensureRarity(tier)
