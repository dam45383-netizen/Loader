local function NI(c) return Instance.new(c) end
local function parseLuck(str)
    if not str then return 0 end
    str=tostring(str):gsub("%s+",""):upper()
    if str=="" or str=="0" then return 0 end
    local mults={K=1e3,M=1e6,B=1e9,T=1e12,Q=1e15}
    local num,suf=str:match("^([%d%.]+)([KMBTQ]+)$")
    if num then return math.floor((tonumber(num) or 0)*(mults[suf] or 1)) else return tonumber(str) or 0 end
end
local function formatCompact(n)
    if n>=1e12 then return string.format("%.2fT",n/1e12)
    elseif n>=1e9 then return string.format("%.2fB",n/1e9)
    elseif n>=1e6 then return string.format("%.2fM",n/1e6)
    elseif n>=1e3 then return string.format("%.1fK",n/1e3) else return tostring(n) end
end
