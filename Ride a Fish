    pingLabel=NI("TextLabel") pingLabel.Text="PING: --" pingLabel.Font=Enum.Font.GothamBold pingLabel.TextSize=11 pingLabel.TextColor3=ACCENT pingLabel.BackgroundTransparency=1 pingLabel.Position=UDim2.new(0.5,0,0,0,20) pingLabel.Size=UDim2.new(0.5,0,0,18) pingLabel.Parent=statsPanel
