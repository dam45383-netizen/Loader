local function NI(c) return Instance.new(c) end
local function parseLuck(str)
    if not str then return 0 end
    str=tostring(str):gsub("%s+",""):upper()
    if str=="" or str=="0" then return 0 end
    local mults={K=1e3,M=1e6,B=1e9,T=1e12,Q=1e15}
    local num,suf=str:match("^([%d%.]+)([KMBTQ]+)$")
    if num then return math.floor((tonumber(num) or 0)*(mults[suf] or 1)) else return tonumber(str) or 0 end
end
local function formatCompact(n)
    if n>=1e12 then return string.format("%.2fT",n/1e12)
    elseif n>=1e9 then return string.format("%.2fB",n/1e9)
    elseif n>=1e6 then return string.format("%.2fM",n/1e6)
    elseif n>=1e3 then return string.format("%.1fK",n/1e3) else return tostring(n) end
end
local function getEggTier(m)
    local t=m:GetAttribute("EggTier")
    if t==nil or t=="" then return "Unknown" end
    return tostring(t)
end

local rarityOptions={"All"}
local raritySet={["All"]=true}
local selectedRaritySet={["All"]=true}
local rarityDropdown=nil

local function getSelectedRarityDisplay()
    if selectedRaritySet["All"] then return "All" end
    if not next(selectedRaritySet) then return "All" end
    local t={} for k,_ in pairs(selectedRaritySet) do table.insert(t,k) end
    return table.concat(t,", ")
end
local function isRarityAllowed(tier)
    if selectedRaritySet["All"] then return true end
    if not next(selectedRaritySet) then return true end
    return selectedRaritySet[tier]==true
end
local function ensureRarity(tier)
    tier=tostring(tier or "Unknown")
    if tier=="" then tier="Unknown" end
    if not raritySet[tier] then
        raritySet[tier]=true
        table.insert(rarityOptions, tier)
        if rarityDropdown then
            pcall(function()
                if rarityDropdown.Refresh then rarityDropdown:Refresh(rarityOptions)
                elseif rarityDropdown.SetOptions then rarityDropdown:SetOptions(rarityOptions) end
            end)
        end
        return true
    end
    return false
end

local function getHRP() local ch=LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait() return ch:WaitForChild("HumanoidRootPart") end
local function getRidingFish() local d=workspace:FindFirstChild(LocalPlayer.Name.."_RidingFish") if d then return d end for _,v in ipairs(workspace:GetChildren()) do if v.Name:lower():find("ridingfish") and v.Name:find(LocalPlayer.Name) then return v end end return nil end
local function getEggPos(m) local cf=nil pcall(function() cf=m:GetPivot() end) if cf then return cf.Position end if m.PrimaryPart then return m.PrimaryPart.Position end for _,v in ipairs(m:GetDescendants()) do if v:IsA("BasePart") then return v.Position end end return nil end

-- ===== FIXED MOVEMENT FOR FISH RIDER =====
local function tpToPos(p)
    local fish=getRidingFish()
    if fish then
        pcall(function() fish:PivotTo(CFrame.new(p+Vector3.new(0,3,0))) end)
        local part=fish.PrimaryPart or fish:FindFirstChildWhichIsA("BasePart")
        if part then part.CFrame=CFrame.new(p+Vector3.new(0,3,0)) end
    end
    local h=getHRP() if h then h.CFrame=CFrame.new(p+Vector3.new(0,3,0)) end
end

local function tweenToPos(p)
    local fish=getRidingFish()
    local movePart=nil
    if fish then movePart=fish.PrimaryPart or fish:FindFirstChildWhichIsA("BasePart") end
    if not movePart then movePart=getHRP() end
    if not movePart then return end
    if currentTween then pcall(function() currentTween:Cancel() end) end
    local dur=math.clamp((movePart.Position-p).Magnitude/tweenSpeed,0.15,8)
    currentTween=TweenService:Create(movePart,TweenInfo.new(dur,Enum.EasingStyle.Linear),{CFrame=CFrame.new(p)})
    currentTween:Play()
    currentTween.Completed:Wait()
    if fish then pcall(function() fish:PivotTo(CFrame.new(p+Vector3.new(0,3,0))) end) end
    local h=getHRP() if h then h.CFrame=CFrame.new(p+Vector3.new(0,3,0)) end
end

local function unstuckChar()
    pcall(function()
        local ch=LocalPlayer.Character
        if not ch then return end
        for _,v in ipairs(ch:GetDescendants()) do if v:IsA("BasePart") then v.Anchored=false end end
        local hum=ch:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.PlatformStand=false
            hum.Sit=false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            task.wait(0.05)
            hum:ChangeState(Enum.HumanoidStateType.RunningNoPhysics)
            task.wait(0.05)
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
    end)
end

local function instantInteract(m) for _,v in ipairs(m:GetDescendants()) do if v:IsA("ProximityPrompt") then v.HoldDuration=0 pcall(function() if fireproximityprompt then fireproximityprompt(v) else v:InputHoldBegin() task.wait() v:InputHoldEnd() end end) end end end
local function spamInteract(m) local t=tick() while tick()-t<1 do if not m.Parent then break end instantInteract(m) task.wait(0.05) end end

local function getAllTokens()
    local folder=workspace:FindFirstChild("TokenClientVisuals")
    if not folder then return {} end
    return folder:GetChildren()
end
local function getTokenPos(m)
    local pos=nil
    pcall(function() if m.GetPivot then pos=m:GetPivot().Position end end)
    if pos then return pos end
    if m:IsA("BasePart") then return m.Position end
    if m.PrimaryPart then return m.PrimaryPart.Position end
    for _,v in ipairs(m:GetDescendants()) do if v:IsA("BasePart") then return v.Position end end
    return nil
end
local function doCollectToken(model)
    if not model or not model.Parent then return end
    local tokenPos=getTokenPos(model)
    if not tokenPos then return end
    tweenToPos(tokenPos)
    task.wait(0.2)
    instantInteract(model)
    pcall(function()
        local hrp=getHRP()
        if not hrp then return end
        if model:IsA("BasePart") then
            if firetouchinterest then firetouchinterest(hrp, model, 0) task.wait(0.08) firetouchinterest(hrp, model, 1) end
        else
            for _,p in ipairs(model:GetDescendants()) do
                if p:IsA("BasePart") then
                    if firetouchinterest then firetouchinterest(hrp, p, 0) task.wait(0.06) firetouchinterest(hrp, p, 1) end
                end
            end
        end
    end)
    task.wait(0.1)
end

local function getEggArea(m)
    if not m then return "Unknown" end
    local cur=m
    for i=1,12 do
        if not cur then break end
        local nm=cur.Name
        if nm=="WildEggs" then return "Wild" end
        if nm:find("KingKalolo") then return "KingKaloloBoss" end
        if nm:find("Kraken") then return "KrakenBoss" end
        cur=cur.Parent
    end
    return "Wild"
end
local function isAreaAllowed(area) if selectedArea=="All" then return true end return area==selectedArea end

local function getAllEggs()
    local list,seen={},{} 
    local function add(m) if m and not seen[m] and m:GetAttribute("EggLuck")~=nil then seen[m]=true table.insert(list,m) end end
    local er=workspace:FindFirstChild("EggRuntime")
    if er then
        for _,runtime in ipairs(er:GetChildren()) do
            add(runtime)
            for _,m in ipairs(runtime:GetChildren()) do add(m) end
            for _,m in ipairs(runtime:GetDescendants()) do if m:IsA("Model") then add(m) end end
        end
    end
    for _,rn in ipairs({"KrakenBossRuntime","KingKaloloBossRuntime"}) do
        local obj=workspace:FindFirstChild(rn)
        if obj then
            add(obj)
            for _,m in ipairs(obj:GetChildren()) do add(m) end
            for _,m in ipairs(obj:GetDescendants()) do if m:IsA("Model") then add(m) end end
        end
    end
    return list
end

local function getFilteredEggs()
    local all=getAllEggs()
    local out={}
    for _,m in ipairs(all) do
        local luck=tonumber(m:GetAttribute("EggLuck")) or 0
        local tier=getEggTier(m)
        local area=getEggArea(m)
        ensureRarity(tier)
        if luck>=minLuckFilter and isRarityAllowed(tier) and isAreaAllowed(area) then table.insert(out,m) end
    end
    return out
end

local function setInvisible(v) local char=LocalPlayer.Character if not char then return end for _,p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") and p.Name~="HumanoidRootPart" then if v then origTrans[p]=p.Transparency p.Transparency=1 else if origTrans[p]~=nil then p.Transparency=origTrans[p] else p.Transparency=0 end end end end end
local function createClone(cf) local char=LocalPlayer.Character if not char then return nil end char.Archivable=true local cl=char:Clone() for _,v in ipairs(cl:GetDescendants()) do if v:IsA("Script") or v:IsA("LocalScript") then v:Destroy() end if v:IsA("BasePart") then v.Anchored=true v.CanCollide=false end end cl.Parent=workspace pcall(function() cl:PivotTo(cf) end) return cl end
local function saveCam() local cam=workspace.CurrentCamera savedCam.Subject=cam.CameraSubject savedCam.Type=cam.CameraType savedCam.CFrame=cam.CFrame end
local function lockCamToClone(cl) local cam=workspace.CurrentCamera local hum=cl:FindFirstChildOfClass("Humanoid") if hum then cam.CameraSubject=hum else cam.CameraType=Enum.CameraType.Scriptable cam.CFrame=savedCam.CFrame end end
local function restoreCam() local cam=workspace.CurrentCamera if savedCam.Subject then cam.CameraSubject=savedCam.Subject end if savedCam.Type then cam.CameraType=savedCam.Type end end
local function fireStoreLoop() local req=ReplicatedStorage:FindFirstChild("EggGame") and ReplicatedStorage.EggGame:FindFirstChild("Requests") if not req then return end if isCollecting then local s=tick() while isCollecting and tick()-s<2.2 do pcall(function() req:FireServer("StoreEgg") end) task.wait(0.1) end else for i=1,10 do pcall(function() req:FireServer("StoreEgg") end) task.wait(0.1) end end end

local function doSteal(model)
    if not model or not model.Parent then return end
    local eggPos=getEggPos(model) if not eggPos then return end
    local stayCF=nil
    local onFish=getRidingFish()~=nil
    local savedSilent=useSilentMethod
    if onFish then useSilentMethod=false end
    if useSilentMethod then
        saveCam()
        stayCF=getHRP() and getHRP().CFrame or CFrame.new(BASE_POS)
        cloneModel=createClone(stayCF)
        lockCamToClone(cloneModel)
        setInvisible(true)
    else
        stayCF=getHRP() and getHRP().CFrame or nil
    end
    tpToPos(eggPos)
    task.wait(0.25)
    spamInteract(model)
    task.wait(0.15)
    tweenToPos(BASE_POS)
    task.wait(0.2)
    fireStoreLoop()
    unstuckChar()
    if useSilentMethod and stayCF then
        tweenToPos(stayCF.Position)
        task.wait(0.15)
        setInvisible(false)
        restoreCam()
        if cloneModel then pcall(function() cloneModel:Destroy() end) cloneModel=nil end
    elseif stayCF then
        tweenToPos(stayCF.Position)
        task.wait(0.15)
    end
