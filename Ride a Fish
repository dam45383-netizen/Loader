local function refreshPanel()
    if not isPanelShow then return end
    local wasOpen=false
    if EggVaultPanel then pcall(function() wasOpen=EggVaultPanel:IsOpen() end) pcall(function() EggVaultPanel:Destroy() end) end
    EggVaultPanel=Window:Panel({Title="🥚 EGG VAULT",Subtitle="≥ "..formatCompact(minLuckFilter).." | "..getSelectedRarityDisplay().." | "..selectedArea,Width=350,GripY=0.35,Open=wasOpen or true,Callback=function(open) isPanelShow=open end})
    local eggs=getFilteredEggs()
    table.sort(eggs,function(a,b) local la,lb=tonumber(a:GetAttribute("EggLuck")) or 0, tonumber(b:GetAttribute("EggLuck")) or 0 if la~=lb then return la>lb end local wa,wb=tonumber(a:GetAttribute("EggKg")) or 0, tonumber(b:GetAttribute("EggKg")) or 0 return wa>wb end)
