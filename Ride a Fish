local function fireStoreLoop() local req=ReplicatedStorage:FindFirstChild("EggGame") and ReplicatedStorage.EggGame:FindFirstChild("Requests") if not req then return end if isCollecting then local s=tick() while isCollecting and tick()-s<2.2 do pcall(function() req:FireServer("StoreEgg") end) task.wait(0.1) end else for i=1,10 do pcall(function() req:FireServer("StoreEgg") end) task.wait(0.1) end end end
local function doSteal(model)
    if not model or not model.Parent then return end
    local eggPos=getEggPos(model) if not eggPos then return end
    local stayCF=nil
    local onFish=getRidingFish()~=nil
    local savedSilent=useSilentMethod
    if onFish then useSilentMethod=false end
    if useSilentMethod then saveCam() stayCF=getHRP() and getHRP().CFrame or CFrame.new(BASE_POS) cloneModel=createClone(stayCF) lockCamToClone(cloneModel) setInvisible(true) else stayCF=getHRP() and getHRP().CFrame or nil end
    tpToPos(eggPos) task.wait(0.25) spamInteract(model) task.wait(0.15) tweenToPos(BASE_POS) task.wait(0.2) fireStoreLoop() unstuckChar()
    if useSilentMethod and stayCF then tweenToPos(stayCF.Position) task.wait(0.15) setInvisible(false) restoreCam() if cloneModel then pcall(function() cloneModel:Destroy() end) cloneModel=nil end
    elseif stayCF then tweenToPos(stayCF.Position) task.wait(0.15) end
    if onFish and stayCF then local fish=getRidingFish() if fish then pcall(function() fish:PivotTo(stayCF) end) end end
    useSilentMethod=savedSilent unstuckChar()
end
