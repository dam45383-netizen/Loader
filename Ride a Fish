local function findByKeyword(keyword)
    keyword = keyword:lower()
    local er = workspace:FindFirstChild("EggRuntime")
    if er then
        for _,v in ipairs(er:GetChildren()) do
            if v.Name:lower():find(keyword,1,true) then return v end
        end
        for _,v in ipairs(er:GetDescendants()) do
