            if isStatsShow and statsPara then
                local fps=math.floor(frames/(tick()-last))
                pcall(function()
                    local ping=math.floor(LocalPlayer:GetNetworkPing()*1000)
                    statsPara:Set("⚡ PERFORMANCE - FPS: "..fps, "PING: "..ping.."ms | Filter: ≥ "..formatCompact(minLuckFilter).." | "..getSelectedRarityDisplay())
                end)
            end
            frames=0 last=tick()
        end
    end)
end)

