        end
    end
    for _,v in ipairs(workspace:GetChildren()) do
        if v.Name:lower():find(keyword,1,true) then return v end
    end
    for _,v in ipairs(workspace:GetDescendants()) do
        if v.Name:lower():find(keyword,1,true) and (v:IsA("Model") or v:IsA("Folder")) then return v end
    end
    return nil
