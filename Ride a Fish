-- SAFE FIX
local function safeGetPivot(obj)
    local ok,cf = pcall(function() return obj:GetPivot() end)
    if ok then return cf end
    return nil
end
local function safeGetPrimaryPart(obj)
    if not obj:IsA("Model") then return nil end
    local ok,pp = pcall(function() return obj.PrimaryPart end)
    if ok then return pp end
    return nil
end
local function getEggPos(m)
    if not m then return nil end
    local cf = safeGetPivot(m)
    if cf then return cf.Position end
    if m:IsA("Model") then
        local pp = safeGetPrimaryPart(m)
        if pp then return pp.Position end
    end
    if m:IsA("BasePart") then return m.Position end
    local ok,part = pcall(function() return m:FindFirstChildWhichIsA("BasePart", true) end)
    if ok and part then return part.Position end
    for _,v in ipairs(m:GetDescendants()) do if v:IsA("BasePart") then return v.Position end end
    return nil
end

local function findByKeyword(keyword)
    keyword = keyword:lower()
    local er = workspace:FindFirstChild("EggRuntime")
    if er then
        for _,v in ipairs(er:GetChildren()) do if v.Name:lower():find(keyword,1,true) then return v end end
        for _,v in ipairs(er:GetDescendants()) do if v.Name:lower():find(keyword,1,true) then return v end end
    end
    for _,v in ipairs(workspace:GetChildren()) do if v.Name:lower():find(keyword,1,true) then return v end end
    for _,v in ipairs(workspace:GetDescendants()) do if v.Name:lower():find(keyword,1,true) and (v:IsA("Model") or v:IsA("Folder")) then return v end end
    return nil
end

local function tpToPos(p)
    local fish=getRidingFish()
    if fish then pcall(function() fish:PivotTo(CFrame.new(p+Vector3.new(0,3,0))) end) end
    local h=getHRP() if h then h.CFrame=CFrame.new(p+Vector3.new(0,3,0)) end
end
local function tweenToPos(p)
    local fish=getRidingFish()
    local movePart=nil
    if fish then
        if fish:IsA("Model") then movePart = safeGetPrimaryPart(fish) end
        if not movePart then local ok,part = pcall(function() return fish:FindFirstChildWhichIsA("BasePart", true) end) if ok then movePart=part end end
    end
    if not movePart then movePart=getHRP() end
    if not movePart then return end
    if currentTween then pcall(function() currentTween:Cancel() end) end
    local dur=math.clamp((movePart.Position-p).Magnitude/tweenSpeed,0.15,8)
    currentTween=TweenService:Create(movePart,TweenInfo.new(dur,Enum.EasingStyle.Linear),{CFrame=CFrame.new(p)})
    currentTween:Play()
    currentTween.Completed:Wait()
    if fish then pcall(function() fish:PivotTo(CFrame.new(p+Vector3.new(0,3,0))) end) end
    local h=getHRP() if h then h.CFrame=CFrame.new(p+Vector3.new(0,3,0)) end
end
local function unstuckChar()
    pcall(function()
        local ch=LocalPlayer.Character
        if not ch then return end
        for _,v in ipairs(ch:GetDescendants()) do if v:IsA("BasePart") then v.Anchored=false end end
        local hum=ch:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand=false hum.Sit=false hum:ChangeState(Enum.HumanoidStateType.GettingUp) task.wait(0.05) hum:ChangeState(Enum.HumanoidStateType.Running) end
    end)
end

local function instantInteract(m) for _,v in ipairs(m:GetDescendants()) do if v:IsA("ProximityPrompt") then v.HoldDuration=0 pcall(function() if fireproximityprompt then fireproximityprompt(v) else v:InputHoldBegin() task.wait() v:InputHoldEnd() end end) end end end
local function spamInteract(m) local t=tick() while tick()-t<1 do if not m.Parent then break end instantInteract(m) task.wait(0.05) end end

