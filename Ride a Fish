local function getSelectedRarityDisplay()
    if selectedRaritySet["All"] then return "All" end
    if not next(selectedRaritySet) then return "All" end
    local t={} for k,_ in pairs(selectedRaritySet) do table.insert(t,k) end
    return table.concat(t,", ")
end
local function isRarityAllowed(tier)
    if selectedRaritySet["All"] then return true end
    if not next(selectedRaritySet) then return true end
    return selectedRaritySet[tier]==true
end
local function ensureRarity(tier)
    tier=tostring(tier or "Unknown")
    if tier=="" then tier="Unknown" end
    if not raritySet[tier] then
        raritySet[tier]=true
        table.insert(rarityOptions, tier)
        if rarityDropdown then pcall(function() if rarityDropdown.Refresh then rarityDropdown:Refresh(rarityOptions) elseif rarityDropdown.SetOptions then rarityDropdown:SetOptions(rarityOptions) end end) end
        return true
    end
    return false
end

