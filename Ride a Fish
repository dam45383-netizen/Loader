local function getTokenPos(m)
    local pos=nil pcall(function() if m.GetPivot then pos=m:GetPivot().Position end end) if pos then return pos end
    if m:IsA("BasePart") then return m.Position end
    if m:IsA("Model") then local pp=safeGetPrimaryPart(m) if pp then return pp.Position end end
    for _,v in ipairs(m:GetDescendants()) do if v:IsA("BasePart") then return v.Position end end
    return nil
end
local function doCollectToken(model) if not model or not model.Parent then return end local tokenPos=getTokenPos(model) if not tokenPos then return end tweenToPos(tokenPos) task.wait(0.2) instantInteract(model) task.wait(0.1) end
local function getEggArea(m)
    if not m then return "Unknown" end
    local cur=m
    for i=1,15 do if not cur then break end local nm=cur.Name:lower() if nm:find("kingkalolo") or nm:find("kalolo") then return "KingKaloloBoss" end if nm:find("kraken") then return "KrakenBoss" end if nm=="wildeggs" then return "Wild" end cur=cur.Parent end
    return "Wild"
end
