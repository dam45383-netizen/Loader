    statsGui=NI("ScreenGui") statsGui.Name="SORU_Stats" statsGui.ResetOnSpawn=false statsGui.Parent=LocalPlayer.PlayerGui
    local statsPanel=NI("Frame") statsPanel.AnchorPoint=Vector2.new(0,0) statsPanel.Position=UDim2.fromScale(0.02,0.18) statsPanel.Size=UDim2.fromScale(0.16,0.09) statsPanel.BackgroundColor3=Color3.fromRGB(12,10,22) statsPanel.BorderSizePixel=0 statsPanel.Parent=statsGui
    local c=NI("UICorner") c.CornerRadius=UDim.new(0,14) c.Parent=statsPanel local st=NI("UIStroke") st.Color=Color3.fromRGB(80,70,130) st.Thickness=1.2 st.Transparency=0.25 st.Parent=statsPanel
    local top=NI("Frame") top.Size=UDim2.new(1,0,0,2) top.BackgroundColor3=Color3.new(1,1,1) top.BorderSizePixel=0 top.Parent=statsPanel local tg=NI("UIGradient") tg.Color=ColorSequence.new(ACCENT,CYAN) tg.Parent=top
    local header=NI("Frame") header.Size=UDim2.new(1,0,0,20) header.BackgroundTransparency=1 header.Parent=statsPanel
