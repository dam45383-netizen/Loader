local function NI(c) return Instance.new(c) end
local function parseLuck(str)
    if not str then return 0 end
    str=tostring(str):gsub("%s+",""):upper()
    if str=="" or str=="0" then return 0 end
    local mults={K=1e3,M=1e6,B=1e9,T=1e12,Q=1e15}
    local num,suf=str:match("^([%d%.]+)([KMBTQ]+)$")
    if num then return math.floor((tonumber(num) or 0)*(mults[suf] or 1)) else return tonumber(str) or 0 end
end
local function formatCompact(n)
    if n>=1e12 then return string.format("%.2fT",n/1e12)
    elseif n>=1e9 then return string.format("%.2fB",n/1e9)
    elseif n>=1e6 then return string.format("%.2fM",n/1e6)
    elseif n>=1e3 then return string.format("%.1fK",n/1e3) else return tostring(n) end
end
local function getEggTier(m)
    local t=m:GetAttribute("EggTier")
    if t==nil or t=="" then return "Unknown" end
    return tostring(t)
end
local function getSelectedRarityDisplay()
    if selectedRaritySet["All"] then return "All" end
    if not next(selectedRaritySet) then return "All" end
    local t={} for k,_ in pairs(selectedRaritySet) do table.insert(t,k) end
    return table.concat(t,", ")
end
local function isRarityAllowed(tier)
    if selectedRaritySet["All"] then return true end
    if not next(selectedRaritySet) then return true end
    return selectedRaritySet[tier]==true
end
local function ensureRarity(tier)
    tier=tostring(tier or "Unknown")
    if tier=="" then tier="Unknown" end
    if not raritySet[tier] then
        raritySet[tier]=true
        table.insert(rarityOptions, tier)
        if rarityDropdown then
            pcall(function()
                if rarityDropdown.Refresh then rarityDropdown:Refresh(rarityOptions)
                elseif rarityDropdown.SetOptions then rarityDropdown:SetOptions(rarityOptions) end
            end)
        end
        return true
    end
    return false
end

local function getHRP() local ch=LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait() return ch:WaitForChild("HumanoidRootPart") end
local function tpToPos(p) local h=getHRP() if h then h.CFrame=CFrame.new(p+Vector3.new(0,3,0)) end end
local function tweenToPos(p) local h=getHRP() if not h then return end if currentTween then pcall(function() currentTween:Cancel() end) end local dur=math.clamp((h.Position-p).Magnitude/tweenSpeed,0.15,8) currentTween=TweenService:Create(h,TweenInfo.new(dur,Enum.EasingStyle.Linear),{CFrame=CFrame.new(p)}) currentTween:Play() currentTween.Completed:Wait() end
local function getEggPos(m) local cf=nil pcall(function() cf=m:GetPivot() end) if cf then return cf.Position end if m.PrimaryPart then return m.PrimaryPart.Position end for _,v in ipairs(m:GetDescendants()) do if v:IsA("BasePart") then return v.Position end end return nil end
local function instantInteract(m) for _,v in ipairs(m:GetDescendants()) do if v:IsA("ProximityPrompt") then v.HoldDuration=0 pcall(function() if fireproximityprompt then fireproximityprompt(v) else v:InputHoldBegin() task.wait() v:InputHoldEnd() end end) end end end
local function spamInteract(m) local t=tick() while tick()-t<1 do if not m.Parent then break end instantInteract(m) task.wait(0.05) end end
local function getAllEggs() local list,seen={},{} local function add(m) if m and not seen[m] and m:GetAttribute("EggLuck")~=nil then seen[m]=true table.insert(list,m) end end local er=workspace:FindFirstChild("EggRuntime") if er then local w=er:FindFirstChild("WildEggs") if w then for _,m in ipairs(w:GetChildren()) do add(m) end end local k=er:FindFirstChild("KrakenBossRuntime") if k then add(k) for _,m in ipairs(k:GetChildren()) do add(m) end for _,m in ipairs(k:GetDescendants()) do if m:IsA("Model") then add(m) end end end end local kra=workspace:FindFirstChild("KrakenBossRuntime") if kra then add(kra) for _,m in ipairs(kra:GetChildren()) do add(m) end for _,m in ipairs(kra:GetDescendants()) do if m:IsA("Model") then add(m) end end end return list end
local function getFilteredEggs()
    local all=getAllEggs()
    local out={}
    for _,m in ipairs(all) do
        local luck=tonumber(m:GetAttribute("EggLuck")) or 0
        local tier=getEggTier(m)
        ensureRarity(tier)
        if luck>=minLuckFilter and isRarityAllowed(tier) then
            table.insert(out,m)
        end
    end
    return out
end
local function getRidingFish() local d=workspace:FindFirstChild(LocalPlayer.Name.."_RidingFish") if d then return d end for _,v in ipairs(workspace:GetChildren()) do if v.Name:lower():find("ridingfish") and v.Name:find(LocalPlayer.Name) then return v end end return nil end
local function setInvisible(v) local char=LocalPlayer.Character if not char then return end for _,p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") and p.Name~="HumanoidRootPart" then if v then origTrans[p]=p.Transparency p.Transparency=1 else if origTrans[p]~=nil then p.Transparency=origTrans[p] else p.Transparency=0 end end end end end
local function createClone(cf) local char=LocalPlayer.Character if not char then return nil end char.Archivable=true local cl=char:Clone() for _,v in ipairs(cl:GetDescendants()) do if v:IsA("Script") or v:IsA("LocalScript") then v:Destroy() end if v:IsA("BasePart") then v.Anchored=true v.CanCollide=false end end cl.Parent=workspace pcall(function() cl:PivotTo(cf) end) return cl end
local function saveCam() local cam=workspace.CurrentCamera savedCam.Subject=cam.CameraSubject savedCam.Type=cam.CameraType savedCam.CFrame=cam.CFrame end
local function lockCamToClone(cl) local cam=workspace.CurrentCamera local hum=cl:FindFirstChildOfClass("Humanoid") if hum then cam.CameraSubject=hum else cam.CameraType=Enum.CameraType.Scriptable cam.CFrame=savedCam.CFrame end end
local function restoreCam() local cam=workspace.CurrentCamera if savedCam.Subject then cam.CameraSubject=savedCam.Subject end if savedCam.Type then cam.CameraType=savedCam.Type end end
local function fireStoreLoop() local req=ReplicatedStorage:FindFirstChild("EggGame") and ReplicatedStorage.EggGame:FindFirstChild("Requests") if not req then return end if isCollecting then local s=tick() while isCollecting and tick()-s<2.2 do pcall(function() req:FireServer("StoreEgg") end) task.wait(0.1) end else for i=1,10 do pcall(function() req:FireServer("StoreEgg") end) task.wait(0.1) end end end
local function doSteal(model) if not model or not model.Parent then return end local eggPos=getEggPos(model) if not eggPos then return end local stayCF=nil if useSilentMethod then saveCam() stayCF=getHRP() and getHRP().CFrame or CFrame.new(BASE_POS) cloneModel=createClone(stayCF) lockCamToClone(cloneModel) setInvisible(true) end tpToPos(eggPos) task.wait(0.25) spamInteract(model) task.wait(0.15) tweenToPos(BASE_POS) task.wait(0.2) fireStoreLoop() if useSilentMethod and stayCF then tweenToPos(stayCF.Position) task.wait(0.15) setInvisible(false) restoreCam() if cloneModel then cloneModel:Destroy() cloneModel=nil end end end

-- ESP (tetap pakai BillboardGui bawaan Roblox)
local function removeEggEsp(m) if m:FindFirstChild("EggVault_ESP") then m:FindFirstChild("EggVault_ESP"):Destroy() end if m:FindFirstChild("EggVault_HL") then m:FindFirstChild("EggVault_HL"):Destroy() end end
local function clearAllEsp() for _,m in ipairs(getAllEggs()) do removeEggEsp(m) end end
local function createEggEsp(m,luck,kg)
    if m:FindFirstChild("EggVault_ESP") then removeEggEsp(m) end
    local tier=getEggTier(m)
    local bb=NI("BillboardGui") bb.Name="EggVault_ESP" bb.Size=UDim2.fromOffset(160,58) bb.StudsOffset=Vector3.new(0,4.5,0) bb.AlwaysOnTop=true bb.Parent=m
    local main=NI("Frame") main.Size=UDim2.fromScale(1,1) main.BackgroundColor3=Color3.fromRGB(16,14,28) main.BorderSizePixel=0 main.Parent=bb
    local c=NI("UICorner") c.CornerRadius=UDim.new(0,12) c.Parent=main
    local st=NI("UIStroke") st.Color=Color3.fromRGB(68,61,106) st.Thickness=1 st.Transparency=0.25 st.Parent=main
    local top=NI("Frame") top.Size=UDim2.new(1,0,0,2) top.BackgroundColor3=Color3.new(1,1,1) top.BorderSizePixel=0 top.Parent=main
    local tg=NI("UIGradient") tg.Color=ColorSequence.new(ACCENT,CYAN) tg.Parent=top
    local luckL=NI("TextLabel") luckL.Text="🍀 "..formatCompact(luck).." ["..tier.."]" luckL.Font=Enum.Font.GothamBold luckL.TextSize=11 luckL.TextColor3=Color3.fromRGB(246,244,255) luckL.BackgroundTransparency=1 luckL.Size=UDim2.new(1,0,0.5,0) luckL.Parent=main
    local kgL=NI("TextLabel") kgL.Text="⚖️ "..tostring(kg).." Kg • "..formatCompact(luck) kgL.Font=Enum.Font.GothamMedium kgL.TextSize=10 kgL.TextColor3=Color3.fromRGB(150,142,186) kgL.BackgroundTransparency=1 kgL.Position=UDim2.new(0,0,0.5,0) kgL.Size=UDim2.new(1,0,0.5,0) kgL.Parent=main
    local hl=NI("Highlight") hl.Name="EggVault_HL" hl.FillColor=ACCENT hl.FillTransparency=0.75 hl.OutlineColor=CYAN hl.OutlineTransparency=0.1 hl.Adornee=m hl.Parent=m
end
local function refreshEsp()
    if not isEspEggEnabled then clearAllEsp() return end
    for _,m in ipairs(getAllEggs()) do
        local luck=tonumber(m:GetAttribute("EggLuck")) or 0
        local tier=getEggTier(m)
        ensureRarity(tier)
        if luck>=minLuckFilter and isRarityAllowed(tier) then
            local kg=tonumber(m:GetAttribute("EggKg")) or 0
            createEggEsp(m,luck,kg)
        else
            removeEggEsp(m)
        end
    end
end

-- === PANEL BARU BAWAAN LIB ===
local function refreshLibPanel()
    if not eggListAcc then return end
    -- hapus tombol lama (bawaan lib)
    for _,btn in ipairs(eggButtons) do
        pcall(function()
            if btn.Parent and btn.Parent.Name=="Holder" then
                btn.Parent:Destroy()
            else
                btn:Destroy()
            end
        end)
    end
    eggButtons = {}

    local eggs=getFilteredEggs()
    table.sort(eggs,function(a,b)
        local la,lb=tonumber(a:GetAttribute("EggLuck")) or 0, tonumber(b:GetAttribute("EggLuck")) or 0
        if la~=lb then return la>lb end
        local wa,wb=tonumber(a:GetAttribute("EggKg")) or 0, tonumber(b:GetAttribute("EggKg")) or 0
        return wa>wb
    end)

    -- update stats paragraph
    if eggStatsPara then
        local best = #eggs>0 and formatCompact(tonumber(eggs[1]:GetAttribute("EggLuck")) or 0) or "0"
        eggStatsPara:Set("🥚 EGG VAULT - "..#eggs.." Egg", "Filter: ≥ "..formatCompact(minLuckFilter).." | "..getSelectedRarityDisplay().." | Best: "..best)
    end

    if #eggs==0 then
        local b = eggListAcc:Button({
            Title="Tidak ada egg sesuai filter",
            Desc="Coba turunin Min Luck atau ubah Rarity ke All",
            Callback=function() Window.Notify("Egg Vault","Gak ada egg yang lolos filter",Color3.fromRGB(248,113,113),1.5) end
        })
        table.insert(eggButtons,b)
        return
    end

    for _,egg in ipairs(eggs) do
        local luck=tonumber(egg:GetAttribute("EggLuck")) or 0
        local kg=egg:GetAttribute("EggKg") or 0
        local tier=getEggTier(egg)
        local b = eggListAcc:Button({
            Title=egg.Name.." ["..tier.."] 🍀 "..formatCompact(luck),
            Desc="⚖️ "..tostring(kg).." Kg | Luck "..formatCompact(luck).." | Tap untuk SILENT STEAL",
            Callback=function()
                task.spawn(function() doSteal(egg) end)
            end
        })
        table.insert(eggButtons,b)
    end
end

