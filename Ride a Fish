local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

local tweenSpeed = 120
local isCollecting, isBestLuck, useSilentMethod, isPanelShow = false, true, true, false
local currentTween, panelGui, mainPanel, scrollFrame, statTotal, statBest
local BASE_POS = Vector3.new(270.9, 4.2, -31.6)
local ACCENT, CYAN = Color3.fromRGB(145,96,255), Color3.fromRGB(56,200,255)
local cloneModel, savedCam = nil, {}
local origTrans = {}

local function NI(c) return Instance.new(c) end
local function getHRP() local ch=LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait() return ch:WaitForChild("HumanoidRootPart") end
local function tpToEgg(p) local h=getHRP() if h then h.CFrame=CFrame.new(p+Vector3.new(0,3,0)) end end
local function tweenToPos(p) local h=getHRP() if not h then return end if currentTween then pcall(function() currentTween:Cancel() end) end local dur=math.clamp((h.Position-p).Magnitude/tweenSpeed,0.15,8) currentTween=TweenService:Create(h,TweenInfo.new(dur,Enum.EasingStyle.Linear),{CFrame=CFrame.new(p)}) currentTween:Play() currentTween.Completed:Wait() end
local function getEggPos(m) local cf=nil pcall(function() cf=m:GetPivot() end) if cf then return cf.Position end if m.PrimaryPart then return m.PrimaryPart.Position end for _,v in ipairs(m:GetDescendants()) do if v:IsA("BasePart") then return v.Position end end return nil end
local function instantInteract(m) for _,v in ipairs(m:GetDescendants()) do if v:IsA("ProximityPrompt") then v.HoldDuration=0 pcall(function() if fireproximityprompt then fireproximityprompt(v) else v:InputHoldBegin() task.wait() v:InputHoldEnd() end end) end end end
local function spamInteract(m) local t=tick() while tick()-t<1 do if not m.Parent then break end instantInteract(m) task.wait(0.05) end end
local function getAllEggs()
    local list,seen={},{} local function add(m) if m and not seen[m] and m:GetAttribute("EggLuck")~=nil then seen[m]=true table.insert(list,m) end end
    local er=workspace:FindFirstChild("EggRuntime") if er then local w=er:FindFirstChild("WildEggs") if w then for _,m in ipairs(w:GetChildren()) do add(m) end end local k=er:FindFirstChild("KrakenBossRuntime") if k then add(k) for _,m in ipairs(k:GetChildren()) do add(m) end for _,m in ipairs(k:GetDescendants()) do if m:IsA("Model") then add(m) end end end end
    local kra=workspace:FindFirstChild("KrakenBossRuntime") if kra then add(kra) for _,m in ipairs(kra:GetChildren()) do add(m) end for _,m in ipairs(kra:GetDescendants()) do if m:IsA("Model") then add(m) end end end
    return list
end

-- SILENT METHOD
local function setInvisible(v) local char=LocalPlayer.Character if not char then return end for _,p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") and p.Name~="HumanoidRootPart" then if v then origTrans[p]=p.Transparency p.Transparency=1 else if origTrans[p]~=nil then p.Transparency=origTrans[p] else p.Transparency=0 end end end end end
local function createClone(cf) local char=LocalPlayer.Character if not char then return nil end char.Archivable=true local cl=char:Clone() for _,v in ipairs(cl:GetDescendants()) do if v:IsA("Script") or v:IsA("LocalScript") then v:Destroy() end if v:IsA("BasePart") then v.Anchored=true v.CanCollide=false end end cl.Parent=workspace pcall(function() cl:PivotTo(cf) end) return cl end
local function saveCam() local cam=workspace.CurrentCamera savedCam.Subject=cam.CameraSubject savedCam.Type=cam.CameraType savedCam.CFrame=cam.CFrame end
local function lockCamToClone(cl) local cam=workspace.CurrentCamera local hum=cl:FindFirstChildOfClass("Humanoid") if hum then cam.CameraSubject=hum else cam.CameraType=Enum.CameraType.Scriptable cam.CFrame=savedCam.CFrame end end
local function restoreCam() local cam=workspace.CurrentCamera if savedCam.Subject then cam.CameraSubject=savedCam.Subject end if savedCam.Type then cam.CameraType=savedCam.Type end end
local function fireStoreLoop() local req=ReplicatedStorage:FindFirstChild("EggGame") and ReplicatedStorage.EggGame:FindFirstChild("Requests") if not req then return end if isCollecting then local s=tick() while isCollecting and tick()-s<2.2 do pcall(function() req:FireServer("StoreEgg") end) task.wait(0.1) end else for i=1,10 do pcall(function() req:FireServer("StoreEgg") end) task.wait(0.1) end end end
local function doSteal(model) if not model or not model.Parent then return end local eggPos=getEggPos(model) if not eggPos then return end local stayCF=nil if useSilentMethod then saveCam() stayCF=getHRP() and getHRP().CFrame or CFrame.new(BASE_POS) cloneModel=createClone(stayCF) lockCamToClone(cloneModel) setInvisible(true) end tpToEgg(eggPos) task.wait(0.25) spamInteract(model) task.wait(0.15) tweenToPos(BASE_POS) task.wait(0.2) fireStoreLoop() if useSilentMethod and stayCF then tweenToPos(stayCF.Position) task.wait(0.15) setInvisible(false) restoreCam() if cloneModel then cloneModel:Destroy() cloneModel=nil end end end

-- PANEL 5X COOL + DPI SCALE
local function makeDraggable(f,h) local drag,sPos,sIn h.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=true sIn=i.Position sPos=f.Position end end) h.InputEnded:Connect(function() drag=false end) UIS.InputChanged:Connect(function(i) if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then local d=i.Position-sIn f.Position=UDim2.new(sPos.X.Scale,sPos.X.Offset+d.X,sPos.Y.Scale,sPos.Y.Offset+d.Y) end end) end
local function makeResizable(f,g) local res,sIn,sSz,vp g.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then res=true sIn=i.Position sSz=f.Size vp=workspace.CurrentCamera.ViewportSize end end) UIS.InputChanged:Connect(function(i) if res and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then local d=i.Position-sIn local nx=math.clamp(sSz.X.Scale+d.X/vp.X,0.24,0.55) local ny=math.clamp(sSz.Y.Scale+d.Y/vp.Y,0.35,0.85) f.Size=UDim2.fromScale(nx,ny) end end) UIS.InputEnded:Connect(function() res=false end) end

local function createPanelUI()
    if panelGui then panelGui:Destroy() end
