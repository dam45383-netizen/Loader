local eggButtons={}

function refreshLibPanel()
    for _,b in ipairs(eggButtons) do pcall(function() if b.Parent and b.Parent.Name=="Holder" then b.Parent:Destroy() else b:Destroy() end end) end
    eggButtons={}
    local eggs=getFilteredEggs()
    table.sort(eggs,function(a,b) local la,lb=tonumber(a:GetAttribute("EggLuck")) or 0, tonumber(b:GetAttribute("EggLuck")) or 0 if la~=lb then return la>lb end return (tonumber(a:GetAttribute("EggKg")) or 0) > (tonumber(b:GetAttribute("EggKg")) or 0) end)
    if eggStatsPara then eggStatsPara:Set("🥚 EGG VAULT - "..#eggs.." Egg", "Filter: ≥ "..formatCompact(minLuckFilter).." | "..getSelectedRarityDisplay().." | Best: "..(#eggs>0 and formatCompact(tonumber(eggs[1]:GetAttribute("EggLuck")) or 0) or "0")) end
    if #eggs==0 then
        local b=EggPanel:Button({Title="Gak ada egg", Desc="Filter kelonggaran dikit", Callback=function() end})
        table.insert(eggButtons,b) return
    end
    for _,egg in ipairs(eggs) do
        local luck=tonumber(egg:GetAttribute("EggLuck")) or 0
        local kg=egg:GetAttribute("EggKg") or 0
        local tier=getEggTier(egg)
        local b=EggPanel:Button({
            Title=egg.Name.." ["..tier.."] 🍀 "..formatCompact(luck),
            Desc="⚖️ "..tostring(kg).." Kg | Tap = SILENT STEAL",
            Callback=function() task.spawn(function() doSteal(egg) end) end
        })
        table.insert(eggButtons,b)
    end
end

