local StatsAcc=MiscTab:Accordion({Title="Stats", Desc=" ", Open=true})
StatsAcc:Toggle({Title="Show FPS & Ping", Desc="Dragcable style lib", Flag="ShowStats", Default=false, Callback=function(v) isStatsShow=v if v then createStatsPanel() Window.Notify("Stats","ON",CYAN,1) else if statsGui then statsGui:Destroy() statsGui=nil end end end})

local TeleportTab=Window:Tab({Title="Teleport", Icon="T"})
local IslandAcc=TeleportTab:Accordion({Title="Island", Desc="Include KingKalolo - Safe", Open=true})
IslandAcc:Dropdown({Title="Select Island", Desc="Pilih tujuan - Auto detect", Flag="IslandDropdown", Options={"Base","Kraken","KingKalolo"}, Default="Base", Callback=function(val) selectedIsland=val Window.Notify("Teleport","Selected: "..val,ACCENT,1) end})
IslandAcc:Button({Title="TP to Selected", Desc="Teleport ke island terpilih", Callback=function() local pos=islandPositions[selectedIsland] or BASE_POS Window.Notify("Teleport","TP ke "..selectedIsland, CYAN,1) tweenToPos(pos) end})
IslandAcc:Button({Title="TP to KingKalolo (SAFE)", Desc="Pakai keyword kalolo", Callback=function() local pos=resolveRuntimePos("kalolo") or islandPositions.KingKalolo Window.Notify("Teleport","TP ke KingKalolo", CYAN,1) tweenToPos(pos) end})
IslandAcc:Button({Title="DEBUG Scan Name", Desc="Cek F9 console nama asli runtime", Callback=function() local found={} for _,v in ipairs(workspace:GetDescendants()) do if v.Name:lower():find("kalolo") or v.Name:lower():find("kraken") then table.insert(found, v:GetFullName().." ["..v.ClassName.."]") end end print("=== SCAN RUNTIME ===") for i,n in ipairs(found) do print(i..". "..n) end Window.Notify("Debug","Found "..#found.." - cek F9", ACCENT, 2) end})

local TokenTab=Window:Tab({Title="Token", Icon="T"})
local TokenAcc=TokenTab:Accordion({Title="Auto Collect Token", Desc="Farm ActiveTokens", Open=true})
TokenAcc:Toggle({Title="Auto Token",Desc="Auto teleport ke token (speed slider)",Flag="AutoToken",Default=false,Callback=function(s) isCollectingToken=s if s then Window.Notify("Auto Token","ON",CYAN,1.5) task.spawn(function() while isCollectingToken do pcall(function() local folder=workspace:FindFirstChild("ActiveTokens") if not folder then task.wait(1) return end local all=getAllTokens() if #all==0 then task.wait(1) return end local hrp=getHRP() table.sort(all, function(a,b) local pa=getTokenPos(a) local pb=getTokenPos(b) if not pa or not pb or not hrp then return false end return (hrp.Position-pa).Magnitude < (hrp.Position-pb).Magnitude end) for _,tok in ipairs(all) do if not isCollectingToken then break end if tok.Parent then doCollectToken(tok) task.wait(0.22) end end end) task.wait(0.3) end end) else Window.Notify("Auto Token","OFF",Color3.fromRGB(248,113,113),1) end end})
TokenAcc:Button({Title="Collect Nearest Token Once",Desc="Teleport ke token terdekat 1x",Callback=function() local all=getAllTokens() if #all==0 then Window.Notify("Token","Ga ada token",Color3.fromRGB(248,113,113),1) return end local hrp=getHRP() local best,closest=nil,math.huge for _,m in ipairs(all) do local p=getTokenPos(m) if p and hrp then local d=(hrp.Position-p).Magnitude if d<closest then closest=d best=m end end end if best then doCollectToken(best) end end})
TokenAcc:Button({Title="Check Token Count",Desc="Lihat berapa token tersedia",Callback=function() local c=#getAllTokens() Window.Notify("Token Count","Ada "..c.." token",ACCENT,1.5) end})

local PumpkinTab=Window:Tab({Title="Pumpkin", Icon="P"})
local PumpkinAcc=PumpkinTab:Accordion({Title="Auto Collect Pumpkin", Desc="Farm ActivePumpkins", Open=true})
PumpkinAcc:Toggle({Title="Auto Pumpkin",Desc="Auto tween ke pumpkin sesuai speed slider",Flag="AutoPumpkin",Default=false,Callback=function(s) isCollectingPumpkin=s if s then Window.Notify("Auto Pumpkin","ON - Speed: "..tweenSpeed,CYAN,1.5) task.spawn(function() while isCollectingPumpkin do pcall(function() local folder=workspace:FindFirstChild("ActivePumpkins") if not folder then task.wait(1) return end local all=getAllPumpkins() if #all==0 then task.wait(1) return end local hrp=getHRP() table.sort(all, function(a,b) local pa=getPumpkinPos(a) local pb=getPumpkinPos(b) if not pa or not pb or not hrp then return false end return (hrp.Position-pa).Magnitude < (hrp.Position-pb).Magnitude end) for _,pump in ipairs(all) do if not isCollectingPumpkin then break end if pump.Parent then doCollectPumpkin(pump) task.wait(0.22) end end end) task.wait(0.3) end end) else Window.Notify("Auto Pumpkin","OFF",Color3.fromRGB(248,113,113),1) end end})
PumpkinAcc:Button({Title="Collect Nearest Pumpkin Once",Desc="Tween ke pumpkin terdekat 1x",Callback=function() local all=getAllPumpkins() if #all==0 then Window.Notify("Pumpkin","Ga ada pumpkin",Color3.fromRGB(248,113,113),1) return end local hrp=getHRP() local best,closest=nil,math.huge for _,m in ipairs(all) do local p=getPumpkinPos(m) if p and hrp then local d=(hrp.Position-p).Magnitude if d<closest then closest=d best=m end end end if best then doCollectPumpkin(best) end end})
PumpkinAcc:Button({Title="Check Pumpkin Count",Desc="Lihat berapa pumpkin tersedia",Callback=function() local c=#getAllPumpkins() Window.Notify("Pumpkin Count","Ada "..c.." pumpkin",ACCENT,1.5) end})

