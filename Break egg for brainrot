local Window = getgenv().SORU_Window
if not Window then return end

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PathfindingService = game:GetService("PathfindingService")
local LP = Players.LocalPlayer

local UUID_PATTERN = "%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x"
local HIT_TOKEN = "e3c6f1c2-3d6f-4ed3-a164-1e5c4aa5053b"

local function GetEggId(model)
    if model.Name:match(UUID_PATTERN) then return model.Name end
    for _,k in ipairs({"EggId","Id","UUID"}) do
        local a = model:GetAttribute(k)
        if a and tostring(a):match(UUID_PATTERN) then return tostring(a) end
    end
    for _,v in ipairs(model:GetDescendants()) do
        if v:IsA("ValueBase") and tostring(v.Value):match(UUID_PATTERN) then return tostring(v.Value) end
    end
    return nil
end

local function GetPos(model)
    local ok, cf = pcall(function() return model:GetPivot() end)
    if ok then return cf.Position end
    local p = model:FindFirstChildWhichIsA("BasePart", true)
    if p then return p.Position end
    return nil
end

local function WalkTo(targetPos, checkEnabled)
    local char = LP.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return false end

    local path = PathfindingService:CreatePath({AgentRadius=2, AgentHeight=5, AgentCanJump=true})
    local success = pcall(function() path:ComputeAsync(hrp.Position, targetPos) end)

    if success and path.Status == Enum.PathStatus.Success then
        for _, wp in ipairs(path:GetWaypoints()) do
            if checkEnabled and not checkEnabled() then return false end
            if not char.Parent then return false end
            hum:MoveTo(wp.Position)
            if wp.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
            local t0 = tick()
            repeat task.wait(0.1) until (hrp.Position - wp.Position).Magnitude <= 3 or (tick()-t0) > 10 or (checkEnabled and not checkEnabled())
        end
        return true
    else
        hum:MoveTo(targetPos)
        local finished = false
        local conn = hum.MoveToFinished:Connect(function() finished = true end)
        local t0 = tick()
        repeat task.wait(0.1) until finished or (tick()-t0) > 15 or (checkEnabled and not checkEnabled())
        if conn then conn:Disconnect() end
        return finished
    end
end

--================ BREAK TAB ================--
local BreakTab = Window:Tab({Title = "Break", Icon = "💥"})

local StudsRadius = 100
local FastBreakEnabled = false
local FastAcc = BreakTab:Accordion({Title = "Fast Break", Desc = "", Open = false})
FastAcc:Slider({Title = "Studs Radius", Flag = "Break_Studs", Min = 10, Max = 1000, Step = 5, Default = 100, Suffix = " studs", Callback = function(v) StudsRadius = v end})
FastAcc:Toggle({Title = "Fast Break (Instant)", Flag = "FastBreak_Toggle", Default = false, Callback = function(v)
    FastBreakEnabled = v
    if v then task.spawn(function()
        local RF = ReplicatedStorage.Packages.Knit.Services.EggSpawnerService.RF.RequestHitEgg
        while FastBreakEnabled do
            local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            local folder = Workspace:FindFirstChild("EggRenderModels")
            if hrp and folder then
                for _,model in ipairs(folder:GetChildren()) do
                    if not FastBreakEnabled then break end
                    if not model:IsA("Model") then continue end
                    local pos = GetPos(model)
                    if pos and (pos - hrp.Position).Magnitude <= StudsRadius then
                        local id = GetEggId(model)
                        if id then pcall(function() RF:InvokeServer({id, HIT_TOKEN}) end) task.wait(0.01) end
                    end
                end
            end
            task.wait(0.01)
        end
    end) end
end})

local AutoBreakStuds = 100
local AutoBreakEnabled = false
local AutoBreakAcc = BreakTab:Accordion({Title = "Auto Break Egg", Desc = "", Open = true})
AutoBreakAcc:Slider({Title = "Studs Radius", Flag = "AutoBreak_Studs", Min = 10, Max = 1000, Step = 5, Default = 100, Suffix = " studs", Callback = function(v) AutoBreakStuds = v end})
AutoBreakAcc:Toggle({Title = "Auto Break Egg (Walk)", Flag = "AutoBreak_Walk_Toggle", Default = false, Callback = function(v)
    AutoBreakEnabled = v
    if v then task.spawn(function()
        local RF = ReplicatedStorage.Packages.Knit.Services.EggSpawnerService.RF.RequestHitEgg
        while AutoBreakEnabled do
            local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            local folder = Workspace:FindFirstChild("EggRenderModels")
            if not hrp or not folder then task.wait(0.5) continue end
            local nearest, nearestId, nearestDist = nil, nil, math.huge
            for _,model in ipairs(folder:GetChildren()) do
                if not model:IsA("Model") then continue end
                local pos = GetPos(model)
                if not pos then continue end
                local dist = (pos - hrp.Position).Magnitude
                if dist <= AutoBreakStuds and dist < nearestDist then
                    local id = GetEggId(model)
                    if id then nearest=model nearestId=id nearestDist=dist end
                end
            end
            if nearest and nearestId then
                local pos = GetPos(nearest)
                if pos then
                    WalkTo(pos + Vector3.new(0,0,2), function() return AutoBreakEnabled end)
                    for i=1,10 do
                        if not AutoBreakEnabled or not nearest.Parent then break end
                        pcall(function() RF:InvokeServer({nearestId, HIT_TOKEN}) end)
                        task.wait(0.08)
                    end
                end
            else task.wait(0.5) end
            task.wait(0.1)
        end
    end) end
end})

--================ BRAINROT TAB ================--
local BrainrotsFolder = Workspace:WaitForChild("Brainrots", 20)
local BasePos = Vector3.new(-54.5, 3.0, -71.1)
local AutoSteal = false
local SelectedRarities = {}
local RaritySet = {}

local function GetRarity(obj)
    return obj and (obj:GetAttribute("Rarity") or obj:GetAttribute("EggId") or obj:GetAttribute("Tier"))
end

local BrainrotTab = Window:Tab({Title = "Brainrot", Icon = "🧠"})
local StealAcc = BrainrotTab:Accordion({Title = "Auto Steal Brainrot", Desc = "", Open = true})

local RarityDropdown = StealAcc:Dropdown({
    Title = "Filter Rarity",
    Flag = "Brainrot_Rarity_Filter",
    Options = {"Scanning..."},
    Multi = true,
    Default = {},
    Callback = function(val) SelectedRarities = typeof(val)=="table" and val or {val} end
})

local function RefreshRarityList()
    local changed = false
    for _,inst in ipairs(BrainrotsFolder:GetDescendants()) do
        local r = GetRarity(inst)
        if r and type(r)=="string" and r~="" and not RaritySet[r] then RaritySet[r]=true changed=true end
    end
    if changed then
        local list = {}
        for k in pairs(RaritySet) do table.insert(list, k) end
        table.sort(list)
        RarityDropdown:Refresh(list)
    end
end
task.spawn(function() while true do pcall(RefreshRarityList) task.wait(2) end end)

StealAcc:Toggle({
    Title = "Auto Steal",
    Flag = "AutoSteal_Walk_Toggle",
    Default = false,
    Callback = function(v)
        AutoSteal = v
        if v then task.spawn(function()
            while AutoSteal do
                pcall(function()
                    if #SelectedRarities == 0 then task.wait(1) return end
                    local char = LP.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if not hrp then task.wait(0.5) return end
                    local target, targetPos = nil, nil
                    for _,obj in ipairs(BrainrotsFolder:GetChildren()) do
                        local r = GetRarity(obj)
                        if not r then local bp = obj:FindFirstChildWhichIsA("BasePart", true) r = bp and GetRarity(bp) end
                        if r and table.find(SelectedRarities, r) then
                            local pos = GetPos(obj)
                            if pos then target=obj targetPos=pos break end
                        end
                    end
                    if target and targetPos then
                        WalkTo(targetPos + Vector3.new(0,0,2), function() return AutoSteal end)
                        task.wait(0.2)
                        local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt then
                            prompt.RequiresLineOfSight = false
                            prompt.MaxActivationDistance = 100
                            local done = false
                            local conn = prompt.Triggered:Connect(function() done = true end)
                            pcall(function() prompt:InputHoldBegin() end)
                            pcall(function() fireproximityprompt(prompt) end)
                            local t0 = tick()
                            repeat task.wait(0.1) until done or (tick()-t0) > (prompt.HoldDuration + 4) or not AutoSteal
                            pcall(function() prompt:InputHoldEnd() end)
                            conn:Disconnect()
                        else task.wait(2) end
                        task.wait(0.3)
                        WalkTo(BasePos, function() return AutoSteal end)
                        task.wait(1)
                    else task.wait(0.5) end
                end)
                task.wait(0.2)
            end
        end) end
    end
})
