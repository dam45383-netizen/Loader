local function getESP(model)
    if espCache[model] then return espCache[model] end
    if not Drawing then return nil end
    local o = {}
    o.box = Drawing.new("Square") o.box.Filled = false o.box.Thickness = 1.5 o.box.Color = Color3.fromRGB(255, 0, 0) o.box.Visible = false
    o.name = Drawing.new("Text") o.name.Center = true o.name.Outline = true o.name.Size = 13 o.name.Color = Color3.fromRGB(255, 255, 255) o.name.Visible = false
    o.dist = Drawing.new("Text") o.dist.Center = true o.dist.Outline = true o.dist.Size = 12 o.dist.Color = Color3.fromRGB(255, 255, 0) o.dist.Visible = false
    o.hpBarBg = Drawing.new("Line") o.hpBarBg.Thickness = 3 o.hpBarBg.Color = Color3.fromRGB(0, 0, 0) o.hpBarBg.Visible = false
    o.hpBar = Drawing.new("Line") o.hpBar.Thickness = 3 o.hpBar.Color = Color3.fromRGB(0, 255, 0) o.hpBar.Visible = false
    o.hpText = Drawing.new("Text") o.hpText.Center = true o.hpText.Outline = true o.hpText.Size = 11 o.hpText.Color = Color3.fromRGB(0, 255, 0) o.hpText.Visible = false
    o.tracer = Drawing.new("Line") o.tracer.Thickness = 1 o.tracer.Color = Color3.fromRGB(255, 0, 0) o.tracer.Transparency = 0.5 o.tracer.Visible = false
    espCache[model] = o
    return o
end
local function hideESP(o)
    if not o then return end
    o.box.Visible = false o.name.Visible = false o.dist.Visible = false o.hpBarBg.Visible = false o.hpBar.Visible = false o.hpText.Visible = false o.tracer.Visible = false
end

RunService.RenderStepped:Connect(function()
    local cam = workspace.CurrentCamera
    if not cam then return end
    local vSize = cam.ViewportSize
    local center = Vector2.new(vSize.X / 2, vSize.Y / 2)
    if FOVCircle then FOVCircle.Position = center FOVCircle.Radius = FOV FOVCircle.Transparency = FOVTransparan FOVCircle.Visible = ShowFOVCircle and AimbotEnabled end
    if FOVGuiCircle then FOVGuiCircle.Size = UDim2.new(0, FOV * 2, 0, FOV * 2) FOVGuiCircle.Visible = ShowFOVCircle and AimbotEnabled end

    if AimbotEnabled and tick() - lastUpdate >= 0.05 then
        lastUpdate = tick()
        CurrentTarget = getClosestTarget()
    end
    if not AimbotEnabled then CurrentTarget = nil end
    if ShowOutline and CurrentTarget then
        if lastOutlineTarget ~= CurrentTarget then Outline.Adornee = CurrentTarget Outline.Enabled = true lastOutlineTarget = CurrentTarget end
    else
        if Outline.Enabled then Outline.Enabled = false lastOutlineTarget = nil end
    end

    if not ESPEnabled then for _, o in pairs(espCache) do hideESP(o) end return end
    local myTeam = getLocalTeam()
    local camPos = cam.CFrame.Position
    local ent = getEntitiesFolder()
    if not ent then return end
    for model, o in pairs(espCache) do if not model.Parent then hideESP(o) espCache[model] = nil end end
    for _, model in ipairs(ent:GetChildren()) do
        if model:IsA("Model") and model.Name ~= LocalPlayer.Name then
            local hum = model:FindFirstChildOfClass("Humanoid")
            local hrp = model:FindFirstChild("HumanoidRootPart")
            local head = model:FindFirstChild("Head")
            local o = getESP(model)
            if not hum or hum.Health <= 0 or not hrp or not head then hideESP(o) continue end
            if ESPTeamCheck and myTeam ~= nil and model:GetAttribute("Team") == myTeam then hideESP(o) continue end
            local dist = (hrp.Position - camPos).Magnitude
            if dist > ESPMaxDist then hideESP(o) continue end
            local headPos, onHead = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
            local footPos, onFoot = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
            if not onHead or not onFoot or headPos.Z <= 0 or footPos.Z <= 0 then hideESP(o) continue end
            local height = math.abs(footPos.Y - headPos.Y)
            local width = height * 0.7
            local isEnemy = myTeam == nil or model:GetAttribute("Team") ~= myTeam
            local col = isEnemy and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 0)
            if ESPBox then o.box.Size = Vector2.new(width, height) o.box.Position = Vector2.new(headPos.X - width / 2, headPos.Y) o.box.Color = col o.box.Visible = true else o.box.Visible = false end
            if ESPName then o.name.Text = model.Name o.name.Position = Vector2.new(headPos.X, headPos.Y - 16) o.name.Visible = true else o.name.Visible = false end
            if ESPDistance then o.dist.Text = math.floor(dist) .. "m" o.dist.Position = Vector2.new(headPos.X, footPos.Y + 2) o.dist.Visible = true else o.dist.Visible = false end
            if ESPHealth then
                local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                local hpCol = pct > 0.5 and Color3.fromRGB(0, 255, 0) or (pct > 0.25 and Color3.fromRGB(255, 255, 0) or Color3.fromRGB(255, 0, 0))
                local barTop = Vector2.new(headPos.X - width / 2 - 6, headPos.Y)
                local barBot = Vector2.new(headPos.X - width / 2 - 6, footPos.Y)
                o.hpBarBg.From = barTop o.hpBarBg.To = barBot o.hpBarBg.Visible = true
                o.hpBar.From = barBot o.hpBar.To = barBot:Lerp(barTop, pct) o.hpBar.Color = hpCol o.hpBar.Visible = true
                o.hpText.Text = math.floor(hum.Health) .. "" o.hpText.Position = Vector2.new(headPos.X - width / 2 - 14, (barTop.Y + barBot.Y) / 2) o.hpText.Color = hpCol o.hpText.Visible = true
            else o.hpBarBg.Visible = false o.hpBar.Visible = false o.hpText.Visible = false end
            if ESPTracer then o.tracer.From = Vector2.new(vSize.X / 2, vSize.Y) o.tracer.To = Vector2.new(headPos.X, footPos.Y) o.tracer.Color = col o.tracer.Visible = true else o.tracer.Visible = false end
        end
    end
end)

