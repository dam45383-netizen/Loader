local function findShootButton()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local c = pg:FindFirstChild("ControllerGUI")
    if not c then return nil end
    local m = c:FindFirstChild("MobileButtons")
    if not m then return nil end
    return m:FindFirstChild("Shoot")
end

local function bindShootButton(btn)
    if not btn or btn:GetAttribute("AimbotBound") then return end
    btn:SetAttribute("AimbotBound", true)
    btn.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then ShootHeld = true end end)
    btn.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then ShootHeld = false end end)
    btn.InputChanged:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch then ShootHeld = true end end)
end

task.spawn(function() while true do local b = findShootButton() if b then bindShootButton(b) end task.wait(1) end end)

UIS.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        local btn = findShootButton()
        if btn then
            local p = input.Position
            local ap = btn.AbsolutePosition
            local as = btn.AbsoluteSize
            if p.X >= ap.X and p.X <= ap.X + as.X and p.Y >= ap.Y and p.Y <= ap.Y + as.Y then ShootHeld = true end
        end
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then ShootHeld = false end
end)

