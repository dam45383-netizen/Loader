local function getEntitiesFolder()
    local e = workspace:FindFirstChild("Entities")
    if e then return e end
    local maps = workspace:FindFirstChild("Maps")
    if maps then local h = maps:FindFirstChild("HorizontalSmoothTracking") if h then local t = h:FindFirstChild("Targets") if t then return t end end end
    return nil
end

local function getLocalTeam()
    if tick() - myTeamCacheTime < 1 and myTeamCache ~= nil then return myTeamCache end
    local ent = getEntitiesFolder()
    if ent then local me = ent:FindFirstChild(LocalPlayer.Name) if me then local t = me:GetAttribute("Team") if t ~= nil then myTeamCache = t myTeamCacheTime = tick() return t end end end
    myTeamCache = LocalPlayer:GetAttribute("Team")
    myTeamCacheTime = tick()
    return myTeamCache
end

local function getAimPart(model)
    local key = tostring(model) .. "_" .. TargetPart
    local cached = partCache[key]
    if cached and cached.Parent then return cached end
    local part = nil
    if TargetPart == "Head" then
        part = model:FindFirstChild("Head")
        if not part or not part:IsA("BasePart") then part = model:FindFirstChild("HumanoidRootPart") end
    else
        part = model:FindFirstChild("HumanoidRootPart")
        if not part then part = model:FindFirstChild("Torso") end
        if not part then part = model:FindFirstChild("UpperTorso") end
        if not part then part = model:FindFirstChild("LowerTorso") end
        if not part then part = model:FindFirstChild("Head") end
    end
    if not part then for _, c in ipairs(model:GetChildren()) do if c:IsA("BasePart") then part = c break end end end
    if not part and model.PrimaryPart then part = model.PrimaryPart end
    if part then partCache[key] = part end
    return part
end

local function isVisible(targetPos, targetModel, camPos)
    if not CheckVisibility then return true end
    local dir = targetPos - camPos
    if dir.Magnitude == 0 then return true end
    local r = workspace:Raycast(camPos, dir, RayParams)
    if not r then return true end
    if r.Instance:IsDescendantOf(targetModel) then return true end
    return false
end

local function getClosestTarget()
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local camPos = cam.CFrame.Position
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local myTeam = getLocalTeam()
    if tick() - lastCache > 0.5 then
        lastCache = tick()
        local ent = getEntitiesFolder()
        cachedEntities = ent and ent:GetChildren() or {}
    end
    local cands = {}
    for _, model in ipairs(cachedEntities) do
        if model:IsA("Model") and model.Name ~= LocalPlayer.Name then
            local hum = model:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health > 0 then
                if not (myTeam ~= nil and model:GetAttribute("Team") == myTeam) then
                    local part = getAimPart(model)
                    if part then
                        local pos = part.Position
                        if (pos - camPos).Magnitude < 1000 then
                            local sp, on = cam:WorldToViewportPoint(pos)
                            if on and sp.Z > 0 then
                                local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                                if d < FOV then cands[#cands + 1] = { model = model, pos = pos, dist = d } end
                            end
                        end
                    end
                end
            end
        end
    end
    if #cands == 0 then return nil end
    table.sort(cands, function(a, b) return a.dist < b.dist end)
    for i = 1, math.min(#cands, 2) do
        if isVisible(cands[i].pos, cands[i].model, cam.CFrame.Position) then return cands[i].model end
    end
    return nil
end

local function shouldAim()
    if not AimbotEnabled then return false end
    if AimMode == "Always On" then return true end
    if AimMode == "On Fire" then return ShootHeld end
    return false
end

