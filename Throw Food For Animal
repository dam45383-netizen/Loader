-- ===== WALK LEGIT: TELEPORT STAGING DULU, BARU WalkTo =====
local function startWalkLoop()
    if walkLoopRunning then return end
    walkLoopRunning = true
    task.spawn(function()
        while AutoThrowFull and ThrowMode == "Legit" do
            local hrp = getHRP()
            local hum = getHumanoid()
            if hrp and hum and hum.Health > 0 then
                local dist = (hrp.Position - TARGET_POS).Magnitude
                if dist > POSITION_TOLERANCE then
                    pcall(function() hrp.CFrame = STAGING_CF end)
                    task.wait(0.15)
                    hum:MoveTo(TARGET_POS)
                    alreadyClicked = false
                    prevY = nil
                    prevTime = nil
                    local t0 = os.clock()
                    while AutoThrowFull and ThrowMode == "Legit" and os.clock() - t0 < 2.5 do
                        task.wait(0.05)
                        local curHRP = getHRP()
                        if not curHRP then break end
                        if (curHRP.Position - TARGET_POS).Magnitude <= POSITION_TOLERANCE then break end
                        if (curHRP.Position - STAGING_POS).Magnitude > 60 then break end
                    end
                else
                    task.wait(CHECK_INTERVAL)
                end
            else
                task.wait(CHECK_INTERVAL)
            end
            task.wait(CHECK_INTERVAL)
        end
        walkLoopRunning = false
    end)
end

