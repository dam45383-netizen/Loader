local SeenModels = {}
local ThrowConns = {}
local NotifierRunning = false

local function GetThrowFolder()
    return workspace:FindFirstChild("ThrowSequence_"..LocalPlayer.Name)
        or workspace:FindFirstChild("ThrowSequence_crazylonepizaione24")
        or (function()
            for _, v in ipairs(workspace:GetChildren()) do
                if v.Name:find("ThrowSequence_") then return v end
            end
            return nil
        end)()
end

local function HandleThrowModel(m)
    if not m or not m.GetAttribute then return end
    if SeenModels[m] then return end
    local animal = m:GetAttribute("AnimalName")
    if not animal then return end
    SeenModels[m] = true
    local mutation = m:GetAttribute("Mutation")
    if mutation == nil or mutation == "" then mutation = "-" end
    local size = m:GetAttribute("SizeMult") or m:GetAttribute("Size") or "?"
    startCamLock(3)
    Window.Notify({
        Title = "You Got..",
        Content = tostring(animal).." | Mutation: "..tostring(mutation).." | Size: "..tostring(size),
        Duration = 6
    })
end

local function StartThrowNotifier()
    if NotifierRunning then return end
    NotifierRunning = true
    SeenModels = {}
    for _, c in ipairs(ThrowConns) do pcall(function() c:Disconnect() end) end
    ThrowConns = {}
    task.spawn(function()
        while NotifierRunning and NotifyAndLock do
            local folder = GetThrowFolder()
            if folder then
                for _, desc in ipairs(folder:GetDescendants()) do
                    pcall(function() HandleThrowModel(desc) end)
                end
            end
            task.wait(0.1)
        end
        NotifierRunning = false
    end)
    local conn = workspace.DescendantAdded:Connect(function(d)
        if not NotifyAndLock then return end
        task.wait(0.25)
        pcall(function()
            if d:GetAttribute("AnimalName") then
                local p = d.Parent
                while p and p ~= workspace do
                    if p.Name:find("ThrowSequence_") then
                        HandleThrowModel(d)
                        break
                    end
                    p = p.Parent
                end
            end
        end)
    end)
    table.insert(ThrowConns, conn)
end

local function StopThrowNotifier()
    NotifierRunning = false
    for _, c in ipairs(ThrowConns) do pcall(function() c:Disconnect() end) end
    ThrowConns = {}
end

if NotifyAndLock then StartThrowNotifier() end

