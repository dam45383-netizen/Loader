RunService.RenderStepped:Connect(function()
    if not AutoThrow and not AutoThrowFull then return end
    -- Kalau Full mode Instant, jangan jalanin logika Legit marker, udah di-handle InstantThrowLoop
    if AutoThrowFull and ThrowMode == "Instant" and not AutoThrow then return end
    if AutoThrowFull and ThrowMode == "Legit" and not isAtPosition() then alreadyClicked = false return end
    local marker = getMarker()
    if not marker then alreadyClicked = false prevY = nil prevTime = nil return end
    local y = marker.Position.Y.Scale
    local now = os.clock()
    if prevY and math.abs(y - prevY) > 0.2 then alreadyClicked = false end
    if alreadyClicked and (now - lastClickTime) > CLICK_COOLDOWN then
        if math.abs(y - TARGET_Y) > 0.05 then alreadyClicked = false end
    end
    local shouldClick = false
    if not alreadyClicked then
