local SORU = loadstring(game:HttpGet("https://raw.githubusercontent.com/dam45383-netizen/Loader/refs/heads/main/UI.lua"))()
local Window = SORU:CreateWindow({ Title = "SORU HUB" })

local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local PLOT_CF = CFrame.new(-8, 5, -37)

local function tp(cf)
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.CFrame = cf end
end

local function GetThrowFolder()
    return workspace:FindFirstChild("ThrowSequence_"..LP.Name) 
        or workspace:FindFirstChild("ThrowSequence_crazylonepizaione24")
        or (function()
            for _,v in ipairs(workspace:GetChildren()) do
                if v.Name:find("ThrowSequence_") then return v end
            end
            return nil
        end)()
end

getgenv().SeenModels = {}
getgenv().ThrowConns = {}

local function HandleThrowModel(m)
    if not m or not m.GetAttribute then return end
    if getgenv().SeenModels[m] then return end
    local animal = m:GetAttribute("AnimalName")
    if not animal then return end
    getgenv().SeenModels[m] = true
    local mutation = m:GetAttribute("Mutation")
    if mutation == nil or mutation == "" then mutation = "-" end
    local size = m:GetAttribute("SizeMult") or m:GetAttribute("Size") or "?"
    Window.Notify({
        Title = "You Got..",
        Content = tostring(animal).." | Mutation: "..tostring(mutation).." | Size: "..tostring(size),
        Duration = 6
    })
end

local function StartThrowNotifier()
    getgenv().SeenModels = {}
    for _,c in ipairs(getgenv().ThrowConns) do pcall(function() c:Disconnect() end) end
    getgenv().ThrowConns = {}
    task.spawn(function()
        while getgenv().AutoThrow do
            local folder = GetThrowFolder()
            if folder then
                for _,desc in ipairs(folder:GetDescendants()) do
                    pcall(function() HandleThrowModel(desc) end)
                end
            end
            task.wait(0.1)
        end
    end)
    local conn = workspace.DescendantAdded:Connect(function(d)
        if not getgenv().AutoThrow then return end
        task.wait(0.25)
        pcall(function()
            if d:GetAttribute("AnimalName") then
                local p = d.Parent
                while p and p ~= workspace do
                    if p.Name:find("ThrowSequence_") then
                        HandleThrowModel(d)
                        break
                    end
                    p = p.Parent
                end
            end
        end)
    end)
    table.insert(getgenv().ThrowConns, conn)
end

local function StopThrowNotifier()
    for _,c in ipairs(getgenv().ThrowConns) do pcall(function() c:Disconnect() end) end
    getgenv().ThrowConns = {}
end

local ThrowTab = Window:Tab({ Title = "Throw", Icon = "🎯" })
local ThrowAcc = ThrowTab:Accordion({ Title = "Auto Throw", Open = true })
getgenv().AutoThrow = false
local ThrowRun = false
local function ThrowLoop()
    if ThrowRun then return end
    ThrowRun = true
    task.spawn(function()
        while getgenv().AutoThrow do
            pcall(function() tp(PLOT_CF) end)
            task.wait(0.1)
            pcall(function() local V3,V2,CF,C3=Vector3.new,Vector2.new,CFrame.new,Color3.new game.ReplicatedStorage.Remotes.Throw_Start:InvokeServer() end)
            task.wait(0.2)
            pcall(function() local V3,V2,CF,C3=Vector3.new,Vector2.new,CFrame.new,Color3.new game.ReplicatedStorage.Remotes.Throw_Resolve:InvokeServer() end)
            task.wait(0.3)
            pcall(function() local V3,V2,CF,C3=Vector3.new,Vector2.new,CFrame.new,Color3.new game.ReplicatedStorage.Remotes.Throw_Complete:InvokeServer() end)
            task.wait(0.1)
        end
        ThrowRun = false
    end)
end
ThrowAcc:Toggle({
    Title = "Auto Throw",
    Flag = "AutoThrow",
    Default = false,
    Callback = function(v)
        getgenv().AutoThrow = v
        if v then StartThrowNotifier() ThrowLoop() else StopThrowNotifier() end
    end
})

local PetTab = Window:Tab({ Title = "Pet", Icon = "🐾" })
local PetAcc = PetTab:Accordion({ Title = "Auto Place Best", Open = true })
getgenv().AutoEquipBest = false
local PetRun = false
local function PetLoop()
    if PetRun then return end
    PetRun = true
    task.spawn(function()
        while getgenv().AutoEquipBest do
            pcall(function() tp(PLOT_CF) end)
            task.wait(0.2)
            pcall(function() local V3,V2,CF,C3=Vector3.new,Vector2.new,CFrame.new,Color3.new game.ReplicatedStorage.Remotes.Plot_EquipBest:InvokeServer() end)
            task.wait(2)
        end
        PetRun = false
    end)
end
PetAcc:Toggle({
    Title = "Auto Place Best",
    Flag = "AutoPlaceBest",
    Default = false,
    Callback = function(v) getgenv().AutoEquipBest=v if v then PetLoop() end end
})

local TrainTab = Window:Tab({ Title = "Training", Icon = "💪" })
local TrainAcc = TrainTab:Accordion({ Title = "Auto Training", Open = true })
getgenv().AutoX2 = false
local function ClickNoMouse(btn)
    if not btn or not btn.Visible or btn.AbsoluteSize.X < 2 then return end
    pcall(function()
        if getconnections then
            for _,c in ipairs(getconnections(btn.MouseButton1Click)) do c:Fire() end
            for _,c in ipairs(getconnections(btn.Activated)) do c:Fire() end
        end
    end)
    pcall(function() if firesignal then firesignal(btn.MouseButton1Click) firesignal(btn.Activated) end end)
    pcall(function() if btn.Activate then btn:Activate() end end)
end
local X2Run = false
local function X2Loop()
    if X2Run then return end
    X2Run = true
    task.spawn(function()
        while getgenv().AutoX2 do
            local layer = LP.PlayerGui:FindFirstChild("TrainingSequence") and LP.PlayerGui.TrainingSequence:FindFirstChild("TapBonusLayer")
            if layer and layer:FindFirstChild("TapBonus") then ClickNoMouse(layer.TapBonus) end
            task.wait(0.05)
        end
        X2Run = false
    end)
end
TrainAcc:Toggle({
    Title = "Auto x2",
    Flag = "AutoX2",
    Default = false,
    Callback = function(v) getgenv().AutoX2=v if v then X2Loop() end end
})
