local function getTapBonusButton()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local seq = pg:FindFirstChild("TrainingSequence")
    if not seq then return nil end
    local layer = seq:FindFirstChild("TapBonusLayer")
    if not layer then return nil end
    local btn = layer:FindFirstChild("TapBonus")
    if btn and btn:IsA("GuiButton") then return btn end
    if layer:IsA("GuiButton") then return layer end
    for _, desc in ipairs(layer:GetDescendants()) do
        if desc:IsA("GuiButton") then return desc end
    end
    return nil
end

local function ClickNoMouse(btn)
    if not btn then return end
    if btn.Visible == false then return end
    if btn.AbsoluteSize.X < 2 then return end
    pcall(function()
        if getconnections then
            for _, c in ipairs(getconnections(btn.MouseButton1Click)) do pcall(function() c:Fire() end) end
            for _, c in ipairs(getconnections(btn.Activated)) do pcall(function() c:Fire() end) end
        end
    end)
    pcall(function()
        if firesignal then firesignal(btn.MouseButton1Click) firesignal(btn.Activated) end
    end)
    pcall(function()
        if btn.Activate then btn:Activate() end
    end)
end

local function X2Loop()
    if X2Run then return end
    X2Run = true
    task.spawn(function()
        while AutoX2 do
            local btn = getTapBonusButton()
            if btn then ClickNoMouse(btn) end
            task.wait(0.05)
        end
        X2Run = false
    end)
end

