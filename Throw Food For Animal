local function getMarker()
    if cachedMarker and cachedMarker.Parent then return cachedMarker end
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local found = pg:FindFirstChild("Marker", true)
    if found and found:IsA("GuiObject") then cachedMarker = found return found end
    return nil
end

local function getHRP()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function isAtPosition()
    local hrp = getHRP()
    if not hrp then return false end
    return (hrp.Position - TARGET_POS).Magnitude <= POSITION_TOLERANCE
end

local function tp(cf)
    local hrp = getHRP()
    if hrp then hrp.CFrame = cf end
end

-- ===== KAMERA: PERSISTEN SELAMA AUTO THROW ON =====
local cameraLockUntil = 0
local CAM_BIND = "NextriftCamLock"

local function isCamLockActive()
    if not NotifyAndLock then return false end
    if os.clock() < cameraLockUntil then return true end
    if AutoThrow or AutoThrowFull then return true end
    return false
end

local function enforceCamera()
    if not isCamLockActive() then return end
    local cam = workspace.CurrentCamera
    local hrp = getHRP()
    local hum = getHumanoid()
    if not cam or not hrp or not hum or hum.Health <= 0 then return end
    if cam.CameraType ~= Enum.CameraType.Custom then cam.CameraType = Enum.CameraType.Custom end
    if cam.CameraSubject ~= hum then cam.CameraSubject = hum end
    local dist = (cam.CFrame.Position - hrp.Position).Magnitude
    if dist > 20 then
        local back = hrp.CFrame.LookVector
        local targetPos = hrp.Position - back * 11 + V3(0, 5, 0)
        cam.CFrame = CFrame.lookAt(targetPos, hrp.Position + V3(0, 2, 0))
    end
end

local function startCamLock(dur)
    cameraLockUntil = os.clock() + (dur or 7)
    pcall(function() RunService:UnbindFromRenderStep(CAM_BIND) end)
    RunService:BindToRenderStep(CAM_BIND, Enum.RenderPriority.Last.Value + 1, function()
        if not isCamLockActive() then
            pcall(function() RunService:UnbindFromRenderStep(CAM_BIND) end)
            return
        end
        enforceCamera()
    end)
end

local function stopCamLock()
    cameraLockUntil = 0
    pcall(function() RunService:UnbindFromRenderStep(CAM_BIND) end)
end

RunService.Heartbeat:Connect(function()
    if isCamLockActive() then enforceCamera() end
end)

pcall(function()
    RunService.PreRender:Connect(function()
        if isCamLockActive() then enforceCamera() end
    end)
end)

task.spawn(function()
    while true do
        task.wait(0.2)
        if isCamLockActive() then enforceCamera() end
    end
end)

