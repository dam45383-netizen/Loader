    Title = "Auto High Win", Flag = "AutoHighWin_F3", Default = false, Desc = "Loop teleport 0.01",
    Callback = function(v)
        autoWin = v
        if v then task.spawn(function()
            local lastScan = 0
            while autoWin do
                if tick() - lastScan > 1.5 then
                    local w, wor, st = getHighestWinClaim()
                    if w then cachedWin, cachedWorld, cachedStage = w, wor, st end
                    lastScan = tick()
                end
                if cachedWin then
                    pcall(function()
                        local hrp = getHRP()
                        hrp.AssemblyLinearVelocity = V3(0,0,0)
                        hrp.CFrame = CF(cachedWin.Position + V3(0,3,0))
