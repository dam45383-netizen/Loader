-- HELPER
local function getPartFromObj(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true) end
    return obj:FindFirstChildWhichIsA("BasePart", true)
end

local function getHighestWinClaim()
    local worlds = {}
    for _, o in ipairs(workspace:GetChildren()) do
        if o.Name:upper():find("WORLD") and o:FindFirstChild("STAGES") then table.insert(worlds, o) end
    end
    table.sort(worlds, function(a,b) return (tonumber(a.Name:match("%d+")) or 0) > (tonumber(b.Name:match("%d+")) or 0) end)
    for _, world in ipairs(worlds) do
        local stages = world.STAGES:GetChildren()
        table.sort(stages, function(a,b) return (tonumber(a.Name:match("%d+")) or 0) > (tonumber(b.Name:match("%d+")) or 0) end)
        for _, stage in ipairs(stages) do
            local winObj = stage:FindFirstChild("WinClaim") or stage:FindFirstChild("Win")
            local part = getPartFromObj(winObj) or getPartFromObj(stage)
            if part then return part, world, stage end
        end
    end
    return nil
end

local function getRemote(name)
    return game:GetService("ReplicatedStorage"):FindFirstChild(name, true)
end

local function getPetList()
    local list = {}
    local petsFolder = game:GetService("ReplicatedStorage"):FindFirstChild("Assets", true) and game:GetService("ReplicatedStorage").Assets:FindFirstChild("Pets")
    if petsFolder then
        for _, v1 in ipairs(petsFolder:GetChildren()) do
            if #v1:GetChildren() > 0 then
                for _, v2 in ipairs(v1:GetChildren()) do table.insert(list, v2.Name) end
            else
                table.insert(list, v1.Name)
            end
        end
    end
    if #list == 0 then list = {"Jet"} end
    return list
end

local function getHRP()
    local char = game.Players.LocalPlayer.Character or game.Players.LocalPlayer.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

