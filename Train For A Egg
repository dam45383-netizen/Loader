local autoGemRain = false local gemRunning = false local gemStatus = GemAcc:Label("Status: Idle | Found: 0")
local function getGemTargets() local folder = workspace:FindFirstChild("GemRain") if not folder then return {} end local list={} for _, obj in ipairs(folder:GetChildren()) do local cf = getCFfromObj(obj) if cf then table.insert(list, {obj = obj, cf = cf}) end end return list end
local function gemLoop()
    while autoGemRain do
        local gems = getGemTargets()
        if #gems == 0 then gemStatus:Set("Status: Searching... | Found: 0") task.wait(0.5) continue end
        local hrp = getHRP() if hrp then table.sort(gems, function(a,b) return (hrp.Position - a.cf.Position).Magnitude < (hrp.Position - b.cf.Position).Magnitude end) end
        gemStatus:Set("Status: Collecting | Found: "..#gems)
        for _, g in ipairs(gems) do if not autoGemRain then break end if not g.obj.Parent then continue end walkToCF(g.cf + Vector3.new(0, 1.5, 0)) task.wait(0.12) end task.wait(0.2)
    end
    gemRunning = false gemStatus:Set("Status: Idle")
end
GemAcc:Toggle({Title="Auto Collect Gem", Flag="AutoGemRain", Default=false, Callback=function(v) autoGemRain = v if v and not gemRunning then gemRunning = true task.spawn(gemLoop) end end})

-- RAID ORBIT
local RaidAcc = AdminTab:Accordion({Title="Raid", Open=true})
local autoRaid = false local raidRunning = false local raidStatus = RaidAcc:Label("Status: Idle")
local function getCrystalTargets()
    local arena = workspace:FindFirstChild("BossArena") if not arena then return {} end
    local crystalsFolder = arena:FindFirstChild("Crystals") or arena
    local list={}
    for _, obj in ipairs(crystalsFolder:GetChildren()) do if obj.Name:lower():find("crystal") then local cf=getCFfromObj(obj) if cf then table.insert(list, {obj=obj, cf=cf}) end end end
    if #list==0 then for _, obj in ipairs(crystalsFolder:GetDescendants()) do if obj:IsA("BasePart") and obj.Name:lower():find("crystal") then table.insert(list, {obj=obj, cf=obj.CFrame}) end end end
    return list
end
local function equipStick()
    local char=LP.Character if not char then return false end
    local hum=char:FindFirstChildOfClass("Humanoid") if not hum then return false end
    local stick=char:FindFirstChild("Stick") or char:FindFirstChildWhichIsA("Tool")
    if not stick or not stick.Name:lower():find("stick") then
        stick=LP.Backpack:FindFirstChild("Stick")
        if not stick then for _, t in ipairs(LP.Backpack:GetChildren()) do if t:IsA("Tool") and t.Name:lower():find("stick") then stick=t break end end end
    end
    if stick and stick.Parent ~= char then pcall(function() hum:EquipTool(stick) end) task.wait(0.12) end
    return true
end
local function orbitCrystalAndHit(crystalObj, crystalCF, duration)
    local start=tick() local radius=6.5 local angle=0 local hrp=getHRP() if not hrp then return end
    while autoRaid and crystalObj.Parent and tick()-start < duration do
        angle+=math.rad(12)
        local offset=Vector3.new(math.cos(angle)*radius, 1.2, math.sin(angle)*radius)
        local targetPos=crystalCF.Position+offset
        local lookCF=CFrame.new(targetPos, crystalCF.Position)
        hrp.CFrame=hrp.CFrame:Lerp(lookCF, 0.18)
        pcall(function()
            local char=LP.Character local tool=char and char:FindFirstChildOfClass("Tool")
            if tool then tool:Activate() for _, r in ipairs(tool:GetDescendants()) do if r:IsA("RemoteEvent") then r:FireServer(crystalObj) end end end
        end)
        RunService.Heartbeat:Wait()
    end
end
local function raidLoop()
    while autoRaid do
        local crystals=getCrystalTargets()
        if #crystals==0 then raidStatus:Set("Status: No Crystal") task.wait(1) continue end
        local hrp=getHRP() if hrp then table.sort(crystals, function(a,b) return (hrp.Position-a.cf.Position).Magnitude < (hrp.Position-b.cf.Position).Magnitude end) end
        raidStatus:Set("Status: Orbit "..#crystals.." crystals")
        for _, c in ipairs(crystals) do
            if not autoRaid then break end if not c.obj.Parent then continue end
            walkToCF(c.cf + Vector3.new(0, 1.5, 8))
            if not autoRaid then break end
            equipStick() task.wait(0.2)
            orbitCrystalAndHit(c.obj, c.cf, 8)
        end
        task.wait(0.3)
    end
    raidRunning=false raidStatus:Set("Status: Idle")
end
RaidAcc:Toggle({Title="Auto Raid Orbit", Flag="AutoRaidCrystal", Default=false, Callback=function(v) autoRaid=v if v and not raidRunning then raidRunning=true task.spawn(raidLoop) end end})

