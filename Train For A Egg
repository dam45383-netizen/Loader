local ANTI_HIT_ENABLED = true
local ANTI_VELOCITY_THRESHOLD = 110
local AntiConns = {}
local function clearAntiConns() for _,c in ipairs(AntiConns) do pcall(function() c:Disconnect() end) end table.clear(AntiConns) end

local function setupAntiHit(char)
    if not ANTI_HIT_ENABLED then return end
    clearAntiConns()
    local hum = char:WaitForChild("Humanoid", 10)
    local hrp = char:WaitForChild("HumanoidRootPart", 10)
    if not hum or not hrp then return end
    pcall(function()
        hum.BreakJointsOnDeath = false
        hum.RequiresNeck = false
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
    end)

    local lastStableCF = hrp.CFrame

    local c1 = hum.StateChanged:Connect(function(_, newState)
        if not ANTI_HIT_ENABLED then return end
        if newState == Enum.HumanoidStateType.Ragdoll or newState == Enum.HumanoidStateType.FallingDown or hum.PlatformStand then
            task.spawn(function()
                task.wait(0.01)
                if not hum.Parent then return end
                hum.PlatformStand = false
                pcall(function()
                    hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
                    hrp.AssemblyAngularVelocity = Vector3.new(0,0,0)
                    hrp.CFrame = lastStableCF
                    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                end)
                task.wait(0.02)
                pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
            end)
        end
    end)
    table.insert(AntiConns, c1)

    local c2 = RunService.Heartbeat:Connect(function()
        if not ANTI_HIT_ENABLED then return end
        if not hrp.Parent then return end
        local vel = hrp.AssemblyLinearVelocity
        local state = hum:GetState()
        if state == Enum.HumanoidStateType.Running or state == Enum.HumanoidStateType.RunningNoPhysics then
            if tick() % 0.2 < 0.02 then lastStableCF = hrp.CFrame end
            return
        end
        if vel.Magnitude > ANTI_VELOCITY_THRESHOLD then
            hrp.AssemblyLinearVelocity = Vector3.new(vel.X * 0.35, math.clamp(vel.Y, -35, 35), vel.Z * 0.35)
            hrp.AssemblyAngularVelocity *= 0.4
        end
        if hum.PlatformStand then hum.PlatformStand = false end
    end)
    table.insert(AntiConns, c2)
end
if LP.Character then task.spawn(function() setupAntiHit(LP.Character) end) end
LP.CharacterAdded:Connect(function(char) task.wait(1) setupAntiHit(char) end)

local SAVE_FOLDER="SORU_HUB" local RARITY_FILE=SAVE_FOLDER.."/EggRarities.json" local BIOME_FILE=SAVE_FOLDER.."/EggBiomes.json" local SELECTED_FILE=SAVE_FOLDER.."/EggFilterSaveV4.json"
pcall(function() if makefolder and not isfolder(SAVE_FOLDER) then makefolder(SAVE_FOLDER) end end)
local function stripEggName(n) return tostring(n):gsub("Egg",""):gsub("%s+","") end
local function loadJson(p) local ok,c=pcall(function() return isfile(p) and readfile(p) end) if ok and c then local ok2,d=pcall(function() return HttpService:JSONDecode(c) end) if ok2 then return d end end return nil end
local function saveJson(p,t) pcall(function() writefile(p, HttpService:JSONEncode(t)) end) end
local function getPetEggsFolder() return workspace:FindFirstChild("PetEggs") end
local function getEggBiome(egg) local b pcall(function() b=egg:GetAttribute("Biome") end) if b then return tostring(b) end pcall(function() b=egg:GetAttribute("Area") end) if b then return tostring(b) end local v=egg:FindFirstChild("Biome") or egg:FindFirstChild("Area") if v and v:IsA("ValueBase") then return tostring(v.Value) end return nil end
local function getUniqueRarities() local saved=loadJson(RARITY_FILE) or {} local map={} for _,v in ipairs(saved) do map[v]=true end local f=getPetEggsFolder() if f then for _,o in ipairs(f:GetChildren()) do local c=stripEggName(o.Name) if c~="" then map[c]=true end end end local list={} for k,_ in pairs(map) do table.insert(list,k) end table.sort(list) if #list>0 then saveJson(RARITY_FILE,list) end return list end
local function getUniqueBiomes() local saved=loadJson(BIOME_FILE) or {} local map={} for _,v in ipairs(saved) do map[v]=true end local f=getPetEggsFolder() if f then for _,o in ipairs(f:GetChildren()) do local b=getEggBiome(o) if b and b~="" then map[b]=true end end end local list={} for k,_ in pairs(map) do table.insert(list,k) end table.sort(list) if #list>0 then saveJson(BIOME_FILE,list) end return list end
local initRarities=getUniqueRarities() if #initRarities==0 then initRarities={"Common","Rare","Epic","Legendary"} end
local initBiomes=getUniqueBiomes() if #initBiomes==0 then initBiomes={"Forest"} end
local savedSel=loadJson(SELECTED_FILE) or {} local priorityRarities=savedSel.priority or {} local selectedBiomes=savedSel.biomes or {} local modeSelected=savedSel.mode or "Steal" local treadmillIfNoEgg=savedSel.treadmill or false
if #priorityRarities==0 then priorityRarities={initRarities[#initRarities]} end
local function saveSelected() saveJson(SELECTED_FILE, {priority=priorityRarities, biomes=selectedBiomes, mode=modeSelected, treadmill=treadmillIfNoEgg}) end

local function getHRP() local char=LP.Character or LP.CharacterAdded:Wait() return char:WaitForChild("HumanoidRootPart",5), char:FindFirstChildOfClass("Humanoid"), char end

local function walkToCF(targetCF)
    local hrp,hum,char=getHRP() if not hrp or not hum or not char then return end
    hrp.Anchored=false hum.AutoRotate=true if hum.PlatformStand then hum.PlatformStand=false end if hum.WalkSpeed < 1 then hum.WalkSpeed = 16 end
    local targetPos = targetCF.Position
    local noclipConn=RunService.Stepped:Connect(function() if char.Parent then for _,pr in ipairs(char:GetDescendants()) do if pr:IsA("BasePart") and pr.CanCollide then pr.CanCollide=false end end end end)
    local start=tick() local lastPos=hrp.Position local stuckTime=0
    repeat
        if (hrp.Position - targetPos).Magnitude < 5 then break end
        if (hrp.Position - lastPos).Magnitude < 0.6 then stuckTime+=0.1 if stuckTime>0.8 then hrp.CFrame=hrp.CFrame+Vector3.new(0,3,0) hum:ChangeState(Enum.HumanoidStateType.Jumping) stuckTime=0 end else stuckTime=0 lastPos=hrp.Position end
        if hum.Seated and hum.SeatPart then local mount=hum.SeatPart.Parent local mountHRP=mount and mount:FindFirstChild("HumanoidRootPart") if mountHRP then mountHRP.CFrame=mountHRP.CFrame:Lerp(targetCF,0.1) end end
        hum:MoveTo(targetPos) pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end) RunService.Heartbeat:Wait()
        if tick()-start>12 then hrp.CFrame=targetCF+Vector3.new(0,2,0) break end
    until false
    if noclipConn then noclipConn:Disconnect() end
end

local function walkToCFWithCarryCheck(targetCF, requireCarry, isCarryFunc)
    local hrp,hum,char=getHRP() if not hrp or not hum or not char then return false end
    hrp.Anchored=false hum.AutoRotate=true if hum.PlatformStand then hum.PlatformStand=false end if hum.WalkSpeed < 1 then hum.WalkSpeed = 16 end
    local targetPos = targetCF.Position
    local noclipConn=RunService.Stepped:Connect(function() if char.Parent then for _,pr in ipairs(char:GetDescendants()) do if pr:IsA("BasePart") and pr.CanCollide then pr.CanCollide=false end end end end)
    local start=tick() local lastPos=hrp.Position local stuckTime=0 local success=true
    repeat
        if requireCarry and not isCarryFunc() then success=false break end
        if (hrp.Position - lastPos).Magnitude < 0.6 then stuckTime+=0.1 if stuckTime>0.8 then hrp.CFrame=hrp.CFrame+Vector3.new(0,3,0) stuckTime=0 end else stuckTime=0 lastPos=hrp.Position end
        hum:MoveTo(targetPos) pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end) RunService.Heartbeat:Wait()
        if (hrp.Position - targetPos).Magnitude < 5 then break end
        if tick()-start>12 then hrp.CFrame=targetCF+Vector3.new(0,2,0) break end
    until false
    if noclipConn then noclipConn:Disconnect() end
    if requireCarry then return success and isCarryFunc() else return true end
end

local function getCFfromObj(obj)
    if not obj then return nil end
    if obj:IsA("Model") then local ok,cf=pcall(function() return obj:GetPivot() end) if ok then return cf end local p=obj:FindFirstChildWhichIsA("BasePart",true) if p then return p.CFrame end
    elseif obj:IsA("BasePart") then return obj.CFrame else local p=obj:FindFirstChildWhichIsA("BasePart",true) if p then return p.CFrame end end return nil
end
local function getEggCF(egg) local cf=getCFfromObj(egg) if cf then return cf+Vector3.new(0,1.5,0) end return nil end
local function getTreadmillNearUpgrade()
    local upgrade=workspace:FindFirstChild("UpgradeTreadmill") if not upgrade then return nil, nil end local upCF=getCFfromObj(upgrade) if not upCF then return nil, nil end local closest, closestCF, minDist=nil, nil, math.huge
    for _,obj in ipairs(workspace:GetDescendants()) do if obj.Name:lower():find("treadmill") and obj.Name~="UpgradeTreadmill" then local cf=getCFfromObj(obj) if cf then local d=(cf.Position - upCF.Position).Magnitude if d < 100 and d < minDist then minDist=d closest=obj closestCF=cf end end end end if closestCF then return closestCF+Vector3.new(0,1.5,0), closest end return nil, nil
end
local function isCarrying() local ok,res=pcall(function() return LP.PlayerGui.CarryGui.Drop.Visible end) if ok then return res==true end local ok2,res2=pcall(function() local gui=LP.PlayerGui:FindFirstChild("CarryGui") if not gui then return false end local drop=gui:FindFirstChild("Drop",true) if drop then return drop.Visible end return false end) return ok2 and res2 end
local function fireInteract(egg) if not egg then return false end for _,v in ipairs(egg:GetDescendants()) do if v:IsA("ProximityPrompt") then pcall(function() v.HoldDuration=0 v.RequiresLineOfSight=false v.MaxActivationDistance=60 fireproximityprompt(v) end) return true end end return false end
local function isBiomeMatch(egg) if #selectedBiomes==0 then return true end local b=getEggBiome(egg) if not b then return false end for _,v in ipairs(selectedBiomes) do if b==v then return true end end return false end
local function findTargetsByPriority()
    local folder=getPetEggsFolder() if not folder then return {} end local all={} for _,egg in ipairs(folder:GetChildren()) do if isBiomeMatch(egg) then table.insert(all,egg) end end local result={} if #priorityRarities==0 then result=all else for _, rarity in ipairs(priorityRarities) do for _, egg in ipairs(all) do if stripEggName(egg.Name)==rarity then table.insert(result,egg) end end end end
    local hrp=getHRP() if hrp then table.sort(result,function(a,b) local ra=stripEggName(a.Name) local rb=stripEggName(b.Name) local ia,ib=999,999 for i,r in ipairs(priorityRarities) do if r==ra then ia=i break end end for i,r in ipairs(priorityRarities) do if r==rb then ib=i break end end if ia~=ib then return ia<ib end local ac=getEggCF(a) local bc=getEggCF(b) if not ac or not bc then return false end return (hrp.Position-ac.Position).Magnitude < (hrp.Position-bc.Position).Magnitude end) end return result
end
local autoSteal=false local running=false
local function dropEggFast() pcall(function() ReplicatedStorage.PetRemotes.Action:FireServer("DropEgg") end) end
local function stealLoop()
    walkToCF(BASE_CF)
    while autoSteal do
        local targets=findTargetsByPriority()
        if #targets==0 then if treadmillIfNoEgg then local treadCF=getTreadmillNearUpgrade() if treadCF then walkToCF(treadCF) task.wait(3) else task.wait(1) end else task.wait(0.5) end continue end
        for _,egg in ipairs(targets) do
            if not autoSteal then break end if not egg.Parent then continue end local eggCF=getEggCF(egg) if not eggCF then continue end walkToCF(eggCF)
            local tries=0 while autoSteal and not isCarrying() and tries < 30 do fireInteract(egg) tries+=1 task.wait(0.05) if not egg.Parent then break end end
            if isCarrying() then
                local baseTarget = (modeSelected=="Helper") and HELPER_CF or BASE_CF
                local arrived = walkToCFWithCarryCheck(baseTarget, true, isCarrying)
                if not arrived then task.wait(0.1) break end
                if modeSelected=="Helper" then task.wait(0.05) dropEggFast() task.wait(0.08) dropEggFast() local t=0 while isCarrying() and t < 15 and autoSteal do task.wait(0.1) t+=1 end if isCarrying() then dropEggFast() end
                else local t=0 while isCarrying() and t < 25 and autoSteal do dropEggFast() task.wait(0.1) t+=1 end end
            end
        end
    end
    running=false
end

