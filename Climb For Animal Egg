    UIS.InputEnded:Connect(function() resizing=false end)

    local function createCard(model,i)
        local rar=getRarityFromModel(model) or "Unknown" local col=getRarityColor(rar)
        local card=Create("Frame",{Size=UDim2.new(1,-8,0,76),BackgroundColor3=T.card,BorderSizePixel=0},listScroll) Create("UICorner",{CornerRadius=UDim.new(0,14)},card) Create("UIStroke",{Color=col,Transparency=0.7},card)
        local vp=Create("ViewportFrame",{Size=UDim2.fromOffset(56,56),Position=UDim2.fromOffset(8,10),BackgroundColor3=Color3.fromRGB(20,18,32),BorderSizePixel=0},card) Create("UICorner",{CornerRadius=UDim.new(0,10)},vp)
        local world=Create("WorldModel",{},vp) local cam=Create("Camera",{},vp) vp.CurrentCamera=cam
        local clone=model:Clone() clone.Parent=world for _,v in ipairs(clone:GetDescendants()) do if v:IsA("Script") or v:IsA("LocalScript") then v:Destroy() end end
        local ok,cf,sz=pcall(function() return clone:GetBoundingBox() end) if ok then local md=math.max(sz.X,sz.Y,sz.Z) cam.CFrame=CFrame.new(cf.Position+Vector3.new(0,0.2,md*1.8),cf.Position) else cam.CFrame=CFrame.new(Vector3.new(0,0,5),Vector3.new(0,0,0)) end
        task.spawn(function() while clone.Parent do clone:PivotTo(clone:GetPivot()*CFrame.Angles(0,math.rad(0.7),0)) task.wait(0.03) end end)
        local mid=Create("Frame",{Size=UDim2.new(1,-160,1,0),Position=UDim2.fromOffset(78,0),BackgroundTransparency=1},card)
        Create("TextLabel",{Text=model.Name,Font=Enum.Font.GothamBold,TextSize=13,TextColor3=T.text,BackgroundTransparency=1,Position=UDim2.fromOffset(0,12),Size=UDim2.new(1,0,0,18),TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},mid)
        local badge=Create("Frame",{Size=UDim2.fromOffset(math.max(60,#rar*7+20),18),Position=UDim2.fromOffset(0,34),BackgroundColor3=col,BackgroundTransparency=0.85,BorderSizePixel=0},mid) Create("UICorner",{CornerRadius=UDim.new(0,6)},badge)
        Create("TextLabel",{Text=string.upper(rar),Font=Enum.Font.GothamBold,TextSize=10,TextColor3=Color3.new(1,1,1),BackgroundTransparency=1,Size=UDim2.fromScale(1,1)},badge)
        local btn=Create("TextButton",{Text="STEAL",Font=Enum.Font.GothamBold,TextSize=11,TextColor3=Color3.new(1,1,1),BackgroundColor3=col,Size=UDim2.fromOffset(68,32),Position=UDim2.new(1,-76,0.5,-16),AutoButtonColor=false},card) Create("UICorner",{CornerRadius=UDim.new(0,9)},btn)
        btn.MouseButton1Click:Connect(function() task.spawn(function() stealEgg(model) end) end)
    end

    local function refreshList()
        for _,c in ipairs(listScroll:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
        local models=getAllEggModels(currentPanelFilter, currentSearch)
        countLab.Text=#models.." eggs • "..currentPanelFilter
        for i,m in ipairs(models) do createCard(m,i) end
    end
    local function refreshFilters()
        for _,c in ipairs(filterScroll:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
        for _,areaName in ipairs(getEggAreaList()) do
            local isSel=areaName==currentPanelFilter
            local btn=Create("TextButton",{Text=areaName,Size=UDim2.fromOffset(math.max(56,#areaName*8+22),30),BackgroundColor3=isSel and T.accent or T.card,TextColor3=isSel and Color3.new(1,1,1) or T.dim,Font=Enum.Font.GothamSemibold,TextSize=12,AutoButtonColor=false},filterScroll)
            Create("UICorner",{CornerRadius=UDim.new(0,10)},btn)
            btn.MouseButton1Click:Connect(function() currentPanelFilter=areaName refreshFilters() refreshList() end)
        end
    end
    searchInput:GetPropertyChangedSignal("Text"):Connect(function() currentSearch=searchInput.Text refreshList() end)
    refreshFilters() refreshList()
    task.spawn(function() while EggPanelGui and EggPanelGui.Parent do task.wait(3) pcall(refreshList) end end)
end

