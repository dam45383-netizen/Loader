    if old then old:Destroy() end
    eggContainer = New("Frame", {Name="EggContainer", Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, LayoutOrder=100}, scroll)
    New("UIListLayout", {Padding=UDim.new(0,8), SortOrder=Enum.SortOrder.LayoutOrder}, eggContainer)
