local function New(c,p,par) local o=Instance.new(c) if p then for k,v in pairs(p) do pcall(function() o[k]=v end) end end if par then o.Parent=par end return o end

local function tweenTo(hrp, targetCf)
    if not hrp or not hrp.Parent then return end
    local speed = getgenv().TweenSpeed or 100
    local dist = (hrp.Position - targetCf.Position).Magnitude
    local dur = math.clamp(dist / speed, 0.08, 6)
    pcall(function()
        local tw = TS:Create(hrp, TweenInfo.new(dur, Enum.EasingStyle.Linear), {CFrame = targetCf})
        tw:Play()
        tw.Completed:Wait()
    end)
end

local function getAllIslandInfos()
    local infos = {}
    local s = workspace:FindFirstChild("Structures") or workspace:FindFirstChild("Structure")
    if not s then return infos end
    local islands = s:FindFirstChild("Islands")
    if not islands then return infos end
    for _, isl in ipairs(islands:GetChildren()) do
        local cf, pos = nil, nil
        if isl:IsA("Model") then
            local ok, pivot = pcall(function() return isl:GetPivot() end)
            if ok and pivot then cf = pivot + Vector3.new(0,12,0); pos = pivot.Position
            elseif isl.PrimaryPart then cf = isl.PrimaryPart.CFrame + Vector3.new(0,12,0); pos = isl.PrimaryPart.Position
            else local bp = isl:FindFirstChildWhichIsA("BasePart", true) if bp then cf = bp.CFrame + Vector3.new(0,12,0); pos = bp.Position end end
        elseif isl:IsA("BasePart") then cf = isl.CFrame + Vector3.new(0,12,0); pos = isl.Position end
        if cf and pos then table.insert(infos, {name=isl.Name, cf=cf, pos=pos}) end
    end
    return infos
end
local function getIslandCF(name) if not name or name=="All" then return nil end for _, info in ipairs(getAllIslandInfos()) do if info.name==name then return info.cf end end return nil end
local function getIslandNameFromModel(model) local area=getgenv().SelectedEggArea if area and area~="All" then return area end if model.Parent and model.Parent.Name~="SpawnedEggs" then return model.Parent.Name end return "All" end
local function doGradualTweenToIsland(hrp, destName)
    local all=getAllIslandInfos()
    if #all==0 then tweenTo(hrp, getIslandCF(destName) or FALLBACK_CF) return end
    table.sort(all, function(a,b) return (a.pos-hrp.Position).Magnitude < (b.pos-hrp.Position).Magnitude end)
    local destIdx
    for i, info in ipairs(all) do if info.name==destName then destIdx=i break end end
    if not destIdx then tweenTo(hrp, getIslandCF(destName) or FALLBACK_CF) return end
    for i=1, destIdx do tweenTo(hrp, all[i].cf) task.wait(0.05) end
end
local function walkToEggViaClimb(hrp, targetPos)
    local hum=hrp.Parent and hrp.Parent:FindFirstChildOfClass("Humanoid") if not hum then return end
    hrp.Anchored=false hum.WalkSpeed=24 hum.AutoRotate=true
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
    local function isClimbing() return hum:GetState()==Enum.HumanoidStateType.Climbing end
    local function fastClimb()
        local speed=getgenv().TweenSpeed or 100
        hum.WalkSpeed=math.clamp(speed,30,100)
        local t0=tick()
        repeat
            local dir=targetPos-hrp.Position
            if dir.Magnitude<4 then break end
            hum:Move(Vector3.new(dir.X,1,dir.Z).Unit, true)
            pcall(function() hrp.AssemblyLinearVelocity=Vector3.new(dir.X*0.8, speed, dir.Z*0.8) end)
            task.wait(0.05)
            if tick()-t0>12 then break end
        until (targetPos-hrp.Position).Magnitude<4 or not isClimbing()
        pcall(function() hrp.AssemblyLinearVelocity=Vector3.new(0,0,0) end)
    end
    local ok, path=pcall(function() local p=PFS:CreatePath({AgentRadius=2, AgentHeight=5, AgentCanJump=true, AgentCanClimb=true, WaypointSpacing=3}) p:ComputeAsync(hrp.Position, targetPos) return p end)
    if ok and path and path.Status==Enum.PathStatus.Success then
        for _, wp in ipairs(path:GetWaypoints()) do
            if wp.Action==Enum.PathWaypointAction.Jump then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
            hum:MoveTo(wp.Position)
            local t=tick()
            repeat task.wait(0.08) if isClimbing() then fastClimb() break end until (hrp.Position-wp.Position).Magnitude<3.5 or tick()-t>4
            if (targetPos-hrp.Position).Magnitude<5 then break end
            if isClimbing() then break end
        end
        if isClimbing() then fastClimb() end
    end
    if (hrp.Position-targetPos).Magnitude>4 then tweenTo(hrp, CFrame.new(targetPos)) end
    hum:Move(Vector3.new(0,0,0), false)
end

local RARITY_WEIGHT = {["Common"]=1,["Rare"]=3,["Epic"]=5,["Legendary"]=6,["Mythic"]=7,["Secret"]=8,["Divine"]=9,["Godly"]=10,["Exclusive"]=27}
local function isBlockedModel(name) return string.lower(tostring(name)):find("nest")~=nil end
local function getRarityFromModel(m) local r=m:GetAttribute("Rarity") if r~=nil then return tostring(r) end r=m:GetAttribute("rarity") if r~=nil then return tostring(r) end return nil end
local function getWeight(n) if not n then return 0 end local l=string.lower(tostring(n)) for k,v in pairs(RARITY_WEIGHT) do if l==string.lower(k) or l:find(string.lower(k)) then return v end end return 4 end
local function getRarityList() local seen={} local list={"All"} local sp=workspace:FindFirstChild("SpawnedEggs") if sp then for _,folder in ipairs(sp:GetChildren()) do if folder:IsA("Folder") or folder:IsA("Model") then for _,mdl in ipairs(folder:GetChildren()) do if mdl:IsA("Model") then local rar=getRarityFromModel(mdl) if rar and rar~="" and not seen[rar] then seen[rar]=true table.insert(list,rar) end end end if folder:IsA("Model") then local rar=getRarityFromModel(folder) if rar and rar~="" and not seen[rar] then seen[rar]=true table.insert(list,rar) end end end end end table.sort(list,function(a,b) if a=="All" then return true end if b=="All" then return false end return getWeight(a)>getWeight(b) end) return list end
local function getEggAreaList() local f=workspace:FindFirstChild("SpawnedEggs") if not f then return {"All"} end local list={"All"} for _,c in ipairs(f:GetChildren()) do table.insert(list,c.Name) end return list end
local function getAllEggModels(area, query, rarityOverride) local sp=workspace:FindFirstChild("SpawnedEggs") if not sp then return {} end local effArea=area or getgenv().SelectedEggArea or "All" local effRarity=rarityOverride if effRarity==nil then effRarity=getgenv().SelectedRarityFilter or "All" end local toScan={} if effArea and effArea~="All" then local t=sp:FindFirstChild(effArea) if t then toScan={t} end else toScan=sp:GetChildren() end local list={} for _,folder in ipairs(toScan) do if folder:IsA("Folder") or folder:IsA("Model") then for _,mdl in ipairs(folder:GetChildren()) do if mdl:IsA("Model") and not isBlockedModel(mdl.Name) then table.insert(list,mdl) end end if folder:IsA("Model") and not isBlockedModel(folder.Name) then table.insert(list,folder) end end end if effRarity~="All" then local rf=string.lower(effRarity) local f2={} for _,m in ipairs(list) do local rar=getRarityFromModel(m) or "" if string.lower(rar)==rf then table.insert(f2,m) end end list=f2 end if query and query~="" then local q=string.lower(query) local f2={} for _,m in ipairs(list) do local rar=getRarityFromModel(m) or "" if string.lower(m.Name):find(q,1,true) or string.lower(rar):find(q,1,true) then table.insert(f2,m) end end list=f2 end table.sort(list,function(a,b) return getWeight(getRarityFromModel(a))>getWeight(getRarityFromModel(b)) end) return list end
local function getModelPos(m) if m.PrimaryPart then return m.PrimaryPart.CFrame end local ok,cf=pcall(function() return m:GetPivot() end) if ok then return cf end local p=m:FindFirstChildWhichIsA("BasePart",true) if p then return p.CFrame end return CFrame.new() end
local function doInteract(m) local pr=m:FindFirstChildWhichIsA("ProximityPrompt",true) if pr then if fireproximityprompt then fireproximityprompt(pr) else pr:InputHoldBegin() task.wait() pr:InputHoldEnd() end return true end local cd=m:FindFirstChildWhichIsA("ClickDetector",true) if cd and fireclickdetector then fireclickdetector(cd) return true end return false end
local function getEggInfo(m)
    local a=m:GetAttributes()
    local rarity = a.Rarity or a.rarity or getRarityFromModel(m) or "?"
    local mutation = a.Mutation or a.mutation or a.Variant or a.variant or a.Trait or a.trait or a.Mut or a.mut or "-"
    local weightRaw = a.WeightKg or a.WeightKG or a.Weight or a.KG or a.kg or a.Mass or a.WeightKGs or 0
    local weightStr = "-"
    if typeof(weightRaw)=="number" then weightStr = string.format("%.2f Kg", weightRaw)
    elseif weightRaw~=0 and weightRaw~="" then weightStr = tostring(weightRaw).." Kg" end
    return tostring(rarity), tostring(mutation), tostring(weightStr), weightRaw
end
local function doNormalSteal(model, hrp)
    local islandName=getIslandNameFromModel(model)
    local targetPos=(getModelPos(model)+Vector3.new(0,3,0)).Position
    doGradualTweenToIsland(hrp, islandName)
    walkToEggViaClimb(hrp, targetPos)
    task.wait(0.1)
    local endT=tick()+(getgenv().SpamDuration or 2)
    while tick()<endT and model.Parent do doInteract(model) task.wait(0.08) end
    tweenTo(hrp, BASE_CF)
end
local function doSilentSteal(model, hrp, oldCf, char)
    char.Archivable=true local clone=char:Clone()
    for _,v in ipairs(clone:GetDescendants()) do if v:IsA("BasePart") then v.Anchored=true v.CanCollide=false end if v:IsA("Script") or v:IsA("LocalScript") then v:Destroy() end end
    clone.Parent=workspace pcall(function() clone:PivotTo(oldCf) end)
    local cam=workspace.CurrentCamera local hc=clone:FindFirstChildOfClass("Humanoid") local hr=char:FindFirstChildOfClass("Humanoid")
    if hc then cam.CameraSubject=hc end
    for _,p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.LocalTransparencyModifier=1 end end
    local islandName=getIslandNameFromModel(model)
    local targetPos=(getModelPos(model)+Vector3.new(0,3,0)).Position
    doGradualTweenToIsland(hrp, islandName)
    walkToEggViaClimb(hrp, targetPos)
    task.wait(0.1)
    local endT=tick()+(getgenv().SpamDuration or 2)
    while tick()<endT and model.Parent do doInteract(model) task.wait(0.08) end
    tweenTo(hrp, BASE_CF)
    task.wait(0.2)
    for _,p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.LocalTransparencyModifier=0 end end
    if hr then cam.CameraSubject=hr end
    task.delay(0.5,function() if clone then clone:Destroy() end end)
end
local function stealEgg(model)
    if getgenv().IsStealing then return end
    if isBlockedModel(model.Name) then return end
    getgenv().IsStealing = true
    local char=plr.Character or plr.CharacterAdded:Wait()
    local hrp=char:FindFirstChild("HumanoidRootPart")
    if hrp then
        pcall(function() hrp.AssemblyLinearVelocity = Vector3.new(0,0,0) end)
        local old=hrp.CFrame
        if getgenv().StealMethod=="Silent" then doSilentSteal(model, hrp, old, char) else doNormalSteal(model, hrp) end
    end
    task.wait(0.2)
    getgenv().IsStealing = false
end

