local function FindEgg()
    local areas = typeof(SelectedArea)=="table" and SelectedArea or {SelectedArea}
    if #SelectedRarities>0 then
        for _,prio in ipairs(SelectedRarities) do
            for _,areaName in ipairs(areas) do
                local folder = GetEggFolder(areaName)
                if folder then
                    for _,model in ipairs(folder:GetChildren()) do
                        local rarity = model:GetAttribute("Rarity")
                        if rarity and string.lower(rarity)==string.lower(prio) then
                            return model, areaName, rarity
                        end
                    end
                end
            end
        end
        return nil
    else
        for _,areaName in ipairs(areas) do
            local folder = GetEggFolder(areaName)
            if folder then
                for _,model in ipairs(folder:GetChildren()) do
                    local rarity = model:GetAttribute("Rarity")
                    if rarity then
                        return model, areaName, rarity
                    end
                end
            end
        end
        return nil
    end
end

