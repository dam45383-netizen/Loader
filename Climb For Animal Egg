end

local function refreshVault()
    for _,c in ipairs(eggContainer:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
    -- PANEL PAKAI "All" UNTUK RARITY JADI INDEPENDEN
    local models=getAllEggModels(currentPanelFilter, currentSearch, "All")
