local function getPanelScroll()
    local function findIn(host)
        if not host then return nil end
        local gui=host:FindFirstChild("SORU_HUB")
        if not gui then return nil end
        for _,v in ipairs(gui:GetDescendants()) do
            if v.Name=="SORU_Panel" then
                local body=v:FindFirstChild("Body")
                if body then
                    for _,ch in ipairs(body:GetChildren()) do if ch:IsA("ScrollingFrame") then return ch end end
                    for _,d in ipairs(body:GetDescendants()) do if d:IsA("ScrollingFrame") then return d end end
                end
            end
        end
        return nil
    end
    local pg=plr:FindFirstChild("PlayerGui")
    local hg=nil
    pcall(function() if gethui then hg=gethui() end end)
    local t0=tick()+6
    while tick()<t0 do
        local sc=findIn(pg) or findIn(hg)
        if sc then return sc end
        task.wait(0.2)
    end
    return nil
end

