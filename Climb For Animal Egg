    local searchBox=Create("Frame",{Size=UDim2.new(1,-20,0,34),Position=UDim2.fromOffset(10,60),BackgroundColor3=T.panel,BorderSizePixel=0},panel) Create("UICorner",{CornerRadius=UDim.new(0,10)},searchBox) Create("UIStroke",{Color=T.stroke,Transparency=0.6},searchBox)
