local function refreshVault()
    for _,c in ipairs(eggContainer:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
    local models=getAllEggModels(currentPanelFilter, currentSearch, "All")
    table.sort(models, function(a,b)
        local _,_,_,wA = getEggInfo(a)
        local _,_,_,wB = getEggInfo(b)
        if type(wA)=="number" and type(wB)=="number" then return wA > wB end
        return getWeight(getRarityFromModel(a)) > getWeight(getRarityFromModel(b))
    end)
    countLabel:Set(#models.." eggs • "..currentPanelFilter..(currentSearch~="" and " • "..currentSearch or ""))
    VaultPanel:SetTitle("Egg Vault ("..#models..")")
    VaultPanel:SetSubtitle(#models.." found")
    for _,m in ipairs(models) do if m.Parent then createEggCard(eggContainer,m) end end
end
_G._refreshVault=refreshVault
local PanelTab=Window:Tab({Title="Panel", Icon="P"})
PanelTab:Button({Title="Open Vault", Callback=function() VaultPanel:Show() refreshVault() end})
PanelTab:Button({Title="Close Vault", Callback=function() VaultPanel:Hide() end})
task.spawn(function() while task.wait(3) do if VaultPanel:IsOpen() then pcall(refreshVault) end end end)

Window.Notify("Ready","Egg Vault + x2 ready",T.ok,2)
