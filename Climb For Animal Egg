local function GetEggFolder(areaName)
    local se = workspace:FindFirstChild("SpawnedEggs")
    if se and se:FindFirstChild(areaName) then return se:FindFirstChild(areaName) end
    local hSe = workspace:FindFirstChild("HalloweenDimension") and workspace.HalloweenDimension:FindFirstChild("SpawnedEggs")
    if hSe and hSe:FindFirstChild(areaName) then return hSe:FindFirstChild(areaName) end
    return nil
end

local function FindEgg()
    local areas = typeof(SelectedArea)=="table" and SelectedArea or {SelectedArea}
    if #SelectedRarities>0 then
        for _,prio in ipairs(SelectedRarities) do
            for _,areaName in ipairs(areas) do
                local folder = GetEggFolder(areaName)
                if folder then
                    for _,model in ipairs(folder:GetChildren()) do
                        local rarity = model:GetAttribute("Rarity")
                        if rarity and string.lower(rarity)==string.lower(prio) then
                            return model, areaName, rarity
                        end
                    end
                end
            end
        end
        return nil
    else
        for _,areaName in ipairs(areas) do
            local folder = GetEggFolder(areaName)
            if folder then
                for _,model in ipairs(folder:GetChildren()) do
                    local rarity = model:GetAttribute("Rarity")
                    if rarity then
                        return model, areaName, rarity
                    end
                end
            end
        end
        return nil
    end
end

local function TweenToPos(hrp, targetPos)
    if not hrp then return end
    local speed = _G.TweenSpeed or 16
    if speed<1 then speed=1 end
    local dur = math.clamp((hrp.Position-targetPos).Magnitude/speed,0.1,20)
    local cfVal = Instance.new("CFrameValue") cfVal.Value=hrp.CFrame
    local conn = RS.Heartbeat:Connect(function() pcall(function() hrp.CFrame=cfVal.Value end) end)
    local tw = TS:Create(cfVal, TweenInfo.new(dur, Enum.EasingStyle.Linear), {Value=CFrame.new(targetPos)})
    tw:Play() tw.Completed:Wait()
    conn:Disconnect() cfVal:Destroy()
end

local function TweenTo(targetPos)
    local hrp = GetHRP()
    if not hrp then return end
    local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand=true hum.AutoRotate=false end
    TweenToPos(hrp, targetPos)
    if hum then hum.PlatformStand=false hum.AutoRotate=true end
end

local function getRarityFromModel(m) local r=m:GetAttribute("Rarity") if r~=nil then return tostring(r) end r=m:GetAttribute("rarity") if r~=nil then return tostring(r) end return nil end
local function getModelPos(m) if m.PrimaryPart then return m.PrimaryPart.CFrame end local ok,cf=pcall(function() return m:GetPivot() end) if ok then return cf end local p=m:FindFirstChildWhichIsA("BasePart",true) if p then return p.CFrame end return CFrame.new() end
local function getEggInfo(m)
    local a=m:GetAttributes()
    local rarity = a.Rarity or a.rarity or getRarityFromModel(m) or "?"
    local weightRaw = a.WeightKg or a.Weight or a.KG or 0
    local weightStr = "-"
    if typeof(weightRaw)=="number" then weightStr=string.format("%.2f Kg",weightRaw) elseif weightRaw~=0 then weightStr=tostring(weightRaw).." Kg" end
    return tostring(rarity), tostring(weightStr)
end

