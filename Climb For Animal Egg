-- DINAMIS DARI rarityColors
local function getRarityListFromConfig()
    local seenTmp = {}
    local tempList = {}
    local function add(r)
        if not r or r == "" then return end
        if seenTmp[r] then return end
        if not r:match("^[A-Za-z]+$") then return end
        if #r < 3 or #r > 20 then return end
        if r:lower() == "all" then return end
        if not r:match("^[A-Z]") then return end
        seenTmp[r] = true
        table.insert(tempList, r)
    end

    local configObj
    pcall(function()
        configObj = game:GetService("ReplicatedStorage").src.GameConfiguration.General.rarityColors
    end)
    if not configObj then
        local rs = game:GetService("ReplicatedStorage")
        local src = rs:FindFirstChild("src")
        if src then
            local gc = src:FindFirstChild("GameConfiguration", true)
            if gc then
                local gen = gc:FindFirstChild("General")
                if gen then
                    configObj = gen:FindFirstChild("rarityColors")
                else
                    configObj = gc:FindFirstChild("rarityColors", true)
                end
            end
        end
    end

    if configObj then
        if configObj:IsA("ModuleScript") then
            local s, data = pcall(require, configObj)
            if s and type(data) == "table" then
                for k,v in pairs(data) do
                    if type(k) == "string" then add(k) end
                    if type(v) == "string" then add(v) end
                    if type(v) == "table" and v.Rarity then add(tostring(v.Rarity)) end
                end
            end
            local srcStr
            pcall(function() srcStr = configObj.Source end)
            if not srcStr and gethiddenproperty then
                pcall(function() srcStr = gethiddenproperty(configObj, "Source") end)
            end
            if not srcStr and decompile then
                pcall(function() srcStr = decompile(configObj) end)
            end
            if srcStr and type(srcStr) == "string" then
                for quoted in srcStr:gmatch('"([^"]+)"') do add(quoted) end
                for quoted in srcStr:gmatch("'([^']+)'") do add(quoted) end
            end
        else
            for _,child in ipairs(configObj:GetChildren()) do
                add(child.Name)
                if child:IsA("StringValue") then add(child.Value) end
            end
            for k,_ in pairs(configObj:GetAttributes()) do add(k) end
        end
    end
    return tempList
end

local function getRarityList()
    local seen = {}
    local list = {"All"}
    seen["All"] = true
    
    -- ambil dari config dulu
    local configList = getRarityListFromConfig()
    for _,r in ipairs(configList) do
        if not seen[r] then seen[r]=true table.insert(list, r) end
    end

    -- fallback / tambahan dari SpawnedEggs biar tetap ada walau config gagal
    local sp = workspace:FindFirstChild("SpawnedEggs")
    if sp then
        for _,folder in ipairs(sp:GetChildren()) do
            if folder:IsA("Folder") or folder:IsA("Model") then
                for _,mdl in ipairs(folder:GetChildren()) do
                    if mdl:IsA("Model") then
                        local rar=getRarityFromModel(mdl)
                        if rar and rar~="" and not seen[rar] then seen[rar]=true table.insert(list,rar) end
                    end
                end
                if folder:IsA("Model") then
                    local rar=getRarityFromModel(folder)
                    if rar and rar~="" and not seen[rar] then seen[rar]=true table.insert(list,rar) end
                end
            end
        end
    end

    table.sort(list,function(a,b)
        if a=="All" then return true end
        if b=="All" then return false end
        return getWeight(a)>getWeight(b)
    end)
    return list
end

local function getEggAreaList() local f=workspace:FindFirstChild("SpawnedEggs") if not f then return {"All"} end local list={"All"} for _,c in ipairs(f:GetChildren()) do table.insert(list,c.Name) end return list end
local function normalizeFilter(input) if input==nil then return {"All"} end if type(input)=="string" then if input=="" then return {"All"} end return {input} end if type(input)=="table" then if #input==0 then return {"All"} end return input end return {"All"} end
local function containsAll(list) if not list or #list==0 then return true end for _,v in ipairs(list) do if string.lower(tostring(v))=="all" then return true end end return false end
local function getAllEggModels(area, query, rarityOverride)
    local sp=workspace:FindFirstChild("SpawnedEggs") if not sp then return {} end
    local effArea=area or getgenv().SelectedEggArea or "All"
    local rawRarity = rarityOverride if rawRarity==nil then rawRarity=getgenv().SelectedRarityFilter end
    local rarityList = normalizeFilter(rawRarity)
    local useAllRarity = containsAll(rarityList)
    local raritySet = {}
    if not useAllRarity then for _,r in ipairs(rarityList) do raritySet[string.lower(tostring(r))]=true end end
    local toScan={}
    if effArea and effArea~="All" then local t=sp:FindFirstChild(effArea) if t then toScan={t} end else toScan=sp:GetChildren() end
    local list={}
    for _,folder in ipairs(toScan) do if folder:IsA("Folder") or folder:IsA("Model") then for _,mdl in ipairs(folder:GetChildren()) do if mdl:IsA("Model") and not isBlockedModel(mdl.Name) then table.insert(list,mdl) end end if folder:IsA("Model") and not isBlockedModel(folder.Name) then table.insert(list,folder) end end end
    if not useAllRarity then local f2={} for _,m in ipairs(list) do local rar=string.lower(getRarityFromModel(m) or "") if raritySet[rar] then table.insert(f2,m) end end list=f2 end
    if query and query~="" then local q=string.lower(query) local f2={} for _,m in ipairs(list) do local rar=getRarityFromModel(m) or "" if string.lower(m.Name):find(q,1,true) or string.lower(rar):find(q,1,true) then table.insert(f2,m) end end list=f2 end
    table.sort(list,function(a,b) return getWeight(getRarityFromModel(a))>getWeight(getRarityFromModel(b)) end)
    return list
end
local function getModelPos(m) if m.PrimaryPart then return m.PrimaryPart.CFrame end local ok,cf=pcall(function() return m:GetPivot() end) if ok then return cf end local p=m:FindFirstChildWhichIsA("BasePart",true) if p then return p.CFrame end return CFrame.new() end
local function doInteract(m) local pr=m:FindFirstChildWhichIsA("ProximityPrompt",true) if pr then if fireproximityprompt then fireproximityprompt(pr) else pr:InputHoldBegin() task.wait() pr:InputHoldEnd() end return true end local cd=m:FindFirstChildWhichIsA("ClickDetector",true) if cd and fireclickdetector then fireclickdetector(cd) return true end return false end
local function getEggInfo(m)
    local a=m:GetAttributes()
    local rarity = a.Rarity or a.rarity or getRarityFromModel(m) or "?"
    local mutation = a.Mutation or a.mutation or a.Variant or a.variant or a.Trait or a.trait or a.Mut or a.mut or "-"
    local weightRaw = a.WeightKg or a.WeightKG or a.Weight or a.KG or a.kg or a.Mass or a.WeightKGs or 0
    local weightStr = "-"
    if typeof(weightRaw)=="number" then weightStr = string.format("%.2f Kg", weightRaw)
    elseif weightRaw~=0 and weightRaw~="" then weightStr = tostring(weightRaw).." Kg" end
    return tostring(rarity), tostring(mutation), tostring(weightStr), weightRaw
end

local function doNormalSteal(model, hrp)
    local eggPos=(getModelPos(model)+Vector3.new(0,3,0)).Position
    tweenTo(hrp, STAGING_CF)
    tweenToY(hrp, eggPos.Y)
    tweenToXZ(hrp, eggPos)
    task.wait(0.1)
    local maxTime = getgenv().SpamDuration or 2
    local start = tick()
    while tick()-start < maxTime and model.Parent do
        if isDropVisible() then break end
        doInteract(model) task.wait(0.08)
    end
    doReturnToBase(hrp)
end

local function doSilentSteal(model, hrp, oldCf, char)
    char.Archivable=true local clone=char:Clone()
    for _,v in ipairs(clone:GetDescendants()) do if v:IsA("BasePart") then v.Anchored=true v.CanCollide=false end if v:IsA("Script") or v:IsA("LocalScript") then v:Destroy() end end
    clone.Parent=workspace pcall(function() clone:PivotTo(oldCf) end)
    local cam=workspace.CurrentCamera local hc=clone:FindFirstChildOfClass("Humanoid") local hr=char:FindFirstChildOfClass("Humanoid")
    if hc then cam.CameraSubject=hc end
    for _,p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.LocalTransparencyModifier=1 end end
    local eggPos=(getModelPos(model)+Vector3.new(0,3,0)).Position
    tweenTo(hrp, STAGING_CF)
    tweenToY(hrp, eggPos.Y)
    tweenToXZ(hrp, eggPos)
    task.wait(0.1)
    local maxTime = getgenv().SpamDuration or 2
    local start = tick()
    while tick()-start < maxTime and model.Parent do
        if isDropVisible() then break end
        doInteract(model) task.wait(0.08)
    end
    doReturnToBase(hrp)
    task.wait(0.2)
    for _,p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.LocalTransparencyModifier=0 end end
    if hr then cam.CameraSubject=hr end
    task.delay(0.5,function() if clone then clone:Destroy() end end)
end

local function stealEgg(model)
    if getgenv().IsStealing then return end
    if isBlockedModel(model.Name) then return end
    if not model.Parent then return end
    getgenv().IsStealing = true
    Window.Notify("Steal","Mencuri "..model.Name.." ["..(getRarityFromModel(model) or "?").."]", T.cyan, 2)
    local char=plr.Character or plr.CharacterAdded:Wait()
    local hrp=char:FindFirstChild("HumanoidRootPart")
    if hrp then
        pcall(function() hrp.AssemblyLinearVelocity = Vector3.new(0,0,0) end)
        local old=hrp.CFrame
        if getgenv().StealMethod=="Silent" then doSilentSteal(model, hrp, old, char) else doNormalSteal(model, hrp) end
    end
    task.wait(0.2)
    getgenv().IsStealing = false
end

