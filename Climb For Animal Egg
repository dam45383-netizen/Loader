local function refreshVault()
    if not eggContainer then
        local sc = getPanelScroll()
        if sc then
            eggContainer=New("Frame", {Name="EggContainer", Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, LayoutOrder=100}, sc)
            New("UIListLayout", {Padding=UDim.new(0,8), SortOrder=Enum.SortOrder.LayoutOrder}, eggContainer)
        else return end
    end
    for _,c in ipairs(eggContainer:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
    local models=getAllEggModels(currentPanelFilter, currentSearch, getgenv().SelectedRarityFilter)
    table.sort(models, function(a,b) local _,_,_,wA = getEggInfo(a) local _,_,_,wB = getEggInfo(b) if type(wA)=="number" and type(wB)=="number" then return wA > wB end return getWeight(getRarityFromModel(a)) > getWeight(getRarityFromModel(b)) end)
    countLabel:Set(#models.." eggs • "..currentPanelFilter..(currentSearch~="" and " • "..currentSearch or ""))
    VaultPanel:SetTitle("Egg Vault ("..#models..")")
    VaultPanel:SetSubtitle(#models.." found")
    for _,m in ipairs(models) do if m.Parent then createEggCard(eggContainer,m) end end
end
