local function Create(cls, props, parent)
    local o = Instance.new(cls)
    if props then for k,v in pairs(props) do pcall(function() o[k]=v end) end end
    if parent then o.Parent = parent end
    return o
end

-- FPS BOOST
local function applyNoTexture()
    local c=0
    pcall(function() game:GetService("Lighting").GlobalShadows=false end)
    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj.Parent:FindFirstChildOfClass("Humanoid") then obj.Material=Enum.Material.SmoothPlastic obj.Reflectance=0
        elseif obj:IsA("Decal") or obj:IsA("Texture") then if obj.Transparency~=1 then c+=1 end obj.Transparency=1
        elseif obj:IsA("MeshPart") then if obj.TextureID~="" then c+=1 end obj.TextureID="" obj.Material=Enum.Material.SmoothPlastic
        end
    end
    return c
end
task.spawn(function() task.wait(3) local n=0 pcall(function() n=applyNoTexture() end) Window.Notify("FPS Boost","No Texture • "..n.." off",T.ok,4) end)

-- RARITY FIX
local RARITY_WEIGHT = {["Common"]=1,["Rare"]=3,["Epic"]=5,["Legendary"]=6,["Mythic"]=7,["Secret"]=8,["Divine"]=9,["Godly"]=10,["Exclusive"]=27}
local function getRarityFromModel(m) local r=m:GetAttribute("Rarity") if r~=nil then return tostring(r) end r=m:GetAttribute("rarity") if r~=nil then return tostring(r) end return nil end
local function getWeight(name) if not name then return 0 end local l=string.lower(tostring(name)) for k,v in pairs(RARITY_WEIGHT) do if l==string.lower(k) or l:find(string.lower(k)) then return v end end return 5 end
local function getRarityColor(name) local w=getWeight(name) if w>=10 then return T.pink elseif w>=8 then return Color3.fromRGB(255,85,85) elseif w>=6 then return T.cyan elseif w>=5 then return T.accent else return T.dim end end
local function getEggAreaList() local f=workspace:FindFirstChild("SpawnedEggs") if not f then return {"All"} end local list={"All"} for _,c in ipairs(f:GetChildren()) do table.insert(list,c.Name) end return list end
local function getAllEggModels(area, query) local sp=workspace:FindFirstChild("SpawnedEggs") if not sp then return {} end local toScan={} local sel=area or getgenv().SelectedEggArea if sel and sel~="All" then local t=sp:FindFirstChild(sel) if t then toScan={t} end else toScan=sp:GetChildren() end local list={} for _,folder in ipairs(toScan) do if folder:IsA("Folder") or folder:IsA("Model") then for _,mdl in ipairs(folder:GetChildren()) do if mdl:IsA("Model") then table.insert(list,mdl) end end if folder:IsA("Model") then table.insert(list,folder) end end end if query and query~="" then local q=string.lower(query) local filtered={} for _,m in ipairs(list) do local rar=getRarityFromModel(m) or "" if string.lower(m.Name):find(q,1,true) or string.lower(rar):find(q,1,true) then table.insert(filtered,m) end end list=filtered end table.sort(list,function(a,b) return getWeight(getRarityFromModel(a)) > getWeight(getRarityFromModel(b)) end) return list end
local function getModelPos(m) if m.PrimaryPart then return m.PrimaryPart.CFrame end local ok,cf=pcall(function() return m:GetPivot() end) if ok then return cf end local p=m:FindFirstChildWhichIsA("BasePart",true) if p then return p.CFrame end return CFrame.new() end
local function doInteract(m) local pr=m:FindFirstChildWhichIsA("ProximityPrompt",true) if pr then if fireproximityprompt then fireproximityprompt(pr) else pr:InputHoldBegin() task.wait() pr:InputHoldEnd() end return true end local cd=m:FindFirstChildWhichIsA("ClickDetector",true) if cd and fireclickdetector then fireclickdetector(cd) return true end return false end
local function doNormalSteal(model, hrp, oldCf) local target=getModelPos(model)+Vector3.new(0,3,0) hrp.CFrame=target task.wait(0.2) local endT=tick()+(getgenv().SpamDuration or 2) while tick()<endT and model.Parent do doInteract(model) task.wait(0.08) end hrp.CFrame=oldCf task.wait(0.3) end
local function doSilentSteal(model, hrp, oldCf, char) char.Archivable=true local clone=char:Clone() for _,v in ipairs(clone:GetDescendants()) do if v:IsA("BasePart") then v.Anchored=true v.CanCollide=false end if v:IsA("Script") or v:IsA("LocalScript") then v:Destroy() end end clone.Parent=workspace pcall(function() clone:PivotTo(oldCf) end) local cam=workspace.CurrentCamera local hc=clone:FindFirstChildOfClass("Humanoid") local hr=char:FindFirstChildOfClass("Humanoid") if hc then cam.CameraSubject=hc end for _,p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.LocalTransparencyModifier=1 end end local target=getModelPos(model)+Vector3.new(0,3,0) hrp.CFrame=target task.wait(0.2) local endT=tick()+(getgenv().SpamDuration or 2) while tick()<endT and model.Parent do doInteract(model) task.wait(0.08) end hrp.CFrame=oldCf task.wait(0.2) for _,p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.LocalTransparencyModifier=0 end end if hr then cam.CameraSubject=hr end task.delay(0.5,function() if clone then clone:Destroy() end end) end
local function stealEgg(model) local plr=game.Players.LocalPlayer local char=plr.Character or plr.CharacterAdded:Wait() local hrp=char:FindFirstChild("HumanoidRootPart") if not hrp then return end local old=hrp.CFrame if getgenv().StealMethod=="Silent" then doSilentSteal(model, hrp, old, char) else doNormalSteal(model, hrp, old) end end

