                                if not ok then local bp = closest:IsA("BasePart") and closest or closest:FindFirstChildWhichIsA("BasePart") if bp then cPos = bp.Position ok = true end end
                                if ok then
                                    hrp.CFrame = CFrame.new(cPos + V3(0, 3, 0))
                                    FireInteract(closest)
                                    pcall(function()
                                        if firetouchinterest then
                                            local part = closest:IsA("BasePart") and closest or closest:FindFirstChildWhichIsA("BasePart")
                                            if part then firetouchinterest(hrp, part, 0) task.wait(0.05) firetouchinterest(hrp, part, 1) end
                                        end
                                    end)
                                end
                                task.wait(0.12)
                            end
                        end
                        attackStart = tick()
                    end
                    local hrp = GetHRP() if not hrp then task.wait(0.3) continue end
                    local monster = GetClosestMonster(hrp.Position) if not monster or not monster.Parent then task.wait(0.5) continue end
                    local ok, mCF = pcall(function() return monster:GetPivot() end) if not ok then task.wait(0.2) continue end
                    local mPos = mCF.Position
                    local firstTarget = (AttackMode == "Above") and (mPos + V3(0, YOffset, 0)) or (mPos - V3(0, YOffset, 0))
                    hrp.CFrame = CFrame.new(firstTarget, mPos)
                    while AutoAttackMonster and monster.Parent and GetMonsterHealth(monster) > 0 do
                        if tick() - attackStart >= AttackTimer then break end
                        hrp = GetHRP() if not hrp then break end
                        local suc, curCF = pcall(function() return monster:GetPivot() end) if not suc then break end
                        local curPos = curCF.Position
                        local stickPos = (AttackMode == "Above") and (curPos + V3(0, YOffset, 0)) or (curPos - V3(0, YOffset, 0))
                        hrp.CFrame = CFrame.new(stickPos, curPos)
                        local tool = EquipBatTool()
                        if tool then pcall(function() tool:Activate() if firesignal then firesignal(tool.Activated) end if getconnections then for _, conn in ipairs(getconnections(tool.Activated)) do conn:Fire() end end end) end
                        RS.Heartbeat:Wait()
                    end
                    task.wait(0.1)
                end
            end)
        end
    end
})

