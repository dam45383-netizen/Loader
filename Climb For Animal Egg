    New("TextLabel", {Text=weightStr, Position=UDim2.fromOffset(74,42), Size=UDim2.new(1,-84,0,16), Font=Enum.Font.GothamBold, TextSize=11, TextColor3=Color3.fromRGB(74,222,128), BackgroundTransparency=1, TextXAlignment=Enum.TextXAlignment.Left, TextTruncate=Enum.TextTruncate.AtEnd, Active=false}, card)

    local btnHolder=New("Frame", {Size=UDim2.new(0,116,0,26), Position=UDim2.new(1,-124,1,-32), BackgroundTransparency=1}, card)
    New("UIListLayout", {FillDirection=Enum.FillDirection.Horizontal, Padding=UDim.new(0,6), SortOrder=Enum.SortOrder.LayoutOrder}, btnHolder)
    local viewBtn=New("TextButton", {Size=UDim2.fromOffset(52,24), BackgroundColor3=Color3.fromRGB(45,42,70), Text="View", Font=Enum.Font.GothamBold, TextSize=11, TextColor3=Color3.fromRGB(200,200,220), AutoButtonColor=true}, btnHolder)
    New("UICorner", {CornerRadius=UDim.new(0,7)}, viewBtn)
    local stealBtn=New("TextButton", {Size=UDim2.fromOffset(52,24), BackgroundColor3=Color3.fromRGB(56,200,255), Text="Steal", Font=Enum.Font.GothamBold, TextSize=11, TextColor3=Color3.fromRGB(15,15,15), AutoButtonColor=true}, btnHolder)
    New("UICorner", {CornerRadius=UDim.new(0,7)}, stealBtn)

    local isSpectating=false
    local savedCam=nil
    local function doUnview()
        if savedCam then
            local cam=workspace.CurrentCamera
            cam.CameraType=savedCam.Type
            cam.CFrame=savedCam.CF
            cam.CameraSubject=savedCam.Subject
        end
        isSpectating=false
        viewBtn.Text="View"
        viewBtn.BackgroundColor3=Color3.fromRGB(45,42,70)
        if _G.CurrentSpectate and _G.CurrentSpectate.Button==viewBtn then _G.CurrentSpectate=nil end
    end

    viewBtn.MouseButton1Click:Connect(function()
        if not mdl.Parent then Window.Notify("Vault", "gone", Color3.fromRGB(248,113,113), 1.5) return end
        if isSpectating then doUnview() Window.Notify("Unview", mdl.Name, Color3.fromRGB(200,200,200), 1) return end
        if _G.CurrentSpectate and _G.CurrentSpectate.Restore then pcall(_G.CurrentSpectate.Restore) end
        local cam=workspace.CurrentCamera
        savedCam={CF=cam.CFrame, Type=cam.CameraType, Subject=cam.CameraSubject}
        local eggPos=getModelPos(mdl).Position
        cam.CameraType=Enum.CameraType.Scriptable
        cam.CFrame=CFrame.new(eggPos+V3(0,5,12), eggPos)
        isSpectating=true
        viewBtn.Text="Unview"
        viewBtn.BackgroundColor3=Color3.fromRGB(248,113,113)
        _G.CurrentSpectate={Button=viewBtn, Restore=doUnview}
        Window.Notify("Spectate: "..mdl.Name, areaName.." | "..rarity, Color3.fromRGB(160,160,255), 2)
        task.spawn(function()
            while isSpectating and mdl.Parent do task.wait(0.5) end
