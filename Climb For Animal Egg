    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") and GetMonsterHealth(m) > 0 then
            local ok, pos = pcall(function() return m:GetPivot().Position end)
            if ok then local d = (hrpPos - pos).Magnitude if d < dist then dist = d closest = m end end
        end
    end
    return closest
end
local function EquipBatTool()
    local char = plr.Character if not char then return nil end
    local already = char:FindFirstChild("Bat") if already then return already end
    already = char:FindFirstChildWhichIsA("Tool") if already and string.lower(already.Name):find("bat") then return already end
    if already then return already end
    local backpack = plr:FindFirstChild("Backpack") if not backpack then return nil end
    for _, t in ipairs(backpack:GetChildren()) do if t:IsA("Tool") and string.lower(t.Name):find("bat") then t.Parent = char return t end end
    local any = backpack:FindFirstChildWhichIsA("Tool") if any then any.Parent = char return any end
