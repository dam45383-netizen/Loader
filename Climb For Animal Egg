local function isUUID(s) return s:match("^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$") ~= nil end
local function safeClick(btn)
    if not btn or not btn:IsA("GuiButton") then return end
    if firesignal then pcall(function() firesignal(btn.Activated) end) pcall(function() firesignal(btn.MouseButton1Click) end) return true
    elseif getconnections then for _, ev in ipairs({"Activated","MouseButton1Click"}) do local ok, cons = pcall(function() return getconnections(btn[ev]) end) if ok and cons then for _, c in ipairs(cons) do pcall(function() c:Fire() end) end return true end end end
    return false
end
local function getTreadmillButtons()
    local out = {} local pg = plr:FindFirstChild("PlayerGui") if not pg then return out end
    local general = pg:FindFirstChild("General") if not general then for _,v in ipairs(pg:GetDescendants()) do if v.Name=="General" then general=v break end end end
    local root = general or pg
    for _, obj in ipairs(root:GetDescendants()) do if obj:IsA("ImageButton") and isUUID(obj.Name) then table.insert(out, obj) end end
    if #out == 0 then for _, obj in ipairs(root:GetDescendants()) do if obj:IsA("Frame") and isUUID(obj.Name) then for _, d in ipairs(obj:GetDescendants()) do if d:IsA("ImageButton") then table.insert(out, d) break end end end end end
    return out
end
local function clickX2()
    local btns = getTreadmillButtons()
    for _, btn in ipairs(btns) do
        local should = (#btns <= 2)
        if not should then local p = btn.Parent for i=1,4 do if not p then break end for _, d in ipairs(p:GetDescendants()) do if d:IsA("TextLabel") and string.lower(d.Text):find("2") then should=true break end end if should then break end p = p.Parent end else should=true end
        if should then safeClick(btn) end
    end
end
