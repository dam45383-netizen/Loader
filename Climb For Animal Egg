local function getAllVaultModels()
    local sp=workspace:FindFirstChild("SpawnedEggs")
    if not sp then return {} end
    local list={}
    local toScan={}
    if currentFilter and currentFilter~="All" then local t=sp:FindFirstChild(currentFilter) if t then toScan={t} end else toScan=sp:GetChildren() end
    for _,folder in ipairs(toScan) do
        if folder:IsA("Folder") or folder:IsA("Model") then
            for _,mdl in ipairs(folder:GetChildren()) do if mdl:IsA("Model") then table.insert(list,{mdl=mdl, area=folder.Name}) end end
        end
    end
    if currentSearch and currentSearch~="" then
        local q=string.lower(currentSearch)
        local f2={}
        for _,it in ipairs(list) do local rar=getRarityFromModel(it.mdl) or "" if string.lower(it.mdl.Name):find(q,1,true) or string.lower(rar):find(q,1,true) then table.insert(f2,it) end end
        list=f2
    end
    return list
end

