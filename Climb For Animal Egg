    resize.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then resizing=true rStart=input.Position rSize=Vector2.new(panel.Size.X.Offset,panel.Size.Y.Offset) end end)
