local function createEggCard(parent, mdl)
    local rarity,variant,weight=getEggInfo(mdl)
    local hold=New("Frame", {Size=UDim2.new(1,0,0,74), BackgroundTransparency=1}, parent)
    local btn=New("TextButton", {Size=UDim2.fromScale(1,1), BackgroundColor3=T.card, AutoButtonColor=false, Text=""}, hold)
