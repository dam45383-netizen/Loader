local function getWalkSpeed()
    local char = plr.Character
    if not char then return 16 end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.WalkSpeed > 0 then return hum.WalkSpeed end
    return 16
end

local function tweenTo(hrp, targetCf)
    if not hrp or not hrp.Parent then return end
    local speed = getgenv().TweenSpeed or 100
    local dist = (hrp.Position - targetCf.Position).Magnitude
    local dur = dist / speed
    if dur < 0.08 then dur = 0.08 end
    pcall(function()
        local tw = TS:Create(hrp, TweenInfo.new(dur, Enum.EasingStyle.Linear), {CFrame = targetCf})
        tw:Play() tw.Completed:Wait()
    end)
end

local function tweenToSpeed(hrp, targetCf, speed)
    if not hrp or not hrp.Parent then return end
    speed = speed or 16
    local dist = (hrp.Position - targetCf.Position).Magnitude
    local dur = dist / speed
    if dur < 0.08 then dur = 0.08 end
    pcall(function()
        local tw = TS:Create(hrp, TweenInfo.new(dur, Enum.EasingStyle.Linear), {CFrame = targetCf})
        tw:Play() tw.Completed:Wait()
    end)
end

local function tweenToDuration(hrp, targetCf, dur)
    if not hrp or not hrp.Parent then return end
    dur = dur or 1
    if dur < 0.05 then dur = 0.05 end
    pcall(function()
        local tw = TS:Create(hrp, TweenInfo.new(dur, Enum.EasingStyle.Linear), {CFrame = targetCf})
        tw:Play() tw.Completed:Wait()
    end)
end

local function tweenToY(hrp, targetY)
    if not hrp or not hrp.Parent then return end
    local cur = hrp.Position
    tweenTo(hrp, CFrame.new(cur.X, targetY, cur.Z))
end
local function tweenToXZ(hrp, targetPos)
    if not hrp or not hrp.Parent then return end
    local cur = hrp.Position
    tweenTo(hrp, CFrame.new(targetPos.X, cur.Y, targetPos.Z))
end

local function doReturnToBase(hrp)
    local mode = getgenv().BackToBaseMode or "Blatant"
    if mode == "Legit" then
        local ws = getWalkSpeed()
        tweenToSpeed(hrp, CFrame.new(STAGING_CF.Position.X, hrp.Position.Y, STAGING_CF.Position.Z), ws)
        tweenToSpeed(hrp, STAGING_CF, ws)
        tweenToSpeed(hrp, BASE_CF, ws)
    else
        local d = getgenv().BackToBaseDuration or 1
        tweenToDuration(hrp, CFrame.new(STAGING_CF.Position.X, hrp.Position.Y, STAGING_CF.Position.Z), d)
        tweenToDuration(hrp, STAGING_CF, d)
        tweenToDuration(hrp, BASE_CF, d)
    end
end

