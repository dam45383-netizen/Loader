local function GetEggFolder(areaName)
    local se = workspace:FindFirstChild("SpawnedEggs")
    if se and se:FindFirstChild(areaName) then return se:FindFirstChild(areaName) end
    local hSe = workspace:FindFirstChild("HalloweenDimension") and workspace.HalloweenDimension:FindFirstChild("SpawnedEggs")
