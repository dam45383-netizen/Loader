-- GUARD TAB - FIXED ANTI GUARD (desc jadi " " + notif blocked nama model)
local GuardTab = Window:Tab({Title = "Guard", Icon = "G"})
local GuardAcc = GuardTab:Accordion({Title = "Guard", Open = true})

local function scanGuardIds()
    getgenv().MyGuardIds={}
    getgenv().MyGuardNames={}
    local count=0
    local function addId(id, name)
        if id and type(id)=="string" and #id>=20 then
            getgenv().MyGuardIds[id]=true
            getgenv().MyGuardNames[id]=name or id
            count+=1
        end
    end
    for _,folder in ipairs({workspace:FindFirstChild("LocalGuards"), workspace:FindFirstChild("Guards"), workspace:FindFirstChild("SpawnedGuards")}) do
        if folder then
            for _,m in ipairs(folder:GetChildren()) do
                if m:IsA("Model") then
                    local id=m:GetAttribute("Id") or m:GetAttribute("ID") or m:GetAttribute("GuardId")
                    if not id then local o=m:FindFirstChild("Id") if o and o.Value then id=o.Value end end
                    if id then addId(tostring(id), m.Name) end
                end
            end
        end
    end
    if count==0 then
        for _,obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") then
                local id=obj:GetAttribute("Id")
                if id and type(id)=="string" and id:find("-") and #id>=32 then
                    addId(id, obj.Name)
                end
            end
        end
    end
    return count
end

local function setupAntiGuardHook()
    if getgenv().GuardHooked then return end
    getgenv().GuardHooked=true
    local rf=nil
    pcall(function() rf=game.ReplicatedStorage.src.Packages._Index["sleitnick_knit@1.7.0"].knit.Services.GuardService.RF.Capture end)
    local oldNC
    oldNC=hookmetamethod(game,"__namecall",newcclosure(function(self,...)
        local method=getnamecallmethod()
        if getgenv().AntiGuard and method=="InvokeServer" and self.Name=="Capture" then
            local id=({...})[1]
            if id then
                local sid=tostring(id)
                local shouldBlock = getgenv().MyGuardIds[sid] or next(getgenv().MyGuardIds)==nil
                if shouldBlock then
                    local modelName = getgenv().MyGuardNames[sid] or sid
                    Window.Notify("Anti Guard","blocked ("..modelName..")",T.bad,2)
                    return nil
                end
            end
        end
        return oldNC(self,...)
    end))
    if rf and hookfunction then
        local oldInvoke
        oldInvoke=hookfunction(rf.InvokeServer,function(self,id,a,b)
            if getgenv().AntiGuard then
                local sid=tostring(id)
                local shouldBlock = getgenv().MyGuardIds[sid] or next(getgenv().MyGuardIds)==nil
                if shouldBlock then
                    local modelName = getgenv().MyGuardNames[sid] or sid
                    Window.Notify("Anti Guard","blocked ("..modelName..")",T.bad,2)
                    return nil
                end
            end
            return oldInvoke(self,id,a,b)
        end)
    end
end

GuardAcc:Toggle({Title="Anti Guard (FIXED)", Desc=" ", Flag="AntiGuard", Default=false, Callback=function(v)
    getgenv().AntiGuard=v
    if v then
        local c=scanGuardIds()
        setupAntiGuardHook()
        Window.Notify("Anti Guard","ON • Found "..c.." guards",T.ok,4)
    else
        Window.Notify("Anti Guard","OFF",T.dim,2)
    end
end})
GuardAcc:Button({Title="Refresh Guard IDs", Desc=" ", Callback=function() local c=scanGuardIds() Window.Notify("Anti Guard","Refreshed • "..c.." found",T.accent,3) end})

