local function New(c,p,par) local o=Instance.new(c) if p then for k,v in pairs(p) do pcall(function() o[k]=v end) end end if par then o.Parent=par end return o end

local RARITY_WEIGHT = {["Common"]=1,["Rare"]=3,["Epic"]=5,["Legendary"]=6,["Mythic"]=7,["Secret"]=8,["Divine"]=9,["Godly"]=10,["Exclusive"]=27}
local function isBlockedModel(name) return string.lower(tostring(name)):find("nest") ~= nil end
local function getRarityFromModel(m) local r=m:GetAttribute("Rarity") if r~=nil then return tostring(r) end r=m:GetAttribute("rarity") if r~=nil then return tostring(r) end return nil end
local function getWeight(n) if not n then return 0 end local l=string.lower(tostring(n)) for k,v in pairs(RARITY_WEIGHT) do if l==string.lower(k) or l:find(string.lower(k)) then return v end end return 4 end

local function getRarityList()
    local seen={} local list={"All"}
    local sp=workspace:FindFirstChild("SpawnedEggs")
    if sp then
        for _,folder in ipairs(sp:GetChildren()) do
            if folder:IsA("Folder") or folder:IsA("Model") then
                for _,mdl in ipairs(folder:GetChildren()) do
                    if mdl:IsA("Model") then
                        local rar=getRarityFromModel(mdl)
                        if rar and rar~="" and not seen[rar] then seen[rar]=true table.insert(list,rar) end
                    end
                end
                if folder:IsA("Model") then
                    local rar=getRarityFromModel(folder)
                    if rar and rar~="" and not seen[rar] then seen[rar]=true table.insert(list,rar) end
                end
            end
        end
    end
    table.sort(list,function(a,b) if a=="All" then return true end if b=="All" then return false end return getWeight(a) > getWeight(b) end)
    return list
end

local function getEggAreaList() local f=workspace:FindFirstChild("SpawnedEggs") if not f then return {"All"} end local list={"All"} for _,c in ipairs(f:GetChildren()) do table.insert(list,c.Name) end return list end

local function getAllEggModels(area, query, rarityOverride)
    local sp=workspace:FindFirstChild("SpawnedEggs") if not sp then return {} end
    local effArea=area or getgenv().SelectedEggArea or "All"
    local effRarity=rarityOverride
    if effRarity==nil then effRarity=getgenv().SelectedRarityFilter or "All" end
    local toScan={} if effArea and effArea~="All" then local t=sp:FindFirstChild(effArea) if t then toScan={t} end else toScan=sp:GetChildren() end
    local list={}
    for _,folder in ipairs(toScan) do
        if folder:IsA("Folder") or folder:IsA("Model") then
            for _,mdl in ipairs(folder:GetChildren()) do
                if mdl:IsA("Model") and not isBlockedModel(mdl.Name) then table.insert(list,mdl) end
            end
            if folder:IsA("Model") and not isBlockedModel(folder.Name) then table.insert(list,folder) end
        end
    end
    if effRarity~="All" then
        local rf=string.lower(effRarity) local f2={}
        for _,m in ipairs(list) do local rar=getRarityFromModel(m) or "" if string.lower(rar)==rf then table.insert(f2,m) end end
        list=f2
    end
    if query and query~="" then local q=string.lower(query) local f2={} for _,m in ipairs(list) do local rar=getRarityFromModel(m) or "" if string.lower(m.Name):find(q,1,true) or string.lower(rar):find(q,1,true) then table.insert(f2,m) end end list=f2 end
    table.sort(list,function(a,b) return getWeight(getRarityFromModel(a)) > getWeight(getRarityFromModel(b)) end)
    return list
end

local function getModelPos(m) if m.PrimaryPart then return m.PrimaryPart.CFrame end local ok,cf=pcall(function() return m:GetPivot() end) if ok then return cf end local p=m:FindFirstChildWhichIsA("BasePart",true) if p then return p.CFrame end return CFrame.new() end
local function doInteract(m) local pr=m:FindFirstChildWhichIsA("ProximityPrompt",true) if pr then if fireproximityprompt then fireproximityprompt(pr) else pr:InputHoldBegin() task.wait() pr:InputHoldEnd() end return true end local cd=m:FindFirstChildWhichIsA("ClickDetector",true) if cd and fireclickdetector then fireclickdetector(cd) return true end return false end
local function doNormalSteal(model, hrp, oldCf) local target=getModelPos(model)+Vector3.new(0,3,0) hrp.CFrame=target task.wait(0.2) local endT=tick()+(getgenv().SpamDuration or 2) while tick()<endT and model.Parent do doInteract(model) task.wait(0.08) end hrp.CFrame=oldCf task.wait(0.3) end
local function doSilentSteal(model, hrp, oldCf, char) char.Archivable=true local clone=char:Clone() for _,v in ipairs(clone:GetDescendants()) do if v:IsA("BasePart") then v.Anchored=true v.CanCollide=false end if v:IsA("Script") or v:IsA("LocalScript") then v:Destroy() end end clone.Parent=workspace pcall(function() clone:PivotTo(oldCf) end) local cam=workspace.CurrentCamera local hc=clone:FindFirstChildOfClass("Humanoid") local hr=char:FindFirstChildOfClass("Humanoid") if hc then cam.CameraSubject=hc end for _,p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.LocalTransparencyModifier=1 end end local target=getModelPos(model)+Vector3.new(0,3,0) hrp.CFrame=target task.wait(0.2) local endT=tick()+(getgenv().SpamDuration or 2) while tick()<endT and model.Parent do doInteract(model) task.wait(0.08) end hrp.CFrame=oldCf task.wait(0.2) for _,p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.LocalTransparencyModifier=0 end end if hr then cam.CameraSubject=hr end task.delay(0.5,function() if clone then clone:Destroy() end end) end
local function stealEgg(model) if isBlockedModel(model.Name) then return end local char=plr.Character or plr.CharacterAdded:Wait() local hrp=char:FindFirstChild("HumanoidRootPart") if not hrp then return end local old=hrp.CFrame if getgenv().StealMethod=="Silent" then doSilentSteal(model, hrp, old, char) else doNormalSteal(model, hrp, old) end end

local function getEggInfo(m)
    local a=m:GetAttributes()
    local rarity=a.Rarity or a.rarity or getRarityFromModel(m) or "?"
    local variant=a.Variant or a.variant or a.Mutation or a.mutation or a.Trait or "-"
    local weight=a.WeightKg or a.WeightKG or a.Weight or a.KG or a.kg or a.Mass or 0
    if typeof(weight)=="number" then weight=string.format("%.2f Kg", weight) end
    return tostring(rarity), tostring(variant), tostring(weight)
end
local function setupViewport(vp, mdl)
    pcall(function()
        vp:ClearAllChildren()
        local clone=mdl:Clone()
        for _,d in ipairs(clone:GetDescendants()) do if d:IsA("Script") or d:IsA("LocalScript") then d:Destroy() end if d:IsA("BasePart") then d.Anchored=true d.CanCollide=false end end
        clone.Parent=vp
        local cam=New("Camera", {}, vp) vp.CurrentCamera=cam
        local cf,size=clone:GetBoundingBox()
        local md=math.max(size.X,size.Y,size.Z) if md<0.5 then md=4 end
        cam.CFrame=CFrame.new(cf.Position+Vector3.new(0, md*0.2, md*1.8), cf.Position)
        cam.FieldOfView=42
    end)
end

