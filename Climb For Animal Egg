local function setupViewport(vp, mdl) pcall(function() vp:ClearAllChildren() local clone=mdl:Clone() for _,d in ipairs(clone:GetDescendants()) do if d:IsA("Script") or d:IsA("LocalScript") then d:Destroy() end if d:IsA("BasePart") then d.Anchored=true d.CanCollide=false end end clone.Parent=vp local cam=New("Camera", {}, vp) vp.CurrentCamera=cam local cf,size=clone:GetBoundingBox() local md=math.max(size.X,size.Y,size.Z) if md<0.5 then md=4 end cam.CFrame=CFrame.new(cf.Position+V3(0, md*0.2, md*1.8), cf.Position) cam.FieldOfView=42 end) end

local VaultPanel = Window:Panel({Title="Egg Vault", Width=420, Open=false, GripY=0.35})

local function getPanelScroll()
    local function findPanel()
        local hosts = {}
        local pg = plr:FindFirstChild("PlayerGui")
        if pg then table.insert(hosts, pg) end
        pcall(function() if gethui then local h=gethui() if h then table.insert(hosts, h) end end end)
        for _, host in ipairs(hosts) do
            local gui = host:FindFirstChild("SORU_HUB")
            if gui then
                local p = gui:FindFirstChild("SORU_Panel", true)
                if p then return p end
                for _,v in ipairs(gui:GetDescendants()) do if v.Name=="SORU_Panel" then return v end end
            end
        end
        return nil
    end
    local t0 = tick() + 10
    while tick() < t0 do
        local panel = findPanel()
        if panel then
            local body = panel:FindFirstChild("Body", true)
            if body then
                for _, d in ipairs(body:GetDescendants()) do
                    if d:IsA("ScrollingFrame") then return d end
                end
            end
        end
        task.wait(0.2)
    end
    return nil
end

