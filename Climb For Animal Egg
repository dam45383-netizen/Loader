local function setupViewport(vp, mdl) pcall(function() vp:ClearAllChildren() local clone=mdl:Clone() for _,d in ipairs(clone:GetDescendants()) do if d:IsA("Script") or d:IsA("LocalScript") then d:Destroy() end if d:IsA("BasePart") then d.Anchored=true d.CanCollide=false end end clone.Parent=vp local cam=New("Camera", {}, vp) vp.CurrentCamera=cam local cf,size=clone:GetBoundingBox() local md=math.max(size.X,size.Y,size.Z) if md<0.5 then md=4 end cam.CFrame=CFrame.new(cf.Position+Vector3.new(0, md*0.2, md*1.8), cf.Position) cam.FieldOfView=42 end) end
