        task.spawn(function()
            local eggPos=getModelPos(mdl).Position
            local yAligned=V3(STAGE_POS.X, eggPos.Y, STAGE_POS.Z)
            Window.Notify(mdl.Name, areaName.." | "..rarity, Color3.fromRGB(56,200,255), 2)
            TweenTo(yAligned)
            TweenTo(eggPos+V3(0,1,0))
            repeat FireInteract(mdl) task.wait(0.2) until IsDropOn() or not mdl.Parent
            if IsDropOn() then
                TweenTo(yAligned)
                repeat task.wait(0.5) until not IsDropOn()
            end
        end)
    end)
end

local function getAllVaultModels()
    local sp=workspace:FindFirstChild("SpawnedEggs")
    if not sp then return {} end
    local list={}
    local toScan={}
    if currentFilter and currentFilter~="All" then local t=sp:FindFirstChild(currentFilter) if t then toScan={t} end else toScan=sp:GetChildren() end
    for _,folder in ipairs(toScan) do
        if folder:IsA("Folder") or folder:IsA("Model") then
            for _,mdl in ipairs(folder:GetChildren()) do if mdl:IsA("Model") then table.insert(list,{mdl=mdl, area=folder.Name}) end end
        end
    end
    if currentSearch and currentSearch~="" then
        local q=string.lower(currentSearch)
        local f2={}
        for _,it in ipairs(list) do local rar=getRarityFromModel(it.mdl) or "" if string.lower(it.mdl.Name):find(q,1,true) or string.lower(rar):find(q,1,true) then table.insert(f2,it) end end
        list=f2
    end
    return list
end

local function refreshVault()
    local cont = ensureEggContainer()
    if not cont then return end
    for _,c in ipairs(cont:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
    local models=getAllVaultModels()
    countLabel:Set(#models.." eggs")
    VaultPanel:SetTitle("Egg Vault ("..#models..")")
    for _,it in ipairs(models) do if it.mdl.Parent then createEggCard(cont,it.mdl,it.area) end end
end
_G._refreshVault=refreshVault

