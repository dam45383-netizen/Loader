local function scanGuardIds() getgenv().MyGuardIds={} getgenv().MyGuardNames={} local c=0 local function addId(id,name) if id and type(id)=="string" and #id>=20 then getgenv().MyGuardIds[id]=true getgenv().MyGuardNames[id]=name or id c+=1 end end for _,folder in ipairs({workspace:FindFirstChild("LocalGuards"), workspace:FindFirstChild("Guards"), workspace:FindFirstChild("SpawnedGuards")}) do if folder then for _,m in ipairs(folder:GetChildren()) do if m:IsA("Model") then local id=m:GetAttribute("Id") or m:GetAttribute("ID") if not id then local o=m:FindFirstChild("Id") if o and o.Value then id=o.Value end end if id then addId(tostring(id), m.Name) end end end end end if c==0 then for _,obj in ipairs(workspace:GetDescendants()) do if obj:IsA("Model") then local id=obj:GetAttribute("Id") if id and type(id)=="string" and id:find("-") and #id>=32 then addId(id,obj.Name) end end end end return c end
local function setupAntiGuardHook() if getgenv().GuardHooked then return end getgenv().GuardHooked=true local rf=nil pcall(function() rf=game.ReplicatedStorage.src.Packages._Index["sleitnick_knit@1.7.0"].knit.Services.GuardService.RF.Capture end) local oldNC oldNC=hookmetamethod(game,"__namecall",newcclosure(function(self,...) local m=getnamecallmethod() if getgenv().AntiGuard and m=="InvokeServer" and self.Name=="Capture" then local id=({...})[1] if id then local sid=tostring(id) if getgenv().MyGuardIds[sid] or next(getgenv().MyGuardIds)==nil then Window.Notify("Anti Guard","blocked ("..(getgenv().MyGuardNames[sid] or sid)..")",T.bad,2) return nil end end end return oldNC(self,...) end)) if rf and hookfunction then local oldI oldI=hookfunction(rf.InvokeServer,function(self,id,a,b) if getgenv().AntiGuard then local sid=tostring(id) if getgenv().MyGuardIds[sid] or next(getgenv().MyGuardIds)==nil then Window.Notify("Anti Guard","blocked ("..(getgenv().MyGuardNames[sid] or sid)..")",T.bad,2) return nil end end return oldI(self,id,a,b) end) end end
