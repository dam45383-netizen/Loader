local function safeClick(btn)
    if not btn or not btn.Parent or not btn.Visible then return end
    local p = btn.Parent
    while p and p ~= playerGui do if p:IsA("GuiObject") and not p.Visible then return end p = p.Parent end
    pcall(function()
        if firesignal then firesignal(btn.Activated)
        elseif getconnections then for _,c in pairs(getconnections(btn.Activated)) do c:Fire() end
        else btn:Activate() end
    end)
end

