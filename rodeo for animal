-- BASE LOCK ROT Y 15
local BASE_V3 = V3(-2.3, 15.0, -287.8)
local BASE_ROT_Y = 15
local BASE_CF = CF(-2.3, 15.0, -287.8) * CFrame.Angles(0, math.rad(BASE_ROT_Y), 0)

local function goToBase()
    local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if getgenv().BaseMode == "Teleport" then
        hrp.CFrame = BASE_CF
    else
        local dist = (hrp.Position - BASE_V3).Magnitude
        local dur = math.clamp(dist / (getgenv().BaseSpeed or 25), 0.25, 12)
        TweenService:Create(hrp, TweenInfo.new(dur, Enum.EasingStyle.Linear), {CFrame = BASE_CF}):Play()
    end
end

local function isRidePrompt(p)
    for _, txt in ipairs({p.ActionText or "", p.ObjectText or "", p.Name or "", p.Parent and p.Parent.Name or ""}) do
        if string.lower(txt):find("ride") then return true end
    end
    return false
end
ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
    if player == plr and getgenv().AutoBase and isRidePrompt(prompt) then
        task.wait(0.35)
        goToBase()
    end
end)

