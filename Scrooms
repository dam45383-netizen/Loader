local function normalizePriorityList(v)
	if type(v) == "string" then
		if v == "" then return {} end
		return { v }
	end
	if type(v) == "table" then
		local out = {}
		local seen = {}
		for _, item in ipairs(v) do
			if type(item) == "string" and item ~= "" and not seen[item] then seen[item] = true out[#out + 1] = item end
		end
		if #out == 0 then
			for k, val in pairs(v) do
				if val == true and type(k) == "string" and k ~= "" and not seen[k] then seen[k] = true out[#out + 1] = k end
			end
		end
		table.sort(out)
		return out
	end
	return {}
end
