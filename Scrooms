----------------------------------------------------------------------
-- FPS boost (semua reversible)
----------------------------------------------------------------------
local Fps = { cache = {}, scanId = {}, saved = {}, special = {}, activeWorkspace = {} }

local OFF = { Enabled = false }
local HIDDEN = { Transparency = 1 }
local NO_SHADOW = { CastShadow = false }
local FLAT = { Material = Enum.Material.SmoothPlastic, Reflectance = 0 }
local LOW_MESH = { RenderFidelity = Enum.RenderFidelity.Performance }
local NO_ATMOSPHERE = { Density = 0, Haze = 0 }
local NO_GLOBAL_SHADOWS = { GlobalShadows = false }
local LOW_LIGHTING = { Technology = Enum.Technology.Compatibility, EnvironmentDiffuseScale = 0, EnvironmentSpecularScale = 0 }
local LOW_TERRAIN = { Decoration = false, WaterWaveSize = 0, WaterTransparency = 1, WaterReflectance = 0, WaterWaveSpeed = 0 }
local NO_FOG = { FogStart = 0, FogEnd = 100000 }

local EFFECT_CLASSES = { "BloomEffect", "BlurEffect", "SunRaysEffect", "ColorCorrectionEffect", "DepthOfFieldEffect" }
local PARTICLE_CLASSES = { "ParticleEmitter", "Fire", "Smoke", "Sparkles" }
local function isAny(inst, classes)
	for _, className in classes do
		if inst:IsA(className) then return true end
	end
	return false
end

local function capture(inst, props)
	local original = {}
	for prop in props do
		local ok, value = pcall(function() return inst[prop] end)
		if ok then original[prop] = value end
	end
	return original
end
local function write(inst, props)
	for prop, value in props do pcall(function() inst[prop] = value end) end
end
local function toggleProps(key, inst, props, on)
	if on then
		if not Fps.saved[key] then Fps.saved[key] = capture(inst, props) end
		write(inst, props)
	elseif Fps.saved[key] then
		write(inst, Fps.saved[key])
		Fps.saved[key] = nil
	end
end

-- Rule per-instance: props(inst) return tabel property yang mau dipaksa, atau nil kalau gak cocok.
Fps.rules = {
	shadows = {
		scope = "workspace",
		props = function(i) if i:IsA("BasePart") then return NO_SHADOW end end,
		extra = function(on) toggleProps("globalShadows", Lighting, NO_GLOBAL_SHADOWS, on) end,
	},
	particles = {
		scope = "workspace",
		props = function(i) if isAny(i, PARTICLE_CLASSES) then return OFF end end,
	},
	trails = {
		scope = "workspace",
		props = function(i) if i:IsA("Trail") or i:IsA("Beam") then return OFF end end,
	},
	decals = {
		scope = "workspace",
		props = function(i) if i:IsA("Decal") or i:IsA("Texture") then return HIDDEN end end,
	},
	lowMaterials = {
		scope = "workspace",
		props = function(i) if i:IsA("BasePart") and not i:IsA("Terrain") then return FLAT end end,
	},
	mesh = {
		scope = "workspace",
		props = function(i) if i:IsA("MeshPart") then return LOW_MESH end end,
	},
	hideAccessories = {
		scope = "workspace",
		props = function(i)
			if i.Name ~= "Handle" or not i:IsA("BasePart") then return end
			local accessory = i.Parent
			if not (accessory and accessory:IsA("Accessory")) then return end
			local owner = accessory.Parent and Players:GetPlayerFromCharacter(accessory.Parent)
			if owner and owner ~= player then return HIDDEN end
		end,
	},
	lightingEffects = {
		scope = "lighting",
		props = function(i)
			if i:IsA("Atmosphere") then return NO_ATMOSPHERE end
			if isAny(i, EFFECT_CLASSES) then return OFF end
		end,
	},
}
for feature in Fps.rules do
	Fps.cache[feature] = setmetatable({}, { __mode = "k" })
	Fps.scanId[feature] = 0
end

-- Fitur yang bukan per-instance
function Fps.special.lowGraphics(on)
	toggleProps("lowLighting", Lighting, LOW_LIGHTING, on)
	pcall(function()
		local rendering = settings().Rendering
		if on then
			if Fps.saved.quality == nil then Fps.saved.quality = rendering.QualityLevel end
			rendering.QualityLevel = Enum.QualityLevel.Level01
		elseif Fps.saved.quality ~= nil then
			rendering.QualityLevel = Fps.saved.quality
			Fps.saved.quality = nil
		end
	end)
end
function Fps.special.terrain(on)
	local terrain = Workspace:FindFirstChildOfClass("Terrain")
	if terrain then toggleProps("terrain", terrain, LOW_TERRAIN, on) end
end
function Fps.special.fog(on)
	toggleProps("fog", Lighting, NO_FOG, on)
end

function Fps.apply(feature, inst)
	local props = Fps.rules[feature].props(inst)
	if not props then return end
	local cache = Fps.cache[feature]
	if not cache[inst] then cache[inst] = capture(inst, props) end
	write(inst, props)
end

function Fps.scan(feature, id)
	local list = if Fps.rules[feature].scope == "lighting" then Lighting:GetChildren() else Workspace:GetDescendants()
	for index, inst in list do
		Fps.apply(feature, inst)
		if index % 2000 == 0 then
			task.wait()
			if Fps.scanId[feature] ~= id or not state.alive then return end
		end
	end
end

function Fps.restore(feature)
	local cache = Fps.cache[feature]
	for inst, original in cache do
		if inst.Parent ~= nil then write(inst, original) end
	end
	table.clear(cache)
end

function Fps.rebuildActive()
	local active = {}
	for feature, rule in Fps.rules do
		if state.fps[feature] and rule.scope == "workspace" then active[#active + 1] = feature end
	end
	Fps.activeWorkspace = active
end

function Fps.set(feature, on)
	if state.fps[feature] == nil then return false end
	on = on == true
	state.fps[feature] = on
	local special = Fps.special[feature]
	if special then pcall(special, on) end
	local rule = Fps.rules[feature]
	if rule then
		if rule.extra then pcall(rule.extra, on) end
		Fps.scanId[feature] += 1
		if on then
			task.spawn(Fps.scan, feature, Fps.scanId[feature])
		else
			Fps.restore(feature)
		end
	end
	Fps.rebuildActive()
	queueSave()
	return true
end

connect(Workspace.DescendantAdded, function(inst)
	local active = Fps.activeWorkspace
	if #active == 0 then return end
	for _, feature in active do pcall(Fps.apply, feature, inst) end
end)
connect(Lighting.ChildAdded, function(inst)
	if state.fps.lightingEffects then pcall(Fps.apply, "lightingEffects", inst) end
end)

----------------------------------------------------------------------
-- Loop utama (Heartbeat)
----------------------------------------------------------------------
local function skipTutorial()
	if not (isInstant() or isLegit()) or state.round == nil then return end
	local tutorial = registry.UI and registry.UI.Tutorial
	if type(tutorial) ~= "table" or tutorial._lesson ~= state.round then return end
	local gui = tutorial.GUI
	local skip = if type(gui) == "table" then gui.SkipMinigame else nil
	if type(skip) ~= "table" or not skip.Visible then return end
	local button = skip.Button
	if button == nil then return end
	local activated = if typeof(button) == "Instance" then (button:FindFirstChild("Activated") or button.Activated) else button.Activated
	fireSignal(activated)
end

local function checkPendingTimeout()
	local pending = session.pending
	if not pending then return end
	castBlock(lockId .. "_pending", true)
	if os.clock() - pending.startedAt < 12 then return end
	local gotNewItem = false
	for uid in getItems() do
		if not pending.beforeItems[uid] then
			gotNewItem = true
			break
		end
	end
	clearPending()
	if not (gotNewItem and (player:GetAttribute("catches") or 0) > pending.beforeCount) then
		state.autoCatch = false
		setMessage("Catch timed out. Auto catch stopped")
	end
end

local function tryAutoCast()
	if not state.autoCatch or state.selling or state.restoring or session.pending or minigame.InSession
		or state.stage or os.clock() < state.nextCast then
		return
	end
	state.nextCast = os.clock() + 1

	local humanoid = currentHumanoid()
	local noCastBlocks = minigame.CastBlocks == nil or next(minigame.CastBlocks) == nil
	local noEquipLocks = inventory.EquipLocks == nil or next(inventory.EquipLocks) == nil
	if not (humanoid and humanoid.Health > 0 and noCastBlocks and noEquipLocks) then return end
	local dialogue = ctl.Dialogue
	if inventory.EquipBlock or (dialogue ~= nil and dialogue.Session) or UserInputService:GetFocusedTextBox() then return end

	if inventory:GetEquipped() ~= "instrument" then
		if inventory.Cache and inventory.Cache.instrument then pcall(function() inventory:Equip("instrument") end) end
		return
	end
	local readyAt = if type(minigame._readyAt) == "number" then minigame._readyAt else 0
	if os.clock() < readyAt then return end
	local actions = ctl.Input and ctl.Input.Actions
	local cast = actions and actions.Cast
	fireSignal(cast and cast.Pressed)
end

local function tick()
	if type(state.round) == "table" and not state.round._jan then
		state.stage, state.round = nil, nil
		unhookAll()
	end
	skipTutorial()
	checkPendingTimeout()
	if state.saveAt and os.clock() >= state.saveAt then saveConfig() end
	tryAutoCast()
end

local logicElapsed, lastLoopError = 0, nil
connect(RunService.Heartbeat, function(deltaTime)
	if state.walkspeedEnabled then applyWalkspeed() end
	logicElapsed += deltaTime
	if logicElapsed < 0.1 then return end
	logicElapsed = 0
	local ok, err = pcall(tick)
	if not ok and err ~= lastLoopError then
		lastLoopError = err
		warn("Scrooms loop: " .. tostring(err))
	end
end)

local idleWarned = false
connect(player.Idled, function()
	if not state.alive then return end
	local ok, err = pcall(function()
		VirtualUser:CaptureController()
		local camera = Workspace.CurrentCamera
		VirtualUser:ClickButton2(Vector2.zero, if camera then camera.CFrame else CFrame.identity)
	end)
	if not ok and not idleWarned then
		idleWarned = true
		warn("Scrooms: anti-AFK gak bisa jalan: " .. tostring(err))
	end
end)

