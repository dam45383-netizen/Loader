local function setFavorite(uid, value)
	local item = getItems()[uid]
	if not item or (item.favorited == true) == value then return true end
	local remaining = 1 - (os.clock() - session.lastFavoriteNetwork)
	if remaining > 0 then task.wait(remaining) end
	throttle()
	if inventoryRemote == nil then return false end
	inventoryRemote:FireServer("toggleFavorite", { uid = uid })
	session.lastFavoriteNetwork = os.clock()
	return waitUntil(function()
		local current = getItems()[uid]
		return current == nil or (current.favorited == true) == value
	end, 4)
end

local function setSaleSetting(name, value)
	local ok, current = pcall(function() return ctl.Settings:Get(name) end)
	if ok and current == value then return true end
	throttle()
	if not pcall(function() ctl.Settings:Set(name, value) end) then return false end
	return waitUntil(function()
		local okGet, v = pcall(function() return data:Get({ "Settings", name }) end)
		return okGet and v == value
	end, 4)
end

local function restoreBackup(backup)
	if type(backup) ~= "table" then return false end
	local favorites, settingValues = backup.favorites or {}, backup.settings or {}
	local complete = true
	for uid, value in favorites do
		local ok, done = pcall(setFavorite, uid, value)
		if not ok or not done then complete = false end
	end
	for name, value in settingValues do
		local ok, done = pcall(setSaleSetting, name, value)
		if not ok or not done then complete = false end
	end
	if complete then
		task.wait(0.2)
		local current = getItems()
		for uid, value in favorites do
			local item = current[uid]
			if item and (item.favorited == true) ~= value then complete = false end
		end
		for name, value in settingValues do
			local ok, now = pcall(function() return ctl.Settings:Get(name) end)
			if ok and now ~= value then complete = false end
		end
	end
	return complete and writeBackup(nil)
end

-- Dipanggil pas start: tunggu sale lama selesai, lalu balikin backup kalau ada.
local function recoverSale()
	state.restoring = true
	while session.saleToken do
		if session.saleWorker and coroutine.status(session.saleWorker) == "dead" then
			session.saleToken, session.saleWorker = nil, nil
			break
		end
		if not state.alive then return end
		task.wait(0.1)
	end
	if not state.alive then return end
	local backup = currentBackup()
	if backup then
		session.saleToken = lockId
		castBlock(lockId, true)
		local ok, restored = pcall(restoreBackup, backup)
		castBlock(lockId, false)
		session.saleToken = nil
		if not ok or not restored then
			state.restoreFailed = true
			setMessage("Restore gagal. Jalankan ulang script")
			return
		end
		setMessage("Sale settings dipulihkan")
	end
	state.restoring, state.restoreFailed = false, false
end

