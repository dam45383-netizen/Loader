-- ================= FORAGE LOGIC =================
local function fireIngredientPrompt(obj)
	if not obj or not obj.Parent then return false end
	local prompt = nil
	if obj:IsA("ProximityPrompt") then
		prompt = obj
	else
		prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
	end
	if not prompt then return false end
	if type(fireproximityprompt) == "function" then
		pcall(fireproximityprompt, prompt)
		return true
	end
	if host.fire then
		pcall(host.fire, prompt.Activated)
		return true
	end
	pcall(function()
		prompt:InputHoldBegin()
		task.wait(0.05)
		prompt:InputHoldEnd()
	end)
	return true
end

local function getIngredientCFrame(obj)
	return getTargetCFrame(obj)
end

local function runForageCycle()
	if not state.autoForage or not state.alive then return end
	if state.selling or state.recovering or shared.pending or minigame.InSession or state.stage then
		state.forageStatus = "Paused"
		return
	end
	local folder = workspace:FindFirstChild("SpawnedIngredients")
	if not folder then
		state.forageStatus = "No Ingredients"
		return
	end
	local ingredients = folder:GetChildren()
	if #ingredients == 0 then
		state.forageStatus = "No ingredients"
		state.forageCurrent = "-"
		return
	end
	local root = getRootPart()
	if not root then return end
	table.sort(ingredients, function(a, b)
		local ca, cb = getIngredientCFrame(a), getIngredientCFrame(b)
		if not ca then return false end
		if not cb then return true end
		return (ca.Position - root.Position).Magnitude < (cb.Position - root.Position).Magnitude
	end)
	local cycleStart = os.clock()
	for _, ing in ipairs(ingredients) do
		if not state.autoForage or not state.alive then break end
		if not ing.Parent then continue end
		if state.selling or state.recovering or shared.pending or minigame.InSession or state.stage then
			state.forageStatus = "Paused"
			break
		end
		if os.clock() - cycleStart > 15 then break end
		state.forageCurrent = ing.Name
		local fails = forageFail[ing] or 0
		if fails >= 2 then forageFail[ing] = nil continue end
		if state.forageMode == "Blatant" then
			state.forageStatus = "Blatant: " .. ing.Name
			if not (blatantClone and blatantClone.Parent) then createBlatantClone(blatantLastPos) task.wait(0.1) end
			local ok = teleportTo(ing)
			if not ok then forageFail[ing] = fails + 1 continue end
			local endAt = os.clock() + 0.5
			while os.clock() < endAt and state.autoForage and state.alive and ing.Parent do
				if state.selling or state.recovering or shared.pending or minigame.InSession or state.stage then break end
				fireIngredientPrompt(ing)
				task.wait(0.01)
			end
			if ing.Parent then forageFail[ing] = fails + 1 else forageFail[ing] = nil state.forageCount += 1 end
		else
			state.forageStatus = "Legit: " .. ing.Name
			local ok = teleportTo(ing)
			if not ok then forageFail[ing] = fails + 1 continue end
			local endAt = os.clock() + 0.7
			while os.clock() < endAt and state.autoForage and state.alive and ing.Parent do
				if state.selling or state.recovering or shared.pending or minigame.InSession or state.stage then break end
				fireIngredientPrompt(ing)
				task.wait(0.05)
			end
			if ing.Parent then forageFail[ing] = fails + 1 else forageFail[ing] = nil state.forageCount += 1 end
		end
		task.wait(0.05)
	end
end

function api.SetFiltersOpen(value)
	if not state.alive then return false end
	state.filtersOpen = value == true
	return true
end
function api.SetMinimized(value)
	if not state.alive then return false end
	state.minimized, state.visible = value == true, true
	if state.minimized then pcall(function() Window:Close() end) else pcall(function() Window:Open() end) end
	return true
end
function api.SetVisible(value)
	if not state.alive then return false end
	state.visible = value == true
	if state.visible then pcall(function() Window:Open() end) else pcall(function() Window:Close() end) end
	return true
end
function api.GetState()
	return {
		alive = state.alive, instantCatch = state.instantCatch, autoMinigame = state.autoMinigame,
		minigameMode = state.minigameMode, minigameEnabled = state.minigameEnabled,
		autoStart = state.autoStart, autoCatch = state.autoStart, selling = state.selling, recovering = state.recovering,
		stage = state.stage, caught = state.caught, minimized = state.minimized, visible = state.visible,
		catchPending = shared.pending ~= nil, filtersOpen = state.filtersOpen, filters = copyFilters(state.filters),
		windowPosition = table.clone(state.windowPosition), floatPosition = table.clone(state.floatPosition),
		autoSell = state.autoSell, autoSellAmount = state.autoSellAmount, autoSellUnit = state.autoSellUnit,
		autoSellIntervalSec = autoSellIntervalSec(), autoSellMinutes = autoSellIntervalSec() / 60,
		nextAutoSellAt = state.nextAutoSellAt, lastTeleport = state.lastTeleport,
		savedPositions = listSavedPositionNames(),
		infJump = state.infJump, noclip = state.noclip, hideName = state.hideName,
		autoForage = state.autoForage, forageMode = state.forageMode, forageCount = state.forageCount, forageCurrent = state.forageCurrent,
		walkSpeedEnabled = state.walkSpeedEnabled, walkSpeedValue = state.walkSpeedValue, fpsBoost = state.fpsBoost,
	}
end
function api.TeleportTo(kind, name)
	if kind == nil or name == nil then return false, "kind / name kosong" end
	if kind == "Saved" then
		local cf = savedPositions[name]
		if cf == nil then return false, "Saved position tidak ketemu" end
		return teleportToCFrame(cf, name)
	end
	local target = nil
	if kind == "Player" then target = findPlayerTarget(name)
	elseif kind == "NPC" then target = findNPCTarget(name)
	else target = findTeleportTarget(kind, name) end
	if target == nil then return false, "Target tidak ketemu" end
	return teleportTo(target)
end
function api.SavePosition(name)
	if name == nil or tostring(name) == "" then return false, "nama kosong" end
	local root = getRootPart()
	if root == nil then return false, "Character belum load" end
	savedPositions[tostring(name)] = root.CFrame
	savePositionsToFile()
	return true, "Disimpan: " .. tostring(name)
end
function api.DeleteSavedPosition(name)
	if name == nil or savedPositions[name] == nil then return false, "Tidak ketemu" end
	savedPositions[name] = nil
	savePositionsToFile()
	return true, "Dihapus: " .. tostring(name)
end
function api.Destroy()
	if not state.alive then return end
	state.alive, state.autoStart, state.autoMinigame, state.instantCatch, state.autoSell = false, false, false, false, false
	state.minigameEnabled = false
	state.nextAutoSellAt = 0
	state.infJump, state.noclip, state.autoForage = false, false, false
	state.walkSpeedEnabled = false
	if state.hideName then restoreHideName() end
	state.hideName = false
	if state.fpsBoost then applyFPSBoost(false) end
	state.fpsBoost = false
	destroyBlatantClone()
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then hum.WalkSpeed = 16 end
	for _, c in workspace:GetChildren() do
		if c.Name == player.Name .. "_Clone" then pcall(function() c:Destroy() end) end
	end
	saveConfig()
	savePositionsToFile()
	restorePatches()
	minigame:SetCastBlock(token, false)
	minigame:SetCastBlock(token .. "_pending", false)
	if not state.selling then minigame:SetCastBlock(token .. "_sale", false) end
	for _, connection in connections do pcall(function() connection:Disconnect() end) end
	for _, tween in tweens do pcall(function() tween:Cancel() end) end
	table.clear(connections)
	table.clear(tweens)
	if host.environment.ScroomsHub == api then host.environment.ScroomsHub = nil end
	pcall(function() Window:Destroy() end)
end

