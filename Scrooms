			Callback = function()
				local name
				local okGet, value = pcall(function() return ui.saveName:Get() end)
				if okGet and value ~= nil then name = if type(value) == "table" then value[1] else value end
				if name == nil or tostring(name) == "" then name = pendingName end
				local okSave, message, finalName = Positions.save(name)
				if okSave then
					pcall(function()
						ui.saveList:Refresh(Positions.names())
						ui.saveList:Set(finalName, false)
					end)
					showSaved(finalName)
				end
				toast("Save Position", message)
			end,
		})
		acc:Button({
			Title = "Delete Position", Desc = "Hapus yang lagi dipilih di list.",
			Callback = function()
				local name = currentSaved()
				if not name then
					toast("Save Position", "Pilih dulu di List Save Position.")
					return
				end
				local okDelete, message = Positions.remove(name)
				if okDelete then
					pcall(function()
						ui.saveList:Refresh(Positions.names())
						ui.saveList:Set(nil, false)
						ui.saveName:Set("", false)
					end)
					showSaved(nil)
				end
				toast("Save Position", message)
			end,
		})
		acc:Button({
			Title = "Teleport To Position", Desc = "Teleport ke yang lagi dipilih di list.",
			Callback = function()
				local name = currentSaved()
				if not name then
					toast("Save Position", "Pilih dulu di List Save Position.")
					return
				end
				local _, message = Positions.teleport(name)
				toast("Save Position", message)
			end,
		})

		ui.afterBuild[#ui.afterBuild + 1] = function()
			local ok, value = pcall(function() return ui.saveList:Get() end)
			if not ok then return end
			if type(value) == "table" then value = value[1] end
			if value ~= nil and value ~= "" then
				showSaved(tostring(value))
				pcall(function() ui.saveName:Set(tostring(value), false) end)
			end
		end
	end

	------------------------------------------------------------ Misc
	do
		local playerAcc = miscTab:Accordion({ Title = "Player", Icon = "play", Open = true, Column = 1 })
		ui.walkspeedSlider = playerAcc:Slider({
			Title = "Walkspeed", Desc = "16 = normal. Geser dulu, lalu aktifkan toggle. Dipaksa tiap frame.",
			Flag = "Scrooms_Walkspeed", Min = MIN_WALKSPEED, Max = MAX_WALKSPEED, Default = state.walkspeed,
			Callback = function(v)
				if building or v == nil then return end
				api.SetWalkspeed(v)
			end,
		})
		addToggle(playerAcc, {
			Title = "Enable Walkspeed", Desc = "Paksa Walkspeed sesuai slider.",
			Flag = "Scrooms_WalkspeedEnabled",
			get = function() return state.walkspeedEnabled end,
			set = api.SetWalkspeedEnabled,
		})
		ui.walkspeedInfo = playerAcc:Info({ Title = "Walkspeed", Value = "-" })

		local screen = miscTab:Accordion({ Title = "Screen", Icon = "grid", Open = true, Column = 2 })
		for _, row in FPS_ORDER do
			local id = row.id
			addToggle(screen, {
				Title = row.label, Desc = row.desc, Flag = "Scrooms_FPS_" .. id,
				get = function() return state.fps[id] end,
				set = function(v) Fps.set(id, v) end,
			})
		end
		screen:Button({
			Title = "Enable All", Desc = "Nyalain semua FPS boost.",
			Callback = function()
				api.SetFPSAll(true)
				toast("FPS Boost", "Semua ON.")
			end,
		})
		screen:Button({
			Title = "Disable All", Desc = "Matiin semua + balikin setting awal.",
			Callback = function()
				api.SetFPSAll(false)
				toast("FPS Boost", "Semua OFF, setting dibalikin.")
			end,
		})
	end
end

