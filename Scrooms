-- Tunggu `check()` true, cek tiap `step` detik sampai `timeout`.
local function waitUntil(check, timeout, step)
	local deadline = os.clock() + timeout
	repeat
		task.wait(step or 0.05)
		if check() then return true end
	until os.clock() >= deadline
	return false
end

-- Hook method/field di object game; semuanya dibalikin lewat unhookAll().
local hooks = {}
local function hook(object, key, replacement)
	if type(object) ~= "table" then return end
	local ok, original = pcall(rawget, object, key)
	if not ok then return end
	hooks[#hooks + 1] = { object = object, key = key, original = original, replacement = replacement }
	pcall(rawset, object, key, replacement)
end
local function unhookAll()
	for index = #hooks, 1, -1 do
		local h = hooks[index]
		local ok, current = pcall(rawget, h.object, h.key)
		if ok and current == h.replacement then pcall(rawset, h.object, h.key, h.original) end
	end
	table.clear(hooks)
end

