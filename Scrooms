	state.saveAt = os.clock() + 0.5
	return true
end

-- ===== Walkspeed =====
local function applyWalkspeedNow()
	if not state.walkspeedEnabled then return end
	local char = player.Character
	if char == nil then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum == nil or hum.Health <= 0 then return end
	pcall(function() hum.WalkSpeed = state.walkspeed end)
end
function api.SetWalkspeed(value)
	if not state.alive then return false end
	if value == nil then return false end
	if type(value) == "table" then value = value[1] end
	local n = tonumber(value)
	if n == nil then return false end
	state.walkspeed = math.clamp(math.floor(n), 16, 150)
	applyWalkspeedNow()
	return true
end
function api.SetWalkspeedEnabled(value)
	if not state.alive then return false end
	state.walkspeedEnabled = value == true
	if state.walkspeedEnabled then
		applyWalkspeedNow()
	else
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid") or nil
		if hum ~= nil then pcall(function() hum.WalkSpeed = 16 end) end
	end
	return true
end

-- ===== FPS Boost =====
local function applyLowGraphics(on)
	if on then
		if fpsCache.lowGraphics == nil then
			local qOk, q = pcall(function() return settings().Rendering.QualityLevel end)
			fpsCache.lowGraphics = {
				quality = if qOk then q else nil,
				technology = Lighting.Technology,
				diffuse = Lighting.EnvironmentDiffuseScale,
				specular = Lighting.EnvironmentSpecularScale,
				shadows = Lighting.GlobalShadows,
			}
		end
		pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
		pcall(function() Lighting.Technology = Enum.Technology.Compatibility end)
		safeSet(Lighting, "EnvironmentDiffuseScale", 0)
		safeSet(Lighting, "EnvironmentSpecularScale", 0)
		safeSet(Lighting, "GlobalShadows", false)
	else
		if fpsCache.lowGraphics ~= nil then
			if fpsCache.lowGraphics.quality ~= nil then pcall(function() settings().Rendering.QualityLevel = fpsCache.lowGraphics.quality end) end
			pcall(function() Lighting.Technology = fpsCache.lowGraphics.technology end)
			safeSet(Lighting, "EnvironmentDiffuseScale", fpsCache.lowGraphics.diffuse)
			safeSet(Lighting, "EnvironmentSpecularScale", fpsCache.lowGraphics.specular)
			safeSet(Lighting, "GlobalShadows", fpsCache.lowGraphics.shadows)
			fpsCache.lowGraphics = nil
		end
	end
end
local function applyShadows(on)
	if on then
		if fpsCache.lightingShadows == nil then fpsCache.lightingShadows = Lighting.GlobalShadows end
		safeSet(Lighting, "GlobalShadows", false)
		for _, inst in Workspace:GetDescendants() do
			if inst:IsA("BasePart") then
				if fpsCache.shadows[inst] == nil then fpsCache.shadows[inst] = inst.CastShadow end
				safeSet(inst, "CastShadow", false)
			end
		end
	else
		if fpsCache.lightingShadows ~= nil then safeSet(Lighting, "GlobalShadows", fpsCache.lightingShadows) fpsCache.lightingShadows = nil end
		for inst, orig in fpsCache.shadows do
			if inst ~= nil and inst.Parent ~= nil then safeSet(inst, "CastShadow", orig) end
		end
		table.clear(fpsCache.shadows)
	end
end
local function applyLightingEffects(on)
	if on then
		for _, eff in Lighting:GetChildren() do
			if eff:IsA("BloomEffect") or eff:IsA("BlurEffect") or eff:IsA("SunRaysEffect") or eff:IsA("ColorCorrectionEffect") or eff:IsA("DepthOfFieldEffect") or eff:IsA("Atmosphere") then
				if fpsCache.lightingEffects[eff] == nil then
					local ok, v = pcall(function() return eff.Enabled end)
					if ok then fpsCache.lightingEffects[eff] = v end
				end
				safeSet(eff, "Enabled", false)
			end
		end
	else
		for eff, orig in fpsCache.lightingEffects do
			if eff ~= nil and eff.Parent ~= nil then safeSet(eff, "Enabled", orig) end
		end
		table.clear(fpsCache.lightingEffects)
	end
end
local function applyParticles(on)
	if on then
		for _, inst in Workspace:GetDescendants() do
			if inst:IsA("ParticleEmitter") or inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Sparkles") then
