end
local function assistRhythm(object)
	if object == nil or type(object) ~= "table" then return end
	if object.Type == "Wind" then
		if object._blow ~= nil and type(object._blow) == "table" then patch(object._blow, token, true) end
		local moveCursor = object._moveCursor
		if type(moveCursor) == "function" then
			patch(object, "_moveCursor", function(self, deltaTime, chartTime)
				if type(self) ~= "table" then return end
				if type(self._notes) == "table" then
					for _, note in self._notes do
						if type(note) == "table" and not note.done and type(note.time) == "number" and type(note.length) == "number" and chartTime >= note.time and chartTime < note.time + note.length then
							local fraction = math.clamp((chartTime - note.time) / note.length, 0, 1)
							if type(note.from) == "number" and type(note.to) == "number" then
								self._pitch = note.from + (note.to - note.from) * fraction
								self._target = self._pitch
							end
							break
						end
					end
				end
				return moveCursor(self, 0, chartTime)
			end)
		end
	end
	local step = object._step
	if type(step) ~= "function" then return end
	if type(object._scroomsCounted) ~= "table" then object._scroomsCounted = {} end
	patch(object, "_step", function(self, deltaTime)
		if type(self) ~= "table" then return end
		if not self._jan then return end
		local ok = pcall(function()
			if not self._paused and not (self._hitstop and os.clock() < self._hitstop) then
				if self.Type == "Wind" and self._blow ~= nil and type(self._blow) == "table" then self._blow[token] = true end
				if type(self._chartTime) ~= "function" then return end
				local chartTime = self:_chartTime()
				if self._locked and self._countInPress ~= nil and type(self._countIn) == "table" and type(self._countIn.taps) == "table" then
					for index, tapTime in self._countIn.taps do
						if type(tapTime) == "number" and not self._scroomsCounted[index] and chartTime >= tapTime then
							self._scroomsCounted[index] = true
							if chartTime - tapTime <= 0.15 and type(self._countInPress) == "function" then self._countInPress() end
						end
					end
				elseif not self._locked then
					local list = self._groups
					if type(list) ~= "table" then list = self._notes end
					if type(list) == "table" then
						for _, note in list do
							if type(note) ~= "table" then continue end
							if type(note.time) ~= "number" or note.time > chartTime then continue end
							if self.Type == "Strings" and note.state == "pending" and type(self._hitGroup) == "function" then
								pcall(function() self:_hitGroup(note) end)
							elseif self.Type == "Keys" and note.state == "pending" and type(self._hitNote) == "function" then
								pcall(function() self:_hitNote(note, chartTime) end)
							elseif self.Type == "Wind" and not note.headJudged and type(note.from) == "number" then
								self._pitch, self._target = note.from, note.from
								if type(self._press) == "function" then pcall(function() self:_press() end) end
							elseif self.Type == "Percussion" and not note.judged and not note.ghost and type(self._hit) == "function" then
								pcall(function() self:_hit(if note.kind == "big" then "don" else note.kind) end)
								if self._jan and note.kind == "big" and not note.judged then pcall(function() self:_hit("ka") end) end
							end
							if not self._jan then return end
						end
					end
				end
			end
		end)
		if not ok then return end
		return step(self, deltaTime)
	end)
end
local function assistStage(stage, object)
	restorePatches()
	if not state.alive then return end
	if object == nil or type(object) ~= "table" then return end
	if not object._jan then return end
	if stage == "main" and object.OnComplete ~= nil and type(object.OnComplete) == "table" then
		local complete = object.OnComplete.Fire
		if type(complete) == "function" then
			patch(object.OnComplete, "Fire", function(self, success, ...)
				if success and state.alive and not (type(object._params) == "table" and object._params.training) then beginPending() end
				return complete(self, success, ...)
			end)
		end
	end
	if state.instantCatch then
		task.defer(function()
			if not state.alive or not state.instantCatch or state.game ~= object or type(object) ~= "table" or not object._jan then return end
			if stage == "ring" and not object._complete then
				if object.OnComplete ~= nil then pcall(function() object.OnComplete:Fire(1) end) end
			elseif stage == "main" and not object._scroomsClaimed then
				if type(object._params) == "table" and object._params.infinite then return end
				object._scroomsClaimed = true
				object._locked = false
				if type(object._changeProgress) == "function" then pcall(function() object:_changeProgress(1) end) end
			end
		end)
	elseif state.autoMinigame then
		if stage == "ring" and not object._complete then
			task.defer(function()
				if state.alive and state.autoMinigame and not state.instantCatch and state.game == object and type(object) == "table" and object._jan and not object._complete then
					if object._tween ~= nil then pcall(function() object._tween:Cancel() end) end
					if type(object._ui) == "table" and object._ui.Ring ~= nil and type(object._ui.Ring) == "table" and object._ui.Ring.Tick ~= nil then
						pcall(function() object._ui.Ring.Tick.Rotation = object._targetRot or 0 end)
					end
					if type(object.Complete) == "function" then pcall(function() object:Complete() end) end
				end
			end)
		elseif stage == "main" then
			assistRhythm(object)
		end
	end
end
local function recoverStage()
	if state.game ~= nil and type(state.game) == "table" and state.game._jan then return end
	if host.objects == nil or type(host.objects) ~= "function" then return end
	local ok, objs = pcall(function() return host.objects(true) end)
	if not ok or type(objs) ~= "table" then return end
	for _, object in objs do
		if type(object) ~= "table" or not rawget(object, "_jan") then continue end
		local ui = rawget(object, "_ui")
		if typeof(ui) ~= "Instance" or not ui:IsDescendantOf(playerGui) then continue end
		local stage = if rawget(object, "_targetRot") then "ring"
			elseif type(rawget(object, "_params")) == "table" and type(object._changeProgress) == "function"
				and type(object._chartTime) == "function" then "main" else nil
		if stage then state.stage, state.game = stage, object return end
	end
end
local function applyMinigame()
	if not state.minigameEnabled then
		state.instantCatch, state.autoMinigame = false, false
	elseif state.minigameMode == "Legit" then
		state.instantCatch, state.autoMinigame = false, true
	else
		state.instantCatch, state.autoMinigame = true, false
	end
	state.viewDirty = true
	recoverStage()
	assistStage(state.stage, state.game)
end
