local okUI, uiError = xpcall(buildUI, debug.traceback)
if not okUI then warn("Scrooms: UI gagal dibuat:\n" .. tostring(uiError)) end

if state.autoSell then state.nextAutoSell = os.clock() + intervalSeconds() end

task.delay(0.6, function()
	if not state.alive then return end
	building = false
	-- widget yang gak ikut sync loop: paksa ke state sekali (flag lib bisa nimpa Default)
	pcall(function() ui.walkspeedSlider:Set(state.walkspeed, false) end)
	pcall(function() ui.timeSell:Set(tostring(state.autoSellAmount), false) end)
	pcall(function() ui.minItems:Set(tostring(state.autoSellMin), false) end)
	pcall(refreshUI)
	for _, fn in ui.afterBuild do pcall(fn) end
end)

-- Terapin FPS boost yang kesimpen di config
task.defer(function()
	if type(saved.fps) ~= "table" then return end
	for _, row in FPS_ORDER do
		if saved.fps[row.id] == true then Fps.set(row.id, true) end
	end
end)

-- Update UI
task.spawn(function()
	while state.alive do
		task.wait(0.25)
		if not state.alive then break end
		pcall(refreshUI)
	end
end)

-- Auto sell
task.spawn(function()
	while state.alive do
		task.wait(1)
		if not state.alive or not state.autoSell or os.clock() < state.nextAutoSell then continue end
		if state.selling or state.restoring or session.pending or minigame.InSession or state.stage then
			state.nextAutoSell = os.clock() + 10
			continue
		end
		state.lastAutoSell = os.clock()
		state.nextAutoSell = state.lastAutoSell + intervalSeconds()
		if countKeys((buildSellList(state.filters))) >= state.autoSellMin then startSale() end
	end
end)

-- Refresh dropdown teleport kalau isi folder berubah
task.spawn(function()
	while state.alive do
		task.wait(5)
		if not state.alive then break end
		for _, panel in ui.panels do
			local names = refreshTargets(panel.kind)
			local signature = table.concat(names, "|")
			if signature ~= panel.signature then
				panel.signature = signature
				pcall(function() panel.dropdown:Refresh(names) end)
			end
		end
	end
end)

