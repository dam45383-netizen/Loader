local function getTeleportFolder(kind)
	local world = workspace:FindFirstChild("World")
	if world == nil then return nil end
	if kind == "Area" then return world:FindFirstChild("AreaParts")
	elseif kind == "NPC" then return world:FindFirstChild("NPCs")
	elseif kind == "CookingPots" then return world:FindFirstChild("CookingPots")
	else return world:FindFirstChild("Instruments") end
end
local function listTeleportNames(kind)
	local folder = getTeleportFolder(kind)
	if folder == nil then return {} end
	local names = {}
	for _, child in folder:GetChildren() do
		if child.Name ~= nil and child.Name ~= "" then names[#names + 1] = child.Name end
	end
	table.sort(names)
	return names
end
local function findTeleportTarget(kind, name)
	if name == nil or name == "" then return nil end
	local folder = getTeleportFolder(kind)
	if folder == nil then return nil end
	for _, child in folder:GetChildren() do
		if child.Name == name then return child end
	end
	return nil
end
local function getNPCEntries()
	local folder = getTeleportFolder("NPC")
	if folder == nil then return {} end
	local entries = {}
	for _, parent in folder:GetChildren() do
		local children = parent:GetChildren()
		local hasChild = false
		for _, child in children do
			if child:IsA("Folder") or child:IsA("Model") or child:IsA("BasePart") then hasChild = true break end
		end
		if hasChild then
			for _, child in children do
				if child:IsA("Folder") or child:IsA("Model") or child:IsA("BasePart") then
					entries[#entries + 1] = { display = child.Name, obj = child, parent = parent.Name, name = child.Name }
				end
			end
		else
			if parent:IsA("Model") or parent:IsA("BasePart") or parent:IsA("Folder") then
				entries[#entries + 1] = { display = parent.Name, obj = parent, parent = nil, name = parent.Name }
			end
		end
	end
	table.sort(entries, function(a, b) return a.display < b.display end)
	return entries
end
local function listNPCNames()
	local entries = getNPCEntries()
	local names = {}
	local seen = {}
	for _, e in entries do
		if not seen[e.display] then seen[e.display] = true names[#names + 1] = e.display end
	end
	table.sort(names)
	return names
end
local function findNPCTarget(display)
	if display == nil or display == "" then return nil end
	if type(display) == "table" then display = display[1] end
	if display == nil or display == "" then return nil end
	for _, e in getNPCEntries() do
		if e.display == display or e.name == display then return e.obj end
	end
	for _, e in getNPCEntries() do
		if e.parent ~= nil and (e.parent .. " / " .. e.name) == display then return e.obj end
	end
	local slashPos = string.find(display, " / ", 1, true)
	if slashPos then
		local childName = string.sub(display, slashPos + 3)
		for _, e in getNPCEntries() do
			if e.name == childName then return e.obj end
		end
	end
	return nil
end
local function listPlayerNames()
	local names = {}
	for _, p in Players:GetPlayers() do
		if p ~= player then names[#names + 1] = p.Name end
	end
	table.sort(names)
	return names
end
local function findPlayerTarget(name)
	if name == nil or name == "" then return nil end
	if type(name) == "table" then name = name[1] end
	if name == nil or name == "" then return nil end
	local target = Players:FindFirstChild(name)
	if not target then return nil end
	local char = target.Character
	if not char then return nil end
	return char
end
local function getPPText(obj)
	if obj == nil then return "-" end
	local pp = obj:FindFirstChild("pp")
	if pp == nil then
		for _, desc in obj:GetDescendants() do
			if desc.Name == "pp" and desc:IsA("ProximityPrompt") then pp = desc break end
		end
	end
	if pp ~= nil and pp:IsA("ProximityPrompt") then
		local txt = pp.ObjectText or ""
		if txt ~= "" then return txt end
		local act = pp.ActionText or ""
		if act ~= "" then return act end
		return "-"
	end
	if obj:IsA("ProximityPrompt") then return obj.ObjectText or "-" end
	return "-"
end
local function getTargetCFrame(obj)
	if obj == nil then return nil end
	if obj:IsA("Model") then
		local ok, cf = pcall(function() return obj:GetPivot() end)
		if ok and cf ~= nil then return cf end
	end
	if obj:IsA("BasePart") then return obj.CFrame end
	local part = obj:FindFirstChildWhichIsA("BasePart", true)
	if part ~= nil then return part.CFrame end
	return nil
end
local function getRootPart()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") or nil
	if root == nil and registry.C and registry.C.Character then
		local ok, r = pcall(function() return registry.C.Character:GetRoot() end)
		if ok then root = r end
	end
	return root, char
end
local function teleportTo(obj)
	if obj == nil then return false, "Target tidak ketemu" end
	local root, char = getRootPart()
	if root == nil then return false, "Character belum load" end
	local humanoid = char and char:FindFirstChildOfClass("Humanoid") or nil
	if humanoid ~= nil and humanoid.Health <= 0 then return false, "Character mati" end
	local cf = getTargetCFrame(obj)
	if cf == nil then return false, "CFrame target tidak ketemu" end
	local dest = cf + Vector3.new(0, 4, 0)
	local ok = pcall(function()
		root.CFrame = dest
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end)
	if not ok then return false, "Gagal teleport" end
	state.lastTeleport = obj.Name
	return true, "Teleported ke " .. obj.Name
end
local function teleportToCFrame(cf, label)
	if cf == nil then return false, "Posisi tidak ketemu" end
	local root, char = getRootPart()
	if root == nil then return false, "Character belum load" end
	local humanoid = char and char:FindFirstChildOfClass("Humanoid") or nil
	if humanoid ~= nil and humanoid.Health <= 0 then return false, "Character mati" end
	local ok = pcall(function()
		root.CFrame = cf
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end)
	if not ok then return false, "Gagal teleport" end
	state.lastTeleport = label or "Saved"
	return true, "Teleported ke " .. (label or "Saved")
end
local lastTeleportSelected = { Area = nil, NPC = nil, Instruments = nil, CookingPots = nil, Player = nil }
local selectedSavedName = nil
local pendingSaveName = ""
local function onTeleportSelect(kind, name, hargaLabel, selectedInfo, doTeleport)
	if name == nil then return end
	if type(name) == "table" then name = name[1] end
	if name == nil or name == "" then return end
	lastTeleportSelected[kind] = name
	local target = nil
	if kind == "Player" then target = findPlayerTarget(name)
	elseif kind == "NPC" then target = findNPCTarget(name)
	else target = findTeleportTarget(kind, name) end
	if target == nil then
		if hargaLabel ~= nil then pcall(function() hargaLabel:Set("Harga: -") end) end
		if selectedInfo ~= nil then pcall(function() selectedInfo:Set("-") end) end
		if doTeleport ~= false then Window:Notify({ Title = "Teleport", Content = "Target " .. tostring(name) .. " tidak ketemu.", Duration = 2 }) end
		return
	end
	local price = getPPText(target)
	if kind == "Player" then price = "-" end
	if hargaLabel ~= nil then pcall(function() hargaLabel:Set("Harga: " .. tostring(price)) end) end
	if selectedInfo ~= nil then pcall(function() selectedInfo:Set(tostring(name)) end) end
	if doTeleport == false then return end
	local ok, msg = teleportTo(target)
	Window:Notify({ Title = "Teleport", Content = msg, Duration = 2 })
end
local function refreshTeleportDropdown(kind, dropdown)
	local names = {}
	if kind == "Player" then names = listPlayerNames()
	elseif kind == "NPC" then names = listNPCNames()
	else names = listTeleportNames(kind) end
	if dropdown ~= nil then pcall(function() dropdown:Refresh(names) end) end
	return names
end

