local function normalizeUnit(value)
	if type(value) == "table" then value = value[1] end
	local key = tostring(value or ""):upper()
	if UNIT_SECONDS[key] then return key end
	return UNIT_ALIASES[key] or "M"
end

local function clampAmount(value, unit)
	local limits = UNIT_LIMITS[unit]
	return math.clamp(math.floor(tonumber(value) or 5), limits[1], limits[2])
end

local function cloneFilters(source)
	local out = { keepRarities = {} }
	local valid = type(source) == "table"
	for key, default in DEFAULT_FILTERS do
		out[key] = if valid and type(source[key]) == "boolean" then source[key] else default
	end
	local rarities = if valid and type(source.keepRarities) == "table" then source.keepRarities else {}
	for _, rarity in RARITIES do out.keepRarities[rarity.id] = rarities[rarity.id] == true end
	return out
end

