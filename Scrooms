end
function api.SetAutoSellAmount(value)
	if not state.alive then return false end
	if value == nil then return false end
	local n = tonumber(value)
	if n == nil then return false end
	state.autoSellAmount = clampAmount(n, state.autoSellUnit)
	if state.autoSell then
		if state.lastAutoSellAt > 0 then
			state.nextAutoSellAt = state.lastAutoSellAt + autoSellIntervalSec()
		else
			state.nextAutoSellAt = os.clock() + autoSellIntervalSec()
		end
		if state.nextAutoSellAt < os.clock() then state.nextAutoSellAt = os.clock() + autoSellIntervalSec() end
	end
	state.viewDirty = true
	state.saveAt = os.clock() + 0.5
	return true
end
function api.SetAutoSellUnit(value)
	if not state.alive then return false end
	if value == nil then return false end
	local unit = normalizeUnit(value)
	if unit == state.autoSellUnit then return true end
	state.autoSellUnit = unit
	state.autoSellAmount = clampAmount(state.autoSellAmount, unit)
	if state.autoSell then
		if state.lastAutoSellAt > 0 then
			state.nextAutoSellAt = state.lastAutoSellAt + autoSellIntervalSec()
		else
			state.nextAutoSellAt = os.clock() + autoSellIntervalSec()
		end
		if state.nextAutoSellAt < os.clock() then state.nextAutoSellAt = os.clock() + autoSellIntervalSec() end
	end
	state.viewDirty = true
	state.saveAt = os.clock() + 0.5
	return true
end
