-- Public API: getgenv().Scrooms
----------------------------------------------------------------------
local api = {}
local Window -- diisi buildUI

local function scheduleAutoSell()
	local from = if state.lastAutoSell > 0 then state.lastAutoSell else os.clock()
	local at = from + intervalSeconds()
	if at < os.clock() then at = os.clock() + intervalSeconds() end
	state.nextAutoSell = at
end

-- Catch
function api.SetMinigameMode(value)
	if not state.alive then return false end
	if type(value) == "table" then value = value[1] end
	local mode = tostring(value or ""):lower()
	if mode == "legit" then
		state.minigameMode = "Legit"
	elseif mode == "instant" then
		state.minigameMode = "Instant"
	else
		return false
	end
	refreshMinigame()
	queueSave()
	return true
end

function api.SetMinigameEnabled(value)
	if not state.alive then return false end
	state.minigameEnabled = value == true
	refreshMinigame()
	return true
end

function api.SetAutoCatch(value)
	if not state.alive then return false end
	if value and not (exec.firesignal or exec.getconnections) then
		setMessage("Executor gak support firesignal / getconnections")
		return false
	end
	state.autoCatch = value == true
	state.nextCast = os.clock() + 0.3
	return true
end

-- Sell
function api.SetAutoSell(value)
	if not state.alive then return false end
	state.autoSell = value == true
	state.nextAutoSell = if state.autoSell then os.clock() + intervalSeconds() else 0
	queueSave()
	return true
end

function api.SetAutoSellAmount(value)
	if not state.alive or tonumber(value) == nil then return false end
	state.autoSellAmount = clampAmount(value, state.autoSellUnit)
	if state.autoSell then scheduleAutoSell() end
	queueSave()
	return true
end

function api.SetAutoSellUnit(value)
	if not state.alive or value == nil then return false end
	local unit = normalizeUnit(value)
	if unit == state.autoSellUnit then return true end
	state.autoSellUnit = unit
	state.autoSellAmount = clampAmount(state.autoSellAmount, unit)
	if state.autoSell then scheduleAutoSell() end
	queueSave()
	return true
end

function api.SetAutoSellMinItems(value)
	if not state.alive or tonumber(value) == nil then return false end
	state.autoSellMin = math.clamp(math.floor(tonumber(value)), 1, MAX_SELL_MIN_ITEMS)
	queueSave()
	return true
end

function api.SetSaleFilters(value)
	if not state.alive or state.selling or state.restoring or type(value) ~= "table" then return false end
	local merged = cloneFilters(state.filters)
	for key in DEFAULT_FILTERS do
		if type(value[key]) == "boolean" then merged[key] = value[key] end
	end
	if type(value.keepRarities) == "table" then merged.keepRarities = table.clone(value.keepRarities) end
	state.filters = cloneFilters(merged)
	queueSave()
	return true
end

function api.PreviewSale()
	local targets, kept = buildSellList(state.filters)
	return { sell = countKeys(targets), keep = countKeys(kept) }
end

api.SellAll = startSale

-- Player
function api.SetWalkspeed(value)
	if not state.alive then return false end
	if type(value) == "table" then value = value[1] end
	local n = tonumber(value)
	if n == nil then return false end
	state.walkspeed = math.clamp(math.floor(n), MIN_WALKSPEED, MAX_WALKSPEED)
	applyWalkspeed()
	queueSave()
	return true
end

function api.SetWalkspeedEnabled(value)
	if not state.alive then return false end
	state.walkspeedEnabled = value == true
	if state.walkspeedEnabled then
		applyWalkspeed()
	else
		local humanoid = currentHumanoid()
		if humanoid then pcall(function() humanoid.WalkSpeed = MIN_WALKSPEED end) end
	end
	queueSave()
	return true
end

-- Screen
function api.SetFPS(feature, value)
	if not state.alive then return false end
	if type(feature) == "table" then feature = feature[1] end
	return Fps.set(tostring(feature), value)
end

function api.SetFPSAll(value)
	if not state.alive then return false end
	for _, row in FPS_ORDER do Fps.set(row.id, value) end
	return true
end

-- Teleport
function api.TeleportTo(kind, name)
	if kind == nil or name == nil then return false, "kind / name kosong" end
	if kind == "Saved" then return Positions.teleport(name) end
	local target = findTarget(kind, name)
	if target == nil then return false, "Target tidak ketemu" end
	return teleportTo(target)
end
api.SavePosition = function(name)
	local ok, msg = Positions.save(name)
	return ok, msg
end
api.DeletePosition = Positions.remove

function api.SetVisible(value)
	if not state.alive or Window == nil then return false end
	pcall(function() if value then Window:Open() else Window:Close() end end)
	return true
end

function api.GetState()
	return {
		alive = state.alive,
		minigameMode = state.minigameMode, minigameEnabled = state.minigameEnabled,
		autoCatch = state.autoCatch, stage = state.stage, caught = state.caught,
		catchPending = session.pending ~= nil,
		selling = state.selling, restoring = state.restoring,
		filters = cloneFilters(state.filters),
		autoSell = state.autoSell, autoSellAmount = state.autoSellAmount, autoSellUnit = state.autoSellUnit,
		autoSellIntervalSec = intervalSeconds(), autoSellMinItems = state.autoSellMin,
		nextAutoSell = state.nextAutoSell,
		walkspeed = state.walkspeed, walkspeedEnabled = state.walkspeedEnabled,
		fps = table.clone(state.fps),
		lastTeleport = state.lastTeleport, savedPositions = Positions.names(),
	}
end

function api.Destroy()
	if not state.alive then return end
	saveConfig() -- simpen dulu sebelum semua dimatiin, biar setting kebawa ke run berikutnya
	state.alive = false
	state.autoCatch, state.autoSell, state.minigameEnabled = false, false, false
	state.walkspeedEnabled = false
	state.nextAutoSell = 0

	for _, row in FPS_ORDER do pcall(Fps.set, row.id, false) end
	unhookAll()
	castBlock(lockId, false)
	castBlock(lockId .. "_pending", false)
	if not state.selling then castBlock(lockId .. "_sale", false) end
	for _, connection in connections do pcall(function() connection:Disconnect() end) end
	table.clear(connections)

	local humanoid = currentHumanoid()
	if humanoid then pcall(function() humanoid.WalkSpeed = MIN_WALKSPEED end) end
	if env.Scrooms == api then env.Scrooms = nil end
	if Window then pcall(function() Window:Destroy() end) end
end

----------------------------------------------------------------------
-- UI sync (cuma Set kalau nilainya beda, biar gak nimpa textbox yang lagi diketik)
----------------------------------------------------------------------
local ui = { controls = {}, panels = {}, afterBuild = {} }
local building = true -- true selama UI dibangun: callback widget diabaikan
local pushed = setmetatable({}, { __mode = "k" })
local lastPreview = 0

local function syncInfo(widget, text)
	if widget == nil or pushed[widget] == text then return end
	pushed[widget] = text
	pcall(function() widget:Set(text) end)
end

local function syncParagraph(widget, text)
	if widget == nil or pushed[widget] == text then return end
	pushed[widget] = text
	pcall(function() widget:Set("Status", text) end)
end

local function syncControls()
	for _, control in ui.controls do
		local value = control.get()
		if pushed[control.widget] ~= value then
			pushed[control.widget] = value
			pcall(function() control.widget:Set(value, false) end)
		end
	end
end

local function statusText()
	local showing = os.clock() < state.messageUntil
	local text
	if state.restoreFailed then
		text = "Restore gagal. Jalankan ulang script"
	elseif state.restoring then
		text = "Restoring sale settings..."
	elseif session.pending then
		text = "Waiting for catch..."
	elseif showing then
		text = state.message
	elseif state.selling then
		text = state.salePhase or (if state.stage then "Finishing the current catch..." else "Selling inventory...")
	elseif state.stage == "ring" then
		text = "Casting..."
	elseif state.stage == "tune" then
		text = "Tuning..."
	elseif state.stage == "main" then
		text = "Catching..."
	elseif state.autoCatch then
		text = "Waiting to cast..."
	else
		text = "Ready"
	end
	if state.caught > 0 and not showing and not session.pending then text ..= " | " .. state.caught .. " caught" end
	return text
end

local function nextSellText()
	if not state.autoSell then return "OFF" end
	if state.selling then return "Selling..." end
	local remaining = math.max(0, state.nextAutoSell - os.clock())
	if remaining >= 3600 then
		return string.format("in %dh %dm", math.floor(remaining / 3600), math.floor(remaining % 3600 / 60))
	elseif remaining >= 60 then
		return string.format("in %dm %ds", math.floor(remaining / 60), math.floor(remaining % 60))
	end
	return string.format("in %ds", math.floor(remaining))
end

local function refreshUI()
	local text = statusText()
	local caught = tostring(state.caught)
	local nextSell = nextSellText()

	syncParagraph(ui.status, text)
	syncInfo(ui.dashStatus, text)
	syncInfo(ui.caught, caught)
	syncInfo(ui.catchCaught, caught)
	syncInfo(ui.dashCaught, caught)
	syncInfo(ui.stage, state.stage or "-")
	syncInfo(ui.pending, if session.pending then "Yes" else "No")
	syncInfo(ui.minigameStatus, if state.minigameEnabled then state.minigameMode .. " ON" else "OFF")
	syncInfo(ui.walkspeedInfo, string.format("%d (%s)", state.walkspeed, if state.walkspeedEnabled then "ON" else "OFF"))
	syncInfo(ui.teleportLast, if state.lastTeleport ~= "" then state.lastTeleport else "-")
	syncInfo(ui.interval, string.format("Every %d %s (%ds)", state.autoSellAmount, state.autoSellUnit, intervalSeconds()))
	syncInfo(ui.nextSell, nextSell)
	syncInfo(ui.dashNext, nextSell)
	syncInfo(ui.lastMessage, if state.message ~= "" then state.message else "-")

	if os.clock() - lastPreview >= 1 and not state.selling and not state.restoring then
		lastPreview = os.clock()
		local ok, preview = pcall(api.PreviewSale)
		if ok and preview then
			local summary = string.format("Sell: %d | Keep: %d", preview.sell, preview.keep)
			syncInfo(ui.preview, summary)
			syncInfo(ui.filterPreview, summary)
		end
	end

	if ui.sellButton ~= nil then
		local title = if state.restoreFailed then "Restore needed"
			elseif state.restoring then "Restoring..."
			elseif state.selling then "Selling..."
			else "Sell Inventory"
		if pushed[ui.sellButton] ~= title then
			pushed[ui.sellButton] = title
			pcall(function() ui.sellButton:SetTitle(title) end)
		end
	end

	syncControls()
end

