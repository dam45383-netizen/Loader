	local ok, cf = pcall(function() return CFrame.new(comp[1], comp[2], comp[3], comp[4], comp[5], comp[6], comp[7], comp[8], comp[9], comp[10], comp[11], comp[12]) end)
	if ok then return cf end
	return nil
end
if type(shared.savedPositions) == "table" then
	savedPositions = shared.savedPositions
else
	local scopeData = positionsDocument.scopes[scope]
	if type(scopeData) == "table" and type(scopeData.positions) == "table" then
		for name, comp in scopeData.positions do
			if type(name) == "string" then
				local cf = decodeCFrame(comp)
				if cf then savedPositions[name] = cf end
			end
		end
	end
	shared.savedPositions = savedPositions
end
local function savePositionsToFile()
