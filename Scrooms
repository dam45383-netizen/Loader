local function isProtected(uid, item, filters, reserved)
	if type(item) ~= "table" then return false end
	local definition = if item.id ~= nil then Items[item.id] else nil
	return (filters.keepQuestItems and reserved[uid] == true)
		or (filters.keepFavorites and item.favorited == true)
		or (definition ~= nil and filters.keepRarities[definition.rarity] == true)
		or (filters.keepMutations and item.mutation ~= nil and item.mutation ~= "none")
		or (filters.keepVariants and type(item.variants) == "table" and #item.variants > 0)
end

-- Return: targets (bakal dijual), kept (ditahan filter). Keduanya { [uid] = true }.
local function buildSellList(filters)
	local reserved = {}
	if filters.keepQuestItems and Quest ~= nil then
		local ok, stock = pcall(function() return Quest:GetQuestStock(function(path) return data:Get(path) end) end)
		if ok and type(stock) == "table" then reserved = stock end
	end
	local targets, kept = {}, {}
	for uid, item in getItems() do
		if type(item) ~= "table" then continue end
		local ok, price = pcall(function() return Selling:GetPrice(item) end)
		if ok and price then
			if isProtected(uid, item, filters, reserved) then kept[uid] = true else targets[uid] = true end
		end
	end
	return targets, kept
end

local function findNearestMerchant(root)
	local world = Workspace:FindFirstChild("World")
	local folder = world and world:FindFirstChild("NPCs")
	if not folder then return nil end
	local nearest, distance = nil, math.huge
	for _, npc in folder:GetDescendants() do
		if npc:IsA("Model") and MERCHANTS[npc.Name] then
			local ok, pivot = pcall(function() return npc:GetPivot() end)
			if ok and pivot then
				local length = (pivot.Position - root.Position).Magnitude
				if length < distance then nearest, distance = npc, length end
			end
		end
	end
	return nearest
end

-- Isi sale: pasang filter, teleport ke merchant, jual. Cleanup ada di startSale.
-- `ctx` nyimpen state buat cleanup (root, origin, backup, dst).
local function sellSteps(filters, ctx)
	local deadline = os.clock() + 90
	while state.alive and (minigame.InSession or session.pending) and os.clock() < deadline do task.wait(0.1) end
	if not state.alive then return "Sale cancelled" end
	if minigame.InSession or session.pending then return "Finish the catch and try again" end

	local humanoid = currentHumanoid()
	local okRoot, root = pcall(function() return ctl.Character:GetRoot() end)
	if not okRoot or not root or not humanoid or humanoid.Health <= 0 then return "Wait for your character" end
	ctx.root = root

	local merchant = findNearestMerchant(root)
	if not merchant then return "No merchant loaded nearby" end
	local targets = buildSellList(filters)
	if next(targets) == nil then return "Nothing to sell. Protected items are kept" end

	-- Hitung perubahan favorit + setting yang dibutuhin, simpen backup dulu.
	local backup = { settings = {}, favorites = {} }
	ctx.backup = backup
	local wantSettings, wantFavorites = {}, {}
	for _, rarity in RARITIES do
		local want = not filters.keepRarities[rarity.id]
		local ok, original = pcall(function() return ctl.Settings:Get(rarity.setting) end)
		if ok and type(original) == "boolean" and original ~= want then
			backup.settings[rarity.setting], wantSettings[rarity.setting] = original, want
		end
	end
	for uid, item in getItems() do
		if type(item) ~= "table" then continue end
		local definition = if item.id ~= nil then Items[item.id] else nil
		local okPrice, price = pcall(function() return Selling:GetPrice(item) end)
		if not okPrice or not price then continue end
		if definition ~= nil and filters.keepRarities[definition.rarity] then continue end
		local special = (filters.keepMutations and item.mutation ~= nil and item.mutation ~= "none")
			or (filters.keepVariants and type(item.variants) == "table" and #item.variants > 0)
		local original = item.favorited == true
		local desired = if special then true elseif not filters.keepFavorites then false else original
		if original ~= desired then backup.favorites[uid], wantFavorites[uid] = original, desired end
	end
	if not writeBackup(backup) then error("Could not save the recovery backup") end

	for uid, value in wantFavorites do
		if not state.alive then return "Sale cancelled" end
		state.salePhase = "Protecting inventory..."
		if not setFavorite(uid, value) then error("Could not confirm item protection") end
	end
	for name, value in wantSettings do
		if not state.alive then return "Sale cancelled" end
		state.salePhase = "Applying sale filters..."
		if not setSaleSetting(name, value) then error("Could not confirm sale filters") end
	end
	for uid, value in wantFavorites do
		local item = getItems()[uid]
		if item and (item.favorited == true) ~= value then error("Item protection changed. Sale cancelled") end
	end
	if not state.alive then return "Sale cancelled" end

	-- Ke merchant
	ctx.origin, ctx.previousItem, ctx.equipped = root.CFrame, inventory:GetEquipped(), true
	local chimesBefore = player:GetAttribute("chimes") or 0
	pcall(function() inventory:Equip(nil) end)
	local okPivot, pivot = pcall(function() return merchant:GetPivot() end)
	if okPivot and pivot and (root.Position - pivot.Position).Magnitude > 10 then
		ctx.moved = true
		root.CFrame = pivot * CFrame.new(0, 0, -5)
		root.AssemblyLinearVelocity = Vector3.zero
	end
	task.wait(0.65)
	local okCur, curRoot = pcall(function() return ctl.Character:GetRoot() end)
	if not state.alive or not okCur or curRoot ~= root or humanoid.Health <= 0 then return "Sale cancelled" end

	-- Jual
	state.salePhase = "Selling inventory..."
	throttle()
	local node = if filters.keepQuestItems then "sellAllKeepDone" else "sellAllDone"
	if dialogueRemote ~= nil then dialogueRemote:FireServer("nodeAction", { npc = merchant.Name, node = node }) end
	local total, sold = countKeys(targets), 0
	waitUntil(function()
		sold = 0
		local current = getItems()
		for uid in targets do
			if not current[uid] then sold += 1 end
		end
		return sold >= total
	end, 4, 0.1)
	if sold <= 0 then return "Sale refused. Try again near a merchant" end
	return string.format("Sold %d items | +%d chimes", sold, (player:GetAttribute("chimes") or chimesBefore) - chimesBefore)
end

local function startSale()
	if not state.alive or state.selling or state.restoring or session.saleToken then return false end
	if ctl.Character == nil then
		setMessage("Character belum ready")
		return false
	end
	local filters = cloneFilters(state.filters)
	if next(buildSellList(filters)) == nil and not minigame.InSession and not session.pending then
		setMessage("Nothing to sell. Protected items are kept")
		return false
	end

	state.selling = true
	castBlock(lockId .. "_sale", true)
	session.saleToken = lockId
	local ctx = {}

	session.saleWorker = task.defer(function()
		local ok, result = xpcall(sellSteps, debug.traceback, filters, ctx)

		-- Balikin favorit + setting jual
		local restored = true
		if ctx.backup then
			state.salePhase = "Restoring sale settings..."
			local okRestore, done = pcall(restoreBackup, ctx.backup)
			restored = okRestore and done == true
		end

		-- Balik ke posisi awal + equip item sebelumnya
		local returned, returnError = pcall(function()
			local root = ctx.root
			if not (root and root.Parent) then return end
			local okCur, curRoot = pcall(function() return ctl.Character:GetRoot() end)
			if not okCur or curRoot ~= root then return end
			if ctx.moved and ctx.origin then
				root.CFrame = ctx.origin
				root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
			end
			if ctx.equipped then
				local previous = ctx.previousItem
				local toEquip = if previous and inventory.Cache and inventory.Cache[previous] then previous else nil
				pcall(function() inventory:Equip(toEquip) end)
			end
		end)

		castBlock(lockId .. "_sale", false)
		state.selling, state.salePhase, state.nextCast = false, nil, os.clock() + 1.2
		if session.saleToken == lockId then session.saleToken, session.saleWorker = nil, nil end

		if not restored then
			state.restoring, state.restoreFailed = true, true
			setMessage("Restore gagal. Jalankan ulang script")
		elseif not returned then
			setMessage("Sale selesai. Cek posisi lo")
		else
			setMessage(if ok then result or "Ready" else "Sale failed. Try again")
		end
		if not ok then warn("Scrooms: " .. tostring(result)) end
		if not returned then warn("Scrooms: " .. tostring(returnError)) end
	end)
	return true
end

----------------------------------------------------------------------
-- Teleport
----------------------------------------------------------------------
local TELEPORT_FOLDERS = { Area = "AreaParts", NPC = "NPCs", Instruments = "Instruments" }
local targetMaps = { Area = {}, NPC = {}, Instruments = {} } -- kind -> { [label] = instance }

local function isTargetInstance(inst)
	return inst:IsA("Model") or inst:IsA("BasePart") or inst:IsA("Folder")
end

local function scanTargets(kind)
	local world = Workspace:FindFirstChild("World")
	local folder = world and world:FindFirstChild(TELEPORT_FOLDERS[kind])
	local found = {}
	if not folder then return found end
	for _, child in folder:GetChildren() do
		if kind == "NPC" and child:IsA("Folder") then
			-- NPCs/<grup>/<npc>
			for _, npc in child:GetChildren() do
				if isTargetInstance(npc) then found[#found + 1] = { name = npc.Name, obj = npc, group = child.Name } end
			end
		elseif child.Name ~= "" then
			found[#found + 1] = { name = child.Name, obj = child }
		end
	end
	table.sort(found, function(a, b) return a.name < b.name end)
	return found
end

-- Scan ulang, return daftar label buat dropdown. Nama kembar dikasih suffix.
local function refreshTargets(kind)
	local map, names = {}, {}
	for _, entry in scanTargets(kind) do
		local label = entry.name
		if map[label] then
			label = if entry.group then string.format("%s (%s)", entry.name, entry.group) else entry.name
			local n = 2
			while map[label] do
				label = string.format("%s #%d", entry.name, n)
				n += 1
			end
		end
		map[label] = entry.obj
		names[#names + 1] = label
	end
	targetMaps[kind] = map
	return names
end

local function findTarget(kind, name)
	local target = targetMaps[kind] and targetMaps[kind][name]
	if target and target.Parent then return target end
	refreshTargets(kind)
	return targetMaps[kind][name]
end

local function priceText(obj)
	local prompt = obj:FindFirstChild("pp")
	if not (prompt and prompt:IsA("ProximityPrompt")) then
		prompt = nil
		for _, desc in obj:GetDescendants() do
			if desc.Name == "pp" and desc:IsA("ProximityPrompt") then
				prompt = desc
				break
			end
		end
	end
	if not prompt then return "-" end
	if prompt.ObjectText ~= "" then return prompt.ObjectText end
	if prompt.ActionText ~= "" then return prompt.ActionText end
	return "-"
end

local function targetCFrame(obj)
	if typeof(obj) ~= "Instance" then return nil end
	if obj:IsA("Model") then
		local ok, cf = pcall(function() return obj:GetPivot() end)
		if ok and cf then return cf end
	end
	if obj:IsA("BasePart") then return obj.CFrame end
	local ok, part = pcall(function() return obj:FindFirstChildWhichIsA("BasePart", true) end)
	if ok and part then return part.CFrame end
	return nil
end

local function getRoot()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		local ok, r = pcall(function() return ctl.Character:GetRoot() end)
		if ok then root = r end
	end
	return root
end

local function teleportCFrame(cf, label)
	if cf == nil then return false, "Posisi tidak ketemu" end
	local root = getRoot()
	if root == nil then return false, "Character belum load" end
	local humanoid = currentHumanoid()
	if humanoid and humanoid.Health <= 0 then return false, "Character mati" end
	local ok = pcall(function()
		root.CFrame = cf
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end)
	if not ok then return false, "Gagal teleport" end
	state.lastTeleport = label
	return true, "Teleported ke " .. label
end

local function teleportTo(obj)
	if obj == nil then return false, "Target tidak ketemu" end
	local cf = targetCFrame(obj)
	if cf == nil then return false, "CFrame target tidak ketemu" end
	return teleportCFrame(cf + Vector3.new(0, 4, 0), obj.Name)
end

----------------------------------------------------------------------
-- Saved positions
----------------------------------------------------------------------
local Positions = { list = session.positions }

local function decodeCFrame(components)
	if type(components) ~= "table" or #components < 12 then return nil end
	local ok, cf = pcall(CFrame.new, table.unpack(components, 1, 12))
	if ok then return cf end
	return nil
end

if not Positions.list then
	Positions.list = {}
	local scopeData = docs.positions.scopes[scopeKey]
	if type(scopeData) == "table" and type(scopeData.positions) == "table" then
		for name, components in scopeData.positions do
			local cf = if type(name) == "string" then decodeCFrame(components) else nil
			if cf then Positions.list[name] = cf end
		end
	end
	session.positions = Positions.list
end

function Positions.names()
	local names = {}
	for name in Positions.list do names[#names + 1] = name end
	table.sort(names)
	return names
end

function Positions.persist()
	local serial = {}
	for name, cf in Positions.list do serial[name] = { cf:GetComponents() } end
	docs.positions.scopes[scopeKey] = { positions = serial }
	Store.save("saved-positions.json", docs.positions)
end

function Positions.save(name)
	name = tostring(name or ""):match("^%s*(.-)%s*$")
	if name == "" then return false, "Nama kosong" end
	local root = getRoot()
	if root == nil then return false, "Character belum load" end
	Positions.list[name] = root.CFrame
	Positions.persist()
	return true, "Disimpan: " .. name, name
end

function Positions.remove(name)
	if name == nil or Positions.list[name] == nil then return false, "Tidak ketemu: " .. tostring(name) end
	Positions.list[name] = nil
	Positions.persist()
	return true, "Dihapus: " .. name
end

function Positions.teleport(name)
	local cf = name and Positions.list[name]
	if cf == nil then return false, "Tidak ketemu: " .. tostring(name) end
	return teleportCFrame(cf, name)
end

