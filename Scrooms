local playerListCache = ""
local playerRefreshAcc = 0
connect(RunService.Heartbeat, function(dt)
	playerRefreshAcc += dt
	if playerRefreshAcc < 1 then return end
	playerRefreshAcc = 0
	if not state.alive then return end
	if ui.teleportPlayerDropdown == nil then return end
	local names = listPlayerNames()
	local key = table.concat(names, ",")
	if key ~= playerListCache then
		playerListCache = key
		pcall(function() ui.teleportPlayerDropdown:Refresh(names) end)
		if lastTeleportSelected.Player ~= nil then
			local still = false
			for _, n in names do if n == lastTeleportSelected.Player then still = true break end end
			if not still then
				lastTeleportSelected.Player = nil
				if ui.teleportPlayerSelected ~= nil then pcall(function() ui.teleportPlayerSelected:Set("-") end) end
			end
		end
	end
end)

