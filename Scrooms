local function items()
	if data == nil then return {} end
	local ok, res = pcall(function() return data:Get({ "Inventory", "Items" }) end)
	if not ok or type(res) ~= "table" then return {} end
	return res
end
local lastNetwork = shared.lastNetwork or 0
local lastFavoriteNetwork = shared.lastFavoriteNetwork or 0
local function paceNetwork()
	local remaining = 0.125 - (os.clock() - lastNetwork)
	if remaining > 0 then task.wait(remaining) end
	lastNetwork = os.clock()
	shared.lastNetwork = lastNetwork
end
local function setFavorite(uid, value)
	local item = items()[uid]
	if not item or (item.favorited == true) == value then return true end
	local remaining = 1 - (os.clock() - lastFavoriteNetwork)
	if remaining > 0 then task.wait(remaining) end
	paceNetwork()
	if inventoryRemote == nil then return false end
	inventoryRemote:FireServer("toggleFavorite", { uid = uid })
	lastFavoriteNetwork = os.clock()
	shared.lastFavoriteNetwork = lastFavoriteNetwork
	local endAt = os.clock() + 4
	repeat
		task.wait(0.05)
		item = items()[uid]
		if not item or (item.favorited == true) == value then return true end
	until os.clock() >= endAt
	return false
end
local function setSaleSetting(name, value)
	if registry == nil or registry.C == nil or registry.C.Settings == nil then return false end
	local ok, cur = pcall(function() return registry.C.Settings:Get(name) end)
	if ok and cur == value then return true end
	paceNetwork()
	local ok2 = pcall(function() registry.C.Settings:Set(name, value) end)
	if not ok2 then return false end
	local endAt = os.clock() + 4
	repeat
		task.wait(0.05)
		local ok3, v = pcall(function() return data:Get({ "Settings", name }) end)
		if ok3 and v == value then return true end
	until os.clock() >= endAt
	return false
end
local function restoreJournal(journal)
	if type(journal) ~= "table" then return false end
	local complete = true
	if type(journal.favorites) == "table" then
		for uid, value in journal.favorites do
			local ok, restored = pcall(setFavorite, uid, value)
			if not ok or not restored then complete = false end
		end
	end
	if type(journal.settings) == "table" then
		for name, value in journal.settings do
			local ok, restored = pcall(setSaleSetting, name, value)
			if not ok or not restored then complete = false end
		end
	end
	if complete then
		task.wait(0.2)
		if type(journal.favorites) == "table" then
			for uid, value in journal.favorites do
				local item = items()[uid]
				if item and (item.favorited == true) ~= value then complete = false end
			end
		end
		if type(journal.settings) == "table" then
			if registry ~= nil and registry.C ~= nil and registry.C.Settings ~= nil then
				for name, value in journal.settings do
					local ok, cur = pcall(function() return registry.C.Settings:Get(name) end)
					if ok and cur ~= value then complete = false end
				end
			end
		end
	end
	if complete then return writeJournal(nil) end
	return false
end
local function recoverSale()
	state.recovering = true
	while shared.saleRunning do
		if shared.saleWorker and coroutine.status(shared.saleWorker) == "dead" then
			shared.saleRunning, shared.saleWorker = nil, nil
			break
		end
		if not state.alive then return end
		task.wait(0.1)
	end
	if not state.alive then return end
	local journal = currentJournal()
	if journal then
		shared.saleRunning = token
		if minigame ~= nil then pcall(function() minigame:SetCastBlock(token, true) end) end
		local ok, restored = pcall(restoreJournal, journal)
		if minigame ~= nil then pcall(function() minigame:SetCastBlock(token, false) end) end
		shared.saleRunning = nil
		if not ok or not restored then
			state.recovering = true
			state.recoveryFailed = true
			message("Recovery needed. Run the script again", true)
			return
		end
		message("Sale settings restored")
	end
	state.recovering = false
	state.recoveryFailed = false
end
local function restorePatches()
	for index = #patches, 1, -1 do
		local entry = patches[index]
		if type(entry) == "table" and entry.object ~= nil and entry.key ~= nil then
			local ok, cur = pcall(function() return rawget(entry.object, entry.key) end)
			if ok and cur == entry.replacement then pcall(function() rawset(entry.object, entry.key, entry.original) end) end
		end
	end
	table.clear(patches)
end
local function patch(object, key, replacement)
	if object == nil or type(object) ~= "table" then return end
	local ok, orig = pcall(function() return rawget(object, key) end)
	if not ok then return end
	table.insert(patches, { object = object, key = key, original = orig, replacement = replacement })
	pcall(function() rawset(object, key, replacement) end)
end
local function beginPending()
