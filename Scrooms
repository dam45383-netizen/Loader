task.spawn(function()
	local lastPreview = 0
	local lastMsg = ""
	while state.alive do
		task.wait(0.1)
		if not state.alive then break end
		pcall(syncTogglesSilent)
		local showingMessage = os.clock() < state.messageUntil
		local text = if state.recoveryFailed then "Recovery needed. Run the script again"
			elseif state.recovering then "Restoring sale settings..."
			elseif shared.pending then "Waiting for catch..."
			elseif showingMessage then state.message
			elseif state.selling then state.salePhase or (if state.stage then "Finishing the current catch..." else "Selling inventory...")
			elseif state.stage == "ring" then "Casting..."
			elseif state.stage == "tune" then "Tuning..."
			elseif state.stage == "main" then "Catching..."
			elseif state.autoStart then "Waiting to cast..." else "Ready"
		if state.caught > 0 and not showingMessage and not shared.pending then text ..= " | " .. state.caught .. " caught" end
		if ui.statusPara ~= nil then pcall(function() ui.statusPara:Set(text) end) end
		if ui.caughtInfo ~= nil then pcall(function() ui.caughtInfo:Set(tostring(state.caught)) end) end
		if ui.caughtCatchInfo ~= nil then pcall(function() ui.caughtCatchInfo:Set(tostring(state.caught)) end) end
		if ui.stageInfo ~= nil then pcall(function() ui.stageInfo:Set(state.stage or "-") end) end
		if ui.pendingInfo ~= nil then pcall(function() ui.pendingInfo:Set(shared.pending and "Yes" or "No") end) end
		if ui.minigameStatus ~= nil then pcall(function() ui.minigameStatus:Set(if not state.minigameEnabled then "OFF" elseif state.minigameMode == "Legit" then "Legit ON" else "Instant ON") end) end
		if ui.dashStatus ~= nil then pcall(function() ui.dashStatus:Set(text) end) end
		if ui.dashCaught ~= nil then pcall(function() ui.dashCaught:Set(tostring(state.caught)) end) end
		if ui.teleportLast ~= nil then pcall(function() ui.teleportLast:Set(state.lastTeleport ~= "" and state.lastTeleport or "-") end) end
		if ui.forageStatus ~= nil then pcall(function() ui.forageStatus:Set(if not state.autoForage then "Idle" else state.forageStatus) end) end
		if ui.forageCurrent ~= nil then pcall(function() ui.forageCurrent:Set(state.forageCurrent) end) end
		if ui.forageCount ~= nil then pcall(function() ui.forageCount:Set(tostring(state.forageCount)) end) end
		if ui.forageModeInfo ~= nil then pcall(function() ui.forageModeInfo:Set(state.forageMode) end) end
		if ui.forageTotal ~= nil then
			pcall(function()
				local f = workspace:FindFirstChild("SpawnedIngredients")
				ui.forageTotal:Set(tostring(f and #f:GetChildren() or 0))
			end)
		end
		local remaining = math.max(0, state.nextAutoSellAt - os.clock())
		local nextText = if not state.autoSell then "OFF"
			elseif state.selling then "Selling..."
			elseif remaining >= 3600 then string.format("in %dh %dm", math.floor(remaining / 3600), math.floor(remaining % 3600 / 60))
			elseif remaining >= 60 then string.format("in %dm %ds", math.floor(remaining / 60), math.floor(remaining % 60))
			else string.format("in %ds", math.floor(remaining))
		if ui.nextAutoSellInfo ~= nil then pcall(function() ui.nextAutoSellInfo:Set(nextText) end) end
		if ui.dashAutoSell ~= nil then pcall(function() ui.dashAutoSell:Set(nextText) end) end
		if ui.intervalInfo ~= nil then pcall(function() ui.intervalInfo:Set(string.format("Every %d %s (%ds)", state.autoSellAmount, state.autoSellUnit, autoSellIntervalSec())) end) end
		if state.message ~= lastMsg then
			lastMsg = state.message
