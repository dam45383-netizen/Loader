-- Bot rhythm (mode Legit): hit note otomatis di tiap tipe instrument.
local function playRhythm(object)
	if type(object) ~= "table" then return end

	if object.Type == "Wind" then
		if type(object._blow) == "table" then hook(object._blow, lockId, true) end
		local moveCursor = object._moveCursor
		if type(moveCursor) == "function" then
			hook(object, "_moveCursor", function(self, _, chartTime)
				if type(self) ~= "table" then return end
				if type(self._notes) == "table" then
					for _, note in self._notes do
						if type(note) == "table" and not note.done and type(note.time) == "number" and type(note.length) == "number"
							and chartTime >= note.time and chartTime < note.time + note.length then
							if type(note.from) == "number" and type(note.to) == "number" then
								local fraction = math.clamp((chartTime - note.time) / note.length, 0, 1)
								self._pitch = note.from + (note.to - note.from) * fraction
								self._target = self._pitch
							end
							break
						end
					end
				end
				return moveCursor(self, 0, chartTime)
			end)
		end
	end

	local step = object._step
	if type(step) ~= "function" then return end
	if type(object._scroomsCounted) ~= "table" then object._scroomsCounted = {} end

	hook(object, "_step", function(self, deltaTime)
		if type(self) ~= "table" or not self._jan then return end
		pcall(function()
			if self._paused or (self._hitstop and os.clock() < self._hitstop) then return end
			if self.Type == "Wind" and type(self._blow) == "table" then self._blow[lockId] = true end
			if type(self._chartTime) ~= "function" then return end
			local chartTime = self:_chartTime()

			if self._locked then
				local countIn = self._countIn
				if self._countInPress ~= nil and type(countIn) == "table" and type(countIn.taps) == "table" then
					for index, tapTime in countIn.taps do
						if type(tapTime) == "number" and not self._scroomsCounted[index] and chartTime >= tapTime then
							self._scroomsCounted[index] = true
							if chartTime - tapTime <= 0.15 and type(self._countInPress) == "function" then self._countInPress() end
						end
					end
				end
				return
			end

			local list = if type(self._groups) == "table" then self._groups else self._notes
			if type(list) ~= "table" then return end
			for _, note in list do
				if type(note) ~= "table" or type(note.time) ~= "number" or note.time > chartTime then continue end
				if self.Type == "Strings" and note.state == "pending" and type(self._hitGroup) == "function" then
					pcall(function() self:_hitGroup(note) end)
				elseif self.Type == "Keys" and note.state == "pending" and type(self._hitNote) == "function" then
					pcall(function() self:_hitNote(note, chartTime) end)
				elseif self.Type == "Wind" and not note.headJudged and type(note.from) == "number" then
					self._pitch, self._target = note.from, note.from
					if type(self._press) == "function" then pcall(function() self:_press() end) end
				elseif self.Type == "Percussion" and not note.judged and not note.ghost and type(self._hit) == "function" then
					pcall(function() self:_hit(if note.kind == "big" then "don" else note.kind) end)
					if self._jan and note.kind == "big" and not note.judged then pcall(function() self:_hit("ka") end) end
				end
				if not self._jan then return end
			end
		end)
		return step(self, deltaTime)
	end)
end

-- Dipanggil tiap stage minigame berubah (ring / tune / main / nil).
local function onStage(stage, object)
	unhookAll()
	if not state.alive or type(object) ~= "table" or not object._jan then return end

	-- Tandai catch yang sukses supaya cast berikutnya nunggu konfirmasi server.
	if stage == "main" and type(object.OnComplete) == "table" then
		local complete = object.OnComplete.Fire
		if type(complete) == "function" then
			hook(object.OnComplete, "Fire", function(self, success, ...)
				if success and state.alive and not (type(object._params) == "table" and object._params.training) then markPending() end
				return complete(self, success, ...)
			end)
		end
	end

	if isInstant() then
		task.defer(function()
			if not state.alive or not isInstant() or state.round ~= object or not object._jan then return end
			if stage == "ring" and not object._complete then
				if object.OnComplete ~= nil then pcall(function() object.OnComplete:Fire(1) end) end
			elseif stage == "main" and not object._scroomsClaimed then
				if type(object._params) == "table" and object._params.infinite then return end
				object._scroomsClaimed = true
				object._locked = false
				if type(object._changeProgress) == "function" then pcall(function() object:_changeProgress(1) end) end
			end
		end)
	elseif isLegit() then
		if stage == "ring" and not object._complete then
			task.defer(function()
				if not (state.alive and isLegit() and state.round == object and object._jan and not object._complete) then return end
				if object._tween ~= nil then pcall(function() object._tween:Cancel() end) end
				local ring = if type(object._ui) == "table" then object._ui.Ring else nil
				if type(ring) == "table" and ring.Tick ~= nil then
					pcall(function() ring.Tick.Rotation = object._targetRot or 0 end)
				end
				if type(object.Complete) == "function" then pcall(function() object:Complete() end) end
			end)
		elseif stage == "main" then
			playRhythm(object)
		end
	end
end

-- Cari minigame yang lagi jalan lewat getgc (kalau stage ke-detect salah / telat).
local function findStage()
	if type(state.round) == "table" and state.round._jan then return end
	if not exec.getgc then return end
	local ok, objects = pcall(exec.getgc, true)
	if not ok or type(objects) ~= "table" then return end
	for _, object in objects do
		if type(object) ~= "table" or not rawget(object, "_jan") then continue end
		local ui = rawget(object, "_ui")
		if typeof(ui) ~= "Instance" or not ui:IsDescendantOf(playerGui) then continue end
		local stage = if rawget(object, "_targetRot") then "ring"
			elseif type(rawget(object, "_params")) == "table" and type(object._changeProgress) == "function"
				and type(object._chartTime) == "function" then "main"
			else nil
		if stage then
			state.stage, state.round = stage, object
			return
		end
	end
end

local function refreshMinigame()
	findStage()
	onStage(state.stage, state.round)
end

connect(minigame.StageChanged, function(stage, object)
	state.stage, state.round = stage, object
