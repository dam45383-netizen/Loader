local blatantClone = nil
local blatantCloneHum = nil
local blatantCamLock = false
local blatantLastPos = nil
local forageFail = {}

local function getNameLabel()
	local nameplate = playerGui:FindFirstChild("Nameplate")
	if not nameplate then return nil end
	local container = nameplate:FindFirstChild("Container")
	if not container then return nil end
	return container:FindFirstChild("PlayerName")
end

local function applyHideName()
	local label = getNameLabel()
	if not label then return end
	if originalNameText == nil then originalNameText = label.Text end
	label.Text = "NEXRIFT"
	label.TextColor3 = Color3.fromRGB(255, 0, 0)
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	label.TextStrokeTransparency = 0
	label.Font = Enum.Font.GothamBlack
	pcall(function() label.TextSize = 17 end)
	label.RichText = false
	local stroke = label:FindFirstChild("NEXRIFT_Stroke")
	if not stroke then
		stroke = Instance.new("UIStroke")
		stroke.Name = "NEXRIFT_Stroke"
		stroke.Color = Color3.fromRGB(255, 0, 0)
		stroke.Thickness = 1.5
		stroke.Transparency = 0.15
		stroke.Parent = label
	else
		stroke.Enabled = true
	end
end

local function restoreHideName()
	local label = getNameLabel()
	if label and originalNameText ~= nil then
		label.Text = originalNameText
		label.TextColor3 = Color3.fromRGB(255, 255, 255)
		label.TextStrokeTransparency = 1
		label.Font = Enum.Font.GothamBold
	end
	local lbl = getNameLabel()
	if lbl then
		local stroke = lbl:FindFirstChild("NEXRIFT_Stroke")
		if stroke then stroke.Enabled = false end
	end
end

local function applyFPSBoost(enabled)
	if enabled then
		pcall(function()
			local lighting = game:GetService("Lighting")
			lighting.GlobalShadows = false
			lighting.FogEnd = 100000
			lighting.Brightness = 1
			for _, eff in lighting:GetChildren() do
				if eff:IsA("PostEffect") then eff.Enabled = false end
			end
			settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
		end)
		for _, obj in workspace:GetDescendants() do
			pcall(function()
				if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then obj.Enabled = false end
				if obj:IsA("Decal") then obj.Transparency = 1 end
			end)
		end
	else
		pcall(function()
			local lighting = game:GetService("Lighting")
			lighting.GlobalShadows = true
			lighting.FogEnd = 1000
			for _, eff in lighting:GetChildren() do
				if eff:IsA("PostEffect") then eff.Enabled = true end
			end
			settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
		end)
	end
end

local function createBlatantClone(anchorCF)
	if blatantClone and blatantClone.Parent then return blatantClone end
	local char = player.Character
	if not char then return nil end
	local originCF = anchorCF
	if not originCF then
		local root = char:FindFirstChild("HumanoidRootPart")
		if root then originCF = root.CFrame end
	end
	char.Archivable = true
	local clone = char:Clone()
	if not clone then return nil end
	clone.Name = player.Name .. "_Clone"
	clone.Parent = workspace
	for _, desc in clone:GetDescendants() do
		if desc:IsA("BasePart") then
			desc.CanCollide = false
			desc.CanTouch = false
			pcall(function() desc.CanQuery = false end)
		end
		if desc:IsA("Script") or desc:IsA("LocalScript") then pcall(function() desc:Destroy() end) end
	end
	local hum = clone:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false) end)
	end
	if originCF then pcall(function() clone:PivotTo(originCF) end) end
	blatantClone = clone
	blatantCloneHum = hum
	blatantCamLock = true
	if originCF then blatantLastPos = originCF end
	local cam = workspace.CurrentCamera
	if cam and hum then cam.CameraSubject = hum end
	return clone
end

local function destroyBlatantClone(restoreCamera)
	blatantCamLock = false
	if blatantClone then pcall(function() blatantClone:Destroy() end) end
	blatantClone = nil
	blatantCloneHum = nil
	if restoreCamera == false then return end
	local char = player.Character
	local cam = workspace.CurrentCamera
	if cam and char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then cam.CameraSubject = hum end
	end
end

local function syncBlatantClone()
	if state.autoForage and state.forageMode == "Blatant" then
		if not (blatantClone and blatantClone.Parent) then createBlatantClone(blatantLastPos) end
	else
		if blatantClone then destroyBlatantClone() end
	end
end

function api.SetInfJump(value)
	if not state.alive then return false end
	state.infJump = value == true
	state.viewDirty = true
	state.saveAt = os.clock() + 0.5
	return true
end

function api.SetNoclip(value)
	if not state.alive then return false end
	state.noclip = value == true
	state.viewDirty = true
	state.saveAt = os.clock() + 0.5
	if not state.noclip then
		local char = player.Character
		if char then
			for _, part in char:GetDescendants() do
				if part:IsA("BasePart") then part.CanCollide = true end
			end
		end
	end
	return true
end

function api.SetHideName(value)
	if not state.alive then return false end
	state.hideName = value == true
	if state.hideName then applyHideName() else restoreHideName() end
	state.viewDirty = true
	state.saveAt = os.clock() + 0.5
	return true
end

function api.SetAutoForage(value)
	if not state.alive then return false end
	state.autoForage = value == true
	if not state.autoForage then
		state.forageStatus = "Idle"
		state.forageCurrent = "-"
		table.clear(forageFail)
		destroyBlatantClone()
	else
		syncBlatantClone()
	end
	state.viewDirty = true
	state.saveAt = os.clock() + 0.5
	return true
end

function api.SetForageMode(value)
	if not state.alive then return false end
	if value == nil then return false end
	if type(value) == "table" then value = value[1] end
	if value == nil then return false end
	state.forageMode = normalizeForageMode(value)
	table.clear(forageFail)
	syncBlatantClone()
	state.viewDirty = true
	state.saveAt = os.clock() + 0.5
	return true
end

function api.SetWalkSpeedEnabled(value)
	if not state.alive then return false end
	state.walkSpeedEnabled = value == true
	if not state.walkSpeedEnabled then
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then hum.WalkSpeed = 16 end
	else
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then hum.WalkSpeed = state.walkSpeedValue end
	end
	state.viewDirty = true
	state.saveAt = os.clock() + 0.5
	return true
end

function api.SetWalkSpeedValue(value)
	if not state.alive then return false end
	if value == nil then return false end
	local n = tonumber(value)
	if n == nil then return false end
	state.walkSpeedValue = clampWalkSpeed(n)
	if state.walkSpeedEnabled then
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then hum.WalkSpeed = state.walkSpeedValue end
	end
	state.viewDirty = true
	state.saveAt = os.clock() + 0.5
	return true
end

function api.SetFPSBoost(value)
	if not state.alive then return false end
	state.fpsBoost = value == true
	applyFPSBoost(state.fpsBoost)
	state.viewDirty = true
	state.saveAt = os.clock() + 0.5
	return true
end

connect(UserInputService.JumpRequest, function()
	if not state.alive or not state.infJump then return end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
end)

connect(RunService.Stepped, function()
	if not state.alive then return end
	if state.noclip then
		local char = player.Character
		if char then
			for _, part in char:GetDescendants() do
				if part:IsA("BasePart") then part.CanCollide = false end
			end
		end
	end
	if state.walkSpeedEnabled then
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum and hum.WalkSpeed ~= state.walkSpeedValue then hum.WalkSpeed = state.walkSpeedValue end
	end
end)

connect(RunService.Heartbeat, function()
	if not state.alive then return end
	if blatantCamLock and blatantClone and blatantClone.Parent and blatantCloneHum then
		local cam = workspace.CurrentCamera
		if cam and cam.CameraSubject ~= blatantCloneHum then cam.CameraSubject = blatantCloneHum end
		local cloneRoot = blatantClone:FindFirstChild("HumanoidRootPart")
		if cloneRoot then blatantLastPos = cloneRoot.CFrame end
		local realHum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if realHum then
			pcall(function() blatantCloneHum:Move(realHum.MoveDirection, false) end)
			if realHum.Jump then blatantCloneHum.Jump = true end
			if blatantCloneHum.WalkSpeed ~= (state.walkSpeedEnabled and state.walkSpeedValue or 16) then
				blatantCloneHum.WalkSpeed = if state.walkSpeedEnabled then state.walkSpeedValue else 16
			end
		end
	end
end)

task.spawn(function()
	while state.alive do
		task.wait(0.5)
		if state.autoForage and state.forageMode == "Blatant" then
			local bad = false
			if not blatantClone or not blatantClone.Parent then
				bad = true
			elseif not blatantCloneHum or blatantCloneHum.Health <= 0 then
				bad = true
			else
				local r = blatantClone:FindFirstChild("HumanoidRootPart")
				if r and r.Position.Y < -100 then bad = true end
			end
			if bad then
				destroyBlatantClone(false)
				task.wait(0.1)
				if state.alive and state.autoForage and state.forageMode == "Blatant" then
					createBlatantClone(blatantLastPos)
				end
			end
		end
	end
end)

connect(player.CharacterAdded, function(char)
	task.wait(0.5)
	if not state.alive then return end
	if state.walkSpeedEnabled then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then hum.WalkSpeed = state.walkSpeedValue end
	end
	if state.fpsBoost then applyFPSBoost(true) end
	if state.autoForage and state.forageMode == "Blatant" then
		destroyBlatantClone(false)
		task.wait(0.2)
		createBlatantClone(blatantLastPos)
	end
end)

connect(playerGui.ChildAdded, function(child)
	if child.Name == "Nameplate" then
		task.wait(0.25)
		if state.alive and state.hideName then applyHideName() end
	end
end)

task.spawn(function()
	while state.alive do
		task.wait(0.25)
		if state.alive and state.hideName then pcall(applyHideName) end
	end
end)

task.spawn(function()
	while state.alive do
		task.wait(0.2)
		if not state.alive then break end
		if state.walkSpeedEnabled then
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if hum and hum.WalkSpeed ~= state.walkSpeedValue then
				pcall(function() hum.WalkSpeed = state.walkSpeedValue end)
			end
		end
	end
end)

