local function backupValid(backup)
	if type(backup) ~= "table" or type(backup.favorites) ~= "table" or type(backup.settings) ~= "table" then return false end
	for uid, value in backup.favorites do
		if type(uid) ~= "string" or type(value) ~= "boolean" then return false end
	end
	for key, value in backup.settings do
		if not SETTING_KEYS[key] or type(value) ~= "boolean" then return false end
	end
	return true
end

local function currentBackup()
	local backup = session.backup or docs.backup.scopes[scopeKey]
