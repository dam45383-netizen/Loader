-- // === TAB 4: TREASURE - NEW ===
local TreasureTab = Window:Tab({Title = "Treasure", Icon = "💎", Group = "Farm"})
TreasureTab:Section("Stealer")

-- Ambil Rarity dinamis dari TreasureData
local RARITY_ORDER = {}
pcall(function()
    local TreasureData = require(RS.Shared:WaitForChild("TreasureData"))
    RARITY_ORDER = TreasureData.RARITY_ORDER
end)
-- Fallback kalau require gagal (executor nge-block)
if #RARITY_ORDER == 0 then
    RARITY_ORDER = {"Common","Uncommon","Rare","Epic","Legendary","Mythic","Secret","Exotic","Divine","Astral","Transcendent","Omega","Ascendant","Paragon","Eternity","Electric","Plasma","Singularity","Hex","Coven","Eldritch","Stellar","Nebula","Galactic","Molten","Infernal","Primordial"}
end

local SelectedRarities = {"Mythic","Secret","Exotic","Divine"}
local AutoSteal = false

local TreasureAcc = TreasureTab:Accordion({Title = "Auto Steal Treasure", Desc = "Teleport + Interact by Rarity", Open = true})

TreasureAcc:Dropdown({
    Title = "Rarity",
    Desc = "Pilih rarity yang mau di steal (Multi)",
    Flag = "TreasureRarity",
    Options = RARITY_ORDER,
    Default = SelectedRarities,
    Multi = true,
    Callback = function(v)
        SelectedRarities = v
    end
})

local function getRarityText(model)
    -- Path: Treasure_130.TreasureLabel.Lines.Line2
    local ok, result = pcall(function()
        local label = model:FindFirstChild("TreasureLabel", true)
        if not label then return nil end
        local line2 = label:FindFirstChild("Line2", true) or label:FindFirstChild("Line2", false)
        if line2 and line2:FindFirstChild("Line2") then line2 = line2.Line2 end -- jaga-jaga
        -- Coba ambil Lines.Line2
        local lines = label:FindFirstChild("Lines")
        if lines and lines:FindFirstChild("Line2") and lines.Line2:IsA("TextLabel") then
            return lines.Line2.Text
        end
        if line2 and line2:IsA("TextLabel") then return line2.Text end
        -- brute force cari TextLabel yang ada di dalamnya yang namanya Line2
        for _,d in ipairs(model:GetDescendants()) do
            if d.Name == "Line2" and d:IsA("TextLabel") then return d.Text end
        end
        return nil
    end)
    if ok then return result end
    return nil
end

local function isWanted(rarityText)
    if not rarityText then return false end
    for _, wanted in ipairs(SelectedRarities) do
        if rarityText:lower():find(wanted:lower()) then return true end
    end
    return false
end

TreasureAcc:Toggle({
    Title = "Auto Steal",
    Desc = "Cek LocalTreasureDrops & steal jika rarity cocok",
    Flag = "AutoStealTreasure",
    Default = false,
    Callback = function(v)
        AutoSteal = v
        if v then task.spawn(function()
            while AutoSteal do
                local dropsFolder = workspace:FindFirstChild("LocalTreasureDrops")
                if dropsFolder then
                    for _, treasure in ipairs(dropsFolder:GetChildren()) do
                        if not AutoSteal then break end
                        local rarityText = getRarityText(treasure)
                        if isWanted(rarityText) then
                            -- Teleport
                            pcall(function()
                                local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                                if hrp then
                                    -- pakai Pivot biar support Model
                                    local cf = treasure:GetPivot() or treasure:GetPrimaryPartCFrame() or CFrame.new(treasure:GetBoundingBox())
                                    hrp.CFrame = cf + Vector3.new(0,3,0)
                                end
                            end)
                            task.wait(0.05)
                            -- Fire Interact 0 detik
                            pcall(function()
                                for _, obj in ipairs(treasure:GetDescendants()) do
                                    if obj:IsA("ProximityPrompt") then
                                        fireproximityprompt(obj, 0)
                                    end
                                end
                            end)
                            -- fallback remote kalau pake remote
                            pcall(function()
                                local interactRemote = RS:FindFirstChild("InteractTreasure") or RS:FindFirstChild("CollectTreasure") or RS:FindFirstChild("TreasureInteract")
                                if interactRemote then
                                    interactRemote:FireServer(treasure)
                                end
                            end)
                            task.wait(0.1)
                        end
                    end
                end
                task.wait(0.2)
            end
        end) end
    end
})

