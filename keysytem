    ------------------------------------------------------------------
    -- RENDER LOOP: ring dinamis, orbit, neon, float, drag pegas, tilt, shake, spotlight
    ------------------------------------------------------------------
    local dragging = false
    local rot = 0
    local shakeT0 = nil
    local ringRot, ringSpd, orbA, bobK = 0, 52, 0, 0
    local glowCol = T.accent
    local spotX, spotY, spotOn = W / 2, H / 2, false
    bind(RunService.RenderStepped, function(dt)
        if dt > 0.1 then dt = 0.1 end
        local now = os.clock()

        -- ring: ngebut saat verifikasi
        local goal = busy and 380 or (done and 150 or 52)
        ringSpd = ringSpd + (goal - ringSpd) * (1 - math.exp(-dt * 4))
        ringRot = (ringRot + ringSpd * dt) % 360
        if ringG then ringG.Rotation = ringRot end
        if badgeRingG then badgeRingG.Rotation = (ringRot * 1.7) % 360 end
        if innerG then innerG.Rotation = (-ringRot * 0.6) % 360 end

        -- titik orbit di sekitar badge
        if dotA and dotB then
            orbA = orbA + dt * (busy and 8 or 2.6)
            local cx, cy, rad = PAD + ICON_S / 2, H / 2, ICON_S / 2 + 2
            dotA.Position = UDim2.fromOffset(cx + math.cos(orbA) * rad, cy + math.sin(orbA) * rad)
            dotB.Position = UDim2.fromOffset(cx + math.cos(orbA + math.pi) * rad, cy + math.sin(orbA + math.pi) * rad)
        end

        -- neon: warna palet berputar / warna status
        if neon then
            glowCol = glowCol:Lerp(stateCol or palette(now * 0.12), math.min(1, dt * 6))
            neon.ImageColor3 = glowCol
        end

        -- posisi: pegas ke target + shake redam + float pelan
        local sx = 0
        if shakeT0 then
            local t = now - shakeT0
            if t > 0.55 then shakeT0 = nil else sx = math.exp(-7 * t) * math.sin(t * 42) * 8 end
        end
        local ex, ey = tx - ox, ty - oy
        local a = 1 - math.exp(-dt * 18)
        ox = ox + ex * a
        oy = oy + ey * a
        local targetRot = dragging and math.clamp(ex * 0.03, -2, 2) or 0
        rot = rot + (targetRot - rot) * (1 - math.exp(-dt * 10))
        if math.abs(rot) < 0.005 and not dragging then rot = 0 end
        bobK = bobK + ((isOpen and 1 or 0) - bobK) * (1 - math.exp(-dt * 2.5))
        local bob = math.sin(now * 1.7) * 1.6 * bobK
        shell.Position = UDim2.new(0.5, ox + sx, 0.5, oy + bob)
        win.Rotation = rot

        -- spotlight mengikuti kursor (hanya kalau ada mouse)
        if spot then
            local want = false
            if UIS.MouseEnabled and isOpen and not done then
                local m = UIS:GetMouseLocation()
                local ap, asz = content.AbsolutePosition, content.AbsoluteSize
                if asz.X > 1 then
                    local r = asz.X / W
                    local lx, ly = (m.X - ap.X) / r, (m.Y - ap.Y) / r
                    want = lx > -20 and lx < W + 20 and ly > -14 and ly < H + 14
                    if want then
                        local k = 1 - math.exp(-dt * 14)
                        spotX = spotX + (math.clamp(lx, 0, W) - spotX) * k
                        spotY = spotY + (math.clamp(ly, 0, H) - spotY) * k
                        spot.Position = UDim2.fromOffset(spotX, spotY)
                    end
                end
            end
            if want ~= spotOn then
                spotOn = want
                play(spot, {GroupTransparency = want and 0.15 or 1}, 0.35, SINE)
            end
        end
    end)
    track(win,
        function()
            dragging = true
            if isOpen then play(winScale, {Scale = 1.02}, 0.25, QUINT) end
            return Vector2.new(tx, ty)
        end,
        function(dx, dy, st, moved)
            if moved and st then
                local s = rootScale.Scale
                tx, ty = st.X + dx / s, st.Y + dy / s
                layout()
            end
        end,
        function()
            dragging = false
            if isOpen and not finished then play(winScale, {Scale = 1}, 0.5, QUINT) end
        end)
    local function shake() shakeT0 = os.clock() end

    ------------------------------------------------------------------
    -- VALIDASI KEY
    ------------------------------------------------------------------
    local function same(a, b)
        if caseSens then return a == b end
        return a:lower() == b:lower()
    end

    local function fetchKeys()
        local ok, body = pcall(function() return game:HttpGet(C.KeyUrl) end)
        if not ok or type(body) ~= "string" then return nil end
        local list = {}
        for line in body:gmatch("[^\r\n]+") do
            local k = trim(line)
            if k ~= "" and k:sub(1, 1) ~= "#" then list[#list + 1] = k end
        end
        return list
    end

    -- return true | false, "pesan"
    local function check(key)
        key = trim(key)
        if key == "" then return false, "Enter your key first" end
        if C.Validate then
            local ok, res, msg = pcall(C.Validate, key)
            if not ok then return false, "Validator error: "..tostring(res) end
            if res then return true end
            return false, msg or "That key isn't valid"
        end
        local list = {}
        for _, k in ipairs(C.Keys or {}) do list[#list + 1] = tostring(k) end
        if C.KeyUrl then
            local remote = fetchKeys()
            if remote then
                for _, k in ipairs(remote) do list[#list + 1] = k end
            elseif #list == 0 then
                return false, "Couldn't load the key list. Check your connection"
            end
        end
        if #list == 0 then return false, "No keys configured" end
        for _, k in ipairs(list) do
            if same(k, key) then return true end
        end
        return false, "That key isn't valid"
    end

    ------------------------------------------------------------------
    -- ALUR VERIFIKASI
    ------------------------------------------------------------------
    local function burst(col)
        local r = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(24, 24), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 7}, btn)
        corner(r, FULL)
        local rs = stroke(r, col, 2, 0.1)
        play(r, {Size = UDim2.fromOffset(220, 220)}, 0.9, QUINT)
        play(rs, {Transparency = 1}, 0.9, SINE)
        task.delay(0.95, function() r:Destroy() end)
    end

    local function onSuccess(key)
        done = true
        sweepOff()
        scanOff()
        if saveKey then pcall(function() if writefile then writefile(keyFile, key) end end) end
        sfx("boot")
        unlockIcon()
        okFill.BackgroundColor3 = T.ok
        play(okFill, {BackgroundTransparency = 0.05}, 0.45, SINE)
        play(btnStroke, {Transparency = 1}, 0.3, SINE)
        setBtn("Accepted")
        say("Key accepted. Loading hub", T.ok, true)
        flash(T.ok)
        burst(T.ok)
        shockwave(T.ok, 70, 0)
        shockwave(T.cyan, 120, 0.12)
        confetti()
        task.delay(0.08, function() sfx("pop", 1.0) end)
        task.delay(0.22, function() sfx("pop", 1.3, 0.8) end)
        task.delay(1.3, function() finish(true, key) end)
    end

    local function lockout(sec)
        locked = true
        play(btn, {GroupTransparency = 0.45}, 0.3, SINE)
        play(okFill, {BackgroundTransparency = 1}, 0.3, SINE)
        say("Too many attempts. Please wait", T.warn, true)
        task.spawn(function()
            for s = sec, 1, -1 do
                if not gui.Parent then return end
                btnL.Text = "Wait "..s.."s"
                task.wait(1)
            end
            locked = false
            attempts = 0
            if gui.Parent then
                setBtn(BTN_TEXT)
                play(btn, {GroupTransparency = 0}, 0.3, SINE)
                clearSay()
            end
        end)
    end

    local function onFail(msg, auto)
        attempts = attempts + 1
        sfx("error")
        sweepOff()
        scanOff()
        if auto then
            pcall(function() if delfile and isfile and isfile(keyFile) then delfile(keyFile) end end)
            msg = "Your saved key is no longer valid"
        end
        okFill.BackgroundColor3 = T.bad
        play(okFill, {BackgroundTransparency = 0.15}, 0.15, SINE)
        setBtn("Invalid")
        task.delay(1.1, function()
            if gui.Parent and not done and not locked and not busy then
                play(okFill, {BackgroundTransparency = 1}, 0.4, SINE)
                setBtn(BTN_TEXT)
            end
        end)
        say(msg or "That key isn't valid", T.bad)
        flash(T.bad)
        shake()
        glitch()
        rattleIcon()
        shockwave(T.bad, 24, 0)
        tintBadge(T.bad, 0.15, 0.12)
        task.delay(0.9, function()
            if gui.Parent and not done then tintBadge(T.bad, 1, 0.5) end
        end)
        if maxAttempts > 0 and attempts >= maxAttempts then lockout(cooldown) end
    end

    local function submit(auto)
        if busy or done or locked or finished then return end
        local key = trim(box.Text)
        if key == "" then
            sfx("error")
            say("Enter your key first", T.warn)
            shake()
            rattleIcon()
            return
        end
        busy = true
        flashTok = flashTok + 1
        stateCol = T.cyan
        sfx("click")
        say("Checking key", T.cyan, true)
        sweepOn()
        scanOn()
        play(winScale, {Scale = 0.97}, 0.25, QUINT) -- squish
        task.spawn(function()
            local n = 0
            while busy and gui.Parent do
                n = n % 3 + 1
                btnL.Text = "Checking"..string.rep(".", n)
                task.wait(0.3)
            end
        end)
        task.spawn(function()
            local t0 = os.clock()
            local ok, msg = check(key)
            local el = os.clock() - t0
            if el < 0.7 then task.wait(0.7 - el) end
            if not gui.Parent then return end
            busy = false
            play(winScale, {Scale = 1}, 0.7, BACK) -- bounce
            if ok then onSuccess(key) else onFail(msg, auto) end
        end)
    end

    btnHit.MouseButton1Click:Connect(function() submit(false) end)
    box.FocusLost:Connect(function(enterPressed) if enterPressed then submit(false) end end)

    ------------------------------------------------------------------
    -- START
    ------------------------------------------------------------------
    applyScale()
    openA()

    -- key tersimpan -> isi otomatis lalu verifikasi (tunggu intro selesai)
    local saved = nil
    if saveKey then
        pcall(function() if isfile and isfile(keyFile) then saved = trim(readfile(keyFile)) end end)
        if saved == "" then saved = nil end
    end
    if saved then
        box.Text = saved
        if autoLogin then
            task.delay(1.3, function() if gui.Parent and not done and not busy then say("Verifying saved key", T.cyan, true) end end)
            task.delay(1.7, function()
                if gui.Parent and not done and not busy then submit(true) end
            end)
        end
    end
    if not (C.Keys or C.KeyUrl or C.Validate) then
        warn("[SORU KEY] Keys, KeyUrl, or Validate isn't set. Every key will be rejected.")
    end

    local obj = {}
    function obj:Destroy() if not finished then finished = true end gui:Destroy() end
    function obj:IsDone() return finished end

    if C.Wait then
        while not (finished and gui.Parent == nil) do task.wait(0.1) end
        return result
    end
    return obj
end

return KeySystem
