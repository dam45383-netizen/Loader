-- kontras WCAG
local function lin(c)
    if c <= 0.03928 then return c / 12.92 end
    return ((c + 0.055) / 1.055) ^ 2.4
end
local function lum(col) return 0.2126 * lin(col.R) + 0.7152 * lin(col.G) + 0.0722 * lin(col.B) end
local function contrast(a, b)
    local la, lb = lum(a), lum(b)
    if la < lb then la, lb = lb, la end
    return (la + 0.05) / (lb + 0.05)
end

local function applyPalette(name)
    local p = THEMES[name] or THEMES.Violet
    T.accent, T.accent2, T.cyan, T.pink = p[1], p[2], p[3], p[4]
    local h = T.accent:ToHSV()
    T.ground   = Color3.fromHSV(h, 0.30, 0.085) -- isi bar
    T.raised   = Color3.fromHSV(h, 0.26, 0.150) -- chip dan baris link (satu tangga tone di atas ground)
    T.raisedHi = Color3.fromHSV(h, 0.24, 0.210) -- tombol saat belum siap
    T.text     = Color3.fromHSV(h, 0.06, 0.970) -- ink penuh
    T.dim      = Color3.fromHSV(h, 0.12, 0.680) -- teks sekunder dan ikon diam
    T.faint    = Color3.fromHSV(h, 0.14, 0.560) -- placeholder
    -- tombol: label putih kalau bisa lulus AA, kalau tidak gelapkan fill sedikit, kalau masih tidak, pakai label gelap
    local fill, ink = T.accent, WHITE
    if contrast(WHITE, fill) < 4.5 then
        local darker = fill
        for _ = 1, 6 do
            darker = darker:Lerp(Color3.new(0, 0, 0), 0.07)
            if contrast(WHITE, darker) >= 4.5 then break end
        end
        if contrast(WHITE, darker) >= 4.5 then fill = darker else ink = T.ground end
    end
    T.btnFill, T.btnText = fill, ink
end

