--[[
    SORU KEY SYSTEM v1.1 FIX
]]
local KeySystem = {}
KeySystem.Version = "1.1"

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Http = game:GetService("HttpService")

local CFG = "SORU_HUB"
pcall(function() if makefolder and not isfolder(CFG) then makefolder(CFG) end end)

local T = {
    ink = Color3.fromRGB(8, 7, 15),
    panel = Color3.fromRGB(16, 14, 28),
    card = Color3.fromRGB(25, 22, 41),
    stroke = Color3.fromRGB(68, 61, 106),
    text = Color3.fromRGB(246, 244, 255),
    dim = Color3.fromRGB(150, 142, 186),
    accent = Color3.fromRGB(145, 96, 255),
    ok = Color3.fromRGB(74, 222, 128),
    bad = Color3.fromRGB(248, 113, 113),
}
local THEMES = {
    Violet = {Color3.fromRGB(145, 96, 255), Color3.fromRGB(94, 106, 255)},
    Ocean = {Color3.fromRGB(40, 160, 255), Color3.fromRGB(56, 112, 255)},
}
local function applyPalette(name)
    local p = THEMES[name] or THEMES.Violet
    T.accent = p[1]
end

local function new(c,p,par) local o=Instance.new(c) if p then for k,v in pairs(p) do o[k]=v end end if par then o.Parent=par end return o end
local function corner(o,r) return new("UICorner",{CornerRadius=UDim.new(0,r or 10)},o) end
local function trim(s) return (tostring(s or ""):match("^%s*(.-)%s*$")) end

function KeySystem.Run(C)
    C = C or {}
    local pl = Players.LocalPlayer
    local pg = pl:WaitForChild("PlayerGui")
    if pg:FindFirstChild("SORU_KEY") then pg.SORU_KEY:Destroy() end
    applyPalette(C.Theme)

    local keyFile = C.KeyFile or (CFG.."/soru.key")
    local saveKey = C.SaveKey ~= false
    local caseSens = C.CaseSensitive ~= false
    
    local gui = new("ScreenGui",{Name="SORU_KEY",ResetOnSpawn=false,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,IgnoreGuiInset=true,DisplayOrder=200},pg)
    local dim = new("Frame",{Size=UDim2.fromScale(1,1),BackgroundColor3=Color3.new(0,0,0),BackgroundTransparency=0.4,BorderSizePixel=0,ZIndex=1},gui)
    local main = new("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(0.5,0.5),Size=UDim2.fromOffset(380,270),BackgroundColor3=T.panel,BorderSizePixel=0,ZIndex=2},gui)
    corner(main,16) new("UIStroke",{Color=T.stroke,Thickness=1,Transparency=0.3},main)
    
    new("TextLabel",{BackgroundTransparency=1,Position=UDim2.fromOffset(20,18),Size=UDim2.fromOffset(340,24),Font=Enum.Font.GothamBold,TextSize=18,TextColor3=T.text,Text=C.Title or "SORU HUB",TextXAlignment=Enum.TextXAlignment.Left},main)
    new("TextLabel",{BackgroundTransparency=1,Position=UDim2.fromOffset(20,42),Size=UDim2.fromOffset(340,18),Font=Enum.Font.GothamMedium,TextSize=12,TextColor3=T.dim,Text=C.Subtitle or "Key System",TextXAlignment=Enum.TextXAlignment.Left},main)

    local box = new("TextBox",{Position=UDim2.fromOffset(20,75),Size=UDim2.fromOffset(340,42),BackgroundColor3=Color3.fromRGB(13,11,23),Font=Enum.Font.GothamMedium,TextSize=13,TextColor3=T.text,PlaceholderText="Masukin key...",PlaceholderColor3=T.dim,Text="",ClearTextOnFocus=false},main)
    corner(box,10) new("UIStroke",{Color=T.stroke,Thickness=1,Transparency=0.5},box)

    local btn = new("TextButton",{Position=UDim2.fromOffset(20,135),Size=UDim2.fromOffset(340,42),BackgroundColor3=T.accent,Font=Enum.Font.GothamBold,TextSize=13,TextColor3=Color3.new(1,1,1),Text="Verify Key",AutoButtonColor=false},main)
    corner(btn,10)

    local status = new("TextLabel",{BackgroundTransparency=1,Position=UDim2.fromOffset(20,185),Size=UDim2.fromOffset(340,20),Font=Enum.Font.GothamMedium,TextSize=11,TextColor3=T.dim,Text="",TextWrapped=true},main)

    local function notify(t,c) status.Text = t status.TextColor3 = c or T.dim end

    -- load saved key
    if saveKey then
        pcall(function()
            if isfile and isfile(keyFile) then
                local saved = trim(readfile(keyFile))
                if saved ~= "" then box.Text = saved end
            end
        end)
    end

    local function checkKey(input)
        input = trim(input)
        local toCheck = caseSens and input or string.lower(input)
        
        -- 1. cek Keys statis
        if C.Keys then
            for _,k in ipairs(C.Keys) do
                local kk = caseSens and tostring(k) or string.lower(tostring(k))
                if kk == toCheck then return true end
            end
        end
        -- 2. cek KeyUrl online
        if C.KeyUrl then
            local ok,res = pcall(function() return game:HttpGet(C.KeyUrl) end)
            if ok then
                for line in res:gmatch("[^\r\n]+") do
                    local l = caseSens and trim(line) or string.lower(trim(line))
                    if l == toCheck then return true end
                end
            end
        end
        -- 3. cek Validate custom
        if C.Validate then
            local ok, res, msg = pcall(C.Validate, input)
            if ok then
                if res == true then return true
                elseif type(res) == "string" then return false, res
                else return false, msg or "Invalid key" end
            end
        end
        return false, "Key salah"
    end

    btn.MouseButton1Click:Connect(function()
        local k = box.Text
        if k == "" then notify("Masukin key dulu", T.bad) return end
        local valid, msg = checkKey(k)
        if valid then
            notify("Key valid! Loading...", T.ok)
            if saveKey then pcall(function() if writefile then writefile(keyFile, k) end end) end
            task.wait(0.5)
            gui:Destroy()
            if C.OnSuccess then pcall(C.OnSuccess, k) end
        else
            notify(msg or "Key salah", T.bad)
        end
    end)

    if C.GetKeyLink then
        local getBtn = new("TextButton",{Position=UDim2.fromOffset(20,215),Size=UDim2.fromOffset(165,32),BackgroundColor3=T.card,Font=Enum.Font.GothamMedium,TextSize=11,TextColor3=T.text,Text="Get Key"},main)
        corner(getBtn,8)
        getBtn.MouseButton1Click:Connect(function() if setclipboard then setclipboard(C.GetKeyLink) end notify("Link Get Key di copy!", T.ok) end)
    end
    if C.DiscordLink then
        local discBtn = new("TextButton",{Position=UDim2.fromOffset(195,215),Size=UDim2.fromOffset(165,32),BackgroundColor3=T.card,Font=Enum.Font.GothamMedium,TextSize=11,TextColor3=T.text,Text="Discord"},main)
        corner(discBtn,8)
        discBtn.MouseButton1Click:Connect(function() if setclipboard then setclipboard(C.DiscordLink) end end)
    end
end

return KeySystem
