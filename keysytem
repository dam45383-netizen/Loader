-- sparkle bintang empat arah: dua batang yang meruncing + inti
local function sparkle(parent, cx, cy, size, col, z)
    local host = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(cx, cy), Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = z or 5}, parent)
    local thick = math.max(2, math.floor(size * 0.16))
    local taper = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1)})
    local function bar(w, h, rot)
        local b = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(w, h), BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = z or 5}, host)
        corner(b, FULL)
        new("UIGradient", {Transparency = taper, Rotation = rot}, b)
    end
    bar(size, thick, 0)
    bar(thick, size, 90)
    local c = math.max(3, math.floor(size * 0.26))
    local core = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(c, c), BackgroundColor3 = col, BorderSizePixel = 0, Rotation = 45, ZIndex = (z or 5) + 1}, host)
    corner(core, 2)
    return host
end

