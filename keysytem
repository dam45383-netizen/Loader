        BackgroundTransparency = 1, Image = "rbxassetid://"..SHADOW_ID, ImageColor3 = col, ImageTransparency = tr,
        ScaleType = Enum.ScaleType.Slice, SliceCenter = Rect.new(49, 49, 450, 450), ZIndex = z or 1,
    }, parent)
end

