      Scale = 1 (0.85 lebih kecil), Theme, Sound = false, Blur, Dim, CaseSensitive = false,
      MaxAttempts = 5 (0 = tanpa batas), Cooldown = 20 (detik), AutoLogin = false, KeyFile,
