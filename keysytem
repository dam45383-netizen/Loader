----------------------------------------------------------------------
-- HELPERS
----------------------------------------------------------------------
local function new(class, props, parent)
    local o = Instance.new(class)
    if props then for k, v in pairs(props) do o[k] = v end end
    if parent then o.Parent = parent end
    return o
end
local function corner(o, r)
    local rad = (typeof(r) == "UDim") and r or UDim.new(0, r or 10)
    return new("UICorner", {CornerRadius = rad}, o)
end
local function stroke(o, color, th, tr)
    return new("UIStroke", {Color = color, Thickness = th or 1, Transparency = tr or 0}, o)
end
local function label(parent, props)
    local d = {
        BackgroundTransparency = 1, BorderSizePixel = 0,
        Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = T.text,
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.None,
    }
    for k, v in pairs(props) do d[k] = v end
    return new("TextLabel", d, parent)
end
local function tw(o, p, t, e)
    e = e or EASE.out
    return TweenService:Create(o, TweenInfo.new(t, e[1], e[2]), p)
end
local function play(o, p, t, e) local x = tw(o, p, t, e) x:Play() return x end
local function copy(s)
    if setclipboard then setclipboard(s) return true elseif toclipboard then toclipboard(s) return true end
    return false
end
local function trim(s) return (tostring(s or ""):match("^%s*(.-)%s*$")) end
local function rand(a, b) return a + math.random() * (b - a) end

-- ukur teks (lebar, tinggi) dengan wrap di maxW
local function measure(txt, size, maxW)
    txt = tostring(txt)
    local w, h = #txt * size * 0.56, size + 3
    pcall(function()
        local v = TextService:GetTextSize(txt, size, Enum.Font.GothamMedium, Vector2.new(maxW, 1000))
        w, h = v.X, v.Y
    end)
    return math.ceil(w), math.ceil(h)
end

-- spring critically damped (response = detik menuju target, damping 1 = tanpa overshoot)
local function stepSpring(s, target, dt, response, damping)
    local w = (2 * math.pi) / response
    local k, c = w * w, 2 * damping * w
    local n = math.max(1, math.ceil(dt / 0.006))
    local h = dt / n
    for _ = 1, n do
        local a = k * (target - s.x) - c * s.v
        s.v = s.v + a * h
        s.x = s.x + s.v * h
    end
end

-- rubber-band: makin jauh melewati batas, makin sedikit elemen mengikuti (rumus Apple)
local function rubber(v, lim, dim)
    local over = math.abs(v) - lim
    if over <= 0 then return v end
    local r = (over * dim * 0.55) / (dim + 0.55 * over)
    return (v < 0 and -1 or 1) * (lim + r)
end

