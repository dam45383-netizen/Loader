function KeySystem.Run(C)
    C = C or {}
    local pl = Players.LocalPlayer
    local pg = pl:WaitForChild("PlayerGui")
    local prev = pg:FindFirstChild("SORU_KEY")
    if prev then prev:Destroy() end
    pcall(function() local ob = Lighting:FindFirstChild("SORU_KEY_BLUR") if ob then ob:Destroy() end end)

    -- tema: dari opsi, kalau tidak ada ikut tema yang tersimpan di hub
    local themeName = C.Theme
    if not themeName then
        pcall(function()
            local p = CFG.."/configs/"..tostring(game.PlaceId)..".json"
            if isfile and isfile(p) then
                local d = Http:JSONDecode(readfile(p))
                if d and d.Features and type(d.Features.UITheme) == "string" then themeName = d.Features.UITheme end
            end
        end)
    end
    applyPalette(themeName)

    -- opsi
    local keyFile = C.KeyFile or (CFG.."/soru.key")
    local saveKey = C.SaveKey ~= false
    local autoLogin = saveKey and C.AutoLogin ~= false
    local maxAttempts = (C.MaxAttempts ~= nil) and C.MaxAttempts or 5
    local cooldown = C.Cooldown or 20
    local caseSens = C.CaseSensitive ~= false
    local BTN_TEXT = C.ButtonText or "Redeem"
    local lowFx = (C.Quality == "Low")
    local RM = (C.ReducedMotion == true)
    local wantConfetti = (C.Confetti == true) and not lowFx and not RM

    -- ukuran bar (px virtual). Semua ukuran turunan mengikuti W dan H.
    local W = math.clamp(C.Width or 290, 220, 520)
    local H = math.clamp(C.Height or 25, 22, 56)
    local PAD = math.max(3, math.floor(H * 0.16))
    local ICON_S = H - PAD * 2
    local BTN_W = math.floor(72 + H * 0.64)
    local GAP = 8
    local IN_X = PAD + ICON_S + GAP
    local IN_W = W - IN_X - (BTN_W + PAD + GAP)
    local BTN_TS = math.clamp(math.floor(ICON_S * 0.6), 11, 14)
    local IN_TS = math.clamp(math.floor(H * 0.52), 12, 16)
    local START_W = math.floor(H * 2.6) -- lebar kapsul awal saat intro
    local ROW_Y, ROW_H = H + 8, 22      -- baris di bawah bar (chip atau link)

    -- state
    local finished, result = false, false
    local isOpen, busy, done, locked, attempts = false, false, false, false, 0
    local focused, hasText, hovering = false, false, false
    local ringOverride, lockOverride, btnOverride = nil, nil, nil

    local gui = new("ScreenGui", {Name = "SORU_KEY", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true, DisplayOrder = 200})
    gui.Parent = pg

    local conns = {}
    local function bind(sig, fn) local c = sig:Connect(fn) conns[#conns + 1] = c return c end
    gui.Destroying:Connect(function() for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end end)

    ------------------------------------------------------------------
    -- SOUND (dibangun di background; kalau belum siap, bunyi dilewati)
    ------------------------------------------------------------------
    local sndOn = C.Sound ~= false
    local sndBase, sndLast = {}, {}
    if sndOn then
        task.spawn(function()
            buildSfx(function(name, def)
                if not gui.Parent then return end
                local s = Instance.new("Sound")
                s.Name = name s.SoundId = def.id s.Volume = 1 s.Parent = gui
                sndBase[name] = {snd = s, dur = def.dur}
            end)
        end)
    end
    local function sfx(name, speed, vol)
        local b = sndBase[name]
        if not sndOn or not b then return end
        local now = os.clock()
        if sndLast[name] and now - sndLast[name] < 0.05 then return end
        sndLast[name] = now
        local c = b.snd:Clone()
        c.Volume = 0.6 * (vol or 1)
        c.PlaybackSpeed = speed or 1
        c.Parent = gui
        c:Play()
        task.delay(b.dur / math.max(speed or 1, 0.3) + 0.4, function() c:Destroy() end)
    end

    ------------------------------------------------------------------
    -- ROOT + SKALA (tidak pernah membesar; mengecil hanya kalau layar sempit)
    ------------------------------------------------------------------
    local dimmer = new("Frame", {Name = "Dim", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 1}, gui)
    local root = new("Frame", {Name = "Root", BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 2}, gui)
    local rootScale = new("UIScale", {Scale = 1}, root)
    local userScale = math.clamp(C.Scale or 1, 0.5, 1.6)
    local virt = Vector2.new(1280, 720)

    ------------------------------------------------------------------
    -- POSISI: target (drag, keyboard) -> spring -> shell. Loop hanya hidup saat ada gerak.
    ------------------------------------------------------------------
    local shell
    local tx, ty, kbY = 0, 0, 0
    local P, Q = {x = 0, v = 0}, {x = 0, v = 0}
    local dragging, dragActive = false, false
    local shakeT0 = nil
    local loopConn = nil
    local step

    local function sleep() if loopConn then loopConn:Disconnect() loopConn = nil end end
    local function wake()
        if loopConn or not gui.Parent then return end
        loopConn = RunService.RenderStepped:Connect(function(dt) step(dt) end)
    end
    gui.Destroying:Connect(sleep)

    local function limits()
        return math.max(0, (virt.X - W) / 2 - 8), math.max(0, (virt.Y - (H + 44)) / 2 - 8)
    end
    local function render(sx)
        if shell then shell.Position = UDim2.new(0.5, P.x + sx, 0.5, Q.x) end
    end
    step = function(dt)
        if dt > 0.05 then dt = 0.05 end
        local sx = 0
        if shakeT0 then
            local t = os.clock() - shakeT0
            if t > 0.42 then shakeT0 = nil else sx = math.exp(-9 * t) * math.sin(t * 46) * 7 end
        end
        local gx, gy = tx, ty + kbY
        if dragging then
            P.x, P.v, Q.x, Q.v = gx, 0, gy, 0 -- 1:1 dengan jari
        else
            stepSpring(P, gx, dt, 0.34, 1)
            stepSpring(Q, gy, dt, 0.34, 1)
        end
        render(sx)
        if not dragging and not shakeT0 and math.abs(P.x - gx) < 0.05 and math.abs(Q.x - gy) < 0.05 and math.abs(P.v) < 0.5 and math.abs(Q.v) < 0.5 then
            P.x, P.v, Q.x, Q.v = gx, 0, gy, 0
            render(0)
            sleep()
        end
    end
    local function applyScale()
        local vp = gui.AbsoluteSize
        if vp.X < 10 or vp.Y < 10 then
            local cam = workspace.CurrentCamera
            vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
        end
        local fit = math.clamp(math.min(vp.X * 0.92 / W, vp.Y * 0.5 / (H + 44)), 0.6, 1)
        local s = fit * userScale
        rootScale.Scale = s
        virt = Vector2.new(vp.X / s, vp.Y / s)
        root.Size = UDim2.fromOffset(virt.X, virt.Y)
        local lx, ly = limits()
        tx, ty = math.clamp(tx, -lx, lx), math.clamp(ty, -ly, ly)
        wake()
    end

    ------------------------------------------------------------------
    -- SHELL + BAR
    -- win = CanvasGroup yang melebar saat intro (kapsul -> pill).
    -- content = kanvas tetap W x H di tengah win, jadi isi bar tidak ikut bergeser.
    ------------------------------------------------------------------
    shell = new("Frame", {Name = "Shell", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(W, H), BackgroundTransparency = 1, Visible = false, ZIndex = 10}, root)

    -- shadow: ada karena bar memang melayang di atas game
    local SHADOW_REST, SHADOW_LIFT = 0.62, 0.5
    local shadow = nil
    if SHADOW_ID ~= "" and not lowFx then
