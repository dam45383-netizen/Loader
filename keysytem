    step = function(dt)
        if dt > 0.05 then dt = 0.05 end
        local sx = 0
        if shakeT0 then
            local t = os.clock() - shakeT0
            if t > 0.42 then shakeT0 = nil else sx = math.exp(-9 * t) * math.sin(t * 46) * 7 end
        end
        local gx, gy = tx, ty + kbY
        if dragging then
            P.x, P.v, Q.x, Q.v = gx, 0, gy, 0 -- 1:1 dengan jari
        else
            stepSpring(P, gx, dt, 0.34, 1)
            stepSpring(Q, gy, dt, 0.34, 1)
        end
        render(sx)
        if not dragging and not shakeT0 and math.abs(P.x - gx) < 0.05 and math.abs(Q.x - gy) < 0.05 and math.abs(P.v) < 0.5 and math.abs(Q.v) < 0.5 then
            P.x, P.v, Q.x, Q.v = gx, 0, gy, 0
            render(0)
            sleep()
        end
