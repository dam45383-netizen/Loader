local function new(class, props, parent)
    local o = Instance.new(class)
    if props then for k, v in pairs(props) do o[k] = v end end
    if parent then o.Parent = parent end
    return o
end
local function corner(o, r)
    local rad = (typeof(r) == "UDim") and r or UDim.new(0, r or 10)
    return new("UICorner", {CornerRadius = rad}, o)
end
local function stroke(o, color, th, tr)
    return new("UIStroke", {Color = color, Thickness = th or 1, Transparency = tr or 0}, o)
end
local function label(parent, props)
    local d = {
        BackgroundTransparency = 1, BorderSizePixel = 0,
        Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = T.text,
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.None,
    }
    for k, v in pairs(props) do d[k] = v end
    return new("TextLabel", d, parent)
end
local function tw(o, p, t, e)
    e = e or EASE.out
    return TweenService:Create(o, TweenInfo.new(t, e[1], e[2]), p)
end
local function play(o, p, t, e) local x = tw(o, p, t, e) x:Play() return x end
local function copy(s)
    if setclipboard then setclipboard(s) return true elseif toclipboard then toclipboard(s) return true end
    return false
end
local function trim(s) return (tostring(s or ""):match("^%s*(.-)%s*$")) end
local function rand(a, b) return a + math.random() * (b - a) end
local function hex(c)
    return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end
local function esc(s)
    return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

