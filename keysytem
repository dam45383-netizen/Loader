        neon = new("ImageLabel", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 20, 1, 20), BackgroundTransparency = 1, Image = "rbxassetid://"..SHADOW_ID, ImageColor3 = T.accent, ImageTransparency = 1, ScaleType = Enum.ScaleType.Slice, SliceCenter = Rect.new(49, 49, 450, 450), ZIndex = 1}, shell)
        loop(neon, {Size = UDim2.new(1, 38, 1, 38)}, 2.6)
    end

    local win = new("CanvasGroup", {Name = "Bar", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.ink, BorderSizePixel = 0, GroupTransparency = 1, Active = true, ZIndex = 2}, shell)
    corner(win, H / 2)
    local winStroke = stroke(win, WHITE, 1.5, 0.3)
    spin(new("UIGradient", {Color = RING}, winStroke), 7)
    local winScale = new("UIScale", {Scale = 0.9}, win)

    do -- isi bar: tint gelap, aurora tipis, highlight atas
        local tint = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 1}, win)
        new("UIGradient", {Color = ColorSequence.new(Color3.fromRGB(22, 18, 40), Color3.fromRGB(9, 8, 16)), Rotation = 100}, tint)
        local ambient = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 2}, win)
        local function orb(col, size, px, py, dx, dy, secs)
            local o = new("Frame", {Size = UDim2.fromOffset(size, size), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(px, py), BackgroundTransparency = 1, ZIndex = 2}, ambient)
            for i = 1, 6 do
                local s = 1 - (i - 1) / 6 * 0.9
                local c = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(s, s), BackgroundColor3 = col, BackgroundTransparency = 0.93, BorderSizePixel = 0, ZIndex = 2}, o)
                corner(c, FULL)
            end
            loop(o, {Position = UDim2.fromScale(px + dx, py + dy)}, secs)
        end
        orb(T.accent, 150, 0.1, 0.5, 0.12, 0.2, 7)
        orb(T.cyan, 130, 0.92, 0.5, -0.12, -0.25, 9)
        gloss(win)
    end

    ------------------------------------------------------------------
    -- ENTRANCE: fade + slide bertahap
    ------------------------------------------------------------------
    local entries = {}
    local function reg(inst, dx, dy)
        entries[#entries + 1] = {inst = inst, pos = inst.Position, dx = dx or 0, dy = dy or 0}
    end
    local function enterEntry(e, delay)
        local inst = e.inst
        inst.GroupTransparency = 1
        inst.Position = e.pos + UDim2.fromOffset(e.dx, e.dy)
