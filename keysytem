    local RING2 = ColorSequence.new{ColorSequenceKeypoint.new(0, T.accent), ColorSequenceKeypoint.new(0.5, T.cyan), ColorSequenceKeypoint.new(1, T.accent)}

    -- opsi
    local keyFile = C.KeyFile or (CFG.."/soru.key")
    local saveKey = C.SaveKey ~= false
    local autoLogin = saveKey and C.AutoLogin ~= false
    local maxAttempts = (C.MaxAttempts ~= nil) and C.MaxAttempts or 5
    local cooldown = C.Cooldown or 20
    local caseSens = C.CaseSensitive ~= false
    local hasRow = (C.GetKeyLink ~= nil) or (C.DiscordLink ~= nil)
    local W = 380
    local H = hasRow and 300 or 256
    local ICON = getAsset("SORU_S_ICON_1024.png", URLS.ICON)
    local BG = getAsset("SORU_THEME_1024.png", URLS.BG)

    -- state
    local finished, result = false, false
    local isOpen, busy, done, locked, attempts = false, false, false, false, 0

    local gui = new("ScreenGui", {Name = "SORU_KEY", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true, DisplayOrder = 200})
    gui.Parent = pg

    local conns = {}
    local function bind(sig, fn) local c = sig:Connect(fn) conns[#conns + 1] = c return c end
    gui.Destroying:Connect(function() for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end end)

    ------------------------------------------------------------------
    -- SOUND
    ------------------------------------------------------------------
    local sndOn = C.Sound ~= false
    local sndBase, sndLast = {}, {}
    if sndOn then
        pcall(function()
            for name, def in pairs(buildSfx()) do
                local s = Instance.new("Sound")
                s.Name = name s.SoundId = def.id s.Volume = 1 s.Parent = gui
                sndBase[name] = {snd = s, dur = def.dur}
            end
        end)
    end
    local function sfx(name, speed, vol)
        local b = sndBase[name]
        if not sndOn or not b then return end
        local now = os.clock()
        local gap = (name == "hover" or name == "tick") and 0.045 or 0.03
        if sndLast[name] and now - sndLast[name] < gap then return end
        sndLast[name] = now
        local c = b.snd:Clone()
        c.Volume = 0.9 * (vol or 1)
        c.PlaybackSpeed = speed or 1
        c.Parent = gui
        c:Play()
        task.delay(b.dur / math.max(speed or 1, 0.3) + 0.4, function() c:Destroy() end)
    end

    ------------------------------------------------------------------
    -- ROOT + SKALA
    ------------------------------------------------------------------
    local dimmer = new("Frame", {Name = "Dim", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 1}, gui)
    local root = new("Frame", {Name = "Root", BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 2}, gui)
    local rootScale = new("UIScale", {Scale = 1}, root)
    local userScale = math.clamp(C.Scale or 1, 0.6, 1.5)
    local virt = Vector2.new(1280, 720)
    local ox, oy = 0, 0
    local shell

    local function layout()
        local limX = math.max(0, (virt.X - W) / 2 - 8)
        local limY = math.max(0, (virt.Y - H) / 2 - 8)
        ox = math.clamp(ox, -limX, limX)
        oy = math.clamp(oy, -limY, limY)
        if shell then shell.Position = UDim2.new(0.5, ox, 0.5, oy) end
    end
    local function applyScale()
        local vp = gui.AbsoluteSize
        if vp.X < 10 or vp.Y < 10 then
            local cam = workspace.CurrentCamera
            vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
        end
        local fit = math.clamp(math.min(vp.X / (W + 80), vp.Y / (H + 60)), 0.5, 1.25)
