            local p = CFG.."/configs/"..tostring(game.PlaceId)..".json"
            if isfile and isfile(p) then
                local d = Http:JSONDecode(readfile(p))
                if d and d.Features and type(d.Features.UITheme) == "string" then themeName = d.Features.UITheme end
            end
        end)
    end
    applyPalette(themeName)
    local ACCENT, DIM = T.accent, T.dim
