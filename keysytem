local atan2 = math.atan2 or function(y, x) return math.atan(y, x) end
local function rnd(v) return math.floor(v + 0.5) end

local function line(parent, x1, y1, x2, y2, th, col, z)
    local dx, dy = x2 - x1, y2 - y1
    local f = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset(rnd((x1 + x2) / 2), rnd((y1 + y2) / 2)),
        Size = UDim2.fromOffset(rnd(math.sqrt(dx * dx + dy * dy)), th),
        Rotation = math.deg(atan2(dy, dx)),
        BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = z or (parent.ZIndex + 1),
    }, parent)
    corner(f, FULL)
    return f
end
local function disc(parent, x, y, d, col, z)
    local f = new("Frame", {Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(d, d), BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = z or (parent.ZIndex + 1)}, parent)
    corner(f, FULL)
    return f
end
-- sel ikon: host (size x size) berisi kanvas 40x40 yang diskalakan
