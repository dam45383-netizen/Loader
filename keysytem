-- spring critically damped (response = detik menuju target, damping 1 = tanpa overshoot)
local function stepSpring(s, target, dt, response, damping)
    local w = (2 * math.pi) / response
    local k, c = w * w, 2 * damping * w
    local n = math.max(1, math.ceil(dt / 0.006))
    local h = dt / n
    for _ = 1, n do
        local a = k * (target - s.x) - c * s.v
        s.v = s.v + a * h
        s.x = s.x + s.v * h
    end
end

-- rubber-band: makin jauh melewati batas, makin sedikit elemen mengikuti
local function rubber(v, lim, dim)
    local over = math.abs(v) - lim
    if over <= 0 then return v end
    local r = (over * dim * 0.55) / (dim + 0.55 * over)
    return (v < 0 and -1 or 1) * (lim + r)
end

