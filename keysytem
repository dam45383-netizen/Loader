    local function shockwave(col, grow, delay, baseW)
        task.delay(delay or 0, function()
            if not gui.Parent then return end
            local bw = baseW or W
            local r = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(W / 2, H / 2), Size = UDim2.fromOffset(bw, H), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 6}, shell)
            corner(r, UDim.new(0.5, 0))
            local rs = stroke(r, col, 2, 0.15)
            play(r, {Size = UDim2.fromOffset(bw + grow, H + grow * 0.5)}, 0.8, QUINT)
            play(rs, {Transparency = 1}, 0.8, SINE)
            task.delay(0.85, function() r:Destroy() end)
        end)
    end

    local CONF_COLORS = {T.accent, T.accent2, T.cyan, T.pink, T.ok, T.warn, WHITE}
    local function confetti()
        for i = 1, CONF_N do
            local ang = math.random() * math.pi * 2
            local dist = rand(40, 130)
            local p = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(W / 2, H / 2), Size = UDim2.fromOffset(math.random(3, 6), math.random(2, 4)), BackgroundColor3 = CONF_COLORS[math.random(#CONF_COLORS)], BorderSizePixel = 0, Rotation = math.random(0, 360), ZIndex = 20}, shell)
            corner(p, 1)
            local px2 = W / 2 + math.cos(ang) * dist * 1.6
            local py2 = H / 2 + math.sin(ang) * dist * 0.7
            local d1 = rand(0.35, 0.55)
            play(p, {Position = UDim2.fromOffset(px2, py2), Rotation = p.Rotation + math.random(-260, 260)}, d1, QUAD)
            task.delay(d1, function()
                if not p.Parent then return end
                play(p, {Position = UDim2.fromOffset(px2 + rand(-12, 12), py2 + rand(25, 55)), BackgroundTransparency = 1}, rand(0.5, 0.7), QUAD, Enum.EasingDirection.In)
            end)
            task.delay(1.3, function() p:Destroy() end)
        end
    end

