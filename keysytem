    ------------------------------------------------------------------
    -- DRAG: 1:1 dengan jari, rubber-band di tepi layar, spring saat dilepas
    ------------------------------------------------------------------
    local lifted = false
    local function liftOn(on) -- "terangkat" hanya saat benar-benar di-drag
        if lifted == on then return end
        lifted = on
        play(winScale, {Scale = on and 1.015 or 1}, on and 0.16 or 0.22, EASE.out)
        if glow and isOpen then play(glow, {ImageTransparency = on and GLOW_LIFT or GLOW_REST}, 0.16, EASE.ease) end
    end
    local function track(handle, onBegin, onMove, onEnd)
        handle.InputBegan:Connect(function(input)
            local ut = input.UserInputType
            if ut ~= Enum.UserInputType.MouseButton1 and ut ~= Enum.UserInputType.Touch then return end
            if dragActive then return end -- jari kedua diabaikan selama drag
            dragActive = true
            local start = input.Position
            local state = onBegin and onBegin(start) or nil
            local moved, ended = false, false
            local conn
            conn = UIS.InputChanged:Connect(function(i)
                local it = i.UserInputType
                if it == Enum.UserInputType.MouseMovement or it == Enum.UserInputType.Touch then
                    local dx, dy = i.Position.X - start.X, i.Position.Y - start.Y
                    if not moved and (math.abs(dx) > 5 or math.abs(dy) > 5) then moved = true end
                    if onMove then onMove(dx, dy, state, moved) end
                end
            end)
            conns[#conns + 1] = conn
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End and not ended then
                    ended = true
                    dragActive = false
                    if conn then conn:Disconnect() end
                    if onEnd then onEnd(moved, state) end
                end
            end)
        end)
    end
    track(win,
        function() -- mulai dari posisi yang sedang terlihat, bukan dari target, supaya tidak melompat
            local lx, ly = limits()
            return Vector2.new(math.clamp(P.x, -lx, lx), math.clamp(Q.x - kbY, -ly, ly))
        end,
        function(dx, dy, st, moved)
            if not moved or not st then return end
            if not dragging then dragging = true liftOn(true) end
            local s = rootScale.Scale
            local lx, ly = limits()
            tx = rubber(st.X + dx / s, lx, virt.X)
            ty = rubber(st.Y + dy / s, ly, virt.Y)
            wake()
        end,
        function()
            dragging = false
            local lx, ly = limits()
            tx, ty = math.clamp(tx, -lx, lx), math.clamp(ty, -ly, ly) -- spring menarik kembali ke dalam batas
            liftOn(false)
            wake()
        end)

    ------------------------------------------------------------------
    -- KEYBOARD AVOIDANCE (layar sentuh): panel naik di atas keyboard layar
    ------------------------------------------------------------------
    local function kbLift()
        if not (box:IsFocused() and UIS.TouchEnabled and not UIS.KeyboardEnabled) then return 0 end
        local s = rootScale.Scale
        local vpH = gui.AbsoluteSize.Y
        if vpH < 10 then return 0 end
        local kbTop = nil
        pcall(function()
            if UIS.OnScreenKeyboardVisible and UIS.OnScreenKeyboardPosition.Y > 0 then kbTop = UIS.OnScreenKeyboardPosition.Y end
        end)
        local limit = (kbTop or vpH * 0.52) - 10 -- tanpa data keyboard, anggap menutup ~48% bawah
        local bottom = vpH / 2 + ty * s + (HP_MAX - HP_IDLE / 2) * s
        if bottom <= limit then return 0 end
        return -math.min((bottom - limit) / s, virt.Y * 0.4)
    end
    updateKb = function()
        kbY = kbLift()
        wake()
    end
    pcall(function()
        bind(UIS:GetPropertyChangedSignal("OnScreenKeyboardVisible"), updateKb)
        bind(UIS:GetPropertyChangedSignal("OnScreenKeyboardPosition"), updateKb)
    end)

    shake = function()
        if RM then return end
        shakeT0 = os.clock()
        wake()
    end

    ------------------------------------------------------------------
    -- EFEK SUKSES: satu pulse dari gembok (Max). Percikan hanya kalau diminta (Confetti = true).
    ------------------------------------------------------------------
    local LX, LY = CM + PILL_X + LOCK_CX, HEAD_H + PILL_Y + PH / 2
    local function pulse(col)
        local r = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(LX, LY), Size = UDim2.fromOffset(ICON_S, ICON_S), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 6}, shell)
        corner(r, FULL)
        local rs = stroke(r, col, 1.5, 0.2)
        play(r, {Size = UDim2.fromOffset(ICON_S * 3.2, ICON_S * 3.2)}, 0.55, EASE.out)
        play(rs, {Transparency = 1}, 0.55, EASE.ease)
        task.delay(0.6, function() r:Destroy() end)
    end
    local function burst()
        local cols = {T.accent, T.ok, T.text}
        for i = 1, 14 do
            local ang = (i / 14) * math.pi * 2 + rand(-0.2, 0.2)
            local dist = rand(34, 76)
            local p = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(LX, LY), Size = UDim2.fromOffset(3, 3), BackgroundColor3 = cols[i % #cols + 1], BorderSizePixel = 0, ZIndex = 20}, shell)
            corner(p, FULL)
            play(p, {Position = UDim2.fromOffset(LX + math.cos(ang) * dist * 1.5, LY + math.sin(ang) * dist * 0.8)}, 0.5, EASE.out)
            task.delay(0.15, function() if p.Parent then play(p, {BackgroundTransparency = 1}, 0.4, EASE.ease) end end)
            task.delay(0.7, function() p:Destroy() end)
        end
    end

    ------------------------------------------------------------------
    -- VALIDASI KEY
    ------------------------------------------------------------------
    local function same(a, b)
        if caseSens then return a == b end
        return a:lower() == b:lower()
    end

    local function fetchKeys()
        local ok, body = pcall(function() return game:HttpGet(C.KeyUrl) end)
        if not ok or type(body) ~= "string" then return nil end
        local list = {}
        for line_ in body:gmatch("[^\r\n]+") do
            local k = trim(line_)
            if k ~= "" and k:sub(1, 1) ~= "#" then list[#list + 1] = k end
        end
        return list
    end

    -- return true | false, "pesan"
    local function check(key)
        key = trim(key)
        if key == "" then return false, "Enter your key first" end
        if C.Validate then
            local ok, res, msg_ = pcall(C.Validate, key)
            if not ok then return false, "Validator error: "..tostring(res) end
            if res then return true end
            return false, msg_ or "That key isn't valid. Check it and try again"
        end
        local list = {}
        for _, k in ipairs(C.Keys or {}) do list[#list + 1] = tostring(k) end
        if C.KeyUrl then
            local remote = fetchKeys()
            if remote then
                for _, k in ipairs(remote) do list[#list + 1] = k end
            elseif #list == 0 then
                return false, "Couldn't load the key list. Check your connection"
            end
        end
        if #list == 0 then return false, "No keys configured" end
        for _, k in ipairs(list) do
            if same(k, key) then return true end
        end
        return false, "That key isn't valid. Check it and try again"
    end

    ------------------------------------------------------------------
    -- ALUR VERIFIKASI
    ------------------------------------------------------------------
    local function onSuccess(key, auto)
        done = true
        busy = false
        errState = false
        if saveKey then pcall(function() if writefile then writefile(keyFile, key) end end) end
        box.TextEditable = false
        pcall(function() box:ReleaseFocus() end)
        unlockIcon()
        applyState(0.2)
        say(auto and "Verified" or "Key accepted", T.ok, true)
        if not auto then -- momen langka: boleh ada delight. Auto-login tetap cepat dan tenang.
            sfx("success")
            if not lowFx and not RM then pulse(T.ok) end
            if wantConfetti then burst() end
        end
        task.delay(auto and 0.5 or 1.0, function() finish(true, key) end)
    end

    local function lockout(sec)
        locked = true
        errState = false
        applyState()
        say("Too many attempts. Please wait", T.warn, true)
        task.spawn(function()
            for s = sec, 1, -1 do
                if not gui.Parent then return end
                if s == sec then
                    btnTok = btnTok + 1 -- batalkan crossfade label yang masih menunggu
                    play(btnL, {TextTransparency = 0}, 0.1, EASE.ease)
                end
                btnL.Text = "Wait "..s.."s"
                task.wait(1)
            end
            locked = false
            attempts = 0
            if gui.Parent and not done then
                applyState()
                clearSay()
            end
        end)
    end

    local function onFail(msg_, auto)
        attempts = attempts + 1
        sfx("error")
        if auto then
            pcall(function() if delfile and isfile and isfile(keyFile) then delfile(keyFile) end end)
            msg_ = "Your saved key is no longer valid. Enter a new one"
        end
        errState = true -- state "Wrong key" bertahan sampai key diedit lagi
        applyState()
        rattleIcon()
        shake()
        say(msg_ or "That key isn't valid. Check it and try again", T.bad, true)
        if maxAttempts > 0 and attempts >= maxAttempts then lockout(cooldown) end
    end

    submit = function(auto)
        if busy or done or locked or finished then return end
        local key = trim(box.Text)
        if key == "" then
            sfx("error")
            say("Enter your key first", T.warn)
            shake()
            rattleIcon()
            return
        end
        if errState then
            errState = false
            clearSay()
        end
        busy = true
        applyState()
        task.spawn(function()
            local t0 = os.clock()
            local ok, msg_ = check(key)
            local el = os.clock() - t0
            if el < 0.35 then task.wait(0.35 - el) end -- cukup lama untuk terbaca, tidak berkedip
            if not gui.Parent or finished then return end
            busy = false
            if ok then onSuccess(key, auto) else onFail(msg_, auto) end
        end)
    end

    btnHit.MouseButton1Click:Connect(function() submit(false) end)

    ------------------------------------------------------------------
    -- START
    ------------------------------------------------------------------
    bind(gui:GetPropertyChangedSignal("AbsoluteSize"), applyScale)
    applyScale()
    render(0)
    applyState(0)
    openA()

    -- key tersimpan -> isi otomatis lalu verifikasi diam-diam (setelah intro selesai)
    local saved = nil
    if saveKey then
        pcall(function() if isfile and isfile(keyFile) then saved = trim(readfile(keyFile)) end end)
        if saved == "" then saved = nil end
    end
    if saved then
        box.Text = saved
        if autoLogin then
            task.delay(0.5, function() if gui.Parent and not done and not busy and not finished then say("Verifying saved key", T.accent, true) end end)
            task.delay(0.8, function() if gui.Parent and not done and not busy and not finished then submit(true) end end)
        end
    end
    if not (C.Keys or C.KeyUrl or C.Validate) then
        warn("[SORU KEY] Keys, KeyUrl, or Validate isn't set. Every key will be rejected.")
    end

    local obj = {}
    function obj:Destroy() if not finished then finished = true end gui:Destroy() end
    function obj:IsDone() return finished end

    if C.Wait then
        while not (finished and gui.Parent == nil) do task.wait(0.1) end
        return result
    end
    return obj
end

return KeySystem
