local V3, CF = Vector3.new, CFrame.new

local SORU = loadstring(game:HttpGet("https://raw.githubusercontent.com/dam45383-netizen/Loader/refs/heads/main/UI.lua"))()
local Window = SORU:CreateWindow({Title = "SORU HUB"})

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

local OreTab = Window:Tab({Title = "Ore"})
OreTab:Section("Ore")

local SellTab = Window:Tab({Title = "Sell"})
SellTab:Section("Sell")

local SELL_CF = CF(18, 2, 79)
local SelectedZone = nil
local SelectedRarity = {}
local Priority1, Priority2, Priority3 = "None", "None", "None"
local AutoFarmOre = false
local AutoSell = false
local isSelling = false
local StatusInfo = nil
local SellStatusInfo = nil

local function getZones()
    local rooms = workspace:FindFirstChild("Rooms")
    if not rooms then return {"Room_1"} end
    local list = {}
    for _, r in ipairs(rooms:GetChildren()) do
        table.insert(list, r.Name)
    end
    table.sort(list, function(a, b)
        local na = tonumber(a:match("%d+")) or 9999
        local nb = tonumber(b:match("%d+")) or 9999
        if na == nb then return a < b end
        return na < nb
    end)
    return list
end

local function getRarities()
    local veins = ReplicatedStorage:FindFirstChild("veins") or ReplicatedStorage:FindFirstChild("Veins")
    if not veins then return {} end
    local list = {}
    for _, v in ipairs(veins:GetChildren()) do
        table.insert(list, v.Name)
    end
    table.sort(list)
    return list
end

local function getRarityOptionsWithNone()
    local list = {"None"}
    for _, v in ipairs(getRarities()) do
        table.insert(list, v)
    end
    return list
end

local function getBag()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    if not gui then return 0, 999 end
    local hud = gui:FindFirstChild("MainHUD")
    if not hud then return 0, 999 end
    local cep = hud:FindFirstChild("CepBar")
    if not cep then return 0, 999 end
    local sayi = cep:FindFirstChild("Sayi")
    if not sayi then return 0, 999 end
    local cur, max = tostring(sayi.Text):match("(%d+)%s*/%s*(%d+)")
    return tonumber(cur) or 0, tonumber(max) or 999
end

local function teleportTo(cf)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    hrp.AssemblyLinearVelocity = V3(0, 0, 0)
    hrp.AssemblyAngularVelocity = V3(0, 0, 0)
    hrp.CFrame = cf
end

local function getRockPos(rock)
    if rock:IsA("BasePart") then
        return rock.Position
    end
    if rock:IsA("Model") then
        local ok, cf = pcall(function() return rock:GetPivot() end)
        if ok and cf then return cf.Position end
    end
    local part = rock:FindFirstChildWhichIsA("BasePart", true)
    if part then return part.Position end
    return nil
end

local function matchesSingleRarity(rock, rarityName)
    local name = rock.Name:lower()
    local r = tostring(rarityName):lower()
    local attr = nil
    pcall(function() attr = rock:GetAttribute("Rarity") end)
    if attr then attr = tostring(attr):lower() end
    if name == r then return true end
    if attr and attr == r then return true end
    if string.find(name, r, 1, true) then return true end
    return false
end

local function isMatch(rock)
    if #SelectedRarity == 0 then return true end
    for _, rarity in ipairs(SelectedRarity) do
        if matchesSingleRarity(rock, rarity) then return true end
    end
    return false
end

local function findNearestInRoom(room, checkFn)
    local rocks = room:FindFirstChild("Rocks")
    if not rocks then return nil end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local myPos = hrp and hrp.Position or V3(0, 0, 0)
    local best, bestDist = nil, math.huge
    for _, rock in ipairs(rocks:GetChildren()) do
        if checkFn(rock) then
            local pos = getRockPos(rock)
            if pos then
                local d = (pos - myPos).Magnitude
                if d < bestDist then
                    best, bestDist = rock, d
                end
            end
        end
    end
    return best
end

local function findTargetRock()
    local rooms = workspace:FindFirstChild("Rooms")
    if not rooms then return nil end
    local zoneName = SelectedZone or getZones()[1]
    if not zoneName then return nil end
    local room = rooms:FindFirstChild(zoneName)
    if not room then return nil end
    local hasPriority = false
    for _, prio in ipairs({Priority1, Priority2, Priority3}) do
        if prio and prio ~= "None" and prio ~= "" then
            hasPriority = true
            local rock = findNearestInRoom(room, function(r) return matchesSingleRarity(r, prio) end)
            if rock then return rock end
        end
    end
    if hasPriority then return nil end
    return findNearestInRoom(room, function(r) return isMatch(r) end)
end

local function interactRock(rock)
    for _, desc in ipairs(rock:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then
            pcall(function()
                if fireproximityprompt then
                    fireproximityprompt(desc, 0)
                end
            end)
        elseif desc:IsA("ClickDetector") then
            pcall(function()
                if fireclickdetector then fireclickdetector(desc) end
            end)
        end
    end
    if rock:IsA("ProximityPrompt") then
        pcall(function() fireproximityprompt(rock, 0) end)
    end
end

local function doSell()
    if isSelling then return end
    isSelling = true
    teleportTo(SELL_CF + V3(0, 3, 0))
    task.wait(0.25)
    pcall(function()
        local se = ReplicatedStorage:FindFirstChild("SellEvent")
        if se then
            se:FireServer("SellAll")
        end
    end)
    task.wait(1)
    isSelling = false
end

local function farmLoop()
    while AutoFarmOre do
        local cur, max = getBag()
        if StatusInfo then StatusInfo:Set("Cep: " .. cur .. "/" .. max .. " | Zone: " .. tostring(SelectedZone or "-")) end
        if SellStatusInfo then SellStatusInfo:Set("Cep: " .. cur .. "/" .. max) end
        if cur >= (max - 1) then
            doSell()
            task.wait(0.2)
        else
            local rock = findTargetRock()
            if not rock then
                task.wait(0.5)
            else
                local pos = getRockPos(rock)
                if pos then
                    teleportTo(CF(pos + V3(0, 3, 0)))
                    interactRock(rock)
                end
                task.wait(0.15)
            end
        end
        task.wait()
    end
end

local function autoSellLoop()
    while AutoSell do
        local cur, max = getBag()
        if SellStatusInfo then SellStatusInfo:Set("Cep: " .. cur .. "/" .. max .. " | AutoSell: ON") end
        if cur >= (max - 1) then
            doSell()
        end
        task.wait(0.5)
    end
end

local ZoneDropdown = OreTab:Dropdown({
    Title = "Zone",
    Flag = "Ore_Zone",
    Options = getZones(),
    Default = getZones()[1],
    Callback = function(v)
        if type(v) == "table" then v = v[1] end
        SelectedZone = tostring(v)
    end
})
SelectedZone = getZones()[1]

local RarityDropdown = OreTab:MultiDropdown({
    Title = "Filter",
    Flag = "Ore_Rarity",
    Options = getRarities(),
    Default = {},
    Callback = function(v)
        SelectedRarity = {}
        if type(v) == "table" then
            for _, name in ipairs(v) do table.insert(SelectedRarity, tostring(name)) end
        elseif v ~= nil then
            SelectedRarity = {tostring(v)}
        end
    end
})

local Prio1Dropdown = OreTab:Dropdown({
    Title = "Priority 1",
    Flag = "Ore_Prio1",
    Options = getRarityOptionsWithNone(),
    Default = "None",
    Callback = function(v)
        if type(v) == "table" then v = v[1] end
        Priority1 = tostring(v)
    end
})

local Prio2Dropdown = OreTab:Dropdown({
    Title = "Priority 2",
    Flag = "Ore_Prio2",
    Options = getRarityOptionsWithNone(),
    Default = "None",
    Callback = function(v)
        if type(v) == "table" then v = v[1] end
        Priority2 = tostring(v)
    end
})

local Prio3Dropdown = OreTab:Dropdown({
    Title = "Priority 3",
    Flag = "Ore_Prio3",
    Options = getRarityOptionsWithNone(),
    Default = "None",
    Callback = function(v)
        if type(v) == "table" then v = v[1] end
        Priority3 = tostring(v)
    end
})

StatusInfo = OreTab:Info({Title = "Status", Value = "Idle"})

OreTab:Button({
    Title = "Refresh",
    Callback = function()
        ZoneDropdown:Refresh(getZones())
        RarityDropdown:Refresh(getRarities())
        Prio1Dropdown:Refresh(getRarityOptionsWithNone())
        Prio2Dropdown:Refresh(getRarityOptionsWithNone())
        Prio3Dropdown:Refresh(getRarityOptionsWithNone())
    end
})

OreTab:Toggle({
    Title = "AutoFarm",
    Flag = "Ore_AutoFarm",
    Default = false,
    Callback = function(v)
        AutoFarmOre = v
        if v then task.spawn(farmLoop) end
    end
})

SellStatusInfo = SellTab:Info({Title = "Cep", Value = "Idle"})

SellTab:Button({
    Title = "Sell",
    Callback = function()
        task.spawn(doSell)
    end
})

SellTab:Toggle({
    Title = "Auto Sell",
    Flag = "AutoSell",
    Default = false,
    Callback = function(v)
        AutoSell = v
        if v then task.spawn(autoSellLoop) end
    end
})
