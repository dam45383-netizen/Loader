local Window = getgenv().SORU_Window
if not Window then return end

repeat task.wait() until game:IsLoaded()
local SORU = loadstring(game:HttpGet("https://raw.githubusercontent.com/dam45383-netizen/Loader/refs/heads/main/UI.lua", true))()

local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local BASE_CF = CFrame.new(514.4080810546875, 72.60182189941406, -406.4489440917969)

local Window = SORU:CreateWindow({Title="Soru Hub", Subtitle="Touch + Panel", ToggleKey=Enum.KeyCode.RightShift})

-- PANEL KANAN - sesuai request lu
local EggPanel = Window:Panel({
    Title = "Egg List",
    Subtitle = "Klik buat steal",
    Width = 330,
    Open = true, -- langsung kebuka
    OpenDrag = "Left", -- Left = panel di KANAN layar (sesuai docs SORU)
    GripY = 0.35,
    Footer = true
})

local StealTab = Window:Tab({Title="Steal", Icon="S"})
local Accordion = StealTab:Accordion({Title="Auto Steal Egg", Desc="Filter Touching", Open=true})

local statusObj = StealTab:Label("Status: Idle")
local countObj = StealTab:Label("Egg found: 0")

local SelectedArea = nil
local AutoSteal = false
local TouchingSlots = {}
local eggButtons = {}

local function getHRP() return LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") end
local function getGuardFolder() return workspace:FindFirstChild("__OBJECTS") and workspace.__OBJECTS:FindFirstChild("Areas") and workspace.__OBJECTS.Areas:FindFirstChild("GuardAreas") end
local function getAreaNames()
    local f = getGuardFolder()
    if not f then return {"No Areas"} end
    local t={} for _,v in ipairs(f:GetChildren()) do table.insert(t, v.Name) end
    return #t>0 and t or {"No Areas"}
end
local function getSelectedInst() local f = getGuardFolder() if f and SelectedArea then return f:FindFirstChild(SelectedArea) end end
local function getPos(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst.Position, inst.CFrame end
    if inst:IsA("Model") then return inst:GetPivot().Position, inst:GetPivot() end
    local bp = inst:FindFirstChildWhichIsA("BasePart", true)
    if bp then return bp.Position, bp.CFrame end
end

local function isTouchingGuard(slot, guardModel)
    local slotPos = getPos(slot)
    if not slotPos then return false end
    for _, part in ipairs(guardModel:GetDescendants()) do
        if part:IsA("BasePart") then
            local localPos = part.CFrame:PointToObjectSpace(slotPos)
            local s = part.Size
            if math.abs(localPos.X) <= s.X/2 + 4 and math.abs(localPos.Z) <= s.Z/2 + 4 and math.abs(localPos.Y) <= s.Y/2 + 25 then
                return true
            end
            local closest = part:GetClosestPointOnSurface(slotPos)
            if (closest - slotPos).Magnitude <= 8 then return true end
        end
    end
    return false
end

local function getClosestPrompt()
    local hrp = getHRP()
    if not hrp then return nil end
    local close, dist = nil, math.huge
    for _,v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            local bp = v.Parent:IsA("BasePart") and v.Parent or v.Parent:FindFirstChildWhichIsA("BasePart", true)
            if bp then
                local d = (bp.Position - hrp.Position).Magnitude
                if d < dist and d < 25 then dist=d; close=v end
            end
        end
    end
    return close
end

local function stealSingle(slot)
    task.spawn(function()
        local pos, cf = getPos(slot)
        if not pos then return end
        local hrp = getHRP()
        if hrp then hrp.CFrame = cf + Vector3.new(0,3,0) end
        statusObj:Set("Stealing: "..slot.Name)
        task.wait(0.25)
        local prompt = getClosestPrompt()
        if prompt then
            pcall(function() prompt.HoldDuration = 0; prompt.MaxActivationDistance = 100 end)
            fireproximityprompt(prompt)
        end
        pcall(function()
            local r = workspace:GetChildren()[42]
            if r and r:IsA("RemoteEvent") then r:FireServer() end
        end)
        task.wait(0.4)
        if hrp then hrp.CFrame = BASE_CF end
    end)
end

local function clearPanelButtons()
    for _,b in ipairs(eggButtons) do pcall(function() b:Destroy() end) end
    eggButtons = {}
end

local function refreshPanelList()
    clearPanelButtons()
    if #TouchingSlots == 0 then
        local lbl = EggPanel:Label("No egg touching area")
        table.insert(eggButtons, lbl)
        return
    end
    EggPanel:Section("Found "..#TouchingSlots.." Eggs")
    for i, slot in ipairs(TouchingSlots) do
        local btn = EggPanel:Button({
            Title = slot.Name,
            Desc = "Tap to steal this egg",
            Callback = function() stealSingle(slot) end
        })
        table.insert(eggButtons, btn)
        if i > 30 then break end -- limit biar ga lag panel
    end
end

local function scanTouchingSlots()
    TouchingSlots = {}
    local guard = getSelectedInst()
    local eggFolder = workspace:FindFirstChild("AreaEggSlotsClient")
    if not guard or not eggFolder then countObj:Set("Egg found: 0"); refreshPanelList(); return {} end
    for _, slot in ipairs(eggFolder:GetChildren()) do
        if isTouchingGuard(slot, guard) then table.insert(TouchingSlots, slot) end
    end
    countObj:Set("Egg found: "..#TouchingSlots.." touching "..guard.Name)
    EggPanel:SetSubtitle(#TouchingSlots.." eggs in "..guard.Name)
    refreshPanelList()
    return TouchingSlots
end

-- UI TAB
local areaDropdown = Accordion:Dropdown({
    Title = "Area Filter (Touch)",
    Flag = "AreaTouchFilter",
    Options = getAreaNames(),
    Callback = function(v)
        SelectedArea = v
        statusObj:Set("Scanning: "..v)
        scanTouchingSlots()
    end
})

Accordion:Button({Title="Rescan Egg List", Callback=function() scanTouchingSlots() end})

Accordion:Toggle({
    Title="Auto Steal (Touch)",
    Flag="AutoStealTouch",
    Default=false,
    Callback=function(v)
        AutoSteal = v
        if not v then return end
        task.spawn(function()
            while AutoSteal do
                pcall(function()
                    if #TouchingSlots==0 then scanTouchingSlots() end
                    if #TouchingSlots>0 then
                        local slot = TouchingSlots[math.random(1,#TouchingSlots)] -- random biar ga ketebak, ganti ke closest kalo mau
                        local hrp = getHRP()
                        local _, cf = getPos(slot)
                        if hrp then hrp.CFrame = cf + Vector3.new(0,3,0) end
                        task.wait(0.25)
                        local prompt = getClosestPrompt()
                        if prompt then prompt.HoldDuration=0; fireproximityprompt(prompt) end
                        local r = workspace:GetChildren()[42]
                        if r and r:IsA("RemoteEvent") then r:FireServer() end
                        task.wait(0.4)
                        if hrp then hrp.CFrame = BASE_CF end
                    end
                end)
                task.wait(1)
            end
        end)
    end
})

